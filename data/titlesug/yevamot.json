{"ויקשה לולא עליה ערוה מתייבמת הא אין עשה ":["קושיה: האם ערוה מתייבמת","עשה של ייבום ואיסור ערוה","עשה דוחה לא תעשה בשעטנז","למה אין עשה דוחה כרת","ייבום בערוה מן הקושיה","קל וחומר מגדילים לשעטנז"],"שש עריות חמורות מאלו שנשואות לאחרים צרות":["שש עריות וצרותיהן מותרות","מחלוקת ב\"ש וב\"ה בצרות אחים","חליצה ויבום: פסול או כשר","הכשר ופסול בחליצה ויבום","אף שאוסרים ואלו מתירין","צרות מותרות לפי שש עריות"],"א רבי אושעיא ר ש חולק אף ברישא נולד ואח ":["רבי שמעון חולק ברישא","משנה יתירה ללמד דין רבנן","נולד ואחר כך ייבם: מחלוקת","הוכחה מן משנה יתירה","רבנן ור\"ש בנולד ואחר כך","מחלוקת רישא וסיפא במשנה"],"כלל אמרו ביבמה איסור ערוה לא חולצת ולא מ":["כלל איסורי יבמה: ערוה, מצוה, קדושה","האם צרת אילונית בכלל הכלל","שלושה סוגי איסור ביבמה","צרת אילונית וכרא\"ס בכלל","איסור ערוה לעומת איסור מצוה","כלל הקדושה והמצווה ביבמה"],"כלל או לרבות צרת אילונית שפטורה וכרא ס":["צרת אילונית מן הכלל או לא","לרבות או למעט צרת אילונית","כרא\"ס: לרבות או למעט","היקף הכלל ביבמה: ערוה בלבד","האם איסור ערוה בלבד מכריע","צרת אילונית ודין הכלל"],"מכל מקום לרבות ממזר שלא תלמד אחוה אחוה מ":["ממזר זוקק ליבום כאח","לרבות ממזר לדין יבום","אח ממזר: יבום וטומאה","ממזר פוטר ביבום כשר","אחיו הוא לכל דבר: ממזר","לרבות ממזר ליורשו ולטומאה"],"מצוה בגדול לייבם ואם קדם הקטן זכה":["מצוה בגדול לייבם","גזירה שוה: על שם אחיו לנחלה","והיה הבכור: דרשת הפסוק","למעט אילונית וסריס ביבום","לא ימחה שמו: סריס מיבם","רבא: גזירה שוה יוצאת מפשוטו"],"ד והיה הבכור מצוה בגדול לייבם אשר תלד למ":["כשמייבם פשוט לא יטול נחלה","הוכחה: על שם אחיו בגזירה שוה","כשאין בכור: עדיפות לגדול","ישיבת אחים וקדימת קטן","שאלת הנחלה בכורה וגדולה","בכור ונחלה: מדרשת הפסוק"],"ויקשה דר נחמיה איש שנתגייר לשם אשה ולהיפ":["גרים לשם אשה ולשולחן מלכים","אין מקבלין גרים לימות המשיח","עבדי שלמה: גרים או לא","הלכה: כולם גרים הם","מי גר אתך בעניותך","גיור לשם אשה וקבלת גרים"],"מביא ממה י אבל מא י שלא נסמכים עליו ישא ":["עד מחו\"ל: נישואין ללא ספק","כתב מוכיח ונסמכים על העד","עדות מחו\"ל וביאת הבעל","ביאה מארץ ישראל לעומת חו\"ל","דייקא: מתי אין כתב מוכיח","ישא אשתו על עדות מחו\"ל"],"בנדר מדובר ביחיד מומחה היכול להתיר דבשלש":["התרת נדר ביחיד מומחה","שלושה לעומת יחיד מומחה","מי מתיר נדר: יחיד או בית דין","בשלשה ישאנה בית דין","הפרת נדר ביבמה בידי מומחה","נדר יבמה: יחיד מומחה להתיר"],"וכולם שהיו להם נשים ומתו מותרות לינשא לה":["מתו נשים: מותרות לקרובים","נתגרשו אף הם מותרות: קטטה","כשהיתה קטטה כבר: היתר לחזור","מיתה וגירושין: אין זה כזה","מיתה אגירושין וגירושין אמיתה","מותרות לבניהם ולאחיהם"],"ומתו ודתניא היו להם נשים אפי נתגרשו מותר":["קטטה והתחלה: מתי מותרות","נתגרשו: מחלוקת קטטה חדשה","גירושין במיתה: כלל אחד","מותרות לבנים ולאחים","כשלא הייתה קטטה אלא כעת","נשים שנתאלמנו ונתגרשו"],"אין להוכיח ש יש זיקה מזה שאין כ א מייבם ":["אסור לבטל מצות יבמין","ארבעה אחין: חוששין לביטול מצוה","חמישה מייבמים: אין זיקה","שלא חוששים למיתת שניים","מדוע אין ראיה מכך שאין זיקה","ביטול מצוה בארבעה אחין"],"טעם ר ש ואשה אל אחותה לא תקח לצרור בשעה ":["טעם רבי שמעון: לצרור","לא תקח אשה אל אחותה","צרות: אסור ליקוח אף אחת","איסור נשיאת אחות בצרור","דרשת לצרור ואיסור ליקוחין","טעמו של רבי שמעון בצרות"],"שלשה אחין ב נשואים ב אחיות ואחד מופנה":["שלושה אחין ושתי אחיות נשואות","אחות אשה: אשתו עמו או יוצאת","ב\"ש וב\"ה במופנה ובאחיות","אוי לו על אשתו ועל אשת אחיו","אחים ואחיות: מחלוקת מופנה","מגט וחליצה לאשת אחיו"],"זו למעט דרי ה בפי ג שלא קיי ל כמותו אלא ":["זו למעט דרי\"ה בפרק יג","הלכה כרבי גמליאל או רבי אליעזר","דרי\"ה שאין הלכה כמותו","זו: מיעוט שאין הלכה כמותו","פרק יג: דרי\"ה לא נפסק","למעט דעה שאין הלכה כמותה"],"משמע שלא עשה מאמר מתייבמת":["מאמר אחד: זיקה אף באחד","דיוק רב נחמן ודחיית רב אשי","שלא עשה מאמר: מתייבמת","אין זיקה אף באחד לרב נחמן","מאמר ויבום: דיוק הברייתא","רב אשי דוחה את דיוק רב נחמן"],"שנה זאת ראשונה לאסור דנכרית צרה לערוה":["נכרית צרה לערוה: שינוי ההלכה","משנה ראשונה להתיר ואחרונה לאסור","חביבה והקדימה: משנה שלא זזה","חזרה מהיתר לאיסור בצרה","ערוה צרה לנכרית ולהיפך","שתי משניות בדין צרה נכרית"],"רב יבמה שאינני קורא בה בשעת נפילה יבמה י":["יבמה שלא נקראה בשעת נפילה","רב: דין אשת אח עם בנים","אסורה עולמית: נדחית מן הבית","קרא בה יבא עליה: ליבמה נפולה","אף שלא נדחתה לגמרי מאחיו","אסורה לו עולמית אף שחזרה"],"זו היא משמע למעט מת ואח כ גירש ואח כ כנס":["זו היא: מי נאסרה עולמית","נישואין ראשונים מפילים: מחלוקת","יש זיקה אף בשנים לר' אשי","ספק קדושין וספק גירושין בעריות","ר' נחמן ורבא: דיוק זו היא","כתב בכתב ידו: ספק גירושין"],"שלשה אחין נשואים שלש נכריות מת אחד":["שלוש נכריות ושני מאמרים","גט למאמר לא לזיקה: רבא","מי שעליה זיקת יבם אחד","ר\"ש: מייבם איזו שירצה","הותרה צרה והיא לא: דברי רבא","ייבום מדרבנן לשני יבמות"],"ואינו מהתורה שא כ גם חליצה לא תצטרך":["ייבום שניהם מדרבנן: אסור","אשר לא יבנה: מי שלא בנה","גט למאמר: הותרה אף היא","רבא: מה שעשה נטל","שני יבמות מבית אחד","מאמר וגט לזיקה ולקידושין"],"ב אחין נשואין ב אחיות מת אחד ואח כ מתה א":["ב' אחין ב' אחיות: אסורה עולמית","נדחתה מהבית לגמרי: הלכה","משנה קודמת סברה להתיר","חביבה והקדימה: משנה זו","נאסרה עליו שעה אחת","אסורה עליו עולמית לחומרה"],"שנה זאת ראשונה לאסור שנדחתה מהבית לגמרי":["שנה ראשונה לאסור: נדחתה לגמרי","שלא נדחתה לגמרי מאחיו","חזר בו לאסור: מסר המשנה","מחלוקת המשנה: להתיר או לאסור","משנה זו לא זזה ממקומה","אשת אח מתה: עוד מחלוקת"],"החליפו הוחלפו בטעות דלא ברשיעי ועוד דר ח":["החליפו בטעות: לא נאסרו","שוגג לא מזיד: החלפת הנשים","מפרישין שלושה חודשים וחוזרות","ר\"ח: חייב קרבן על שגגה","החלפה במזיד או בטעות","נאסרו במזיד: הוכחה מהמשנה"],"ברישא לא חלקו ב ש ובחזקתה ובסיפא חלקו לא":["ספק ארוסה וספק נשואה: ירושה","בית שמאי בחזקה וביורשים","עולא: ספק מוציא מידי ודאי","רבה ואביי: יחלוקו בית שמאי","ספק נשואה והיבם בחצי","חלוקה בחצי ונפילה לייבום"],"החולץ ליבמתו הרי הוא כאחד מן האחין לנחלה":["החולץ ליבמתו: נחלה כאח","נכסי אב: יש אב לפני חליצה","הכונס ליבמה וזכייה בנכסים","ר' יהודה: כבכור לאחר מיתת אב","הלכה כר' יהודה או כרבים","קרוב אסור: החולץ ליבמתו ואסורים"],"החולץ ליבמתו דהו א הואיל ואפסדה מיבום מה":["עולא ור\"י נפחא: הלכה כר\"י","ר' ינאי ור\"נ: קרא דבריך בחוץ","איסור קרובות החולץ והכונס","מותר בקרובת צרת חלוצתו","אסור בצרת קרובת חלוצתו","נכסי אב ויבום: מחלוקת ר\"י"],"החולץ ליבמתו ונשא אחיו אחותה ומת חולצת":["חלצה ונשא אחיו אחותה","מגרש: פטורה משום ערוה","חליצה והנישואין לאחות","אחות חלוצה: חולצת ולא מתייבמת","ערוה לאחר גירושין ואחות","גט מול חליצה באחות היבמה"],"ר ל כאן שנה רבי אחות גרושה מד ת אחות חלו":["אחות גרושה מד\"ת וחלוצה מד\"ס","שמואל: הלכה כריב\"ב","יש זיקה: הכרעת שמואל","ר\"ל: כאן שנה רבי","גרושה וחלוצה: איסור אחות","הבחנה בין אחות גרושה לחלוצה"],"היבמה לא תחלוץ ולא תתייבם עד שיעברו שלשה":["ג' חודשים לכל הנשים","שלושה חודשים לפני חליצה","ר\"י: נשואות יתארסו וארוסות ינשאו","ר' יוסי: כל הנשים יתארסו","מפני האיבול: האלמנה לבד","טעמי ההמתנה: ולד קיימא"],"לא תתייבם שמא יהיה ולד קיימא ופגע באא ח ":["חליצת מעוברת: למה ממתינה","ספק קידש משתי אחיות: אליהו","לא איעברה: ממתינה ג' חודשים","ולד קיימא ופסול כהונה","בדיעבד או לכתחילה בחליצה","גרושה מפעם וארוסה: טעמים"],"יבמה ג חדשים נזונת מבעל אח כ לא מבעל ולא":["יבמה נזונת מבעל לג' חודשים","עמד בדין וברח: משל יבם","נפלה לפני קטן: לא מיבם","מזונות היבמה בין בעל ליבם","לא משמים קנסוה","ביבמה ונפילה לבעל או ליבם"],"ת ר יבמה שחלצו לה בתוך ג ח ממתינה ג ח מש":["ג' חודשים משעת מיתה","חליצה בתוך ג' חודשים","שאני מגט דרב ושמואל","ממתינה משעת נתינה או כתיבה","איסור כרת לעומת איסור לאו","ג' חודשים לחליצה מכאן"],"והתניא ודברו אליו שמשיאין לו עצה הוגנת ל":["ודברו אליו: עצה הוגנת","הוא ילד והיא זקנה: לחלוץ","מהיכן יפרנס כולן","ארבע נשים ועצה טובה","עשיר ששאל עצה ליבמות","עצה הוגנת לאיש ולנשים"],"קרובת חלוצתו ויקשה הא אחות חלוצה מד ס":["קרובת חלוצתו: ממזר לר\"ע","קרובת גרושתו ממזר מודים","בית חלוץ הנעל קראו ביתו","סתום כשיטה תנאית אחרת","אחות חלוצה מדרבנן: קושיה","ר\"ע וחכמים בקרובת חלוצה"],"א טעם ר ע לא יקח ולא יגלה כנף אביו כר י ":["טעם ר\"ע: לא יקח ולא יגלה","ממזר מאנוסת אביו: מחלוקת","שלוש שיטות בטעם הממזרות","נדה וסוטה: אינו ממזר","שומרת יבם: מסופק הממזרות","לא יבא ממזר: דרשת הפסוק"],"יבמה אחת ליבם אחד ש":["מאמר גט בעילה וחליצה בזה","מה מפקיע זיקה ומה קידושין","סדר פעולות: מאמר וגט","גט ומאמר: צריכה גט וחליצה","שתי יבמות ליבם אחד: מאמר","סדר מאמר גט בעילה וחליצה"],"גט מאמר בעילה חליצה":["מאמר בזו וגט לזו: הפקעת זיקה","ב' יבמות: מאמר ומאמר","גט לזו וחליצה לזו","בעילה פסולה ושני גיטין","סדר הפקעה בריבוי יבמות","מי צריכה גט וחליצה לזיקה"],"חליצה מאמר גט בעילה או בעילה מאמר גט חלי":["גט לזו וגט לזו: חליצה אחת","אסור בקרובות הב' כרבנן","חליצה לזו ובעילה לזו","בתחילה, באמצע ובסוף: בעילה","אין אחר חליצה כלום","ר' נחמיה: בשניהם אין כלום"],"וכן ב יבמות ליבם אחד או ב יבמין ליבמה אח":["חליצה לזו וחליצה לזו","בעילה: מתי אין אחריה כלום","גירושין אחר חליצה: זיקה פקעה","ר' נחמיה לעומת חכמים בבעילה","בתחילה אין אחריה כלום","כמה גיטין וחליצות בריבוי יבמות"],"גט לזו גט לזו מאמר בעילה חליצה":["רבי נחמיה: בשניהם אין כלום","אחר חליצה או בעילה: אין כלום","בעילה באמצע ובסוף לחכמים","גט לזו ובעל זו: ביאה פסולה","גט וחליצה לזו: מתי פוקעת","הפקעת זיקה ביבמות רבות"],"חליצה לזו חליצה לזו מאמר גט בעילה":["ה' חלוקות של בעילה וחליצה","סדר ההפקעה בתחילה ובאמצע","ר' נחמיה: אף באמצע או בסוף","בעילה בתחילה מבטלת הכל","שלוש עמדות בסדר הפעולות","אין אחר חליצה כלום בכל מצב"],"ה ק הוא שוגג סבר שלא יבמתו הוא מזיד לזנו":["שוגג ומזיד בביאת יבמה","לא לשם מצוה: שניהם","ר' חייא: אפילו שוגגים או אנוסים","היא למצוה והוא לזנות","כוונה לשם מצוה בביאה","ביאה שלא לשם מצוה: טעמי"],"טעם ר מ אם קדושי רשות לא מאכילין כ ש קדו":["קדושי רשות ואכילה בתרומה","פצוע דכא כהן וכבת ישראל","רבי מאיר: אם קדושי רשות לא מאכיל","קדושי עבירה מאכילים: מחלוקת","אביי ורבא: מאכילה בלא ידעה","כהן פצוע דכא ותרומה לאשתו"],"ד אלמנה לא יקח אף מהאירוסין וקמ ל דלא יל":["אלמנה לא יקח אף מאירוסין","לא ילפינן מתמר מנישואין","גזירה שוה ממאירוסין לאלמנה","גרושה ואלמנה: אין הבדל","דומיא דגרושה מאירוסין","כהן ואלמנה: מקור האיסור"],"יכנוס ד יקח אשה ריבוי אבל רק אשה שאירסה ":["יקח אשה: ריבוי לאשה מאורסה","יכנוס: אשה שאירסה ולא יבמה","יקח אשה לא יבמה","רבוי יקח אשה ומורשת","אשה שאירסה: ריבוי מיוחד","מי נכנס בכלל יקח אשה"],"מהנשואין ד עשה ולא תעשה ואין עשה דייבום ":["כהן לא ישא אילונית אלא בבנים","זונה לר' יהודה וחכמים","הזנו ולא יפרוצו: טעם ר' יהודה","עשה דייבום ואסור כהונה","גזירה: ביאה ראשונה אטו שניה","זונה שבתורה: גיורת ומשוחררת"],"ת ק נקט כהן משום ר י ולעולם אוסר גם לישר":["ר\"א: כהן לא ישא קטנה","רבה: כר\"מ וכר\"י","קטן וקטנה: לא חולצין ולא מתייבמין","זונה כשמה מבעלה: ר\"א","פנוי על הפנויה שלא לאישות","ראב\"א: בכהן גדול ובעולה"],"הא יש לו בנים נושא אשה דלאו בת בנים אבל ":["כהן עם בנים ונישואין נוספים","שמואל: אסור לעמוד בלא אשה","למכור ספר תורה בשביל אשה","לא טוב היות האדם לבדו","כהן שאין לו בנים: נישואין","נישואי כהן בת בנים או לא"],"ת ר שהה י שנים יוציא ויתן כתובה שמא לא ז":["שהה עשר שנים: גירושין וכתובה","עשר שנים לשבת אברהם","ישיבת חו\"ל אינה נמנית","יצחק עקר ולמדים מאברהם","שנות יצחק לייחס שנות יעקב","חולה או בבית האסורים: אין מנין"],"טעם ת ק א ומלאו את הארץ וכבשה חסר איש שד":["פרו ורבו: ואל אברהם אני א-ל","שינוי דבר שלום: חובה או מצוה","גדול השלום: ה' שינה בדבר","ואדוני זקן: שינוי לשלום","מצוה שלא לומר דבר שלא נשמע","ר' אבא: אל תוכח לץ"],"בת ישראל שניסת לכהן ומת והניחה מעוברת רב":["בת ישראל לכהן מעוברת","עובר במעי זרה זר או שאין ילוד","לא יאכלו מפני חלק עובר","רבי יוסי ובת כהן לכהן","ילוד מאכיל: אביי ורבא","זו שמעתי וזו לא שמעתי"],"איבעיא טעמו עובר במעי זרה זר או שאין ילו":["עובר במעי כהנת: נפק\"מ","רבה ורב יוסף: טעם האכילה","קשיא: שאין ילוד אינו מאכיל","מעשה ביוסי ובת כהן","טעם חלק העובר בתרומה","בת כהן ועובר: מחלוקת אמוראים"],"העובר היבם האירוסין החרש ובן תשע שנים וי":["העובר, היבם, האירוסין, החרש","בן תשע שנים ויום אחד","ספק בן תשע: שתי שערות","בת כהן לישראל: כנעוריה","פוסלין ומאכילין: טעמי הפסול","נפל הבית על בת אחיו"],"עובר בת כהן לישראל ושבה כנעוריה ולא מעוב":["בת כהן לישראל: שבה אל בית אביה","בת ישראל לכהן: קנין כספו","אירוסין בהויה ובמשום שמא","חרש: קנין בתקנה דרבנן","שומרת יבם: ושבה אל בית אביה","הפסולים מן האכילה בתרומה"],"האונס המפתה והשוטה לא פוסלין ולא מאכילין":["האונס והמפתה: לא פוסלין","ישראל שבא על בת כהן","עבד פוסל משום ביאה","ממזר פוסל ומאכיל","כיצד: בת ישראל לכהן וילדה בת","שטות וקטן: פסול ביאה וזרע"],"כדת ר שוטה וקטן שמתו נשותיהן פטורות מחלי":["שוטה וקטן שמתו: פטורות","נשותיהם פטורות מחליצה וייבום","פטור מחליצה ביבמת שוטה","כדתנן: שוטה וקטן","קטן ושוטה: אין יבום","נשי שוטה וקטן בדין יבום"],"איבעיא פצוע דכא כהן בגיורת ומשוחררת בקדו":["פצוע דכא כהן בגיורת","לא תתחתן בם: איסור בגויים","רבא: גזרו בכשרים ולא בפסולים","שלמה ובת פרעה: גיורה","גזרה על בני הולדה בלבד","חתנות בגויותם ובנתגיירו"],"ד כראות שאול את דוד יוצא לקראת הפלשתי אמ":["עמוני ולא עמונית: מעשה דוד","דואג ואבנר: בן מי זה הנער","ממזר ומום זר: לא קשה","מקובלני משמואל: עמוני ולא עמונית","יתר הישמעאלי מכריז","על אשר לא קדמו בלחם ובמים"],"ר ל ממזרת אחר י דורות מותרת":["ממזרת אחר עשרה דורות","עשירי עשירי: זכרים ונקבות","דון מינה ואוקי באתרא","עמוני ומואבי: איסור לזכרים","ר\"ל: נקבות מותרות אחר עשר","אחר עשרה דורות מותרת"],"סריס חמה כהן שנשא בת ישראל מאכילה בתרומה":["סריס חמה כהן מאכיל","אנדרוגינוס: נושא ולא נישא","טומטום שנקרע ונמצא זכר","ר\"א: אנדרוגינוס כזכר לסקילה","ריו\"ס ור\"ש: אנדרוגינוס מאכיל","שאינו מוליד אינו מאכיל: דחייה"],"סריס חמה כהן מאכיל ואין אומרים שאינו מול":["אין אומרים שאינו מוליד","סריס חמה ותרומה לבת ישראל","מאכיל אף שאינו מוליד","סריס בעל תרומה: הלכה","שאינו מוליד: אין מוציאים מן התרומה","תרומה לסריס חמה כהן"],"שנה ברישא נשא ולא קידש שגם אסורה על היבם":["נשא ולא קידש: עשה ולא תעשה","חלל שנשא כשרה: טעם הלשון","אלמנה ולא בתולה: נישואין מפילין","כהן גדול שנשא אלמנה","למה נקטה המשנה 'נשא'","אסורה על היבם מטעם לא תעשה"],"משנתינו ד לא תאכל במעשר כר מ ד מעשר ראשו":["מעשר ראשון אסור לזרים","כר\"מ: כתרומה לזרים","טובלת כתרומה למיתה וחומש","רבנן: לאו דלא תוכל לאכול","תרומה במיתה ובחומש: מחלוקת","מעשר שני ועני בלאו"],"ראשון לפני שמועה ו אחרון לאחר שמועה":["ולד ממזר מיבמה: ר\"ע","אין קדושין בחייבי לאוין","ממזר מאשת יבם לעומת חכמים","מלאוין דשאר: כן ממזר","ראשון לפני שמועה ואחרון לאחר","ר\"ע מודה בממזר לענין קידושין"],"ומשנתינו אפי בהלכו אשתו וגיסו בעל אחות א":["בהלכו בעל אחות אשתו למדינת הים","כל עריות אין צריכות גט","אחות גרושתו: קושיה על ר\"ע","תנאי בקידושין ולא בנישואין","אשת אח שנשא אחיו בתנאי","אשתו מותרת: קושיה ותירוץ"],"אחר מיתת ראשונה ר ששת אחר מיתת ראשונה וד":["אחר מיתת ראשונה: ודאי","ר' ששת: מיתה לפני הביאה","ביאה אחר מיתת הראשונה","הקדמת מיתת הראשונה לשנייה","בעילה אחר מיתה: הלכה ודאית","מאמר או בעילה לאחר מיתה"],"תניא ר ש אם ראשון ביאה שני לא ביאה":["רבי שמעון: ביאה ראשונה ושנייה","מאמר אחר מאמר ביבמין","לא כב\"ע: ב' יבמין ויבמה","בן תשע שבא על יבמתו","שתי יבמות ליבם אחד: לא","זיקת שני יבמין חולצת"],"רבא מוכח מהמשנה זיקת ב יבמין חולצת לא רק":["זיקת ב' יבמין חולצת","רבא: לא רק כשיש צרה","מוכח מן המשנה לרבא","חליצה בשני יבמין מוכחת","זיקה ביבמין ללא צרה","רבא: מן המשנה על יבמין"],"כדת ר אנס אשה מותר לישא בתה":["אנס אשה: מותר לישא בתה","הנטען מאשה: איסור מדרבנן","קרובות מחמת אשתו בנישואין","אסורה באמה ובתה ואחותה","מדרבנן אסור בקרובות האנוסה","לכתחילה לאחר מיתה"],"ראב י התיר לבני שפחה ששוחררו להחליף נשיה":["בני שפחה ששוחררו: החלפת נשים","ראב\"י ורבי שמעון: מאב ולא מאם","אחים מאב ומאם: בני פלוני","ר\"ש אסר: החלפת נשים","גר כקטן שנולד: לא גוזר","אחים מאם בלבד: מותר לכו\"ע"],"טעם חולצים ואח כ מייבם דבלא ה שמא פגע בי":["חולצים ואחר כך מייבמים","מקצתן אחין מאב ומקצתן מאם","מקצתן כהנים: חולצין ואינן מייבמין","אחד מייבם את כולם: לא","כולן חולצין במקצתן מאם","ספק אחים מאב ומאם בחליצה"],"שבמקום ר י העלו מתרומה ליוחסין במקום ריו":["העלאה מתרומה ליוחסין","ר' שמעון: מי העיד במקום מי","עבד לכהונה על פי עדות","מימי העדתי רק עדות אחת","העלאת עבד לכהונה: עדות במקום אחר","הטעיית עדות בבני ישראל"],"דיינין שיודעים להקרות כדיינים אף שהדיוטו":["שלושה שיודעים להקרות כדיינים","ב\"ד שקול: ג' לעומת ה'","זקני ישראל: הדיוטות וגרים","ר\"י: חמישה לחליצה","לעיני הזקנים: מקום ורוק","ונקרא שמו בישראל: מי משיב"],"ואעפ כ ר פ ורהבדר י עשו בחמשה לפרסם הדבר":["חמישה לחליצה לפרסום הדבר","רשב\"י: בישראל ואני גר","ר\"י ורשב\"י: שטר על פיו","להצטרף לחמשה ולפרסם","רשב\"י לא מוציא בלי עדים","ר\"כ מבקש להצטרף לחמשה"],"ולכו ע לא מקישים ריבים לנגעים דא כ אפי ג":["חליצה בלילה: מחלוקת שמואל","אין מקישים ריבים לנגעים","חליצה כתחלת דין או גמר דין","עשה מעשה ביחידי בלילה","רב\"ח קטוספאה ביחיד","ר' יש בן אלישע חלץ במוק"],"חלצה ורקקה ולא קראה חליצתה כשרה":["חלצה ורקקה ולא קראה: כשרה","קראה ורקקה ולא חלצה: פסולה","ר\"א ור\"ע: חלצה וקראה ולא רקקה","ככה יעשה: כל מעשה מעכב","חרש וחרשת: חליצה פסולה","קטנה שחלצה תחלוץ משתגדיל"],"למסקנא אסיפא דחרש שנחלץ והחרשת שחלצה פסו":["קריאה מעכבת באלם ואלמנה","קרייה: מה מעכבת בחליצה","הראוי לבילה: ביאה אינה מעכבת","כ\"ד דבר שנאמר באמר ואמרה","חרש וחרשת: חליצה לא כשרה","קריאה ורישא: כר\"ז"],"מצות חליצה בא ויבמתו לב ד ומשיאין עצה הה":["סדר חליצה לעיני הזקנים","מאן יבמי להקים לאחיו שם","בית חלוץ הנעל: הכינוי","רוק הנראה לדיינים בחליצה","מצוה בדיינים ולא בתלמידים","ר\"ה וגמר כל הפרשה"],"טעם ב ש א אין תנאי בנשואין ואם תמאן יטעו":["תנאי בנישואין: ב\"ש וב\"ה","אין אדם עושה בעילתו זנות","משום פירי שמנישואין","אין אדם טורח בסעודה ומפסידה","בית הלל: ידעי דנישואיה דרבנן","חופה ומסירה לשלוחי בעל"],"מר י תיקנו בגט מיאון ביום פלוני מיאנה פל":["גט מיאון: נוסח התיקון","ביום פלוני מיאנה פלונית","תיקנו גט מיאון בפנינו","מיאון לתקנת גט","תקנת הנוסח לגט מיאון","מיאון ונוסח הגט בפני ב\"ד"],"רישא מיאון מבטל גט וסיפא מיאון חברו לא מ":["מיאון חברו לא מבטל גט","מיאון שלו מבטל גט חברו","שמואל: מי ששנה זו לא שנה זו","גזירה: מכרת ברמיזותיו","שילשה בגיטין וניראית כגדולה","רבא ורבי אלעזר: סיפא לא מבטל"],"המגרש את האשה והחזירה מותרת ליבם ר א אוס":["המגרש ומחזיר: מותרת ליבם","ר\"א אוסר להחזיר לאחר גירוש","יתומה שהשיאוה אחיה","קטנה שהשיאה אביה ונתגרשה","החזרה לאחר גט: איסור ליבם","לכו\"ע אסורה ליבם לקטנה"],"לר א מלמדין ואף דידבק בחליצה הבאת שלום ה":["לר\"א מלמדין לאדם","חליצה, הבאת שלום, הפרת נדרים","מיאונין ופקדונות ועירבונות","כאב\"ש הכונס יבמתו לשם נוי","רבי צדוק: רע ירוע כי ערב זר","הנודר כבנה במה"],"נשוי ב יתומות קטנות ומת ביאה וחליצה של א":["שתי יתומות: ביאה וחליצה אחת","קטנה וחרשת: ביאת אחת אינה פוטרת","נשוי שתי יתומות ומת","שתי חרשות: פטור צרה בביאה","ביאה אחת פוטרת צרה","חליצה ביבמה חרשת ויתומה"],"ויקשה מדתנן חרשת חליצתה פסולה":["חרשת: חליצתה פסולה","רבה: כאן חרשת מעיקרא","פקחת שנתחרשה: נישואין דאורייתא","פקח וחרש לשתי נכריות","אביי מקשה מן המשנה לחרשות","ב' אחיות חרשות ופקח: קושיה"],"משמואל ור א הלכה כר אלעזר אף שכבר אמרו ה":["הלכה כר' אלעזר ולא כר' אליעזר","שמואל ור\"א: הלכה כר' אלעזר","שלא קיים ייבום כלל","גדולה נפלה לפניו: הבדל","ייבום בבית אחד: הכרעה","שני ביאה ושני חליצה: מחלוקת"],"יבם קטן שבא על יבמה קטנה יגדלו זע ז גדול":["יבם קטן ויבמה קטנה: יגדלו","לא נבעלתי בתוך ל' יום","כופין שיחלוץ לה או מבקשין","נדרה הנאה מיבמה בחיי בעלה","ב\"י חדשים: מודה ומשתכנע","שניהם קטנים לא מוזהרין"],"לכאורה משנתינו לא כר מ דקטן וקטנה לא מתי":["קטן וקטנה: מתייבמין או לא","לכאורה לא כר\"מ בקטנה","מוזהרין על איסור אחות אשה","יבמה גדולה: כל ביאה חשש","שכל ביאה חשש איסור","ביאת קטנים ואזהרה"],"טענת ב ש לדבריכם רק קציר חטים קציר שעורי":["טענת ב\"ש: קציר חטים ושעורים","שיירות מצויות ושכיחי אינשי","מעשה בקציר וה\"ה כל בוצר","נשך נחש לאחד ומת","האשה שאמרה מת בעלי תנשא","ב\"ה: אותה מדינה ומפחדת לשקר"],"ר ח נתייבמה יבמה נכנס לנחלה יקום על שם א":["נתייבמה: יבמה נכנסת לנחלה","יקום על שם אחיו והרי קם","ר' חנינא: נחלה וקיום השם","ייבום והירושה לאחר מיתה","יבמה ונחלת האח","והרי קם: טעם הנחלה ביבמה"],"איבעיא בת חמיה טעם בת חמותה ששונאתה כאמה":["בת חמיה: אשת אב לעומת כלה","שבע נשים: ר' יהודה מוסיף","כמים הפנים לפנים: טעם רבנן","חמות שונאת כלה: טעם הירושה","מגלה לבנה מעשיה","שאיסור הכלה לחמות בד\"ת"],"עולא כשהאמינה תורה עד אחד וקיבלוהו הרי כ":["עד אחד שהאמינה תורה","עולא: כאן שנים","לא תצא מהיתרה הראשון","אחד ואחד: עדות בבת","קבלה של עד אחד ביבמה","האמינה תורה: מה נחשב שנים"],"אף שתקה לא תנשא וקמ ל לא מת שאין אומרים ":["אף שתקה לא תנשא","לא מת: אין אומרים ודאי יודעת","לקלקל צרתה: תמות נפשי","אמר לה לא מת במשנה","שתיקה ביבמה ומיתת בעל","תמות נפשי עם פלישתים"],"צריכי רק בקמייתא אמר ר ט שיש לצרה צער הג":["ר\"ט: צער הגוף לצרה","ר\"ע: אין לה על חמותה אלא מילי","שמואל: הלכה כר' טרפון","ניתן לי בן ומת בעלי","לצרה לא חוששין","צער צרה: קמייתא ובתרייתא"],"מחד קידש ולא בעל באיסור ומאידך גזל ולא ל":["קידש ולא בעל: לשון הכתוב","גזל ולא לקח בהיתר","כתובה ביניהן לר\"ט ולר\"ע","רשב\"א: קידש בביאה","איסור דרבנן קנס לר\"ע","דאורייתא לא קנס: ר\"ט"],"א איבעיא מר נ המזכה גט לאשתו במקום יבם":["מזכה גט לאשתו במקום יבם","זכות לה או חוב לה","גט במקום קטטה: זכות או חוב","טוב גוף שנים מאלמנה","כסאה בין חשובות","תשב עמו בפתח ביתה"],"והך ניתן לי בן במדינת הים מת בעלי ואח כ ":["ניתן לי בן במדינת הים","ר\"פ: בגרושה ולא באשה","אני והוא נחבאנו במערה","מת בעלי ואחר כך בני","לא נאמנת בדבר בן במדינה","רחבדר\"ה: חבאה במערה"],"תנא לזו עדים ובנים ולזו לא עדים ולא בנים":["לזו עדים ובנים ולזו לא","שתיהן מותרות: עדים ובנים","עדים ובנים להיתר יבמה","יבמה בלא עדים ובנים","תנא: לזו ולזו מותרות","היתר יבמה לפי ראיות"],"ת ר צריך שיראו פדחת וגם פרצוף פנים שניהם":["צריך שיראו פדחת ופרצוף","הכרת פניהם ענתה בם","מעשה בבגד על המצח","עם החוטם: זיהוי הזקן","לראות פני היבם בחליצה","זיהוי בעל בשני פנים"],"ר מ נפל למים בין שיש להן סוף בין שאין אש":["נפל למים: אשתו אסורה","מעשה באחד שנפל לבור","ר\"מ: בין שיש סוף בין שאין","סומא שירד למערה: השיאו נשותיהם","מהארכובה ולמעלה תנשא","יש להם סוף: עומד ורואה"],"לב ש אין משיאין ע פ בת קול ולב ה משיאין ":["משיאין על פי בת קול","ב\"ש: אין משיאין על בת קול","ב\"ה: משיאין על בת קול","נפקא מינה לכשתמצא","בת קול לקביעת נישואין","מחלוקת בית שמאי ובית הלל"],"ודתניא לר ע אשה נאמנת להביא גיטה מק ו דח":["אשה נאמנת להביא גיטה","ר\"ע: הפונדקית נאמנת","בני לוי והפונדקית","מקלו ותרמילו וספר תורה","נכרית ומסיחה לפי תומה","אחר שהוחזקו: קושיה ותירוץ"],"גריעות פונדקית נכרית היתה וזה סברת רבנן ":["גריעות פונדקית: נכרית היתה","מסיחה לפי תומה: קבר שקברתיו","שראתם בכתה ורק אחר כך שאלוה","הפונדקית בכתה לפני השאלה","סברת רבנן לעומת סברת ר\"ע","דברי הפונדקית כעדות"]}