   "dhs": "מאי אין"
  },
  {
   "daf": "64a",
   "line": 5,
   "seg": 2,
   "ref": "Tosafot on Nedarim 64a:5:2",
   "text": "אמרו לו מת - ובגמרא פריך מת נולד הוא:",
