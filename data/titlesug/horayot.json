{"שמואל לעולם אין ב ד חייבין עד שיאמרו להם":["בית דין אינם חייבים עד מותרין אתם","לא נגמרה הוראה","חזר לעירו ושנה פטור","הורה לעשות חייב","הורו לה להנשא וקלקלה","הורו לעבור על כל המצות"],"בין שעשו ועשה עמהן כו רישא וסיפא זו ואצ ":["רישא וסיפא: הורו ועשו עמהם","בית דין שהורו ועשו עמהם","ביאור רישא וסיפא בהוראה","בזה רישא דהוראה כזה","תוכן רישא וסיפא","הוראה ומעשה בהמון"],"הורו ב ד וידעו שטעו וחזרו בהן בין שהביאו":["הורו וחזרו והלך ועשה פטור","ר' שמעון פוטר ור' אלעזר ספק","ישב בביתו חייב הלך למדינת הים","ר\"ע: קרוב לפטור","בן עזאי על היושב בביתו","הורו לעקור את כל הגוף"],"אריא ר רב טעמא דר ש הואיל וברשות ב ד הוא":["טעמא דר\"ש בהוראה ברשות ב\"ד","הוראה שיצאה ברוב צבור","פר העלם דבר של צבור","שעירי עכו\"ם לר\"ש ולר\"י","ר\"מ מחייב ור\"ש פוטר","אשם תלוי בין ר' יוחנן"],"הורו ב ד וידע אחד מהן שטעו ואמר להן טועי":["חבר שידע שטעו פטור","גר ממזר או נתין פוסלים","שכולם ראויים להוראה","כאן עדה ונאמר להלן עדה","זקן שלא ראוי לבנים","פסול בבית דין והוראה"],"הורו ב ד שוגגין ועשו כל הקהל שוגגין מביא":["שוגגים ועשו מזידים פטורים","מזידין ועשו שוגגין כשבה","פר לשוגגין בקהל","הא שוגג דומיא דמזיד","שהורו שחלב מותר ונתחלף לשומן","שוגגים ומזידים בהוראה"],"שוגגין ועשו מזידין הרי אלו פטורין":["תנא רישא מזידין ושוגגין","רמי בר חמא בשוגג ומזיד","חלב ושומן בהוראה שוגגת","תנא סיפא שוגגין ועשו מזידין","מחלוקת רישא וסיפא","שוגגין ומזידין בכפל תנא"],"הורו ב ד ועשו כל הקהל או רובן על פיהן לר":["כל הקהל על פי הוראה פר","י\"ב שבטים י\"ב פרים","רשב\"י י\"ג פרים","בעבודת כוכבים פר ושעיר","פר ושעיר לכל שבט","חטא שבט שלם בהוראה"],"ר יהודה אומר י ב שבטים מביאין י ב פרים ו":["שבעה שבטים על פי הוראה","ר' יהודה ז' פרים לשאר השבטים","ר\"ש ח' פרים לבית דין","שבט אחד על פי ב\"ד שלו","חכמים: רק בית דין הגדול","שבט שעשה על הוראת בית דין"],"ת ר ידעו שהורו וטעו מה הורו יכול יהו חיי":["ידעו שטעו מה הורו","ונודעה החטאת ולא שיודעים","חטאו שני שבטים שני פרים","הקהל חייב וכל קהל וקהל","ר\"ש: ב\"ד מביאין על ידיהן","ר\"מ: ב\"ד מביאים והן פטורין"],"הורה בפני עצמו ועשה בפני עצמו מתכפר לו ב":["הורה בפני עצמו מתכפר לו","הורה עם הצבור ועשה עם הצבור","בית דין עד שיורו לבטל ולקיים","גם המשיח כך","בעבודת כוכבים לבטל מקצת","ביטול מקצת וקיום מקצת"],"ומדת ר הורה עם הצבור ועשה עם הצבור יכול ":["נשיא מוצא מכלל יחיד","משיח מוצא מכלל יחיד","נשיא שחטא עם הצבור","דחיית קל וחומר בנשיא","ואכתי אינו יכול להביא פר","שני מקומות הורו בשני איסורים"],"וכן המשיח ד לאשמת העם הרי משיח כצבור":["משיח כצבור לאשמת העם","המשיח כמו הציבור","לאשמת העם למשיח","משיח כציבור בהוראה","המשיח כצבור בהעלם דבר","כהן משוח כצבור בהוראה"],"אין חייבין אלא על העלם דבר עם שגגת המעשה":["העלם דבר עם שגגת מעשה","רק בשגגת מעשה","דבר בעבודת כוכבים","שגגת מעשה להעלם הדבר","עבודת כוכבים ותנאי","בית דין חייבים בהעלם דבר"],"דת ר ישגו ונעלם דבר אין חייבין אלא על הע":["ישגו ונעלם דבר במשנה","אין חייבין אלא על העלם דבר","הלימוד מישגו ונעלם","שגגת מעשה להעלם דבר","ישגו בשני תנאים","דבר מתוך שגגה"],"אין בית דין חייבין עד שיורו בדבר שזדונו ":["זדונו כרת ושגגתו חטאת","בית דין עד דבר כרת וחטאת","המשיח כזה","כרת וחטאת בהוראה","הוראה בדבר כרת","כרת וחטאת תנאי לחיוב"],"צבור דתניא רבי אומר נאמר כאן ולהלן עליה ":["עליה: גזירה שוה לצבור","כרת וחטאת לחיוב בנשיא","ועשה אחת מכל מצות לנשיא","ועשו אחת מכל מצות לצבור","חיוב יחיד מעליון לתחתון","ואם נפש וילמד תחתון מעליון"],"אין חייבין על עשה ועל ל ת שבמקדש ואין מב":["עשה ולא תעשה במקדש פטור","אבל בנדה חייבים","אשם תלוי בעשה ובלא תעשה","פרוש מן הנדה ואל תבא","מצות עשה בנדה","מקדש ונדה בשני חיובים"],"צבור לא מחייבי קרבן בעלמא ויחיד אשם תלוי":["צבור אשם תלוי לא","ואשמו בצבור בחטאת קבועה","ואשם מטומאת מקדש","דנין אשמו מן אשם","אשם תלוי רק על ספק חטאת","שיבה וביאה בכהן"],"אין חייבין על שמיעת קול ועל ביטוי שפתים ":["שמיעת קול וביטוי שפתים פטור","הנשיא כיוצא בהם","ר\"ע: הנשיא חייב חוץ משמיעת הקול","המלך לא דן ולא דנין אותו","ר\"י הגלילי על הנשיא","הנשיא ושמיעת הקול"],"עולא טעמא דריה ג לאו מ והיה כי יאשם לאחת":["טעמא דריה\"ג לא תגיע ידו","נשיא ומשיח לא באים לעניות","גדלהו משל אחיו","נשיא שנצטרע מהו","ר\"ע: משיח פטור מכולן","זה קרבן אהרן ובניו"],"כל המצות שבתורה שחייבין על זדונן כרת ועל":["היחיד מביא כשבה ושעירה","הנשיא שעיר והמשיח פר","בעבודת כוכבים שעירה לכולם","אשם תלוי ואשם ודאי בחלוקה","עולה ויורד בעבודה","ר\"א: הנשיא מביא שעיר"],"תניא ר ש היה נותן כלל כל שהיחיד באשם תלו":["כלל ר\"ש לאשם תלוי","שמיעת קול וביטוי פטור ב\"ד","כל שהוא בעולה ויורד","משיח ובית דין בסתירה","כאן בדלות וכאן בדלי דלות","ר\"ש וריב\"י בדלות"],"חטא ואח כ עבר ממשיחותו קתני משום דקתני ג":["חטא ואחר כך עבר ממשיחותו","ק\"ו מנשיא בשגגת מעשה","והקריב על חטאתו משעבר","משיח מביא חטאת משעבר","אשר נשיא יחטא כשהוא נשיא","חטאת נשיא משעבר"],"חטאו עד שלא נתמנו ואח כ נתמנו הרי אלו כה":["חטאו קודם המינוי כהדיוטות","ר\"ש: נודע קודם למינוי חייב","איזהו נשיא: מלך","מכל מצות ה' אלהיו","הנשיא מלך שאין עליו אלא ה'","חטא לפני מינוי הנשיא"],"דת ר אם הכהן המשיח יחטא פרט לקודמות דדין":["פרט לקודמות במשיח","נשיא ומשיח בקודמות","המשיח יחטא כשהוא משיח","אשר נשיא יחטא שחטא והרי הוא נשיא","ק\"ו בקודמות מנשיא","לא מביא על הקודמות"],"ואיזהו המשיח המשוח בשמן המשחה לא המרובה ":["משוח בשמן המשחה ולא מרובה בגדים","פר הבא על כל המצות","פר יוה\"כ ועשירית האיפה","שווים ביוה\"כ","מצווים על הבתולה ואסורים באלמנה","מחזירין הרוצח"],"ת ר שמן המשחה שעשה משה במדבר לר י היו שו":["שמן המשחה ונס בו","שורין את העקרים במים","תחלתו שנים עשר לוגין","שמן משחת קודש לדורותיכם","ר\"י: כמה נסים בשמן המשחה","וכולו קיים לעתיד לבוא"],"כהן גדול פורם מלמטה וההדיוט מלמעלה":["כהן גדול פורם מלמטה","כהן גדול מקריב אונן ולא אוכל","ההדיוט לא מקריב ולא אוכל","הבדל באבלות בין כהן גדול להדיוט","פריעה ופרימה לכהן גדול","אונן וכהן גדול בעבודה"],"רב למטה למטה ממש למעלה למעלה ממש":["רב: למטה ממש ולמעלה ממש","שמואל: למטה מקמי שפה","וזה וזה בצואר","קרע שאינו מבדיל שפה","על אביו ועל אמו מבדיל","שמואל כר\"י בקרע של תפלות"],"כל התדיר מחבירו קודם את חבירו וכל המקודש":["התדיר קודם לחבירו","המקודש קודם לחבירו","פר המשיח קודם לפר העדה","קדימה בפר תמיד","פר המשיח לפר העדה בכל מעשיו","תדירות וקדושה בסדר הקרבה"],"אביי ד מלבד עולת הבקר אשר לעולת התמיד ה ":["מלבד עולת הבקר דתדירה","כל דתדירה קדמה","הקדמת התמיד בפסוק","עולת התמיד מקדמת","דרישת תדירות מן הכתוב","כל תדיר קודם לפי הכתוב"],"האיש קודם לאשה להחיות ולהשב אבדה":["האיש קודם להשיב אבדה","האשה קודמת לכסות ולהוציא מבית השבי","בשניהם בקלקלה האיש קודם","סדר פדיון נפשות","האשה לכסות ולהוציא מבית השבי","קדימה בפדיון שבויים"],"ת ר היה הוא ואביו ורבו בשבי הוא קודם לרב":["הוא קודם לרבו ורבו לאביו","אמו קודמת לכולם בשבי","חכם קודם למלך ישראל","מלך ישראל שמת כל ישראל ראויים","מלך קודם לכהן גדול","כהן גדול קודם לנביא"],"כהן קודם ללוי לוי לישראל ישראל לממזר וממ":["סדר הקדימה בין כהן ללוי","ממזר תלמיד חכם קודם לכהן עם הארץ","כשכולם שווים","נתין וגר בסדר היוחסין","גר קודם לעבד משוחרר","מעלות היוחסין בסדר"],"כהן קודם ללוי בני עמרם אהרן ומשה ויבדל א":["כהן קודם ללוי מן הכתוב","לוי קודם לישראל כשהבדיל ה'","ישראל קודם לממזר שמיוחס","ממזר קודם לנתין מטפה כשרה","נתין קודם לגר שגדל בקדושה","גר קודם לעבד משוחרר שלא היה בארור"]}