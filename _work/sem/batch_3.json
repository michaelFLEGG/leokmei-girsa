 "aramaic": [
  {
   "id": "2167:45",
   "מילה": "אימתי",
   "לפני": "מדכתיב 'והיה הוא ותמורתו יהיה קודש לא יגאל', ",
   "אחרי": " עושה תמורה - מחיים, "
  },
  {
   "id": "2168:0",
   "מילה": "אימתי",
   "לפני": "",
   "אחרי": " אינו נגאל - מחיים, הא לאחר שחיטה - נגאל, הא בעי העמדה והערכ"
  },
  {
   "id": "2174:107",
   "מילה": "למיתפס",
   "לפני": "תיה - לא מיפריק, לאחר שחיטה דאקיל לו קדושתיה - מיפריק! ולא אמרי' דכ\"ש הוא ומה מחיים דאלים ",
   "אחרי": " פדיונו –כ\"ש לאחר שחיטה דלא אלים למיתפס פדיונו אלא ש\"מ: לא י"
  },
  {
   "id": "2174:146",
   "מילה": "למיתפס",
   "לפני": "ושתיה - מיפריק! ולא אמרי' דכ\"ש הוא ומה מחיים דאלים למיתפס פדיונו –כ\"ש לאחר שחיטה דלא אלים ",
   "אחרי": " פדיונו אלא ש\"מ: לא יגאל - לא ימכר הוא."
  },
  {
   "id": "2176:16",
   "מילה": "הוו",
   "לפני": "ואם כתב לא ימכר ",
   "אחרי": "\"א: איזדבוני לא מזדבן - דעשה עובדין דחול, אבל איפרוקי מיפריק"
  },
  {
   "id": "2219:46",
   "מילה": "למיתפס",
   "לפני": "ולא העמיד כראבר\"ש דדוקא פסולי המוקדשין דאלימי ",
   "אחרי": " פדיונו, אבל בכור לא."
  },
  {
   "id": "2275:0",
   "מילה": "למימרא",
   "לפני": "",
   "אחרי": " דר\"א סבר יש אם למקרא? "
  },
  {
   "id": "2286:38",
   "מילה": "אשמעינן",
   "לפני": "הי ר\"ש? אילימא ר\"ש דמתני' עד עכשיו לא ",
   "אחרי": " שמואל דבר שאין מתכוין מותר? "
  },
  {
   "id": "2308:14",
   "מילה": "למישרייה",
   "לפני": "במאי איכוין - ",
   "אחרי": " בהאי מומא, בהאי מומא קנסוה רבנן, דלא לישתרי לו,"
  },
  {
   "id": "2316:51",
   "מילה": "מיטמא",
   "לפני": "אם אמרת ויטהר תנן, סוף סוף כי לא מטמיא לאחרונה, הא ",
   "אחרי": " ועומד מראשונה, מה? תיקו."
  },
  {
   "id": "2324:9",
   "מילה": "נקטינן",
   "לפני": "ואריב'ח: ",
   "אחרי": ", הטיבה ומת בנו זורעה, אלמא: לו קנסו רבנן, לבנו לא קנסו רבנן"
  },
  {
   "id": "2326:0",
   "מילה": "נקטינן",
   "לפני": "",
   "אחרי": " טימא טהרות ומת לא קנסו בנו אחריו, דהיזק שאינו ניכר - לא שמי"
  },
  {
   "id": "2340:4",
   "מילה": "אשמעינן",
   "לפני": "דאם ",
   "אחרי": " נכרי דלא אתי למיסרך, אבל קטן דאתי למיסרך - אימא לא, "
  },
  {
   "id": "2340:25",
   "מילה": "למיסרך",
   "לפני": "דאם אשמעינן נכרי דלא אתי ",
