"daf": "נג:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 3302,
"text": "מתני'.",
"next": "עבודת כוכבים שהניחוה עובדיה, בשעת שלום מותרת, בשעת מלחמה - אסורה."
