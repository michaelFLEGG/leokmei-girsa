{"לעולם יספר אדם בלשון נקיה":["לשון נקיה בדברי תורה","שמות נקיים לדבר שאינו נקי","מרכב ומושב לשון נקיה","טעם רכיבת האשה על החמור","לשון נקיה ולשון ערומים","דרך לשון נקיה בחכמים"],"לכו ע אור ערב הוא":["זמן בדיקת חמץ מאור ערב","בדיקה לאור הנר בערב הפסח","זריזין מקדימין לבדיקה בבוקר","תלמיד חכם לא יתחיל שמועה","שש שעות ולמעלה לחמץ","בדיקה בבוקר מצד הזריזין"],"שבעת ימים שאר לא ימצא בבתיכם":["שאור בבתים ובגבולין","לא ימצא שלא יטמין פקדונות","אתה רואה של אחרים ושל גבוה","שאור של נכרי בחצר","היתר ראייה בשל אחרים","איסור שאור בגבולין"],"המוצא חמץ בביתו ביו ט כופה עליו הכלי":["מציאת חמץ ביום טוב","כופה עליו כלי ביום טוב","חמץ של הקדש אינו צריך ביעור","חמץ נכרי ומחיצה עשרה טפחים","בדילי ממנו בחמץ הקדש","ביטול חמץ ביום טוב"],"אזלי בתר בתרא דמעות שנמצאו לפני סוחרי בה":["מעות בהר הבית וחולין","מעשר לפי מקום ירושלים","שוקי ירושלים מתכבדין בכל יום","מעות שנמצאו והלכה בתרא","מעשר בשעת הרגל בירושלים","ממון מעשר לפי זמן ומקום"],"תיבה שנשתמשו בה מעות חולין או מעשר הולכי":["תיבה של מעות חולין ומעשר","הולכים אחר הרוב או הבתרא","לא ידע באיזה השתמש בסוף","מעות ציבור שנמצאו בגומא","הלכה בתרא בתיבת המעות","ספק מעשר במעות שנשתמשו בהן"],"הבודק צריך שיברך":["ברכת הבודק על ביעור חמץ","לבער או על ביעור חמץ","מברך על המצוה שנצטוה","אב מברך למול ולא הבן","לשון הברכה בביעור חמץ","ברכה על מצוה שלא נצטוה"],"בשחיטה מברך וצונו על השחיטה":["ברכת השחיטה לפסח ולקדשים","ברכה על שחיטה שלא נצטוה","שחיטה בברכה וצונו","אין מברכין על שחיטה בלא ציווי","הבדל בין שחיטה לפסח לקדשים","צוויי השחיטה בברכה"],"נוטל לולב לצאת בו מברך על נטילת לולב שבה":["ברכת לולב בהגבהה ולא בנטילה","לצאת בו בהגבהתו","נטילת לולב וברכת הסוכה","סוכה לישיבה ולולב להגבהה","ברכה על לולב לצאת בו","סיפא דנכנס לסוכה לישיבה"],"אין חוששין שמא גיררה חולדה מבית לבית וממ":["חולדה שגררה לחם מבית לבית","אין חוששין לחולדה מגררת","בדיקת לחם שנלקח מן החולדה","מדורות הנכרים טמאים לבדיקה","ספק לקיחה וספק אכילה בחמץ","בשר שלא משייר ובדיקת חולדה"],"ב תירוצים להעמיד המשנה ועל התירוץ השני ג":["ספק אם אכל או לא אכל","שפחה ברימון וחולדה שם","ספק ספיקא בטומאת הטילה","כהן שהציץ בבור לידע מין","חולדה וברדלס מטהרים ספק","ספק וספק בטומאה ובתרומה"],"ככר בפי נחש אם צריך חבר להוציא אם בגופו ":["ככר בפי נחש ותשלום שליח","הוצאה מבית הנחש בממון","חבר שהוציא ככר מפי נחש","טרחה בגוף או בממון תיקו","הטריחו בגופו או בממונו","ספק אם הטריח בגופו"],"ר י בודקין אור לי ד ובי ד שחרית ובשעת הב":["זמני בדיקת חמץ לדעת ר' יהודה","בדיקה לאור י\"ד ובשחרית","לא בדק יבדוק בתוך המועד","בדיקה לאחר המועד לחכמים","מה שמשייר ינחנו בצנעא","בדיקה שמתחלפת בזמנים"],"ר מ אוכלים כל חמש ושורפין בתחלת שש":["אכילת חלות התודה עד חמש","שריפת חולין ותרומה בשש","זמן אכילה ושריפה לתרומה","חלות התודה הפסולות על האיצטבא","כשהניח אחת ונטלו שתיהן","מחלוקת חולין ותרומה בפסח"],"רבי חנינא סגן הכהנים מימיהם של כהנים לא ":["שריפת בשר טמא בשר טמא ולד","כהנים משרפים טמא עם טהור","שריפת תרומה טהורה עם טמאה","נר בשמן טמא מעל טומאה","מדבריהם למדנו שריפה בפסח","מחלוקת שריפת התלויה והטמאה"],"סבר ר ע טומאת משקין לטמא אחרים דאורייתא":["טומאת משקין לטמא אחרים","מקור טומאת משקין דאורייתא","משקין שמטמאים להיות ראשון","טומאה תחלה בתרומה","ר' עקיבא ודין טומאת משקין","טבול יום ותחלה בטומאה"],"הא דר ש בקרקע טהורין דווקא מים ולא דם":["מים בקרקע טהורין ברביעית","קרקע וגזירה על הטבילה","רביעית מים לטבילת מחטין","דם אינו מטהר בקרקע","פחות מרביעית טמאין","שיעור רביעית למים בקרקע"],"איפוך רבי יהושע מודה לר א":["בתוכו טהור וגבו טמא","רבי יהושע ורבי אליעזר בקרקע","לא גזרו שמא נגע גבו","להציל רביעית מן הטומאה","גבו של כלי שנטמא","הצלת רביעית לדעת רבי אליעזר"],"דחולין נאכלין כל ארבע תרומה כל חמש ושורפ":["מאכיל חולין לבהמה ולחיה","חולין לבהמה לחיה ולעופות","מתי מותר להאכיל לבהמה","בהמה משייר וחיה מצניעה","עופות אגב בהמה וחיה","חולין שנשארו לבהמה בפסח"],"שאלו על מקור איסור הנאה":["מקור איסור הנאה בנותר","איסור הנאה ללא אכילה","חולין שנשחטו בעזרה מן התורה","כל איסורין בשריפה לנותר","פסולי קדשי קדשים באש תשרף","לאו לא תאכל לאיסור הנאה"],"הך דבעי ל לא תאכל אם אינו ענין לגופו":["לאו לא תאכל לכל האיסורים","מעשר הקל ללמוד על הבשר","לא בערתי ממנו בטמא","לרבות עצים ולבונה בטומאה","לעבור על שני לאוין בנותר","הקיש מעשר דגנך לבשר הקדש"],"בכל מתרפאין חוץ מעצי אשירה":["רפואה בכל חוץ מעבודה זרה","סכנה מותרת בכל נפשך","חביב גופו או חביב ממונו","סכנה מתרפא בכל מאודך","עצי אשירה אינם לרפואה","הרפואה בדבר שיש בו סכנה"],"בישלה על גבי גחלים לכו ע הפת מותרת":["פת על גחלים עוממות ולוחשות","שבח עצים בפת באיסור הנאה","אבוקה כנגדו והיתר הנאה","פת שנאפתה על גחלים לוחשות","כסא אסור בהנאה ושבח עצים","חלוקו בהנאה מעצים של איסור"],"חמץ של נכרי שעבר עליו הפסח מותר בהנאה":["חמץ נכרי אחר הפסח מותר","חמץ ישראל אסור בהנאה לעולם","שאור של ישראל לא יראה לך","הנאה מחמץ נכרי לאחר הפסח","הבדל בין חמץ ישראל לנכרי","שעבר עליו הפסח בידי נכרי"],"דווקא בעיניה אבל בתערובת לא":["חמץ בעיניו ובתערובת","קניית שאור מן הנכרים לאחר הפסח","רב נחמן התיר לקנות שאור","היתר שאור נכרי מיד לאחר הפסח","איסור חמץ בתערובת לאחר הפסח","מה נאסר בחמץ של ישראל"],"כל הכלים שנשתמשו בהן חמץ בצונן משתמש בהן":["כלי חמץ בצונן מותרים למצה","בית שאור כלי שחימוצו קשה","בית חרוסת ככלי שאור","עריבות דמחוזא מותרות במצה","כלי שנשתמשו בחמץ בצונן","כלי שחימוצו קשה ואוירא"],"נכרי שהלוה את ישראל על חמצו אחר הפסח מות":["הלוואה על חמץ אחר הפסח","חמץ מלוה נכרי לישראל מותר","ישראל שהלוה נכרי על חמצו","חמץ משועבד לחוב אחר הפסח","חמץ מלווה ובעלות אחר הפסח","איסור הנאה בחמץ שהלוה"],"חמץ שנפלה עליו מפולת הרי הוא כמבוער":["חמץ תחת מפולת כמבוער","חפישת הכלב שלשה טפחים","ביטול חמץ בלב תחת הריסה","כל שאין הכלב מחפש אחריו","כספים ושלשה טפחים בקרקע","רשב'ג בחמץ נפול"],"וצריך שיבטל בלבו":["ביטול חמץ בלב ללא חיפוש","טפח לחפישה מפני הריח","הכלב מוצא חמץ משלשה טפחים","חמץ שאין בו ריח חסרון","ביטול בלב כשאין לחפש","סגי בטפח לכיסוי מעינא"],"האוכל תרומת חמץ בפסח בשוגג משלם קרן וחומ":["תרומת חמץ בפסח בשוגג","קרן וחומש על תרומת חמץ","במזיד פטור מתשלומין","לפי מידה או לפי דמים","דעה שחמץ בפסח מותר בהנאה","שילם לפי דמים ומדידה"],"האוכל תרומה בשוגג משלם קרן וחומש אחד האו":["תשלום חומש לפי הדמים","חומש וחומש דחומש בתרומה","שוה ארבע ואחר כך זוז","גזלן ושעת הגזילה בתשלום","תבוא עליו ברכה ותשלום","תרומה טמאה וטהורה בחומש"],"ראב י ור ע וריב נ סוברים חמץ בפסח אסור ב":["חמץ בפסח אסור בהנאה לכולם","לפי דמים או לפי מדה בתשלום","תשלום חמץ לר' עקיבא ולפי דמים","שיטת לפי מדה בתשלום חמץ","הכרעה שחמץ בפסח אסור בהנאה","מחלוקת התשלום בחמץ בפסח"],"ותיובתא אאבא שאול מהא דהאוכל תרומה פחות ":["תרומה פחות מכזית משלם קרן","שיעור שווה פרוטה במעילה","מעילה ותרומה בשיעור שוו\"פ","תיובתא לאבא שאול בשיעור","כזית לתרומה ושווה פרוטה","קרן בלי חומש בפחות מכזית"],"אלו דברים שאדם יוצא בהן יד ח בפסח":["חמשת מיני דגן למצה","יוצא במצה מדמאי ומעשר","חלות תודה ורקיקי נזיר למכור","כוסמין שיפון ושיבולת שועל","אורז ודוחן אינם מין מצה","דבר הבא לידי חימוץ במצה"],"כוסמין מין חיטין גולבא":["אורז מין דגן לחימוץ וכרת","קרמית חייבת בחלה","עיסה ביין ושמן ודבש לא נחמצת","בהמחה וגמע חמץ ומצה אי יד\"ח","מי פירות אינם מחמיצין","מצה עשירה אינה יוצאת בה"],"יוצאין בפת נקיה ובהדראה ובסריקין המצוייר":["סריקין המצויירין בפסח","אסור סריקין מפני חימוץ","סריקי בייתוס מותרים","רקיקין מותרים ולא גלוסקאות","סריקין של נחתומין בפסח","אשה שוהה על הסריקין"],"ואלו ירקות שאדם יוצא בהן ידי חובתו בפסח":["ירקות מרור לפסח לחין ויבשין","מרור שיצא בו בכבוש ושלוק","הלכה ירק מר שיש לו שרף","ירקות שיוצאים בהן ידי חובה","מיני ירק המכסיפין פנים","ירק מר לפי שרף ופנים"],"חזרת חסא עולשין הינדבי תמכא רבב ח תמכתא ":["פירוש שמות הירקות בפסח","מדברי כולן ירק מר שרף","תמכא וחרחבינא בשמותיהם","כשרות חזרת יולין וגלין","ר' עקיבא ירק מר בלשון","שיטת כל ירק מר ופניו"],"מרור מין ירק הוא ולא מרירתא דכופיא מרה ש":["מרור ירק ולא מרה דג","מרור ומצה לדבר דומיא","ירדוף ורזיפו לא ירק מרור","מרורים כתיב שתי מרורים","מרור דומיא דמצה דגידולי קרקע","מין ירק ולא מרה של דג"],"אין שורין את המורסן לתרנגולים אבל חולטין":["חמץ שאין בא לידי חימוץ","חליטה בתבשיל למנוע חימוץ","מורסן וחיטין לחולה בפסח","לא ילעוס אדם חיטין על מכתו","אפוי ומבושל אינם מחמיצים","קמח שנפל לתוכו דלף"],"אלו דברים שאין באין לידי חימוץ האפוי שבש":["חלוט ברותחין שאינו חמץ","לא יחלוט שתי חיטין יחד","שיבולת נחוש שיצא מקצה","כד מיובש בקליות שפיו למטה","בזקיפא מותר בתנור","קמח לשמן ומלח כמי פירות"],"אין מוללין את הקדירה בפסח":["מילול קדירה בקמח וחומץ","תבלין בקדירה מרותחת בפסח","לכל נותן חוץ מחומץ וציר","קמח לפני חומץ בבישול","נזיר סחור סחור לכרם","מחיית קדירה בקמח חיטים קלויות"],"אין נותנין קמח לתוך חרוסת או חרדל ואם נת":["קמח בחרוסת ואוכל מיד","ר' מאיר אוסר קמח בחרוסת","מבשלין הפסח במשקין","סכין וטבילה בפסח במים","מי תשמיש נחתום ישפכו","תשמיש הנחתום מחמיץ בפסח"],"אל תאכלו ממנו נא ובשל מבושל במים":["נא ובשל מבושל במים באיסור","צלי אש לפסח ולא שצלאו","חרוך ובשל ונא בפסח","פסח שלא נצלה כל צורכו","אברנים בלשון פרסאי","בשר פסח חי אינו מותר"],"ת ר ג דברים נאמרים בכותח הבבלי":["כותח בבלי מטמטם הלב","כותח מסמא עיניים ומכחיש גוף","נסיובי חלבא ומילחא בכותח","עיפוש פת מכחיש את הגוף","שלשה דברים שאמרו בכותח","כותח לחולה וסכנה"],"וזיתום המצרי וכו":["רב יוסף בשלשה מיני שעורים","שערי וחיטי בזיתום המצרי","קורטמי ומלחא ברפואה","תריו וקלוי וטחן ושתו","קמיט מרפי ודרפי מקמיט","לחולה ולאשה עוברה סכנה"],"רבי אבהו מרי ו כל איסורין שבתורה אין הית":["היתר אינו מצטרף לאיסור","איסור נזיר משרת ואין מצטרף","שאור בלא תקטירו בהקטרה","הקטרה אינה לפחות מכזית","כל איסורין ולאו דרישה","היתר מצטרף לאיסור בחמץ"],"והך ד מכל אשר יעשה מגפן היין מחרצנים ועד":["איסורי נזיר מצטרפים זה לזה","איסור והיתר מצטרפין לנזיר","גפן מחרצנים ועד זג","ללמד על איסור ואיסור","לר' עקיבא איסור והיתר מצטרפין","מצטרף איסור לאיסור בנזיר"],"בצק שבסידקי עריבה אם יש כזית במקום אחד ח":["בצק בסדקי העריבה לחמץ","כזית בצק בסדקי עריבה","בטל במיעוטו בפחות מכזית","בצק בסדק ותורת חציצה","מקום העשוי לחזק בבצק","קפיד בצק חוצץ לטומאה"],"אריא ש ל ש אלא במקום שאין עשויין לחזק אב":["מקום העשוי לחזק בכזית","הסברת הבצק בסדקי העריבה","סתירה בברייתא לבצק בסדקים","כזית בסדקים חייב לבער","פחות מכזית אינו חייב","תיקון ברייתא בבצק העריבה"],"הפת שעיפשה ונפסלה מלאכול לאדם והכלב יכול":["פת שעיפשה וטומאת אוכלין","פסולה לאדם ראויה לכלב","רבי נתן פת מטמאה טומאת אוכלין","מיוחד לאוכל אדם טמא","פת טמאה בכזית נשרפת","הלכה כרבי נתן בטהרות"],"עריבת העבדנין שנתן לתוכה קמח תוך ג ימים ":["עריבה של עבדנין תוך שלשה ימים","עורות בעריבה מבטלים חיוב ביעור","רבא הלכה כרבי נתן שעה אחת","עריבה שנתן בה קמח לביעור","מחלוקת רבי נתן בעריבה","שלשה ימים לחיוב ביעור"],"בצק החרש אם יש כיוצא בו שהחמיץ הר ז אסור":["בצק החרש ואם יש כיוצא בו","אסור בצק שהחמיץ בדומה","בצק חרש כשהחמיץ אסור","אסור מדין כיוצא בו בחמץ","כיוצא בו החמיץ בצק","חרש וחמץ כיוצא בו"],"אם אין שם כיוצא בו מהו":["שיעור מיל למרחק בדבר כיוצא","לגבל ולתפלה ארבעה מילין","כדי הילוך מיל אינו חוזר","עור האדם ביטול בכדי עבודה","שיעור ההילוך בעור ובטומאה","מיל לפניו ולאחריו בטהרה"],"כיצד מפרישין חלה בטומאה ביו ט":["הפרשת חלה בטומאה ביום טוב","חלה שנטמאה לא תקרא שם","תטיל בצונן או תפרישנה בערב","לא זה חמץ שמוזהרין עליו","חלה שהחמיצה מפרישה לערב","ר' יהושע בחלה מופרשת לערב"],"א בטובת הנאה חלקו דלר א טובת הנאה ממון ו":["טובת הנאה אם היא ממון","הואיל ואי בעי איתשיל","טובת הנאה לר' אליעזר ממון","טובת הנאה ושאלת ממון","הואיל בטובת הנאה מחלוקת","טובת הנאה אינה ממון לכולם"],"בעי רבי ירמיה טבלא שאין לה לבזבזין מהו ת":["טבלא שאין לה לבזבזין","תוך כלי או אוויר כלי בצירוף","הסל מצרף לר' אליעזר","תנור מצרף לדעה אחרת","ככרות בבל שנושכות זו מזו","מחלוקת בצירוף חמץ לבצק"],"רבן גמליאל אומר שלש נשים לשות כאחת ואופו":["שלש נשים לשות ואופות כאחת","שלש נשים עוסקות בבצק","רבי עקיבא לא כל נשים שוות","תפח תלטוש בצונן","אשה לשה ואשה עורכת ואופה","זריזות של נשים וחימוץ הבצק"],"ת ר לשה היא מקטפת וחבירתה לשה תחתיה":["סבב העבודה בשלוש נשים","לשה מקטפת ואופה לחלופין","כל זמן שעוסקות אין חימוץ","חלוקת תפקידים בבצק לפסח","מקטפת אופה ולשה בסבב","שלוש נשות סבב בלא חימוץ"],"רבי עקיבא אומר לא כל הנשים וכו":["נשים זריזות או לא זריזות","עצים לחים או יבשים בחימוץ","תנור חם או צונן בבצק","אין לך אלא מה ששנו חכמים","הכלל תפח תלטוש בצונן","ר' עקיבא שאל את רבן גמליאל"],"משנה":["שיאור ישרף והאוכלו פטור","סידוק חייב כרת באכילה","איזהו שיאור כקרני חגבים","שיאור וסידוק לחמץ בפסח","חמץ שנסדק חייב כרת","שיאור לרבי יהודה וחכמים"],"איזהו שיאור ר מ כל שהכסיפו פניו כאדם שעמ":["הכסיפו פניו כשיאור לר' מאיר","סידוק כקרני חגבים לר' מאיר","דעת חכמים בשיאור וסידוק","טעם ר' מאיר בחיוב כרת","סדק מלמעלה ומלמטה בכרת","שיאור וסידוק אינם חלוקים בכרת"],"י ד שחל להיות בשבת מבערין את הכל מלפני ה":["ערב פסח בשבת מבערין מלפני השבת","ביעור חמץ בערב שבת לר' מאיר","תרומה מלפני השבת וחולין בזמנן","ביעור בזמנו לחכמים בשבת","ר' אליעזר בר צדוק בביעור","ביעור תרומה לפני השבת"],"ראב צ פעם אחת שבת אבא ביבנה וחל י ד להיו":["ביעור חמץ בערב פסח בשבת ביבנה","זונין ממונה של רבן גמליאל","ביערנו את החמץ בערב שבת","מעשה ביבנה בביעור חמץ","הלכה כאבא בביעור בשבת","מונה שהודיע על שעת הביעור"],"ההולך לשחוט את פסחו ולמול את בנו ולאכול ":["ביטול חמץ בדרך לשחיטת הפסח","אם יכול לחזור לבער יחזור","להציל מנכרים ומנהר בביטול","שבות רשות יחזור מיד","בשר קדש ביציאה מירושלים","כזית או כביצה בחמץ ובשר קדש"],"והך דההולך לאכול סעודת אירוסין בבית חמיו":["סעודת אירוסין מצוה או רשות","סעודה שניה לחתן לא מצוה","ר' יוסי וסעודת אירוסין כמצוה","סעודה ראשונה מצוה בהכל","מחלוקת ר' יוסי ורבי יהודה","שביתת רשות מיד חוזר"],"ההולך ממקום וכו":["אל ישנה אדם מפני המחלוקת","הולך למקום שאין עושין","חומרי מקום שיצא משם","מפני שינוי המחלוקת במקום","הרואהו סבור שבטלן הוא","אביי ורבא בשינוי מנהג"],"כיוצא בו המוליך פירות שביעית וכו":["פירות שביעית בביעור מחוץ לגבול","הוציא שביעית ממקום שלא כלו","הכובש שלשה כבשין בחבית","גב החמור וקדושת הפירות","אוכלין בתמרין עד שיכלה","מחלוקת ר' ג' בביעור מן החבית"],"אריא ר אסור לו לאדם שיאמר בשר זה לפסח מפ":["בשר זה לפסח מקדיש בהמתו","אסור לומר בשר לפסח","חטים לפסח כמתנדב בלבד","תודוס איש רומי וגדיים מקולסין","נדוי בהאכלת קדשים בחוץ","מקולס ומקולוס לאכילה בלילי פסח"],"תנא בין שאמרו להדליק ובין שאמרו שלא להדל":["הדלקה ושלא להדליק לדבר אחד","שני הצדדים לדבר אחד","ועמך כולם צדיקים בהדלקה","רבא דרש הדלקה כשבת","כוונת חכמים בהדלקה","מחלוקת אם להדליק או לא"],"ואור דידן במוצ ש איברי ואור דגיהנום בער ":["עשרה דברים נבראו בערב שבת","אור גיהנום בערב שבת","אור ופרד נבראו בערב שבת","צבתא בצבתא מתעבדא","אור ודמיון לבריאה בערב שבת","רבי נחמיה משום אביו באור"],"ת ר עשרה דברים נבראו בער ש בין השמשות וא":["עשרה דברים שנבראו בערב שבת","מקל אהרן ובגד אדם הראשון","המזיקין נבראו בין השמשות","פתיחת פי האתון ופי הארץ","באר המן וקשת בערב שבת","הרשעים שנבלעו בין השמשות"],"ת ר שבעה דברים מכוסים מבני אדם אלו הן יו":["יום המיתה ויום הנחמה מכוסים","עומק הדין מכוסה מן האדם","מה בלב חבירו אין אדם יודע","מלכות בית דוד מתי תחזור","שבעה דברים מכוסים מאדם","במה משתכר אדם מכוסה"],"ת ר שלושה דברים עלו במחשבה ליבראות ואם ל":["מחשבה לברוא מת שיסריח","המת שישתכח מן הלב","תבואה שתרקב ומטבע שיצא","שלשה דברים עלו במחשבה","דין שיעלו מן המחשבה","מטבע שיצא מחשבה ליבראות"],"מקום שנהגו לעשות מלאכה בתשעה באב עושין":["מלאכה בתשעה באב לפי מנהג","תלמידי חכמים בטלים בתשעה באב","לעולם יעשה אדם עצמו תלמיד חכם","מנהג מקום בעשיית מלאכה","רבן שמעון בתלמיד חכם בטלות","מלאכה בט באב לפי המקום"],"שמואל אין תענית ציבור בבבל אלא ט באב בלב":["תענית ציבור בבבל רק תשעה באב","מותר יום שבא אחר תשעה באב","הכנסה לחשיכה ביום תשעה באב","ספק יום תשעה באב וקביעות חודש","שני ימים בקביעת הירח","אין בין תשעה באב ליום כיפור"],"והך דאין בין ט באב לתענית ציבור אלא שזה ":["תשעה באב ותענית ציבור בחומרא","מלאכה אסורה בתשעה באב ומותרת בתענית","רחיצה בתענית ציבור כתשעה באב","קולא במלאכה בתענית ציבור","חומרא בתענית ציבור כאיסור רחיצה","פניו ידיו ורגליו בתענית ציבור"],"ובכל מקום תלמידי חכמים וכו":["תלמיד חכם בטל ולא מחזי כיוהרא","קריאת שמע ויוהרא לחתן","רב שמואל ורבן שמעון בביטול","מלאכה בטלנים ותלמיד חכם","כוונת קריאת שמע לא מחזי","תלמיד חכם בשוק ויוהרא"],"ב משנה":["מלאכה בערב פסח ביהודה עד חצות","בגליל אין עושים מלאכה כלל","בית שמאי ובית הלל בלילה","בית שמאי אוסרים בית הלל מתירין","מלאכה בערב פסח עד הנץ החמה","הלילה בערב פסח לבית שמאי"],"הך דמתני תליא בפלוגתת ר מ ור י אי מנהג ה":["מנהג או איסור במלאכת ערב פסח","ר' מאיר ור' יהודה במלאכה ביום","המנכש בערב פסח ונעקרה","שותלה במקום הטיט לא הגריד","שלשה ימים לשתילה בערב פסח","מלאכה בערב פסח מותרת עד חצות"],"א במיירי בגליל שאסור וא א דמיירי בלילה ד":["תירוץ בגליל אסורה במלאכה","לילה כבית שמאי ובית הלל","רב אשי אין דרך לנכש בלילה","ביהודה בהשרשה מקצת היום","מקצת היום ככולו בשתילה","תרי מקצת היום לא ככולו"],"ד משנה":["מלאכה שהתחיל גומרה בערב פסח","אין מתחיל מלאכה בערב פסח","שלש אומנות עושות מלאכה עד חצות","חייטים ספרים וכובסים בערב פסח","רצענין לדעת ר' יוסי בר יהודה","ר' מאיר ומלאכה שהתחיל בה"],"מושיבין שובכין לתרנגולים בי ד":["שובך לתרנגולים בערב פסח","תרנגולת שברחה מחזירין אותה","גורפין מתחת רגלי בהמה בערב פסח","מוליכין כלים מבית האומן ביום","מלאכה לצורך המועד ולא לצורך","מסלקין לצדדין בחול המועד"],"וסיפא דאהדורי אתאן לחוה מ":["תרנגולת חוזרת לשובך אחר שלושה","שלש ימים למרדה ולישיבה","ביצים שפסדו לגמרי אחר שלושה","רבי אמי תוך שלשה לישיבה","הזבל שבחצר מסלקין לצדדין","אביי ורבא בזבל לאשפה בחול המועד"],"ומתירין גמזיות של הקדש של חרוב ושל שקמה":["גמזיות של הקדש של חרוב ושקמה","אבותינו הקדישו קורות בלבד","מעילה בגידולין ואיסור","אין מעילה בגידולין לדעה","רבנן איסור אף בלא מעילה","הקדש עצים להתיר גמזיות"],"א ריב ל ואת הכבש השני תעשה בין הערבים חל":["תמיד של בין הערבים חלוק לשעות","זמן קרבן פסח בשמונה ומחצה","צללי ערב ותמיד לפני הפסח","שמונה ומחצה ובין הערבים","קדימת הפסח לעשיית התמיד","חל ערב פסח בשבת וצלייה"],"והך דחל להיות בשבת לרי ש כסידרו כל השנה ":["שחיטה בערב שבת לפי סדר השנה","כסידרו כל השנה או כל השנים","סדר קרבן פסח בערב פסח","אביי וסדר שחיטת פסח בערב שבת","ר' יוסי בסדר הפסח בשבת","תיקון סדר שחיטה כל השנים"],"ודחתה הגמ דאפשר דגם בסיפא בשתי עבודות ור":["מחשבה מעבודה לעבודה בזריקה","חשב בשחיטה ובזריקה לשם","שוחט לשמו וזורק שלא לשמו","שחיטה וזריקה בפסח לשם אחר","בעיית רב פפא במחשבה","מחשבין מעבודה לעבודה"],"שחטו שלא לאוכליו ושלא למנויו לערלים ולטמ":["שחיטה שלא לאוכליו פסולה","שחיטה לאוכליו ולמנויו כשרה","שחיטה קודם חצות פסולה","שחטו קודם לתמיד כשרה בדם","מרס בדמו עד זריקת התמיד","ערלים וטמאים בשחיטה הפסח"],"שלא לאוכליו לשום חולה או לשום זקן איש לפ":["שחיטה לחולה או זקן בפסח","איש לפי אכלו תכסו מכסת","אוכלין מונין במכסת","שלא למנויו נמנו חבורה אחרת","רבי לשון סורסי כוס לי טלה","הכתוב שנה לעכב במכסת"],"ולר ח פסול דאדרבה לאידך גיסא":["ערל לפסול ולא מקצתה בשחיטה","זריקה בערל מפסלת מקצתה","פיגול בזריקה ולא בשחיטה","לחלק בין שחיטה לזריקה","ערלה כולה פוסלת בזריקה","כולה ערלה פסלה ולא מקצתה"],"רב מיום שנגנז ספר יוחסין תשש כחן של חכמי":["גניזת ספר יוחסין והחכמים","טעות בין קמוץ לבצירה בדברי הימים","ארבע מאה גמלי דרשא","כוחם של חכמים מאז גניזת היוחסין","טעות בדרשה בדברי הימים","מאור עיני חכמים כהה"],"השוחט את הפסח על החמץ עובר בלא תעשה":["שחיטת פסח על החמץ לא תעשה","תמיד על החמץ בלא תעשה","רבי שמעון פסח לשמו חייב","זבחים אחרים לשמן ושלא לשמן פטור","במועד לשמו פטור ושלא לשמו חייב","שחיטה על החמץ בתוך העזרה"],"רשב ל לעולם אינו חייב עד שיהא החמץ לשוחט":["חמץ שלשוחט או לזורק חייב","חמץ בעזרה בשחיטה על החמץ","על בסמוך ובחוץ לחומת העזרה","לחם חוץ לחומה לא קדש","חמץ שאיתא בחוץ לחומה","דעה שאין על בסמוך בחמץ"],"רבי יהודה אומר אף התמיד וכו וטעמא ד זבח ":["זבח המיוחד לי הוא התמיד","זבחי זבחי שני זמנים","פלגינהו רחמנא לתמיד ולפסח","זבח חובה בזמן אחד בלבד","תמיד ופסח בתרי זמני","הכתוב לא כתב זבחיי למיעוט"],"ובמועד לשמו פטור ושלא לשמו חייב הא סתמא ":["פסח במועד לשם פסח שני","בעלים טמאי מת ונדחו לפסח שני","הא סתמא פטור בפסח במועד","שיטת רבן שמעון בבעלים טמאים","שלא לשמו בפסח שני חייב","עקירה בפסח בשאר ימות השנה"],"רי צ אין הפסח נשחט אלא בשלש כתות של ל ל ":["שלש כתות של שלשים בני אדם","קהל ועדה וישראל בשחיטה","חמשים בני אדם בשחיטת פסח","עולים עשרה ויוצאים עשרה","מספיק להשחיט בחמשים","כתות בזה אחר זה לפסח"],"כיצד תולין ומפשיטין וכו קרעו והוציאו את ":["תליה והפשטה בפסח","הוציא אמוריו והקטירם במזבח","כל אחד נותן פסחו בעורו","כת ראשונה מפשיל לאחוריו","עיליש טייעות בהלכת הפשטה","ידי הכתות בשחיטת הפסח"],"הלכה זו נתעלמה מבני בתירא פעם אחת חל י ד":["פסח דוחה שבת ונתעלמה ההלכה","הלל הבבלי מלמד פסח דוחה שבת","מאתיים פסחים שדוחין שבת","קל וחומר מתמיד בפסח","מועדו בתמיד ובפסח דוחה שבת","בני בתירא שכחו דין שבת בפסח"],"וכששאלוהו שכח ולא הביא סכין מער ש מהו א ":["סכין בפסח בערב שבת","הלכה זו שמעתי ושכחתי","טלה תוחבו בצמרו וגדי בקרניו","הנח להן לישראל נביאים הן","מעשה ונזכר הלכה שקיבל שמעיה","סכין לפסח אם דוחה שבת"],"כלל א ר עקיבא וכו":["כל מלאכה שאפשר מערב שבת","מילה דוחה שבת ופסח נוסף","הלכה כרבי עקיבא בשבת","מילה שאי אפשר מערב שבת","כרת בפסח ובמילה דוחים שבת","כלל רבי עקיבא בדחיית שבת"],"חגיגה דתנא הרכבתו והבאתו דלא דחי שבת וקת":["חגיגה הבאה עם הפסח בשבת","הרכבה והבאה אינן דוחות שבת","חגיגה בטהרה ובמועט","חגיגת ערב פסח אינה חובה","חגיגה נאכלת תחילה לשבע","רבי אליעזר ודחיית חגיגה"],"ונאכלת לשני ימים וכו":["חגיגה כפסח לבן תימא","חגיגת חמישה עשר שני ימים","לא ילין זבח חג הפסח","צלי או שלא צלי בחגיגה","חגיגה מן הצאן ולא מן הבקר","בן תימא ואכילת חגיגה"],"הפסח ששחטו שלא לשמו בשבת חייב עליו חטאת":["פסח ששחטו שלא לשמו בשבת","זבחים שנשחטו לשם פסח בשבת","ר' אליעזר ור' יהושע בשינוי שם","אימורי ציבור לשמן ומותרין","עוקר וטועה בשינוי שם הפסח","שחטו לשם אימורי ציבור פטור"],"רישא בעוקר והוויא עקירה":["רישא בעוקר וסיפא בטועה","רבי יהושע עוקר ושוגג בשינוי","חזרה ארבעים פעם בשינוי שם","דמיא כמונח בכיסו בטועה","לדידי לא דמי בין עוקר לטועה","קצבה לאימורי ציבור ולפסח"],"ונותן את כרעיו וכו":["תוך תוך וגדי מקולס בפסח","רבי ישמעאל ורבי טרפון בגדי","גדי מקולס אסור בלילי פסח","נחתך אבר ממנו אינו מקולס","צלוי כאחד הוא מקולס","אבר נשלק ממנו במחובר"],"האי מולייתא מאן דאסר אף פומא לתחת":["מולייתא מותרת ופומא לעיל","מאן דאסר פומא לתחת","הילכתא מולייתא שרי","פומא לעיל בגדי מקולס","מולייתא מותרת לאכילה בפסח","הלכה כמותר במולייתא"],"נגע בחרסו של תנור יקלוף את מקומו":["רוטב שנטף על החרס יטול מקומו","נגע בחרס התנור יקלוף","סכו בשמן תרומה חבורת כהנים","סולת שנטף עליה רוטב יקמוץ","שמן מעשר שני בפסח אסור","מעשר שני בפדיון ירושלים"],"איתמר חם לתוך חם דברי הכל אסור":["חם לתוך חם וצונן לתוך צונן","עילאה גבר דברי רב","תתאה גבר דברי שמואל","רוטב מרתח לחרס בצלי אש","חם לתוך צונן ומה שנופל גובר","מחלוקת רב ושמואל בבליעה"],"ת כ דשמואל חם לתוך חם אסור וכן צונן שנתן":["חם לתוך חם אסור לכולם","בשר חם נופל לחלב קר קולף","צונן לתוך צונן מדיח","א\"א שלא יבלע מעט בחלב","עילאה גבר בבשר ובחלב","כוותיה דבשר חם בחלב קר"],"חמשה דברים באין בטומאה ואינן נאכלין בטומ":["חמשה דברים באין בטומאה","העומר ושתי הלחם לא נאכלים בטומאה","הפסח שבא בטומאה נאכל בטומאה","לחם הפנים ושעירי ראשי חדשים","שלמי צבור לא נאכלים בטומאה","פסח בטומאה כי בא לאכילה"],"חמשה למעוטי חגיגת ט ו דהוו א קרבן ציבור ":["חגיגת חמישה עשר בטומאה","קרבן ציבור דוחה טומאה לא","שעירי ראשי חדשים צריכים","ראש חודש נקרא מועד לאביי","שעירי הרגלים בכלל שלמי צבור","תשלומין בשבעה כשאין דוחה טומאה"],"נטמא בשר וחלב קיים אינו זורק את הדם":["נטמא בשר וחלב קיים לא זורק","נטמא החלב והבשר קיים זורק","במוקדשים אף שנטמא הבשר זורק","זריקה בטומאה בשר וחלב","דם שנטמא בזריקה בבשר ובחלב","קדשים מוקדשים בטומאת הבשר"],"ר ג מרב אם זרק הורצה ואכילה לא מעכבא בפס":["זריקה מרצה ואכילה לא מעכבת","איש לפי אכלו תכסו לעיכוב","רב כרבי נתן בפסח אכילה","ראשונים שיש להם כזית פטורים","נמנו חבורה ונמנו חבורה אחרת","בדם תלויה המצוה ולא באכילה"],"הפסח שנזרק דמו ואחר כך נודע שהוא טמא הצי":["פסח טמא שנזרק הציץ מרצה","טומאת הגוף אין הציץ מרצה","נזיר ועושה פסח הציץ על הדם","טומאת התהום מרצה הציץ","הציץ מרצה על טומאת הדם בלבד","הציץ והתהום בטומאה בפסח"],"טעמא דנזרק ואחר כך נודע אבל נודע ואחר כך":["נודע אחר זריקה לא מרצה","רבינא טומאה בשוגג ובמזיד","רבי שילא זריקה ללא טומאה","נודע לפני זריקה והורצה","על הדם ועל הבשר ועל החלב","ציץ מרצה לשוגג ולמזיד בזריקה"],"מבר א נודע לו לאחר זריקה מרצה ואף נודע ל":["נודע לאחר זריקה מרצה","נודע לפני זריקה מרצה","טומאה שנודעה לפני ולאחר זריקה","הציץ מרצה בכל מצב של ידיעה","לשון ידיעה לפני ואחר זריקה","זריקה וידיעה בפסח"],"ד שורפין אותו לפני הבירה מעצי המערכה ארי":["שריפה לפני הבירה לביישן","שריפת בשר קדש לביוש","עצי המערכה לשריפת הבשר","שריפה לפני הבירה ביזיון","שריפה כדי להביש את החוטא","לפני הבירה שריפה לביזוי"],"הפסח שיצא או שנטמא ישרף מיד":["פסח שיצא או נטמא נשרף מיד","נטמאו הבעלים או שמתו ישרף בט\"ז","תעובר צורתו ונשרף בשש עשר","ר' יוחנן בן ברוקה שריפה מיד","לפי שאין לו אוכלין נשרף מיד","בעלים טמאים שמתו בפסח"],"טמא והבשר אשר יגע בכל טמא לא יאכל באש יש":["בשר טמא לא יאכל באש ישרף","חטאת והן לא הובא את דמה","משה ואהרן בחטאת שלא נאכלה","דמה נכנס לפנים או יצא","בקודש היתה חטאת ושריפה","נטמא בשר קדשים קלים בשריפה"],"א משנה":["עצמות וגידין ונותר בששה עשר","חל ט\"ז בשבת נשרפים בי\"ז","שריפת נותר ביום שבעה עשר","אינן דוחין שבת ויום טוב","שריפה ביום שבעה עשר","נותר שבשבת דוחה שבת לא"],"ה ק כל הנאכל בשור הגדול יאכל בגדי הרך וש":["הנאכל בשור הגדול בגדי הרך","ראשי כנפים וסחוסים לאכילה","רבא כל הנאכל בשלקא בצלי","גידים הרכים נידונין כבשר","אי נאכל ראשי כנפים בגדי","שור גדול ושור רך בדין אכילה"],"מותיר בטהור ד לא תותירו ממנו עד בקר והנת":["לא תותירו עד בקר בטהור","עשה אחר לא תעשה לא לוקה","לאו שאין בו מעשה אין לוקין","עצם לא תשברו בכשר ולא בפסול","שובר עצם בטמא לא מוזהר","לא מן השם הוא לאו שאין בו מעשה"],"ול ק מהא דאבר שיצא מקצתו חותך עד מקום שמ":["אבר שיצא מקצתו חותך עד העצם","קולף עד הפרק וחותך","שבירת עצם משום פקע","אביי ורבינא בשבירת העצם בקולית","אבר שאין בו כזית ושבירה","שובר עצם באבר שיצא מקצתו"],"אריא ר וכן לתפילה":["מחיצה של ברזל בין ישראל לאביהם","מחיצת ברזל לא תפסיק בתפילה","תפילה דלא מפסיקה מחיצה","הפסק בתפילה ומחיצת ברזל","דין מחיצה בתפילה ישראל ואביהם","ישראל ואביהם שבשמים בתפילה"],"ר ה בני חבורה נכנסין בשלשה ויוצאין אף בא":["בני חבורה נכנסים בשלשה ויוצאים באחד","נכנסו בזמן שרגילים להכנס","המאחרים נותנים שכר דמים","האחרון מוסיף דמים בקורבן","שכר דמים לאחרונים בפסח","הלכה לא כרבינא בשכר דמים"],"ואין להוכיח דיש ברירה דהך רוצה היינו בשע":["אין ברירה ברוצה בשעת שחיטה","כלה רדופה משל אביה או משל בעלה","אז הייתי בעיניו כמוצאת שלום","ככלה בבית חמיה ולא בבית אביה","תקראי אישי ולא בעלי","רדופה בזמן לשחיטה ואכילה"],"האומר לעבדו צא ושחוט עלי את הפסח":["עבד ששחט גדי או טלה לרבו","שכח מה אמר רבו לשחוט","גדי שלו וטלה שלי בשכחה","שניהם לבית השריפה ופטורים","שליח ששחט בשני פסחים","עבד ששכח שאלת רבו בשחיטה"],"שחט גדי יאכל אף דרגיל בטלה":["אין נמנין על שני פסחים כאחד","מלך ומלכה ששחטו שני פסחים","רבן גמליאל על מלך ומלכה","הלטאה בבית המטבחים ומלכה","בית המטבחים רותח או צונן","דדעתן קלה יאכלו מן הראשון"],"שכח מה שאמר לו רבו וכו":["עבד קנה רבו ומקנה לו","הולך אצל רועה הרגיל רבו","מקני לו חד מהם על מנת שאין לרבו","תקנת רב העבד ברועה","מי שקנה עבד קנה רבו","עבד שמכר פסח לרועה בשכחה"],"האומר לבניו הריני שוחט את הפסח על מי שיע":["זכייה בחלק הפסח בהכנסת הראש","אומר לבניו: על מי שיעלה ראשון","זכה בחלקו ומזכה את אחיו","שיעור כניסה לזכייה בפסח","הזוכה בפסח מזכה את חבריו","שחיטה על הראשון לירושלים"],"אין להוכיח דיש ברירה ארי ו כדי לזרזן במצ":["אין ברירה, אלא זירוז במצוה","התמנו מעיקרא, לא אחר כך","התמנות קודם השחיטה, לא אחריה","זירוז הזריזים, בנות לפני בנים","הוכחה מזכייה: ממנוי מוקדם","בנות זריזות ובנים שפלים"],"לעולם נמנין עליו עד שיהיה בו כזית לכל אח":["עד כמה נמנין על הפסח","שיעור כזית לכל אחד ואחד","מתי פורשין מהחבורה: שחיטה","מחלוקת ר\"ש על זריקת הדם","כזית לכל אחד בחבורה","פרישה מן החבורה עד הזריקה"],"לעולם נמנין וקמ ל דאף דאימני עליו חבורה ":["חבורה שנמנתה חוזרת, וממנין אחרת","ביטול חבורה והקמת חבורה אחרת","חבורה ראשונה אינה נעשית קבועה","מנין חדש לאחר ביטול המנין","אפשר להמנות על פסח אחר","נמנין מחדש אם יצאה חבורה"],"הממנה עמו אחר בחלקו רשאין בני חבורה ליתן":["הממנה אחר בחלקו: נותנים לו שלו","זכות חבורה לתת חלק לזר","הפרשת חלק לחבר נוסף","אוכל משלו והם משלהם","חבורה רשאית לתת חלקה לאחר","שותפים שאינם מחלקים יחד"],"איבעיא להו בני חבורה שהיו ידיו של אחד מה":["ידיו יפות: האם לשלחו מהחבורה","גירוש שותף בשל כשרון שחיטה","לומר לחבר: טול חלקך וצא","שאלת חבורה ביד יפה","חבורה רשאית לפטור שותף מתפקיד","דעות שאינן מתקבלות לזר"],"א ד הך דאיבעי היינו אי בני חבורה רשאין ל":["רשאין לחלק כשידיו יפות","יכולת החבורה לחלק את חלקה","תנאי ידיים יפות להוצאת שותף","שאלה נפתרת מברייתא: ידיו יפות","חלוקה מותנית בכשרון הזביחה","ידיו יפות: הכרעה מן הברייתא"],"ת ר הממנה אחרים עמו על פסחו ועל חגיגתו מ":["ממנה אחרים: מעות חולין","מכירת עולה ושלמים לא מועילה","קנס על מעות שנתרמו לנדבה","שותפות בפסח ובחגיגה פסולה","מעות מיועדות לנדבה בגלל מכירה","מכירה שלא עשתה כלום"],"האונן והמפקח את הגל וכן מי שהבטיחוהו להו":["שחיטה על האונן ועל המפקח בגל","מי נחשב לחבורה הנשחטת עליהם","פסול בחבורה פוטר מפסח שני","אונן ומפקח בגל: שחיטה על הכל","אי שחיטה בפני עצמן מחשש פסול","פטור מפסח שני בפסול הפסח"],"ר ה מרי ו לא שנו אלא בית האסורין דנכרים ":["בית האסורין של נכרים ושל ישראל","הפסח בבית האסורין של ישראל","שחיטה בתוך חומת בית פאגי","שארית ישראל: שחיטה לאסיר ישראלי","אפשרות אכילה לאסיר נכרי","הבחנה בין מקום לנכרים ולישראל"],"אין שוחטין את הפסח על היחיד דברי רבי יהו":["שחיטה על יחיד: מחלוקת ר' יוסי","חבורה שאין יכולה לאכול כזית","ר' יהודה אוסר שחיטה על יחיד","אין חבורת נשים ועבדים וקטנים","שיעור יכולת אכילה לשחיטה","מיעוט הקהל וגדלו בשחיטה"],"ר י מנין שאין שוחטין את הפסח על היחיד ת ":["לא תוכל לזבח באחד: ביאור הפסוק","גזירת ר' יהודה על חבורת נשים","טעם פסילת נשים וקטנים ועבדים","אשה בפסח ראשון ובשני","שחיטה בשער אחד: מקור ר\"י","איש לפי אכלו: ר' יוסי מבאר"],"ת ר פסח ומצה ומרור בראשון חובה מכאן ואיל":["פסח ומצה ומרור: חובה בלילה הראשון","נשים חייבות בפסח לדעת ר\"ש","מצה חובה בנשים מדין בל תאכל","חיוב פסח בשנים ובאחד","פסח לאנשים חובה, לנשים רשות","בל תאכל מחייב מצה בנשים"],"אונן טובל ואוכל את פסחו לערב אבל לא בקדש":["אונן טובל ואוכל פסח לערב","אונן ושומע על מתו בקדשים","גר שנתגייר בערב פסח","הפורש מן הערלה כפורש מן הקבר","טבילת אונן: פסח אך לא קדשים","ב\"ש וב\"ה בגר שנתגייר"],"דס ל אנינות דלילה דרבנן וגבי פסח לא העמי":["אנינות לילה מדרבנן: פסח לא נדחה","גזירת חכמים במקום כרת לא הועמדה","הבדל בין פסח לקדשים באנינות","גזירה דרבנן במקום עשה","דבריהם לא הועמדו במקום כרת","אנינות דלילה בפסח ובקדשים"],"איתמר היה בדרך רחוקה ושחטו וזרקו עליו":["שחיטה וזריקה על המרוחק בדרך","הורצה או לא: מחלוקת ר\"נ ור\"ש","דרך רחוקה ואינו עושה כשיכול","טמא ומרוחק: הכרעה לפסח שני","מי שהיה בדרך רחוקה ושחטו עליו","מכלל דאי בעי עבד: ראיה לר\"נ"],"איזו היא דרך רחוקה מן המודיעים ולחוץ וכמ":["דרך רחוקה: מן המודיעים ולחוץ","מאיסקופת העזרה ולחוץ לר\"א","נקודה על ה' בדרך רחוקה","שיעור הדרך לפסח: מחלוקת ר\"ע","רחוק ודאי או רחוק מהעזרה","ר' יוסי מבאר את נקודת ה'"],"אמר לו רבי יוסי לפיכך וכו":["דרך ובדרך: מה שמגיד הכתוב","דרך שנים שלושה ימים: שמיעה","מאיסקופת העזרה נקרא דרך","הכתוב מרחיב את מושג הדרך","לימוד ריה\"ג על מילת דרך","ר' יוסי ודרשת ריה\"ג בדרך"],"מה בין פסח הראשון לשני הראשון אסור בבל י":["הבדלי פסח ראשון משני","בל יראה בראשון ולא בשני","הלל באכילה: רק בפסח ראשון","צלי על מצה ומרורים בשני","שני דוחה שבת כראשון","חמץ בבית בפסח שני"],"ת ר ככל חקת הפסח יעשו אתו במצוה שבגופו ה":["ככל חקת הפסח: מצוות שבגופו","מצוה שעל גופו ושלא על גופו","עצם לא ישברו: מוח ומבע\"ל","איסי בן יהודה על יעשו אתו","מעשה הפסח במצוות שבגוף","כמה דאפשר לאהדורי מהדרינן"],"בעי ר ז אימורי פסח מצרים היכן הקטירום":["אימורי פסח מצרים: היכן הוקטרו","ג' מזבחות במצרים על המשקוף","אין מזבח לאימורין במצרים","צלי בשיפוד ואימורי מצרים","שאלת ר\"ז על קטורת מצרים","משקוף ומזוזות כמזבח ליציאה"],"ונאכל בחפזון וכו":["אכילת חפזון: פסח בלבד","חפזון כדרך אכילת הפסח","רק הפסח נאכל בחפזון","ואכלתם בחפזון: דרשה לפסח","אין קרבן אחר באכילה בחפזון","חפזון מיוחד לפסח ולא לאחר"],"ופסח דורות נוהג כל שבעה וכו":["פסח דורות: לאו אפסח אלא אחמץ","לילה אחד ופסח דורות כל שבעה","חימוץ כל היום בפסח דורות","הדין לפסח דורות כפסח הלילה","שבעה ימים לאיסור חמץ בדורות","מה נוהג בפסח דורות"],"א ר יהושע שמעתי שתמורת פסח קריבה ותמורת ":["תמורת הפסח: הפירוש של ר\"ע","פסח שנמצא קודם שחיטה ירעה","אחר שחיטה קרב שלמים ותמורתו","ר' יהושע ור\"ע בתמורת הפסח","פסח שהסתאב נמכר לשלמים","דמים של פסח שנמכר לשלמים"],"ולא אמרי דפסח קרב ולא קרב דהא קמ ל דאיכא":["קודם שחיטה או קודם חצות","מחלוקת רבה ורב זביד בתמורה","חצות היום כגבול בתמורת הפסח","ר\"א: קודם חצות ירעה","תמורה לפני חצות או לפני שחיטה","כתנאי: שחיטה או חצות לפסח"],"המפריש נקבה לפסחו או זכר בן שתי שנים ירע":["פסח נקבה או זכר בן שתי שנים","מפריש פסח ומת: לשם שלמים","דמי פסח שהסתאב לנדבה","נקבה לפסח נמכרת ליפול לנדבה","בן המת אינו מביא לשם פסח","פסח שנפסל ונעשה שלמים"],"ארהבדר ח ש מ תלת ש מ בעלי חיים נדחין וש ":["שלוש הלכות בדחייה של הפסח","בעלי חיים נדחין מן המזבח","דחוי מתחילה הוי דחוי","דחייה גם בדמים ולא רק בבעל חי","שלושה דברים בדין הדחוי","דחוי בדמים: הקשר לדחיית פסח"],"הפסח שנתערב בזבחים כולן ירעו עד שיסתאבו ":["פסח שנתערב בזבחים ובכורות","ירעו עד שיסתאבו ויימכרו","מדמי היפה שבהם ממין זה","ר\"ש: חבורות כהנים יאכלו","ערבוב קרבנות: המותר לנדבה","בכור בתערובת פסח"],"הך דר ש לטעמיה דמביאין קדשים לבית הפסול":["ר\"ש: שחיטה בצפון בתערובת","אין מביאין קדשים לבית הפסול","ממתין עד שיוממו לבכור הפסח","אשם שנתערב בשלמים","כל היכא שאיתיה לפסח תחול","בכור בעל מום אוכל בתערובת"],"חבורה שאבד פסחה ואמרו לאחד צא ובקש ושחוט":["פסח שאבד ושחיטה על חבורה","הנשחט ראשון קובע את האוכלים","אם אינו ידוע איזה נשחט ראשון","פטור מפסח שני בשחיטה כפולה","שליח שחט עבור חבורה שאבדה","אוכל משלו והם אינם אוכלים"],"שתי חבורות שנתערבו פסחיהן אלו מושכין להן":["פסחים מעורבים בין חבורות","מושכין אחד מכל חבורה וחבורה","ידיך משוכות משלך ונמנית","חבורות שנתערבו: מי הנמנה","שני יחידים בפסחים מעורבים","דרך הכרעה בפסחים שנתערבו"],"דערבי פסחים ולא ער ש דלר י מן המנחה ולמע":["ערב פסח ושבת: אכילה לר' יוסי","לר\"י בערב שבת לא יאכל מתשע","ר\"י ור' יוסי: לא מפסיקין","מודה ר' יוסי בערב פסח","ערב פסח שחל בערב שבת","קביעת הלכה בעכו בין תלמידים"],"שינוי מקום בתוך הבית א צ לברך":["שינוי מקום בברכה: מתי צריך לברך","עקירת רגלים לקראת חתן וכלה","הניח זקן או חולה: אין ברכה","חוזר לקביעותו הקודמת בברכה","ברכה אחרונה בשינוי מקום סעודה","הטעונים ברכה במקומן: שינוי מקום"],"שרבא בירך קודם על בשמים ואח כ על המאור":["סדר ברכות הבדלה: מאור ובשמים","ב\"ש וב\"ה בסדר המאור והבשמים","רבא מברך בשמים לפני המאור","נהגו העם כבית הלל","מזון בתחילה והבדלה בסוף","סדר הברכות במוצאי שבת"],"שרבא בירך בפה ג על כוס ראשונה ואח כ כוס ":["ברכה על כוס ראשונה והשתייה","הסיח דעתו: אסור לשתות אחר ברכה","לא עקר דעתו מלשתות בברכה","ישבו בסעודה: ברכה על כל כוס","אין הלכה כתלמידי רב בכוסות","ריש גלותא ונוהג כוס ראשונה"],"הפוחת לא יפחות משלש והמוסיף לא יוסיף על ":["הבדלה: לא פחות משלוש","מי שאומר הבדלה הרבה ובמיעוט","נוהגים לומר הבדלה שלוש פעמים","ואין הלכה כחנניא אחי","המבדיל: הנוסח שבתורה","שבע הבדלות לא יוסיף"],"וחתים רב מקדש ישראל ושמואל המבדיל בין קו":["חתימה במקדש ישראל או בין קודש לחול","רב ושמואל בחתימת ההבדלה","לייט אביי: מאריכין ימיו","מקדש ישראל: חתימה שאינה הלכה","חותם בין קודש לחול כשמואל","ההלכה בחתימת הבדלה"],"מי שלא קידש בער ש מהו שיקדש והולך כל היו":["מי שלא קידש בערב שבת","קידוש היום כשאין כוס אחד","קידוש הכוס: לילה ויום","כבוד יום קודם לכבוד לילה","חביבה מצוה בשעתה: מתי נדחית","מוצאי שבת: ברכות לפני הבדלה"],"זכור את יום השבת לקדשו זוכרהו על היין בכ":["זכור ביום: ברכת פרי הגפן","קידושא רבה בבני מחוזא","הכל בפה\"ג ברישא","החכם עיניו בראשו: הלצה","זכירה בכניסת השבת על היין","ברכה ארוכה בקידוש היום"],"מי שלא הבדיל במוצ ש מבדיל והולך בכל השבת":["הבדלה באמצע השבוע עד רביעי","הבדלה בלי נר עד יום רביעי","גיטין: ימי חול לפני ואחרי שבת","איסור הבדלה על האור","ימי השבוע וגיטין בעד השבת","מי שלא הבדיל: זמן ההבדלה"],"אין אומרים הבא כוס של ברכה לברך אלא על ה":["קידוש על שכר: מחלוקת ר\"ש","הבא כוס של ברכה רק על היין","שיעור טעימת יין לקידוש","מלא לוגמא לדעת ריבר\"י","אין מקדשין על השכר","כל שהוא או מלא לוגמא בקידוש"],"וכן תני ר ג דמן נרש המקדש וטעם מלא לוגמא":["מלא לוגמא בקידוש לדעת ר\"ג","גידול סתמא ולא בר מנשיא","טעם מלא לוגמא ביין הקידוש","תנא בשם גידול סתמא","ר\"ג דמן נרש: טעימה מספקת","לא לשנות שמו של התנא"],"שתאן חי יצא אר א ידי יין יצא ידי חירות ל":["ארבע כוסות: חי או מזוג","שתייה בבת אחת לידי יין וחירות","רוב הכוס לארבע הכוסות","טעם ומראה יין בכוס הפסח","כדי רביעית לכל כוס","ידי יין יצא וידי חירות לא"],"ג שימור ברכה חירות":["ליל שמורים וכוס של ברכה","כוס ברכה מצטרף לטובה ולא לרעה","ארבעה כוסות: כל אחד מצוה","לא יאכל ולא ישתה בליל הסדר","חירות בשמירת הברכה","מזיקין וכוס הברכה בליל הפסח"],"ובביתו אסור רק לאדם חשוב כרבא שהביט בקור":["רבא ששתה כוס אחת בביתו","אסור לאדם חשוב בביתו לשתות","אומנתו מחזיקה לו בשתייה","הביט בקורה אחרת ונפגע","אשתו ואומנתו מסייעות בשתייה","חשוב רבא: החזקה בשתיית היין"],"מחמשה מיני צל צריך ליזהר דקל יחיד עץ חור":["חמישה מיני צל מסוכנים לשדים","צל דקל יחיד ועץ חורשף","עץ דפנה מותר מפני אביו","רב כהנא נמנע מכל צל","צל אניה וצל ערבה וצל קוצים","שדים בצל ודאי מעץ מסוכן"],"שם השדים בצלף רוחי":["שמות השדים לפי מקום מושבם","שמות השדים בצלף ובזרד","נפקא מינה לכתיבת קמע","רישפי ושידא ורוחי: שמות שדים","שם השד נקבע לפי מקומו","שדי הצלף והזרד בקמע"],"שדי הצלף אין לה עינים ונפק מ לברוח מהם ו":["שדי הצלף אין להם עינים","ברחה מהשד: הדקל נשבר","נפקא מינה לבריחה מן השדים","השד חיבק את הדקל ונשבר","צלף ושדיו: הכרה בברח","מעשה באיש שברח מן השד"],"פרחא דבי זרדתא שידי אין בו פחות מס שדים ":["פרחא דבי זרדתא: שישים שדים","בעץ זרדתא אין פחות מששים","הקמע בשישים שדי הזרדתא","שמות מקומות שדים לקמע","ששים שדים בעץ הזרד","פרחא דבי זרדתא ושדיה"],"מעשה בשומר העיר שנעמד ליד עץ זרדתא סמוך ":["שומר העיר והשדים בזרדתא","קמיע לשד אחד ולששים שדים","ידע זרדתא ששים שדים","השדים מודיעים: פנו כליכם","חכם שכתב קמיע לשיתין שידי","השדים לועגים לחכם שלא ידע"],"קטב מרירי תרי קטבי הוו של לפני הצהרים זה":["שני הקטבים: לפני הצהרים ואחריהם","שדים ודאי מא' בתמוז עד ט\"ז","מט\"ז ואילך ספק מצויים שדים","קטב מרירי מתקרב לשמאל","השדים בצל חצב ובצל בית הכסא","עשיר ומזל: הצלת ר\"פ מן הקטב"],"מזון תלוי בבית קשה לעניות תלא סילתא תלא ":["מזון תלוי בבית לעניות","סובין ופרורי לחם בבית מזיקין","לחם ולא בשר בתלייה","בלילי שבת ורביעי שרו מזיקין","תלא סילתא: תלא מזוניה","סימני עניות בבית מזון"],"המלאך הממונה על הפרנסה שמו נקיד":["נקיד ממונה על הפרנסה","נבל ממונה על העניות","שמות המלאכים הממונים על פרנסה","הפרנסה והעניות: שני ממונים","מלאכי הפרנסה והעניות בשמם","נקיד ונבל: שמות מלאכים"],"קערה ע פ החבית קשה לעניות":["קערה על פי החבית לעניות","שתייה מצלחת קשה לעיניים","אכילה בלי נטילה: פחד ל' יום","מקיז דם ונוטל ידיו: ז' ימים","מסתפר ואינו נוטל ידיו","גוזז צפרניו: פחד יום אחד"],"הרגיל להניח שפתיו על נחיריו סולם הוא לרו":["הנחת שפתיים על הנחיריים: רוח רעה","יד על המצח: סולם לרוח שינה","סולמות לרוחות רעות ולשינה","הרגל גוף שפותח לרוח רעה","נחיריים ומצח: סימני רוחות","סולם לרוח רעה בהרגל אדם"],"אוכלין ומשקין תחת המטה אף מחופין בכלי בר":["אוכל ומשקה תחת המטה: רוח רעה","אין שותים מים בלילי שבת ורביעי","ז' קולות של דוד לשתיית מים","שתייה בלילה ודם בראשו","כלי ברזל על אוכל ומשקה","הקולות על המים בשעת צמא"],"אל תצא יחידי בלילה דתניא לא יצא יחידי בל":["אל תצא יחידי בלילה מפני מלאכי חבלה","אגרת בת מחלת וי\"ח רבוא","רבי חנינא בן דוסא ובת מחלת","שברח סוסיהם: רק למקום יישוב","הניח לה בלילי שבת ורביעי","הזהרו בחנינא ובתורתו"],"ולא תשא אשה אי נשאת ב תישא שלישית שתגלה ":["אשה שנשאה פעמיים: שלישית","הפוך בנבילתא ולא במילי ניבול","אשה שתגלה אם יעצו רעה","נישואי שלישית בחכמת נשים","נבילתא: הפיכה במעשה שלא בדיבור","לא תיפוך במילי שמביאים לניבול פה"],"פשוט נבילתא בשוק ותרוויח ולא תאמר כהן אנ":["פשוט נבילתא בשוק ותרוויח","אל תאמר כהן אני בשוק","שנוא הדבר להתגנות בשוק","עסק פשוט בשוק ורווח","גאווה אסורה במסחר בשוק","מסחר בשוק בלי גאווה"],"כשאתה עולה לגג קח סעודתך עמך אפי בדרך קצ":["סעודה עמך בעלייה לגג","דלעות בזוז: זול למאה","אוכל עמך גם בדרך קצרה","נשיאת מזון בדרך ותמיד","הכנה לדרך: סעודה עמך","מאה דלעות בזוז בשוק"],"סודנא שכר אר ח סוד נאה וגמילות חסדים":["סודנא: שכר או סוד נאה","גמילות חסדים בלשון סודנא","אשראי ספק יבוא ספק לא יבוא","כל אגב גביא בעי: גביה","מעות רעות באשראי","פירוש סודנא לר\"ח"],"והיושבת על דם טהור אסורה לשמש עונה":["היושבת על דם טהור: שמש עונה","שמות איסי ויוסף: שושלת זהות","איסי בן עקביה: כינויי תנא","יוסף הבבלי ואיסי בן יהודה","סימני זהות של איסי בן גור אריה","שמותיו של איסי בן עקביה"],"הוא רבי יצחק בן טבלא הוא רבי יצחק בן חקל":["שמות ר' יצחק: שמעתא ואגדתא","סימן שמעוני שמעתא אחי ועמי","ר' יצחק בן טבלא ובן חקלא","אכול בצל ירקות בזול ושב בצל","אל תאכל אווזין ותרנגולין יקרין","כינויי ר' יצחק לפי תחומו"],"הפחת ממאכלך ושתייתך והוסף על דירתך":["הפחת מאכל והוסף דירה","זנב הכבש: נחבא מפני בעלי חיים","ירקות על אשפות העיר","משל מערבא בשאר המאכל","מתחבאים לפי סוג המזון","דירה ומאכל: הגבלות לחיים"],"מזגו לו כוס ראשון ב ש מברך על היום ואח כ":["ב\"ש וב\"ה: היום או היין קודם","סדר ברכת היום בכוס הראשון","ב\"ש מברך על היום תחילה","ב\"ה מברך על היין תחילה","כוס ראשון: סדר ברכות הקידוש","מחלוקת סדר היום והיין"],"הביאו לפניו מטבל בחזרת עד שמגיע לפרפרת ה":["חזרת וחרוסת ושני תבשילין","ראבר\"צ: חרוסת מצוה","מצות צריכות כוונה לדעת ר\"י","מטבל בחזרת: כוונה ואכילה","ר' יוסי: אין צריכות כוונה","שני טיבולים להיכר לתינוקות"],"זאת אומרת מצות צריכות כוונה":["כוונה במצוות: מחלוקת שני טיבולים","אכלן בלא מתכוין יצא","אכלן לחצאין: שיעור פרס","שאר ירקות וטבילה שנייה","מאי יצא בטבילת חזרת","שלא ישהה בין אכילה לחברתה"],"כשיש שאר ירקות":["שאר ירקות ואחריהם מרור","ברכה על ירק לפני המרור","ברכת מרור אחרי שאר ירקות","בורא פרי האדמה לפני מרור","סדר ברכת ירקות והמרור","בשעה שיש ירקות אחרים"],"כל שטיבולו במשקה צריך נטילת ידים":["טיבול במשקה: נטילת ידיים","חסה בחרוסת לקפא חריפות","מרור בחרוסת מבטל מרירות","נטילה בטיבול ראשון לר\"ע","הסח דעתו ונגיעה בשני טיבולים","שתי נטילות לאמירת הגדה והלל"],"בלע מצה יצא בלע מרור לא יצא":["בלע מצה יצא, מרור לא","כרכן בסיב ובלען: מצה נפסלת","שולחן נעקר לפני מגיד ההגדה","מצה ומרור לפני כל אחד","הלכה כר\"ה בבליעה","כולהו לפני מי שאומר הגדה"],"מזגו לו כוס שני וכאן הבן שואל אביו ואם א":["כוס שני: מה נשתנה","מתחיל בגנות ומסיים בשבח","הבן שואל והאב מלמד","ארמי אובד אבי: מדרש ההגדה","שאלת הבן לפי דעתו","הלילה הזה מכל הלילות"],"חכם בנו שואלו ואם אינו חכם אשתו שואלתו ו":["חכם בנו שואלו: אשתו או עצמו","שני ת\"ח שואלין זה לזה","שתי טבילות: מנהג לא חיוב","אטו כל יום לא סגי בטבילה","הטבילה פעמיים בליל הסדר","שאלת מה נשתנה לתינוקות"],"ר ג כל שלא אמר שלשה דברים אלו בפסח לא יצ":["שלושה דברים: פסח מצה ומרור","חייב אדם לראות את עצמו","על שום פסח המקום על בתי אבותינו","עד היכן אומר ההלל: ב\"ש וב\"ה","ר\"ג: מחויבות אמירת שלושה דברים","מעבדות לחרות בהודאה ובהלל"],"צריך שיאמר ואותנו הוציא משם":["הגבהת מצה ומרור ולא בשר","ואותנו הוציא משם: אמירה","בשר בלא הגבהה כאוכל קדשים בחוץ","הגבהה לפני ההגדה","מה נאמר בהגבהה ואותנו","מראית אכילת קדשים בחוץ"],"שיר שבתורה משה וישראל אמרוהו בשעה שעלו מ":["שיר שבתורה ושירת הלל","הלל שתקנו הנביאים לישראל","כלו תפלות דוד בן ישי","הלל משה וישראל בים","פסלו של מיכה בבכי","הלל על צרה וגאולה"],"מזגו לו כוס שלישי מברך על מזונו":["כוס שלישי על ברכת המזון","כוס רביעי: גמר הלל וברכת השיר","בין הכוסות: שתייה והסח","שלא ישתכר בין שלישי לרביעי","ברכת המזון טעונה כוס","ארבע כוסות דרך חירות"],"ש מ ברכת המזון טעונה כוס":["ברכת המזון טעונה כוס","כל כוס כאן מצוה בפני עצמה","ארבע כוסות תיקנו רבנן","דרך חירות בכל כוס וכוס","כוס לברכת המזון בכל מקום","מצוה בכל אחד מארבע הכוסות"],"בשעה שהפיל נמרוד הרשע את אברהם אבינו לתו":["אברהם בכבשן: נאה ליחיד להציל","גבריאל מציל את חנניה מישאל ועזריה","שר הברד מבקש לרדת לכבשן","ה' אינו מקפח שכר בריה","אש ומים: נס בתוך נס","אברהם מציל שלושה מבני בניו"],"דלתי ולי יהושיע אמרה כנסת ישראל לפני ה ר":["דלתי ולי יהושיע: כנסת ישראל","מצרים תביא דורון למשיח","כוש ורומי: ק\"ו מן המצרים","געור חיה וקנה: משל לאומות","הללו את ה' כל גוים","שלוחי ר' ודברי אביו"],"ישנו מקצתן יאכלו כולן לא יאכלו":["ישנו מקצתן: אכילת הפסח","נתנמנמו יאכלו, נרדמו לא","פסח אחר חצות מטמא ידים","פגול ונותר מטמאין את הידים","שינה חלקית בסעודת הפסח","טומאת ידיים בקדשים שנפסלו"],"לרי ש בירך ברכת הפסח פטר את של זבח":["ברכת הפסח ופטור ברכת הזבח","ר\"ע: לא זו פוטרת זו","זריקה בכלל שפיכה ולהפך","שהחיינו בפדיון הבן: מי מברך","אבי הבן מברך שתים","ברכת הזבח מול ברכת הפסח"],"זריקה בכלל שפיכה ולא שפיכה בכלל זריקה":["זריקה בכלל שפיכה: לא להיפך","האב מברך על פדיון הבן","שהחיינו של כהן או של אב","מי מברך שהחיינו לאחר הנאה","שתי ברכות לאבי הבן","הלכה כאבי הבן: ברכה כפולה"]}