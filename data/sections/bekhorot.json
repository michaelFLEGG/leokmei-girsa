"k": "m",
"letter": "ג",
"how": "m",
"i": 2574,
"text": "מתני'.",
"next": "הריס של עין שניקב, שנפגם, שנסדק, הרי בעינו דק, תבלול, חלזון, נחש, ועינב."
},
{
"daf": "לח:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2581,
"text": "דק תבלול.",
"next": ""
},
{
"daf": "לח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2590,
"text": "חלזון נחש ועצב.",
"next": ""
},
{
"daf": "לח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2600,
"text": "איזהו תבלול לבן הפוסק את הסירא.",
"next": ""
},
{
"daf": "לח:",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2610,
"text": "מתני'.",
