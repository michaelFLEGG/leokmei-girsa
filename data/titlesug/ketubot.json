{"והקולא באבילות כאן שנוהג ימי משתה ורק אח":["בעילה באבילות אינה קולא","אבילות אינה מקלה בבעילה","מתי מתחילה האבילות לגבי בעילה","הקולא באבילות רק בימי המשתה","בעילה לפני חופה וקולא באבילות","אבילות וימי משתה לא בבעילה"],"תנא הואיל ותקנת חכמים מן הזיבורית רשב ג ":["כתובה מדאורייתא או מדרבנן","מקור חיוב הכתובה מהתורה","רשב\"ג: כתובה מדרבנן","כתובת אלמנה מדרבנן","מוהר הבתולות וכתובה","פירוש מוהר הבתולות ברשב\"ג"],"הגדול שבא על הקטנה וקטן שבא על הגדולה ומ":["כתובת בנות פסולות","כתובת מוכת עץ מחלוקת","כתובת הגיורת והשבויה","בעילה פסולה וכתובה","כתובה למי שאין לה טענת בתולים","מנה או מאתים בפסולות"],"האוכל אצל חמיו ביהודה שלא בעדים":["טענת בתולים ביהודה ובגליל","מנהג יחוד ביהודה","האוכל אצל חמיו ביהודה","נאמנות הייחוד לטענת בתולים","מנהגי חופה ביהודה ובגליל","שושבינים ביהודה ובגליל"],"האוכל שיש מקומות ביהודה שלא אוכל ג":["מנהגי יחוד ושושבינים","ביהודה שושבינין ישנים","אכילה אצל החמיו והשלכותיה","הבדל מנהגי יהודה וגליל בחופה","יחוד לפני חופה מנהג יהודה","מי נאמן בבתולים לפי מנהג המקום"],"שתי תקנות לאלמנה בת כהן בתחילה לאלמנה מנ":["תקנת כתובת אלמנה בת כהן","מאתים לאלמנת כהן","החזרה לבית אביה כתקנה","כתובת כהנת אלמנה מנה ומאתים","אלמנת כהן תקנה נוספת","תקנת חכמים לאלמנת כהן"],"ראוה מדברת מה טיבו של זה איש פלוני וכהן ":["נאמנות האישה על זהות הבעל","בעולה לנתין ולממזר","מעוברת נאמנות על טיב העובר","נאמנות לטענה על יחוס","אשה מעוברת ומה טיב עוברה","טענת האשה על בעלה הכהן"],"מדברת זעירי נסתרה אמנם מודה שנבעלה ר א נ":["האם נבעלה או נסתרה","נבעלה בעינינו מחלוקת","מודה שנבעלה או נסתרה","זעירי: נסתרה אמנם","נבעלה בעינינו או לא","הודאה בבעילה ובסתירה"],"למסקנא רישא דנאמנין ב אנוסין מחמת נפשות":["אנוסים לעדות בנפשות","אנוס ממון אינו נאמן","אין משים עצמו רשע","עד שהגיד אין חוזר ומגיד","נאמנות אנוסים למיתה","עדות אנוסים ובית דין"],"שניהם אומרים זה כתב ידי וזה כתב ידו של ח":["כתב יד צירוף עדים","כתב יד בשטר רבי וחכמים","זה כתב ידי וזה כתב ידו","נאמנות להכרת כתב יד","אחד מכיר כתב יד חבירו","כתב יד לא דורש צירוף"],"שמואל הלכה כחכמים ולא אומרים דהלכה כרבי ":["הלכה כחכמים בכתב ידי","שטר שיצא מבית דין","חתימת עדים על שטר יתומים","ב\"ד טועים וחשש לשטר","דשמואל: הלכה כחכמים","שטר בבית דין ללא צירוף"],"שמואל עד ודיין מצטרפין רב ח כמה מעליא הא":["עד ודיין מצטרפין","דברי שמואל עד ודיין","אין עד מעיד עדות הדיין","כמה מעליא הא שמעתא","צירוף עד לדיין בדין","רבנאי משמואל עד ודיין"],"וצריכי כל הני שדה שטר אישות וכהונה":["צירוף עדות לשדה ושטר","עדות באשת איש","עדות שבויה ונשביתי","עדות בכהונה ובשטר","ארבעה דברים בלא עדים","שדה שטר אישות וכהונה"],"ואעפ כ ייחד לה בית בחצרו וכשיוצאה בראש ב":["יחוד לאשה מגורשת","ייחד לה בית בחצרו","מותר לייחד גרושה","מגורש לא תנשא בשכונתו","גירושין ושכונה ומבוי","עבירה בגרושה וביחוד"],"היא נדחית מפניו ואין הוא נדחה מפניה ובחצ":["חצר משותפת ודחיית הגבר","טלטול האיש קשה מאשה","לוה בנכסי אביה נפרעת","שליח בין ארוס וארוסה","שמחות בנישואין ובאירוסין","גס ליבו בארוסה"],"רהבדר י והוא שיש גדול עמו":["נאמנות בשליחות בדרבנן","קיום שטרות מדרבנן","הימנוהו רבנן בדרבנן","גדול עמו לנאמנות","אב ורב אינם מעידים","נאמנות בעדות בעל דין"],"ה ק אלו נערות פסולות דגם לכשרות יש שיש ל":["קנס לנערה פסולה","ממזרת נתינה וכותית","קנס ומכר בנערה","ולו תהיה לאשה נערה","קנס בקטנה ונערה","נערה אבל לא קטנה כר\"מ"],"ולר ע דאין קידושין תופסין בחייבי לאוין נ":["אלמנה לכהן גדול","קידושין בחייבי לאוין","ר\"ע והולד ממזר","עקיבא ורבי ישבב בממזרות","כל שאין לו ביאה בישראל","בעולה לכהן גדול"],"ב רי ו אף תימא אחותו נערה כאן שהתרו בו כ":["לוקה ואינו משלם","ריבתה תורה עדים זוממין","הכהו לוקה או משלם","חובל בחבירו לתשלומין","כל המשלם אינו לוקה","מלקות וממון במקום אחד"],"חובל בחבירו ג רשבדר א גם אינו משלם ממון ":["אסון ענוש יענש מיתה","מותרה לדבר חמור","חובשין את המכה","שבתו יתן ורפא ירפא","מכה בהתראה ונזק","ממון או מלקות באסון"],"חלקו ר א ורבינא בדעת רי ו הסנדלר אם מעשה":["שבת דאורייתא או דרבנן","קדש היא ואין מעשיה קודש","מעשה שבת חיוב דאורייתא","הסנדלר בשבת לפי דעה","פטור אשארא בשבת","חיוב מלאכה בשבת לרבי יהודה"],"טובח לעכו ם לר ש דחייב אף דמתחילה צריך ל":["שור הנסקל בבית שומר","דבר הגורם לממון כממון","שור הנסקל שאינו שלו","גנב מבית שומר","חייב שור שלא לו","טובח לנכרי חיוב רבי שמעון"],"רבא הניח אביהן פרה שאולה משתמשין בה כל י":["פרה שאולה שנטבחה","אחריות נכסים לאב","משתמש בפרה שאולה","כסבורין שלאביהם היא","אם מת השואל חיוב","אחריות נכסים והשאלה"],"ר ח לרבא בהכרח דתב ח דמכה אדם ומכה בהמה ":["מכה אדם ומכה בהמה","חידוש בקנס ובהריגה","אביי ורבה קנס ממון","תב\"ח אדם ובהמה בשבת","חלוקה בשבת והתראה","רבי מאיר בקנס ובתו"],"רי ו רבי יהודה ורבי דוסא אמרו דבר אחד ר ":["שבויה ואכילת תרומה","נשביתי וטהורה לאכילה","שבויה שמיעך לה ערבי","רבי יהודה והשבויה","שבויה כתובה מאתים","הפודה שבויה ישאנה"],"רמי רפב ש לרב יוסף איך ס ל לר י דבקדושתה":["גיורת וממתינה שלושה חדשים","שבויה וממתנה שלושה חודשים","שלא יודעת להיכן יביאוה","רבי יוסי ככל הנשים","גיורת ושבויה מחלוקת ההמתנה","אשה מזנה ותעבורת"],"טעם ריה ג אשר לא אורשה הא אורסה אין לה ק":["קנס הנערה לאביה או לעצמה","אשר לא אורשה לאב","ארוסה וקנס לאביה","נערה בתולה לגזירה שוה","קנס לנערה בתולה מחלוקת","גזירה שוה לנ' שקלים"],"קנסה לאביה וי א לעצמה כר ח בנערה שנתארסה":["בא עליה ומתה פטור","ונתן לאבי הנערה","יש בגר בקבר ואב","ג' נשים משמשות במוך","קנס למתה פטור","קטנה שמא תתעבר"],"צער אבוה דשמואל שחבטה ע ג קרקע":["צער באונס ובמפותה","פקחות אומרות אין לה צער","מפותה אינה מקבלת צער","חבטה על הקרקע צער","צער בפיסוק רגלים","אונס משלם צער או לא"],"מרי ו ר א בשיטת ר ע רבו אמרה דיש לה קנס ":["ר\"א כשיטת ר\"ע בקנס","קנס לעצמה לדעת ר\"א","רבו אמרה קנס לעצמה","רבו של ר\"א והקנס","קנס לעצמה שיטת ר\"ע","ר\"ע ור\"א בקנס לאשה"],"איזהו בושת הכל לפי המבייש והמתבייש":["איזהו בושת ופגם","בושת לפי המבייש והמתבייש","קנס שוה בכל אדם","חמישים סלעים לכל דבר","בושת ופגם מדברי הכתוב","בנעוריה לאביה קנס"],"ולא חמישים סלעים לכל דבר":["חמישים סלעים לכל אדם","בושת ופגם עבד בריא או מוכה","תחת אשר עינה בושת","שבח נעורים לאב","אביה זוכה בקנס הנערה","קנס לאב ולא לבת"],"כל מקום שיש מכר אין קנס וכל מקום שיש קנס":["קטנה מכר או קנס","קנס במקום מכר לחכמים","ר\"מ וקטנה מבת ג' שנים","ולו תהיה לאשה מהוה עצמה","נערה אפילו קטנה במשמע","קטנה בקנס ומכר"],"רב זו דברי ר מ אבל חכ א יש לה קנס במקום ":["מוציא שם רע על קטנה","והוציאו את הנערה סקילה","קטנה אינה בת עונשין","נערה לגלויי אפילו קטנה","שם רע בקטנה פטור","נער אפילו קטנה"],"לא רק אנסתי דלא פגמה דמשלם בושת ופגם אלא":["אנסתי ופתיתי בושת ופגם","אונס ומפותה לבושת","פגמה ומשלם לה","אף בושת ופגם לאביה","שנח לה ולא ניחל לאביה","בושת ופגם בפיתוי"],"ואף דתנינא המפתה נותן ג בושת ופגם וקנס ו":["מפתה נותן בושת ופגם וקנס","אונס נותן גם צער","מחלוקת רבי שמעון ורבנן בקנס","לאביה במפותה","סוגיית המפתה והאונס","קנס מפתה לאביה"],"ב והקשהו לרבה מדר ש שאמר דאם לא הספיקה ל":["קנס ממון או מיתה","האחים ירשו קנס","קנס שהגיע לאחר מות האב","זכתה מדין קנס בבגרותה","כ\"ב שנה רב יוסף ורבה","קנס לגבות בירושה"],"ג והקשהו מדר ש פוטר שאינו משלם קנס על פי":["ר\"ש ופטור על פי עצמו","קנס אדם לא מניח דבר קצוב","רבנן בושת ופגם בתביעה","הודו לי דקנס תבע","קרבן שבועה והודאה בקנס","תובע דבר קצוב או לא"],"המארס את בתו וגרשה אירסה ונתארמלה כתובתה":["המארס את בתו וגרשה כתובה","השיאה וגרשה והשיאה ונתארמלה","נתארמלה פעמיים אינה נישאת","ראשונה של אב השיאה","כתובה לאב ולבת","אב ובתו בכתובה"],"טעם דהשיאה וגרשה השיאה ונתארמלה אבל נתאר":["נתארמלה פעמיים חזקה","חזקת שתי אלמנות","כרבי פעמיים חזקה","השיאה וגרשה כתובה לשלה","מבית אב לבת בחזקה","חזקה שנתארמלה פעמיים"],"ר נ שני שטרות היוצאין בזה אחר זה ביטל שנ":["שני שטרות על נכס אחד","שטר שני ביטל את הראשון","הודאה בשטר ראשון פסול","שמחל לשיעבודו","מכר ומתנה מי קודם","שטרות יוצאים זה אחר זה"],"הגיורת שנתגיירה בתה עמה וזינתה הרי זו בח":["גיורת ובתה שזינתה","הורה שלא בקדושה ולידה בקדושה","בתה בחנק או בסקילה","פתח בית האב למצוה","לרבות הורה ולידה","גיורת ותוצאותיה בחיוב"],"ר ל ומתה לרבות הורתה שלא בקדושה ולידתה ב":["רבות ומתה למיתה לא לקנס","הורה ולידה בקדושה ישראלית","נבלה נעשתה בישראל","ומתה לרבות בגיורת","מיתה ולא קנס בגיורת","ולידתה בקדושה והורתה לא"],"בכסף אר י ויצאה חנם אין כסף אין כסף לאדו":["אב או אדון לכסף הבת","ויצאה חנם אין כסף","זכאי במציאתה משום איבה","אביה מקבל קידושיה","בנעוריה בית אביה לאב","יציאה מרשות האב"],"ר י אף עני שבישראל לא יפחות משני חלילין ":["עני בישראל שני חלילין","מזונות ותכשיט בהלך למדינת הים","נשתטה ירידה לנכסיו","צדקה ותכשיט לאשה","קבורה לפי כבוד הנכסים","ירידה לנכסים לאחר מיתה"],"לעולם להוציא ממשנה ראשונה ד הגיע זמן ולא":["אוכלות משלו ואוכלות בתרומה","הגיע זמן ולא נישאו","לעולם חידוש במשנה","משנה ראשונה על אוכלות משלו","לעולם להוציא ממשנה","בנות לעולם בתרומה"],"במזונות בתו אינו חייב אבל יש מצוה הא במז":["מצוה לזון את הבנות","מזונות בתו בחיי אביה","כר\"מ וכרבי יהודה במזונות","כריב\"ב אחר מיתת אביהן","האב אינו חייב במזונות בתו","ק\"ו לבנים בלימוד"],"ר ק המכניס בנו פחות מבן שש רץ אחריו ואינ":["רץ אחר הבן פחות משש","סכנה מחולשה ורצון חכמה","חביריו רצין אחריו","בכחוש ובבריא לריצה","באושא התקינו מכירת מלוג","מכירת מלוג בחיי הבעל"],"ארחב י רב ציוה לפרנס מחיטי דעלייה במקרה ":["פרנסה משמין באב","מזונות ופרנסה מן המטלטלין","עלייה ואב לפרנסה","שמואל: לפרנסה שמין באב","יתומות בעלייה ופרנסה","מטלטלי יתומים למזונות"],"מעשה בנהרדעא ודנו לזון מהמטלטלים בפומבדי":["מעשה בנהרדעא במטלטלי יתומים","החזירו את הגבייה מהיתומים","רבי אמי ורבי אסי לזונם","רבי יודע במידת רחמנות","מידת הדין מול מידת רחמים","שלא יקבעו הלכה לדורות"],"רב יוסף ליתן לזה שבא אליו מתמרים המתייבש":["תמרים על המחצלות מטלטלין","לבודיא מחוברים לדקל","כל העומד ליגזז","בע\"ח בתמרים מחוברים","תמרים ודקל מזונות יתומים","מטלטלין או קרקע לזון"],"רבא ליתום ויתומה שבאו לפניו העלו ליתום ב":["ליתום בשביל יתומה","ממקרקעי ולא ממטלטלי","פרנסה לשפחה ולבן","תרתי שפחה לשמשו","הוצאה לכתובה ופרנסה","שני יתומים בפרנסה"],"רבי נכסים שיש להן ושאין להם אחריות מוציא":["נכסים שיש להן אחריות","הלכתא ממקרקעי ולא ממטלטלי","אחריות נכסים ומזונות לבנות","רשב\"א אחריות והוצאה לבנים","מוציאין לכתובה ולמזונות","הלכה כרשב\"א ברבא"],"רישא כר מ הפוחת לבתולה מר ולאלמנה מק זו ":["הפוחת לבתולה מר' ולאלמנה","שדה שוה מנה תחת מאתים","אחריות טעות סופר","מצא שטר יש אחריות","חמשה גובין מן המחוררין","כתובה ואין בה אחריות"],"מרשב י מפני מה התקינו כתובת בנין דכרין":["כתובת בנין דכרין","עד עישור נכסי","בנות תובעות כתובה לאחר המיתה","שיקפוץ אדם ויכתוב לבתו","בת בין הבנים לא יורשת","תקנת בנין דכרין"],"ר פ הלך לבית אבא סוראה שיכתוב כתובת בתו ":["ר\"פ ואבא סוראה בכתובת הבת","לכתוב כל שהיה לו לבתו","שלא להעביר ירושה לבן רע","כפיית כתיבת כתובת בת","רצון וכפייה בכתיבת כתובה","שתיקה ככתיבה בבית אבא"],"בעא רי ס מר נ מכרה כתובתה לבעלה אם יש לה":["מוכרת כתובתה לבעלה","מוחלת לבעלה אין בנין דכרין","אנסוה זוזי יש בנין דכרין","כמי שכפוה ומחילה","מכירת כתובה לאחרים","מחילת כתובה ובנין דכרין"],"רבא בעי ופשט מוכרת כתובה לבעלה כמוכרת לא":["מוכרת כתובה כמוכרת לאחרים","יצר אנסה קנס רבנן","משיב רעה תחת טובה","מחילת כתובה ומזונות","ארוסה שמתה אין לה כתובה","ארוסה אין אונן ואין מיטמא"],"שומת אלמנה רב מה שעליה שמואל אין שמין מה":["שומת אלמנה מה שעליה","אין שמין מה שעליה","לקיט ואלמנה שלח והוצא","כלת בר אלישיב ותבעה כתובה","הלכה כרב באלמנה","הקדש נכסים וכסות אשה"],"אם רצה להוסיף ולא אמרי שרבנן קצצו שלא לב":["תנאי כתובה ככתובה דמי","נפק\"מ לתובעת ולמורדת","כתובת בנין דכרין בפומבדיתא","ייחד לה קרקע בארבע מצרים","לא גובה ממשעבדי ירתון","כתובה בלא שבועה"],"אחות רב ח נישאה לר א ואיבדה כתובתה ב":["אחות רב חנינא ואיבוד כתובה","שלוש שנים בלא כתובה","כתובה לאחר חופה או ביאה","מוחלת בתחילה או בסוף","מחלוקת תחילת חופה וסוף ביאה","מחלוקת אמוראים בכתובה ומחילה"],"יב חודש ר ח ימים או עשור שנה מימים תהיה ":["יב חודש לבתולה","בגרה ונתקדשה ל' יום","קטנה לא נפסקת להשיאה","מזונות יב חודש בבגרות","אלמנה כתבועה","בגרה כתבועה לגבי זמן"],"ר ה מרב יכולה אשה לומר לבעלה איני ניזונת":["אשה אומרת איני ניזונת ואיני עושה","מזונות תחת מעשה ידיים","מקדיש מעשה ידי אשתו","עבד כנעני ועבד עברי","מקדיש מעשה ידי אשה","הקדש מעשה ידי אשה ולעבד"],"ואלו מלאכות שהאשה עושה לבעלה טוחנת ואופה":["מלאכות האשה לבעלה","שפחה אחת שתים שלוש ארבע","המדיר את אשתו מלאכה","בטלה מביאה לשיעמום","אין אשה אלא ליופי","הרוצה שיעדן את אשתו"],"טוחנת היינו א מטחנת ב בריחים של יד":["טוחנת מטחנת או ריחיים","לשון טוחנת במשנה","אין אשה אלא לתכשיטי אשה","מתני' דלא כר\"ח","הרוצה לעדן אשתו בפשתן","הרוצה לשלב בתו באפרוחים"],"ב ר ח בן חכינאי הלך לבי רב בסוף ימי המשת":["ר\"ח בן חכינאי והשתלמות תורה","אשתו ניפתה קמח וחייתה","י\"ב שנה בבית המדרש","בן נכבד לפני אביו","ענייה זו זה שכרה","תפילה לחיית האשה"],"ה ריב ר שלחו אביו לביהמ ד לפני רב יוסף פ":["שש שנים בישיבה לפני רב יוסף","בא לביתו בעיו\"כ","נזכרת ביונתך","מפסקה בישיבה וסעודה","אביו יוצא לקראתו בנשק","נטרדו ולא אכלו"],"המורדת על בעלה פוחתין לה מכתובתה שבעה די":["המורדת פוחתין מכתובתה","שבעה דינרים בשבת","עד מתי הוא פוחת","מורד על אשתו מוסיפין","מורדת מתשמיש או ממלאכה","הכפייה על המורד ומורדת"],"מורדת לכו ע מתשמיש המטה ור ה וריב ח חלקו":["מורדת מתשמיש או ממלאכה","מחלוקת רב הונא וריב\"ח","מורדת ארוסה נשואה נדה","קודם משדלים אותו","מורד שאומר איני זן","מורדת בכל מצב לכו\"ע"],"מורדת דאמרה שהיא רוצה בו ורק רוצה לצערו":["מורדת שאמרה מאיס עלי","כופין אותה מעשה וכפאה","סייעתא דשמיא בכפייה","רצון לצער ללא כפייה","מורדת שרוצה בו","כפייה במורדת בסורא"],"ואף דכבר תנינא האב זכאי בבתו בקידושיה בכ":["האב זכאי בבתו בקידושיה","זכאי במציאתה ובמעשה ידיה","מקבל את גיטה ואוכל פירות","נישאת יתר עליו הבעל","בושתה ופגמה מחלוקת","זכות האב והבעל בבת"],"תני לפני רבא מציאת האשה לעצמה ר ע לבעלה ":["מציאת האשה לבעלה","ר\"ע מציאת אשה לבעל","הדחק במציאה לבעל","עשתה לו שתים בבת אחת","שלשה או ארבע בבת אחת","מציאה של אשה תיקו"],"אף ראשון ע ה ושני ת ח יכול לומר לאחיך הי":["עם הארץ ותלמיד חכם רשות","הייתי רוצה ליתן ולא לך","ראשון ע\"ה ושני ת\"ח","מתנת שידוך לאח","אח שאינו ת\"ח","יכול לומר לאחיך"],"פסקה להכניס לו כספים סלעה נעשה ששה דינרי":["החתן מקבל עשרה דינרים לקופה","כל מנה ומנה לקופה","הכל כמנהג המדינה","עסקא רבה ועסקא קטן","פסקה להכניס סלעה","נתינה לחתן בנדוניה"],"ואף דתני כנגדם ט ו מנה מ מ תני עסקא רבה ":["עסקה רבה ועסקה קטנה","אף שרווחו מרובה","זוטר זיונא בעסקה","ט\"ו מנה כנגדם","סחורה קטנה ורווח גדול","אחריות מועטת בעסק קטן"],"המשיא את בתו סתם לא יפחות לה מחמשים זוז":["המשיא את בתו סתם חמשים זוז","להכניסה ערומה","מפרנסין יתומה לפי כבודה","חמשים זוזי פשיטי","יתום שבא לישא בית ומטה","די מחסורו לפרנסו לא לעשרו"],"אביי חמשים זוזי פשיטי מדינה ולא צורי":["חמשים זוז מדינה ולא צורי","אם יש בכיס מפרנסין","בושתה מרובה משל איש","משיאין יתומה ואחר כך יתום","סוס לרכוב ועבד לרוץ","אשר יחסר לו אפילו סוס"],"ת ר המסמא עינו והמצבה בטנו והמקפח שוקו א":["המסמא עינו אינו נפטר","המקבל צדקה וא\"צ לכך","מי שמקבל צדקה שלא לצורך","מסמא עינו והמקפח שוקו","נפטר מהעולם בכך","מקבל צדקה ואינו צריך"],"תנן אין מחייבין אותו למכור ביתו וכלי תשמ":["אין מחייבין למכור ביתו","השתמש בכלי זהב בכלי כסף","מכירת כלי תשמיש לפי מעמד","מחריש כסף שחייב למכור","גבייה מעשיר שלא ידע","יתומה שהשיאה אמה"],"שמואל לפרנסה שמין באב":["שמואל לפרנסה שמין באב","הבנות ניזונות מנכסי אביהן","נכסים ועשירות בדעת","תיובתא דשמואל באומדנא","הלכה כרבי יוסי ליתומה","רבא הלכה כרבי לגבי בת"],"רבי בת הניזונת מן האחין נוטלת עישור נכסי":["בת הניזונת מן האחין עישור","עשר בנות ובן","ראשונה עישור שניה במה ששיירה","כולן להנשא כאחת","מסייע לר\"מ בעישור","חולקות בשוה בבית"],"שלח רב לרבי בין השורות האחין ששיעבדו מכר":["האחין ששיעבדו מוציאין לפרנסה","מכרו או משכנו לפרנסה","מחלוקת רבי וריו\"ה","שעבוד אחין למזונות","מוציאין לפרנסה ולא למזונות","שלח רב לרבי בשעבוד"],"שלח ר ע לר ה הונא חברין שלום":["שלח ר\"ע עישור נכסים בלשון ענן","ובשמתא אם לא יאמר ענן","ממקרקעי או ממטלטלי בלשון ענן","מרזח בראש מיסב","שליח ואיסור בית מרזח","מי שלא ישאל בלשון ענן"],"המשליש מעות לחתנו ליקח מהן שדה לבתו והיא":["המשליש מעות לחתנו לשדה","מהנשואין הרשות בידה","הלכה כרבי יוסי בשליש","גדולה ורשות בשליש","הרשות בידו בגדולה","מהאירוסין מה שהושלש בידו"],"גופא המודר הנאה מחבירו ואין לו מה יאכל ה":["המודר הנאה מחבירו וחנווני","מי שאין לו מה יאכל","פועלים לבנות ולגדור","מודר הנאה ופועלים שנוטלים","אינו מפסיד בלא ידיעה","הודעה למודר הנאה לחנווני"],"תנן המדיר אשתו שלא תטעום א מכל הפירות יו":["המדיר אשתו שלא תטעום פירות","כאן מתני' בסתם ובמפרש","הוא נותן אצבע בין שיניה","נזיר ושמע הבעל ולא הפר","יוציא ויתן כתובה בנדר","ר\"מ ורבי יוסי בהפרת נדר"],"והך דמדויק מסיפא דהא שנים יקיים":["שנים יקיים או שנים יוציא","רדופה ואינה רדופה בבית חמיה","ככלה בבית חמיה","תקראי אישי ולא תקראי בעלי","אז הייתי בעיניו כמוצאת שלום","כהנת וכר\"י בנדר"],"ואף דכבר שנינו גבי כתובות אטו קידושין וש":["בנדרים בשר יין והתקשטות","אטו קידושין ושם קידושין","לעולם ארישא מקפיד","נדר בתחילה וסיפא","מה שאנשים מקפידים בו","נדר שלא תאכל בשר ויין"],"רבה מחלוקת בטעות אשה אחת כעין שתי נשים":["קידשה בטעות בפחות משוה פרוטה","אשה אחת כעין שתי נשים","קטן ששלח סבלונות מקודשת","אם בעלו קנו","רשב\"י ורבי בעלו לא קנו","בטעות ובעילה לשם קידושין"],"ת ר הלכה לחכם והתירה מקודשת לרופא וריפאה":["הלכה לחכם והתירה מקודשת","רופא וריפאה אינה מקודשת","חכם עוקר נדר מעיקרו","נדר שידעו בו רבים לא יחזיר","כל נדר שצריך חקירת חכם","דר\"א ור\"מ באדם ואשתו בב\"ד"],"ר מ כל נדר שצריך חקירת חכם לא יחזיר":["אשה חשובה והחכם שהתירה","טב למיתב טן דו מלמיתב ארמלו","בעל נמוך בכסא החשובות","בעלה באומנות בזויה","הלך לחכם או רופא מקודשת","אם אין רוצה שתתבזה אשתו"],"ר ח מאדם גדול ר ש נשכה כלב ונעשה מקומו צ":["נשיכה כלב במקום מום","קול עבה באשה מום","בין דדי אשה מום","דדיים גסים מחברותיה מום","הפשילה דדיה והניקה","מומי אשה בדברי ר\"נ"],"ולציון יאמר איש ואיש יולד בה והוא יכוננה":["בני ציון עדיפים כתרי","הנולד בה והמצפה לראותה","כשעולה לארץ עדיף כשניים","בבלאי טיפשאי","בני ציון חילוק מעלה","הנולד בארץ והמתין לה"],"היו בה מומין ועודה בבית אביה האב צריך לה":["מומין בבית אביה לפני ארוסין","האב מביא ראיה על המומין","מומין שבגלוי ושבסתר","מרחץ והבודקת בקרובותיה","הבעל נאמן במומין","חזקת הגוף בטומאה"],"רישא אב מביא ראיה הא לא הבעל נאמן כרי ה ":["בהרת ושער לבן חזקת הגוף","הלך אחר חזקת הגוף","אם בהרת קודם לשער לבן","בבית האב כאן נמצאו","אין מפיה אנו חיין","רבי יהודה בחזקת הגוף"],"שמואל המחליף פרה בחמור ומשך בעל החמור את":["המחליף פרה בחמור ומשיכה","בעל החמור מביא ראיה","כלה בבית אביה ראיה","קידושין לטובתו","משיכת פרה וחמור שמת","חזקת החמור בשעת משיכה"],"האיש שנולדו בו מומין אין כופין אותו להוצ":["האיש שנולדו בו מומין אין כופין","מומין קטנים וגדולים","ר\"י נולדו וכ\"ש היו","היו אבל נולדו לא","רשב\"ג וכפייה בהוצאה","מומים שכופים להוציא"],"ר י תני נולדו וכ ש היו דסברה וקיבלה חב ר":["היו ונולדו מחלוקת ר\"י","היו אבל נולדו לא","סברה וקיבלה בכפייה","חב\"ר תני נולדו","מומין אחר הנישואין","אם נולדו אחר הנישואין"],"מומין גדולים רשב ג כגון ניסמית עינו נקטע":["מומין גדולים כגון סומא","הלכה כרשב\"ג במומין","מוכה שחין ובעל פוליפוס","אף שהתנה עמה","בכל מקום ששנה רשב\"ג","כופין להוציא מומין מסוכנים"],"בעל פוליפוס שמואל ריח החוטם במתניתא ריח ":["בעל פוליפוס ריח החוטם","המקמץ צואת כלבים","המצרף נחושת והבורסי","רב האומר איני זן","שמואל האכילו שעורים לאלעזר","מומין של מלאכה ופוליפוס"],"ר ח אין בעלי ראתן בבבל שאוכלין תרדין ושו":["בעלי ראתן ומצורעין בבבל","שאוכלין תרדין ושותין שכר","רוחצין במי פרת","בבבל אכילת תרדין","האם יש מצורעים בבבל","מנהג המצורעים בבבל"],"רישא שחלקו ב ש וב ה דהא בזכותה נפלו":["בית שמאי ובית הלל על נכסי אשה","בזכותה נפלו נכסים","לכתחילה לא תמכור","אם מכרה ונתנה קיים","כשנפלו נכסים מכירה","בית שמאי ובית הלל במכירה"],"רב ושמואל אמרו כרבותינו בין שנפלו לה נכס":["נפלו לה נכסים קודם או אחר האירוסין","הבעל מוציא מיד הלקוחות","לא כר\"י ולא כרחב\"ע","נכסי אשה נופלים לבעל","נפלו נכסים לאשה ונישאת","מוציא מיד הלקוחות"],"פשיטא דבנפלו לה כספים וחלוקים בינהם מה ל":["כספים לקנות קרקע או בית","בית ודקל בית","כשגזעו מחליף פרי","הגונב ולד בהמת מלוג","ר\"י לאשה תשלומי כפל","אילנות לעץ או לפרי"],"מר נ הכניסה עז לחלבה ורחל לגיזתה ותרנגול":["הכניסה עז לחלבה פירות","רחל לגיזתה ותרנגולת לביצתה","אוכל והולך עד שתכלה הקרן","המלח והחול פירות","פיר גפרית מחפורת צריף","מחוברין בשעת יציאה"],"ר כ מרב מחלוקת בשדה שאינה שלה":["מחלוקת בשדה שאינה שלה","בשדה שלה לא תמכור","מפני שבח בית אביה","מכירה בשדה שאינה שלה","קרקע של אשה שאינה שלה","שדה ומכירה בלא בית אביה"],"קימעא רבי אסי אפילו גרוגרת אחת והוא שאכל":["גרוגרת אחת אכילה בכבוד","אכלה דרך כבוד כאיסר","חבילי זמורות ושאכל","ערלה שביעית וכלאים חזקה","הוצאות על נכסי אשה קטנה","שיגרא דתמרי ואכילה"],"יבמה שנפלה ורצה האח הקטן לפוסלה ע י גט א":["יבמה שנפלה ופסילה בגט","האח הקטן מוכר נכסים","לא למכור ומכר לא מהני","שומרת יבם ונכסים מאה מנה","חלוץ תמורת חצי נכסים","לא ימכור שכל נכסיו אחראין"],"אביי וכל מקום שאמרו רבנן לא ימכור אף שמכ":["לא ימכור ומכירה מהניא","אביי ורב יוסף במכירה","רחב\"פ נזמים לשמועתו","רמבדר\"נ הדין עם אביי","הרי שנשה באחיו ומת","לא יאמר הואיל"],"אותו שנפלה לו יבמה במתא מחסיא ורצה אחיו ":["אחיו פוסל יבמה בגט","נתינת חצי נכסים מעכשיו","רמאי פומפדיתא","משוך פרה לאחר ל' יום","מעכשיו לעומת לאחר זמן","קניין מעכשיו ביבמה"],"בעו מעולא יבם ואח כ חילק מהו לא עשה ולא ":["יבם ואחר כך חילק לא עשה כלום","חילק ואחר כך יבם","תרי מעשים הוו","רבין מר\"ל לא עשה כלום","הלכה לא עשה ולא כלום","מעשה יבום וחליצה"],"החזירה הרי היא ככל הנשים ואין לה אלא כתו":["החזירה ככל הנשים ואין לה כתובתה","שמעון בן שטח ותיקן כתובה","בראשונה כתבו לבתולה מאתים","לא היו נושאין נשים","תקנת שמעון בן שטח","בית אביה והכתובה לבתולה"],"תני רבי חייא האומר לאשתו":["האומר לאשתו אי אפשי בתקנה","ידו כידה ידו עדיפא","שומרת יבם ליורשי הבעל","אי אפשי בתקנת חכמים","אמירה לאשה לוותר על כתובה","נחלה הבאה ממקום אחר"],"מי שמת והניח אשה ובע ח ויורשין והיה לו פ":["מי שמת והניח אשה ובעלי חוב","ר\"ט לכושל שבהם","ר\"ע אין מרחמין בדין","פירות תלושים הקודם זכה","זכתה אשה יותר מכתובתה","מותר של כתובה ובעל חוב"],"וצריכא מלווה להודיעך דר ע לא מודה לר ט":["מלווה ופקדון ר\"ע וריט","ר\"ע לא מודה לר\"ט במלווה","ר\"ט לא מודה לר\"ע בפקדון","ביאור מחלוקת מלווה ופקדון","שני מקרים במחלוקת ראשונה","הודעה לשני הדברים"],"כושל ריב ח לכושל שבראיה רי ו לכתובת אשה ":["כושל לכושל שבראיה או לכתובת אשה","ר\"ב לכושל שבראיה וכשר","ר\"א לכתובת אשה משום חן","כתנאי כושל ומשום חן","לכתובת אשה מחלוקת","משום חן לאשה בכושל"],"שבועה שהבעל פוטר את אשתו כרב על אפוטרופי":["שבועה שהבעל פוטר את אשתו","על אפוטרופיא שנעשית בחיי בעלה","על הפוגמת כתובתה","שבועה לאשה על הפוגמת","היורשים משביעים אותה","שבועה על פריעת כתובה"],"איבעיא פוגמת כתובתה בעדים מהו והוא טוען ":["פוגמת כתובתה בעדים מהו","נשבעין ולא משלמין","הפוגם שטרו שלא בעדים","נוטל בשבועה במשיב אבידה","פרע בעדים או בלא עדים","שבועה לפוגם שטר"],"ש מ כותבין שובר דאי לא ליחוש שמא תוציא כ":["כותבין שובר כשיש כתובה","רב מיירי במקום שאין כותבין","שמואל אף במקום שכותבין","ר\"ע משמואל עליו להביא ראיה","רב חזר בו גט גובה עיקר","כתובה ואין עמה גט"],"ר נ לר ה לרב דאמר גט גובה עיקר לא חוששים":["גט גובה עיקר וכתובה תוספת","שני גיטין ושתי כתובות","קורעים השטר וכותבים","שתי כתובות וגט אחד","כתובה וגט ומיתה","מגרש את אשתו והחזירה"],"ר ה מנה מאתים ולא תוספת ולר י בהוו א אף ":["מנה מאתים ולא תוספת","תוספת כתובה חידשו","תיובתא דרב יהודה","כתובתה קיימת על התוספת","בתולה מאתים ואלמנה מנה","המשנה הטעתו"],"קודמת ולא תני אין לה משמע דאי קדמה שניה ":["בעל חוב מאוחר שקדם וגבה","קודמת ולא תני אין לה","בן קודם לבת","תפסה ומוציאים ממנה","ראשונה קודמת לשניה","מה שגבה גבה לאיידי"],"ה רבה מצאנו לרבנן דרב שאמרו":["אחת בחייו ואחת במותו","בנין דכרין לשתי נשים","כבר קפצה נחלה","נשא את הראשונה ומתה","רב יוסף חלקו באחת בחייו","כתובת אמן ובניה"],"מי שהיה נשוי שתי נשים ומתו ואחר כך מת הו":["נשוי שתי נשים וכתובת אמן","חולקין בשוה או נוטלים","מותר דינר לכתובת אמן","נכסים בראוי אינן כבמוחזק","שמין את הנכסים בבית דין","נכסים שיש להן אחריות"],"לזו אלף ולזו ת ק אם יש שם מותר דינר אלו ":["לזו אלף ולזו ת\"ק בכתובות","מרובין ונתמעטו זכו יורשין","מועטין ונתרבו זכו","בני בר צרצור","כתובה קטנה ונידוי","כשם שמרובין כך מועטין"],"סימן אלף ומאה מצוה בכתובה יעקב זקף שדותי":["נשוי אלף זוז ושני בתים","שטר אחריות ללוקח","מכר בתים ולקח בעל חוב","באלף או בחמש מאות","סבר רב חנינא מתני'","הלכתא בחמש מאה"],"מי שהיה נשוי שלש נשים ומת כתובתה של זו מ":["נשוי שלש נשים ומת חולקין","כתובת מנה מאתים שלוש מאות","שלושה שהטילו לכיס","חלוקת כתובות לשלוש נשים","מנה חמשים מאתים","כיס פיחתו או הותירו"],"מי שהיה נשוי ד נשים ומת הראשונה קודמת לש":["נשוי ארבע נשים הראשונה קודמת","בן ננס נשבעת לשניה","יוצאות ביום אחד חולקות","כתיבת שעות בירושלים","הרביעית נפרעת בלא שבועה","היו כולן יוצאות בשעה אחת"],"א שמואל חלקו בשנמצאת אחת מהן שדה שאינה ש":["שמואל שדה שאינה שלו ובע\"ח","רנב\"א לכו\"ע מה שגבה לא גבה","יתומים שאמרו גדולים","אביי קשישא ובן ננס","שני אחים ושני שותפים בדין","מה שגבה גבה בן ננס"],"מי שהיה נשוי ב נשים ומכר את שדהו וכתבה ר":["נשוי שתי נשים ומכר שדהו","השניה מוציאה מהלוקח","אשה בעלת חוב וחוזרות חלילה","עד שיעשו פשרה","נחת רוח עשיתי לבעלי","גרושה שאיבדה כתובתה"],"כתבה מיירי בשקנו מידה ולא יכולה לומר נחת":["נחת רוח עשיתי לבעלי מחלוקת","לוקח אחד ומכירה אחרת","כולה כר\"מ בנחת רוח","אין נפרעין ממשועבדים","מכירה ללוקח שני כתבה","ר\"י יכולה לומר נחת רוח"],"איבעיא ניזונת תנן וכאנשי גליל ולא סגי דל":["ניזונת כאנשי גליל או יהודה","מלאכות אלמנה ליורשים","אלמנה עושה ליורשים חוץ ממזיגת הכוס","כל מלאכות העבד לרבו","ריב\"ל במלאכות העבד","לא מחוייבים כבעל"],"אלמנה בין מן האירוסין בין מן הנשואין מוכ":["אלמנה מוכרת שלא בבית דין","מהנשואין מוכרת משום מזונות","מהאירוסין רק בבית דין משום חן","גרושה לא תמכור אלא בב\"ד","גרושה שהיה חינה בעיני בעלה","שאין לה מזונות מגורשת"],"מהנשואין משום מזוני":["כשם שמוכרת שלא בב\"ד כך יורשיה","משום חן ומשום מזונות במכירה","גרושה שאין לה מזונות","מגורשת ואינה מגורשת","בעל חייב במזונות בגרושה","משום איבה ומשום חן"],"מכרה כתובתה או מקצתה משכנה כתובתה או מקצ":["מכרה כתובתה או מקצתה רק בב\"ד","מוכרת ארבע וחמש פעמים","מוכרת למזונות שלא בב\"ד","כתובה אפותיקי לאחר","מקצת כסף ככל כסף","אבדה מזונותיה לרבי שמעון"],"מתני ר ש דתניא מכרה כתובתה משכנה כתובתה ":["מקצת כסף ככל כסף מחלוקת","בתולה במקצת בתוליה","בוגרת שכלו בתוליה","ר\"א ור\"ש מכשירין בבוגרת","מוכרת כתובה לאחר","הפסוק בתולה ובתוליה"],"שלח רבד ר לרב יוסף מוכרת שלא בב ד צריכה ":["מוכרת שלא בב\"ד שבועה או לא","הכרזה ושמה לעצמה","מי שם לך מספוא יתומים","הלכתא צריכה שבועה","אלמנה ששמה לעצמה","שבועה ולא הכרזה"],"אלמנה שהיתה כתובתה מאתים ומכרה שוה מנה ב":["אלמנה שמכרה כתובתה בחלק","מכרה בטל מנה ודינר","רשב\"ג מכרה קיים בשיעור","תשעה קבין ובגנה חצי קב","מכרה לזה ולזה האחרון בטל","אלמנה ומכירה מעל השווי"],"בשוה מאתים במנה דאמרי לה את אפסדת":["שוה מאתים במנה אמרי לה אפסדת","שוה מנה במאתים אנא ארווחנא","הכל לבעל המעות","הכל לשליח לר\"י","דבר שיש לו קצבה חולקין","דבר שאין לו קצבה לבעל המעות"],"שום הדיינין שפיחתו שתות או הוסיפו שתות מ":["שום הדיינין שפיחתו שתות בטל","רשב\"ג מכרן קיים","אגרת בקורת ביניהם","שליח כדיינין שלא לעצמן","שליח כאלמנה בטעות בטל","שליח יחיד ובית דין רבים"],"שליח רבא מר נ שליח כדיינין שלא לעצמן לאפ":["שליח כדיינין שלא לעצמן","שליח שפיחת תרומתו תרומה","שליח כאלמנה ובטעות","הלכה כחכמים בשליח","יתומים שהגדילו אין יכולין למחות","אפוטרופוס שהעמידו"],"רב תני קטנה יוצאה בגט אין לה כתובה וכ ש ":["קטנה יוצאה בגט אין לה כתובה","ממאנת אין לה כתובה","שמואל יוצאה בגט יש לה כתובה","ממאנת לא פסלה מהאחין","ממאנת אינה צריכה להמתין","ר\"א אין מעשה קטנה כלום"],"ר ג מרב כמה אתה נותן לבנך בתך כך וכך עמד":["כמה אתה נותן לבנך קנו בדברים","דברים הנקנים באמירה","הכתיבה והאמירה בשידוך","רב אשי לא ניתנו לכתוב","אין כותבין שטרי אירוסין","אמירה לאשה ולאיש"],"אם טענה מפני שהיא ילדה והן ילדים זנין או":["אם טענה שהיא ילדה זנין אותה","משתמשת במדור בעבדים ושפחות","ואת תשבי בביתי","בביתי לא בבקתי","יתומים שמכרו מדור אלמנה","משעבדי לה מחיים"],"גם ענייה שבישראל וגם מרתא בת בייתוס עד כ":["עניה ומרתא בת בייתוס עד כ\"ה שנים","לפום גמלא שיחנא","לר\"מ מהו שתשלש","שתשלש תיקו","פרנסה לעניה לכ\"ה שנים","מרתא בת בייתוס"],"המודר הנאה מחבירו":["המודר הנאה שוקל שקלו ופורע חובו","תורמין על האבוד ועל הגבוי","מחזיר אבידתו מצוה","ר\"א משתרשי כחנן","שלוה על מנת שלא לפרוע","מודר הנאה ותפול הנאה להקדש"],"אביי ה ק בשביל שאני זכר וראוי לעסוק בתור":["אביי בשביל שאני זכר הפסדתי","לא עוסק בתורה לא יורש","בנכסים מרובין ומועטין","בשביל שאני זכר וראוי לירש","רבא דחה את אביי בירושה","זכר שנכסיו מרובים"],"ש מ לרבנן טענו חטין ושעורין והודה בשעורי":["טענו חטין ושעורין והודה בשעורין","טענו חטין ושעורין פטור","רבא טוען מלא עשרה כדי שמן","עשרה כדי שמן בבורך","שמן טוען ולא קנקנים","מודה במקצת הטענה"],"הפוסק מעות לחתנו ופשט לו את הרגל תשב עד ":["הפוסק מעות לחתנו ופשט את הרגל","תשב עד שתלבין ראשה","אדמון מה אני יכולה לעשות","רבן גמליאל רואה אני את דברי אדמון","כנוס או פטור","פסקה על עצמה מחלוקת"],"מתני לא כריב י דס ל לא נחלקו אדמון וחכמי":["אדמון וחכמים בפוסק מעות לחתן","כסבורה אני שאבא נותן עלי","רואה אני את דברי אדמון","בקטנה כופין לבעל ליתן גט","כל מקום שאמר ר\"ג רואה אני","מחלוקת אדמון וחכמים בפשיטת רגל"],"אביי דווקא עד אבל דיין לא איבד את זכותו":["עד איבד זכותו ודיין לא","העדים חותמין אחרי קריאה","הדיינין חותמים שלא קראוהו","דיין שחתם בלא קריאה","עד ודיין בחתימה על שטר","חתימת דיין על שטר שלא נקרא"],"רב כגון שהקיפוה ד בנ א מד רוחותיה ויקשה ":["שהקיפוה ארבע בני אדם מארבע רוחות","ד' שבאו מכח ד' וד' מכח א'","חד שבא מכח ד' לאדמון","דרך יש לי אצלך","אי שתקת שתקת לרבנן","הדקל לבתו וחילקו היתומים"],"שנים שהוציאו שטר חוב זה על זה":["שנים שהוציאו שטר חוב זה על זה","אדמון כיצד אתה לוה ממני","זה גובה שטר חובו וזה גובה שטר חובו","חכמים גובה כל אחד שטרו","שטרות חוב הדדיים","מחלוקת אדמון וחכמים על שטרות"],"מכרך לעיר דבכרך מצוי כל דבר משא כ בעיר":["מכרך לעיר דבכרך מצוי כל דבר","מעיר לכרך ישיבת כרכים קשה","ריב\"ח ישיבת כרכים","ויברכו העם למתנדבים לשבת בירושלים","מעבר מעיר לכרך","שבת בירושלים מעדיפה כרך"],"הכל מעלין לארץ ישראל ואין הכל מוציאין":["הכל מעלין לארץ ואין הכל מוציאין","נשא אשה בא\"י וגרשה בקפוטקיא","מעות ארץ ישראל לגירושין","רשב\"ג ממעות קפוטקיא","לאתויי עבדים","כל מעלין לירושלים לאתויי"],"הכל מעלין לאתויי עבדים":["הכל מעלין לאתויי עבדים","מנוה היפה לנוה הרעה","עבד שברח מחו\"ל לארץ","מכור כאן ולך משום ישיבת ארץ","הוא אומר לעלות והיא לא","כופין אותה לעלות או תצא"],"ת ר לעולם ידור אדם בא י אף בעיר שרובה עכ":["לעולם ידור אדם בארץ ישראל","הדר בארץ כמי שיש לו אלוה","הדר בחוץ לארץ כעובד עכו\"ם","כי גרשוני מנחלת ה'","דוד ועבודה זרה בחוץ לארץ","גר בארץ ישראל אף בעיר נכרים"]}