{"המביא גט ממדינת הים ואינו יכול לומר בפ נ":["גט ממדינת הים בעדים וחותמיהם","גט ממדינת הים ואמירת פ\"נ ובפ\"נ","שווין גיטי נשים ושחרורי עבדים","אחד גיטי נשים ושחרורי עבדים","הדרך השווה לגיטין ולשחרורים","מביא גט מחוץ לארץ ועדיו"],"בנתנו פיקח ולא הספיק לומר בפ נ ובפ נ עד ":["נתינת גט לפיקח שנתחרש","פיקח שנתחרש בשעת מסירת הגט","הספק לומר פ\"נ אחר שנתחרש","מסירה לפיקח שנתחרש לפני אמירה","גט שנתן פיקח ונתחרש מיד","חרשות לאחר נתינה ואמירת פ\"נ"],"כל גט שיש עליו עד כותי פסול חוץ מגיטי נש":["גט עם עד כותי פסול","הכשרת גט בעדי כותים","מעשה ר\"ג בכפר עותנאי","כותי פסול לגט חוץ מנשים ועבדים","מעשה ר\"ג שהכשיר עדים כותים","עדות כותים בגיטי נשים ושחרורי עבדים"],"הכשירו רק בעד אחד כותי בלבד":["עד אחד כותי אחרי מעשה ר\"ג","מחלוקת אביי ורבא בעדי כותים","לעולם שנים ולא עד אחד","ר\"ג מכשיר בשני עדים כותים","תני עדו או לעולם תרי","הכשר גט בשני עדים כותים"],"כל השטרות העולים בערכאות עכו ם אף שחותמי":["שטרי ערכאות העכו\"ם והכשרם","ר\"ש מכשיר שטרי עכו\"ם הדיוטות","דינא דמלכותא בשטרי עכו\"ם","מכר בנתינת כסף ושטר ראייה","שמואל: דינא דמלכותא דינא","שטרות שנעשו בערכאות ודינם"],"במכר משנתן כסף קנה והשטר ראייה בעלמא ולא":["מכר בנתינת כסף קנה","קניין מכר בכסף ולא בשטר","שטר ראייה בעלמא במכר","השטר אינו מרע נפשם","מתנה במעשה שמואל ודינא דמלכותא","תני חוץ מגיטי נשים בשטרי עכו\"ם"],"האומר תן גט זה לאשתי ושטר שחרור זה לעבדי":["חזרה מגט ושחרור שנתן לשליח","האומר תן גט לאשתי: חזרה","ר\"מ וחכמים בחזרה מן הנתינה","זכין שלא בפניו וחבין בפניו","זיכוי ושליחות לאדם שלא בפניו","הפוסל את עבדו מן התרומה"],"ש מ מרבנן התופס לבע ח קנה ואפי בחב לאחרי":["תופס לבעל חוב קנה","מחלוקת ר\"א וחכמים במלקט פאה","התופס במקום שחב לאחרים","כל האומר תנו כאומר זכו","לא תלקט לעני אבל כאן לא","זכייה בנכסי המפקיר לחבירו"],"האומר תנו גט זה לאשתי שטר שחרור זה לעבדי":["נתינת גט ושחרור לאחר מיתה","תנו מנה לפלוני לאחר מיתה","מנה סתם ומנה קבור","צבורין בקרן זוית ודין מסוכן","בריא ושכיב מרע בנתינה לאחר מיתה","במעמד שלשתן קנה"],"והוא שצבורין ומונחין בקרן זוית":["לקבורה לא חיישינן במנה","מנה קבור ואמירת תנו","שכיב מרע ונתינה במעמד שלשתן","ושכיב מרע שלא אמר תנו","המפרש והיוצא בשיירא","ר\"ש שזורי והמסוכן"],"ידים טהורות לחצאין או לא":["טהרת ידים לחצאין","נטילה ביד אחת ושנייה בשטיפה","משקה טופח ואינו חיבור לטומאה","טופח להטפיח ולעניין מקוה","צירוף לנטילה אחת","חצי יד ונגבה ושוב מחצית"],"הבא ראשו ורובו במים שאובין וטהור שנפלו ע":["מים שאובין על ראשו ורובו","שלוש לוגין מים שאובין טמא","טבילה במים שאובין על רוב הגוף","הבא ראשו ורובו במים","מים שאובין שנפלו על הראש","שיעור מים שאובין לטומאה"],"אחד אומר בפני נכתב ושנים אומרים בפנינו נ":["עדי כתיבה ועדי חתימה בגט","שנים אומרים בפנינו נכתב","גט מחוץ לארץ ואמירת פ\"נ","יתד שלא תמוט בעדי חתימה","ר\"י מכשיר בגט יוצא מתחת ידי שניהם","חזרה ממדברים ראשונים בעדות"],"נכתב ונחתם ביום נכתב ונחתם בלילה בלילה ו":["גט שנכתב ביום ונחתם בלילה","כתיבה ביום וחתימה בלילה פסול","ר\"ש מכשיר גט שנכתב ביום","זמן כתיבה וחתימה בגיטין","גיטי נשים שנחתמו בלילה","כשר בלילה ביום לגט"],"כתובה כמעשה ב ד נכתבת ביום ונחתמת בלילה":["כתובה שנכתבה ביום ונחתמה בלילה","כתובת רחב\"ר ועיסוק באותו ענין","כתובה כמעשה ב\"ד","דעסוקין באותו ענין כשר","כראב\"צ ולא כשמואל בכתובה","כתיבה וחתימה בזמנים שונים בכתובה"],"כתבו גט לאשתי חתמו שנים באותו יום והשאר ":["חתימה עד עשרה ימים בגט","שנים חתמו ביום והשאר אחרים","הסמכה על עדים בשעת הדחק","ר\"י: כשר אחר עשרה ימים","ר\"ל: כולם משום עדים","כתיבת גט ודחיית חתימה"],"בכל כותבים":["חומרי כתיבה לגט וסוגיהם","אין כותבין במשקין ובמי פירות","כתיבה על עלה של זית ועל קרן פרה","ריה\"ג: אין כותבין על בעלי חיים","כתיבה על דבר שיש בו רוח חיים","כתיבה במה שמתקיים"],"דיו סם סיקרא צבע מגן אדום קומוס משרף קנק":["פירוש חומרי הכתיבה: סם וסיקרא","קומוס משרף וקנקנתום של סנדלרים","צבע מגן אדום בכתיבת הגט","הגדרת דיו וסם בכתיבה","שמות חומרי הכתיבה הקדומים","קנקנתום שחור לסנדלרים"],"נתן לה נייר חלק וא ל ה ז גיטך מגורשת מספ":["נייר חלק שנאמר לו הרי זה גיטך","בדיקה במי נרא לגט שלא נכתב","גט ספק בנייר חלק","אבד הגט בלי רישום ניכר","שטר פסים ושטר אמנה","זורקו לים ונאמר שטר אמנה"],"וכתב ולא חקק שאינה כתיבה":["כתיבה ולא חקיקה בשחרור עבד","עבד שיצא בכתב על טבלא","לא בכתב על כובע צמר ותכשיט","חק תוכות סביבן לא מהני","חקיקת יריכות קוי האותיות מועילה","כתב שאינו חקיקה בגט"],"רושם מטבע מיחרץ סביבות הצורה חק תוכות דפ":["גט חקוק כמטבע ודינר זהב","חק תוכות פסול לגירוש","גירושין בחקיקה בולטת","הבולט והשקוע בחקיקה","מטבע שמחוץ לצורה","חקיקת יריכות כשרה"],"כתב גט על טס זהב נתקבלה גיטה ונתקבלה כתו":["גט על טס זהב ונתקבלה כתובה","התקבלי גיטך והשאר לכתובתך","אין שאר ואויר מגילה","אם לא אמר לה לא","דיש שאר לגט על מגילה","שאר הכתובה בגט זהב"],"מוחזקים בעבד שהוא שלו וגט כתוב על ידו וי":["גט כתוב על יד עבד ויוצא מידה","סימן הקנאה או כתיבה להזדייף","עדי מסירה בכתובת קעקע","הגודרות אין להן חזקה","תיפו\"ל בגט על יד העבד","כתיבה שיכולה להזדייף"],"מוחזקין בטבלא דף שהיא שלה וגט כתוב עליה ":["גט כתוב על טבלה שהיא מוחזקת בה","זקן שהלוה לכל הכפר","אשה שאינה יודעת להקנות","מערב היוצא אחר חתימת העדים","השטר של האיש ושובר הגט","קיום הגט רק בחותמיו"],"כתב לה גט ונתנו ביד עבדו וכתב לה שטר מתנ":["גט ושטר מתנה ביד עבד","חצר מהלכת אינה קונה","כפות דחצר לקנין גט","עומד ויושב לא קנה","שכל שמהלך לא קנה","קנין בכפות ידי העבד"],"אין כותבין במחובר לקרקע":["כתיבה במחובר לקרקע ותלישה","כתיבת טופס ותורף לשטרי מסירה","כתיבה על חרס של עציץ נקוב","אביי ורבא בעלה של עציץ","גזירה שמא יקטום","נייר מחוק ודיפתרא שמזדייף"],"דכתבו על המחובר כששייר מקום התורף וכר א ":["כתיבה לטופס ולתורף ותלישה","עדי מסירה כרתי בטופס","ר\"מ: עדי חתימה כרתי","כתבו על המחובר ששייר תורף","כשר שלקח ונתן לו בעציץ","שמא יכתוב תורף"],"וחכמים מכשירין היינו ר א דעדי מסירה כרתי":["הכשר גט לאלתר ולא לעשרה ימים","שמא היה תנאי ומחקן","גיטין ולא שאר שטרות בזמן","למען יעמדו ימים רבים","ר\"א דעדי מסירה כרתי","כשר לאלתר בשטר ראייה"],"הכל כשרין לכתוב את הגט אפי חרש שוטה וקטן":["מי כשר לכתוב גט: חרש ושוטה וקטן","האשה כותבת גיטה והאיש שוברו","גוי לכתיבת גט על דעת עצמו","גדול העומד על גביו","כתיבה לשמה בגוי פסול למסירה","כשרות הכותב בגט"],"רק בגדול עומד על גביו שאינם בני דעה":["גוי על דעת עצמו מכוון בכתיבה","גדול עומד על גביו של קטן","למתני' דר\"מ גוי כשר","דווקא לגבי הבאה פסול גוי","שאני גוי שעל דעת עצמו","כשר בכתיבה ופסול בהבאה"],"הכל כשרין להביא את הגט חוץ מחש ו וסומא ו":["מי כשר להביא גט: תחילה וסוף בדעת","קיבל הקטן וחזר ונתפקח","פתוח ונסתמא וחזר ונתפתח","שפוי ונשתטה וחזר ונשתפה","סומא שאינו יודע ממי נוטלו","כל שתחילתו וסופו בכשרות"],"חש ו לאו בני דיעה גוי לאו בר היתר הוא":["חש\"ו ושוטה בהבאת גט","סומא מותר בטביעות עין","כאן בחו\"ל צריך בפ\"נ","פתוח ונסתמא כשר","דייק חזר ונתפתח","זה הכלל לכשרות שליחות גט"],"עבד מהו שיעשה שליח לקבל גט אשה מיד בעלה":["עבד שליח לקבל גט מיד בעלה","עבד מקבל גט לחבירו מרבו","שפחה מעוברת שזכתה לה בנה","עובר ירך אמו כאבר","שחרור חצי עבד כרבי","שליח עכו\"ם וכותי בתרומה"],"אף הנשים שאינן נאמנות לומר מת בעלה נאמנו":["נאמנות להביא גט ולא לומר מת","אשה מביאה גיטה בפ\"נ","מה בין גט למיתה: הכתב מוכיח","נאמנת בחו\"ל ולא בארץ","רשב\"א מר\"ע: מק\"ו לנשים","בעל מערער ולא משגיחים בו"],"דכשם שאין נאמנות לומר מת בעלה כך אין נאמ":["שלא על דיבורה אנו סומכים","בארץ אי בעל מערער נאמן","מציעתא בארץ ולא שהכתב ופה","רישא וסיפא בחו\"ל","קלקול אשה שמתכוונת לקלקל","אשה נאמנת מק\"ו משאר נשים"],"כתב לגרש את אשתו ונמלך":["נמלך בגירושין אחר כתיבה","סופרים המתלמדים בכתיבת גט","מקרין ולא קוראין בלימוד סופרים","כתב גט ונמלך בגירוש","גט שנכתב ללימוד ולא לגירוש","הכתיבה להתלמד ואינה גט"],"וכתב אפי עושה לשום כריתות בעינן לשם בעל":["כתיבה לשם בעל בגט","גם לשם כריתות צריך לשם בעל","וכתב לשם הבעל בלבד","כתיבה לשם האיש","לשם בעל ולא לשם אחר","הכתיבה חייבת לשם הבעל"],"לה שיכתוב לאשה ואפי יש לו שני נשים":["גט לה: לאשה מסוימת","שתי נשים ואין ברירה בגט","לאיזה שארצה אגרש פסול","אין ברירה בגירושין","כתיבה לשם אשה אחת בלבד","אשה שאינה ברורה בגט"],"טופסי גיטין צריך שיניח מקום האיש האשה וה":["טופס גט עם מקום ריק לשמות","שטרי מלוה וטופס ריק במקומות","ר' יהודה פוסל טופס בכולן","ר' אלעזר מכשיר חוץ מגיטי נשים","וכתב לה לשמה בטופס","מפני התקנה בטופסי שטרות"],"המביא גט ואבד הימנו מצאו לאלתר כשר ואם ל":["גט שאבד ונמצא מיד כשר","גט שנמצא בחפיסה או בדלוסקמא","שני תנאים לגט שנמצא","שיירות מצויות והוחזקו בשני","גט שנמצא בבית הפשתן בפומבדיתא","מצא גט בזמן שהבעל מודה"],"דמצא גיטי נשים שחרורי עבדים דייתיקי מתנו":["מצא גיטי נשים ויחזיר לאשה","מצא גט לזמן מרובה","כל מעשה ב\"ד יחזיר לאשה","שיירות מצויות ושאלת רבה","אינו לאלתר פסול בשיירות","במקום שמוכרים הכותנה"],"המביא גט והניחו זקן או חולה נותן לה בחזק":["חזקת חיים לזקן וחולה בגט","בת ישראל לכהן ובעלה במדינת הים","שולח חטאתו ממדינת הים","זקן שהגיע לגבורות אינו בחזקה","תיובתא: בן מאה שנה","גט שעה אחת קודם מיתה"],"דווקא זקן שלא הגיע לגבורות וחולה שרוב חו":["כיון דהפליג הפליג","חוששים שמא תמות קודם בעלה","ר\"מ: דלא חייש למיתה","ר\"י: דחייש למיתה ביין הכותים","שני לוגין שאני עתיד להפריש","שמא מת לא חיישי"],"שלשה דברים אמר רבי אלעזר בן פרטא לפני חכ":["שלושה דברים בחזקת קיימין","עיר שהקיפה כרקום","ספינה המוטרפת והיוצא לידון","עיר שכבשה כרקום לא חזקה","חומרי חיים וחומרי מתים","בת ישראל לכהן בתרומה"],"משלחו ביד אחר דווקא בחלה אונס":["שליח עושה שליח בגט","שלוחו ביד אחר בחולי אונס","כרשב\"ג: אין שליח עושה שליח","את הולך לא ישלחנו ביד אחר","הולך וחלה שאני","בשניהם אין שליח עושה שליח"],"המביא גט ממדינת הים וחלה":["שליחות בבית דין לגט מחוץ לארץ","שליח אחרון אינו צריך פ\"נ","אומר שליח ב\"ד אני","חלה המביא גט ממדינת הים","משלחו בב\"ד לפניהם","אמירה בפ\"נ לשליח הראשון"],"המלוה מעות את הכהן ואת הלוי ואת העני להפ":["הלוואה לכהן ללוי ולעני להפרשה","מפריש בחזקת שהן קיימין","מתו ויש ליטול רשות מיורשים","הלוואה בפני בית דין ללא רשות","הפרשה מכספי הלוואה לכהן","חזקת קיום לכהן שהלווה לו"],"ישראל שאמר ללוי יש לך בידי":["תרומת מעשר בכור ובמעשר","יש לך בידי מעשר לא חוששין","כור מעשר חוששין לתרומה","כך אמר לי אבא לוי","קץ ותיקון בעל הבית בתרומה","ונחשב לכם תרומתכם"],"הגיע ולא הגיעו דאף ממילא ולא אמרינן דלצע":["ביטול גט לפני שהגיע לידה","הגיע ולא הגיעו: אף ממילא","שליח שני מבטל את הראשון","קדם הוא אצל אשתו","אם משהגיע גט לידה אינו מתבטל","לא אמרינן אגלאי מילתא למפרע"],"בטל הוא אי איפשי בו דבריו קיימין דלשנא ד":["בטל הוא, אי איפשי בו בגט","לשון בטל במתנה ובגט","שליח מתנה כשליח הגט","להולך לאו כזכי דמי","אמר לא אמר כלום ביטול","דבריו קיימין מעיקרא"],"והלכתא כנחמן דכרבי בביטלו דלא כתקנת רשב ":["הלכה כנחמן: ביטול בדיעבד","כרבי ולא כתקנת רשב\"ג","בטל בדיעבד ודאפשר לבטל","ביטול מן המנויים שלא בפני כולם","הלכתא כנחמן בביטול גט","תקנת רשב\"ג בביטול"],"והלכתא כנחמני כאביי דגילוי דעת בגט אינו ":["גילוי דעת אינו מבטל גט","הלכה כאביי בגילוי דעת","גילוי דעת בגט לא מועיל","ביטול גט בגילוי דעת","כאביי: אין גילוי דעת מבטל","בגט אין ביטול בגילוי דעת"],"בראשונה היה משנה שמו ושמה שם עירו ושם עי":["תיקון ר\"ג: שם הבעל וכל שום","הבאים מארץ ישראל ושני שמות","גירושין בשם שהוחזק","שתי נשים ושתי שמות","גט בשם יהודה ובשם גליל","הוחזק בשני השמות"],"הבאים מא י לכאן שמו יוסף וקוראין לו יוחנ":["יוסף וקוראין לו יוחנן בגט","תיקון העולם בשם הבעל","רבי מרי ורבי אלעזר כמותך","שם דגליל עמו הא דאתחזק","אשתו שביהודה ואשתו שבגליל","מגורשת לאחר שני השמות"],"אותה שקרו לה מרים וקצת שרה":["שם האשה בגט: מרים ולא שרה","קצת שרה וכל שום שיש לה","קרויה מרים בשם הגט","שם האשה בכתיבת הגט","כל שום שיש לה באשה","שמה של האשה בגט"],"אין אלמנה נפרעת מנכסי יתומים אלא בשבועה":["אלמנה נפרעת מנכסי יתומים בשבועה","נודרת ליתומים וגובה כתובה","תקנת ר\"ג: עדים חותמים על הגט","הלל התקין פרוזבול","תיקון העולם בכתובה","העדים חותמין על הגט"],"אלמנה וכל בע ח וקמ ל דלא לימא דמשום חן ה":["לא משום חן הקילו רבנן","אלמנה וכל בעל חוב בפרוזבול","קמ\"ל שלא יאמר משום חן","הקלה לאלמנה ולבעלי חוב","טעם הקלה: תיקון לא חן","הקילו רבנן לאלמנה"],"אם אין לו קרקע ולערב יש קרקע כותבין עליו":["פרוזבול כשאין לו קרקע","לערב יש קרקע וכותבין פרוזבול","לחייב יש קרקע ולו אין","ונתן לאשר אשם לו","נושה בחברו מנה וחברו בחברו","מוציאין מזה ונותנין לזה"],"שביעית משמטת המלוה בין בשטר בין שלא בשטר":["שביעית משמטת מלוה בשטר","שטר שיש בו אחריות נכסים","סיים לו שדה אחת לא משמט","כתב כל נכסיי ערבים לך","רי\"ו: משמט גם בשטר","שטר העומד לגבות כגבוי"],"היה חייב זוזי לרבה והביא לו בשביעית וא ל":["מעשה רבה ושמיטת הכסף","משמט אני והלך לחייב","רבה עצוב ואב\"מ","אעפ\"כ אמר ורבה לקח","לא היה דעת באב\"מ מתחילה","ספר המעשה לרבה"],"עבד שנשבה ופדאוהו אם לשום עבד ישתעבד":["עבד שנשבה ופדוהו לשם עבד","לפני יאוש ולאחר יאוש","רשב\"ג: בין כך ובין כך ישתעבד","שלא יפיל עצמו לגייסות","כשם שמצוה לפדות בני חורין","קנין לרבו שני בשבאי"],"לעולם לפני יאוש ולשום עבד ישתעבד לרבו רא":["אביי: לפני יאוש היינו כשם","רבא: לאחר יאוש כדחזקיה","שייך קנין לרבו שני","שקנה משבאי למעשה ידיו","אתם קונים מהם ולא הם מכם","מצוה לפדות את העבדים"],"המפקיר עבדו יצא לחירות וצריך גט שיחרור":["המפקיר עבדו וצריך גט שחרור","עבדים קטנים וגדולים שקנו עצמן","הלכה כאבא שאול בעבד","נתייאשתי מפלוני עבדי","לה לה מאשה: דבשטר","אין לו תקנה אלא בשטר"],"האומר עשיתי עבדי עשוי הרי הוא בן חורין ה":["עשיתי עבדי עשוי: לרבי קנה","אעשנו בן חורין וחכמים לא קנה","שחרור בדברים ללא שטר","אמירה לשחרור עבד בשטר","וכולן בשטר: שחרור ומתנה","האומר עבדי עשוי"],"האומר נתתי נתונה הרי היא שלו שדה פלונית ":["נתתי נתונה: שדה לפלוני","ר\"מ: קנה בדברים","חכמים: לא קנה בלא שטר","אתננה לפלוני בשדה","ארי\"ו: וכולן בשטר","נתינת שדה בדברים בלבד"],"ר ח נותן אוכל פירות רבה משלשין הפירות עד":["שילוש פירות עד שיבוא אליהו","נותן אוכל פירות לאבא","הא באבא הא בבן המקבל","ר\"ח ורבה בפירות","פירות בין אב לבן המקבל","אוכל פירות בשלישית"],"עבד שעשאו רבו אפותיקי לאחרים ושיחררו":["עבד אפותיקי ששוחרר לאחרים","כופין את רבו לשחרר מפני תיקון","שטר על דמיו לרבו השני","רשב\"ג: אינו כותב אלא משחרר","הקדש חמץ ושחרור מפקיעין שיעבוד","שמא ימצאנו בשוק ויאמר עבדי"],"ושיחררו רבו ראשון שחררו":["ושיחררו רבו ראשון שחררו","רבו שני ושחרור מפקיע שיעבוד","מפני תיקון העולם בעבד משועבד","שורת הדין אין העבד חייב","כופין את רבו שני לשחרר","עבד שיצא עליו שם בן חורין"],"כופין את רבו שני ועושהו בן חורין וכותב ע":["עבד מזיק ששיעבודו של חברו","בהיזק שאינו ניכר שמיה היזק","עולא ורב: שני אינו רבו","שחררו רבו שני ושיעבוד במצוות","כופין את רבו ראשון וכותב שטר","אינו כותב אלא משחרר כותב"],"מי שחציו עבד וחציו בן חורין":["חציו עבד וחציו בן חורין","עובד את רבו יום ואת עצמו יום","ב\"ש: תקנתם את רבו ואת עצמו","לישא שפחה אי אפשר","כופין את רבו ועושה בן חורין","חזרו ב\"ה להורות כב\"ש"],"המוכר עבדו לעכו ם או לחוצה לארץ יצא בן ח":["מכר עבדו לעכו\"ם יצא לחירות","צריך גט שחרור מרבו ראשון","כתב עליו אונו זהו שחרורו","אונו: לכשתברח ממנו","ר\"ש: אין לי עסק בך","עבד שנמכר לחוצה לארץ"],"המוכר עבדו לעכו ם יצא לחירות וצריך גט שח":["כתב עליו אונו זהו שחרורו","אונו בעבד הנמכר לעכו\"ם","בלא כתב עליו אונו לא יצא","לכשתברח ממנו אין לי עסק","שחרור בעבד שנמכר לנכרי","אין עסק עם עבד שברח"],"אין פודין את השבויין יתר על כדי דמיהן מפ":["פדיית שבויים יתר על כדי דמיהן","אין מבריחין את השבויים","רשב\"ג: מפני תקנת השבויין","דוחק הצבור בפדיון","פדה לבתו בסכום גדול","שלא ברצון חכמים עשה"],"מפני תיקון העולם משום דוחק הצבור או כדי ":["פדה לבתו בסכום גדול","דוחק הצבור ושלא יבקשו יותר","שאפשר שלא ברצון חכמים","פדיון שבויים ותקנת הציבור","תיקון העולם בפדיון שבויים","משום דוחק הציבור"],"ואין לוקחין ספרים תפילין ומזוזות מן העכו":["לקיחת ספרים ותפילין מן העכו\"ם","ספר תורה ביד עכו\"ם: יגנז או קורין","ספר תורה שכתבו מין ישרף","יתר על כדי דמיהן אין לוקחין","מין נמצא ביד עכו\"ם יגנז","ספר שנמצא ביד עכו\"ם לגנוז"],"יתר על כדי דמיהן אין לוקחין הא בכדי דמיה":["שמא היינו לגנוז ספר תורה","ר\"נ: ספר מין ישרף","כתבו עכו\"ם יגנז","ביד מין יגנז ביד עכו\"ם","י\"א יגנז וי\"א קורין בו","מסחר בספרי קודש מעכו\"ם"],"המוציא את אשתו משום שם רע לא יחזיר משום ":["החזרה לאשה אחר גירוש משום נדר","כל נדר שידעו בו רבים","נדר שצריך חקירת חכם","מעשה בצידן: קונם אם איני מגרשיך","ר\"ל: לא אסרו אלא מפני זה","המוציא משום שם רע"],"המוציא את אשתו משום אילונית לר י לא יחזי":["המוציא משום אילונית לא יחזיר","שתיקותיך יפה מדיבוריך","נישאת לאחר והיו לה בנים","ר\"י חייש לקלקול","רבנן לא חששו לקלקול","בצריך שאלת חכם כר\"א"],"דר י חייש לקלקול ורבנן לא חששו לקלקול":["לא תיפוך: חשש קלקול בגירושין","חכמים: ר\"מ דבעי תנאי כפול","ולכן מגורשת בתנאי כפול","שאינו רוצה שתתבזה בב\"ד","ר\"א ור\"מ בצריך שאלת חכם","נדר ידוע לרבים בהחזרה"],"המוכר את עצמו ואת בניו לעכו ם אין פודין ":["מכר עצמו ובניו לעכו\"ם","אין פודין אותו אלא הבנים","פדיון הבנים לאחר מיתת האב","מכר ושנה ושילש","מכירה חוזרת שלוש","בנים שנפדים לאחר מיתה"],"כשאכל ושתה א ל ביתו אם רוצה כר לשכב עליו":["כר לשכב בבטן הסובע","בתי בטני כרי","הסבא שאכל ושתה ואמר כר","מעשה באוכל ושותה ואומר כר","דברי בתו על הכר","בטן כר למי שאכל"],"כשנפטר הניח קב כורכום וקרא על עצמו ועזבו":["קב כורכום לפטירה","ועזבו לאחרים חילם","קריאת הפסוק בעת הפטירה","הניח קב כורכום בעת פטירה","מעשה בפטירה וקריאת פסוק","עזיבת הנכסים לאחרים"],"מוכר שדהו לגוי לוקח ומביא ממנו בכורים מפ":["בכורים משדה שנמכרה לגוי","קנין לגוי בארץ להפקיע ממעשר","קדושת הארץ לא מתבטלת במכר לגוי","חפירת בורות בארץ לגוי","דגנך ולא דגן עכו\"ם","הלקט והשכחה של גוי חייבין במעשר"],"אף שאין קנין לעכו ם בארץ ישראל להפקיע ממ":["קנין לגוי בא\"י להפקיע ממעשר","השמים שמים לה והארץ נתן לבני אדם","דגן עכו\"ם ומעשר","ליקט גוי של ישראל מופקר","ישראל שלקח שדה גוי עד שלא הביאה שליש","כיבוש יחיד אין שמו כיבוש"],"לעולם מתני ר ע דמדאורייתא בדמזיק שיימינן":["נזיקין נגבים בעידית מפני תיקון","בעל חוב בבינונית ולא בזיבורית","מיטב שדהו ישלם","ר\"ע: בדמזיק שיימינן מדאורייתא","גזלנים וחמסנים בגביית חוב","אקפוץ ואלונו בחובי"],"ערב דכתובה לכו ע לא משתעבד קבלן דבע ח לכ":["ערב לכתובה אינו משתעבד","קבלן דבעל חוב משתעבד","נכסי הלוה ושעבוד הערב","שעשה מצוה ולא החסיר כלום","אשה רוצה להינשא מן האיש","תיובתא דמר זוטרא"],"יתומין שסמכו אצל בעה ב או שמינה להן אביה":["אפוטרופוס ליתומים: תרומה ומעשר","יתומים שסמכו אצל בעה\"ב","מינוי אפוטרופוס: שבועה לאבי יתומים","להאכיל ולא להניח","מוכרין להן פירות ובהמה","ואין רשאין לדון לחוב"],"ד אתם ולא שותפין אריסין אפוטרופין ולא תו":["ואין רשאין למכור ברחוק ולגאול בקרוב","אין רשאין למכור שדות וליקח עבדים","רשב\"ג: לא למכור עבדים וליקח שדות","כדי שלא משפיין","ד'אתם' ולא שותפין אריסין","ואין פודין עליהן את השבויין"],"יינו של ר ע היתום משכוהו בד לחבית ונתייק":["יינו של ר\"ע היתום במחיר","נכסי יתומין כהקדש ונקנים בכסף","משכוהו בד' לחבית ונתייקר לשש","יין יתומים שנתייקר","יתום ומכירת יין ביוקר","נכסי היתומים ככסף הקדש"],"משוך פירי מיתמי אייקור היינו דרחב א":["משיכת פירות יתומים כשהתייקר","זול לא יהא כח הדיוט חמור","היינו דרחב\"א בהתייקרות","כח הדיוט חמור מהקדש","משיכת פירי יתומים כשזול","אפוטרופוס ופירות שנתייקרו"],"משכו היתומים פירות ונתייקר לא יהא כח הדי":["יתומים שמשכו פירות והתייקרו","רעה להם שפעמים צריכים לפירות","סבור דהיינו דרחב\"א","זול: לא יהא חמור מהקדש","שפעמים צריכים לכסף","יתומים ופירות זולים ויקרים"],"נתנו יתמי זוזי אפירי זול לא יהא כח הדיוט":["נתנו יתומים כסף על פירות","נשרפו חיטכם בעלייה","קנין ע\"י משיכה בשטר","מכירה בלא הכרזה לכרגא ולמזונות","אמו של זעירא שמכרה קרקע למס","מכירה לקבורה ללא הכרזה"],"המטמא והמדמע והמנסך בשוגג פטור במזיד חיי":["מטמא ומדמע ומנסך בשוגג","בשוגג פטור במזיד חייב","עבירות טומאה ודמע ונסך","שוגג ומזיד באיסורי מקדש","המדמע בשוגג פטור","הכלל בשוגג ובמזיד"],"הכהנים שפגלו במקדש מזידין חייבין":["כהנים שפגלו במקדש במזיד","נאמנות על טהרות שנטמאו","זבחים שנתפגלו ביום פלוני","ברישא נאמן משום שבידו","סיפא שמצאו ולא אמר דבר","עדות על פיגול בזבחים"],"היה עושה עמו בטהרות וא ל טהרות שעשיתי עמ":["נאמן שבידו הוא ברישא","אינו נאמן בתאריך פלוני","היה עושה עמו בזבחים","מצאו ולא אמר דבר ואחר כך","נאמנות כוהן על עבודה שעשה","טהרות וזבחים בעדות כהן"],"העיד רי ו בן גודגדא על החרשת שהשיאה אביה":["העדות על החרשת שהשיאה אביה","קטנה בת ישראל לכהן ובעלה יורשה","המריש הגזול ודמי תקנת השבים","חטאת הגזולה שלא נודעה לרבים","עדות ריב\"ג: ראו גט זה ואמר לה כנסי","בושה בנהג כך"],"עדות ריב ג באמר לעדים ראו גט זה שאני נות":["ראו גט זה ואמר כנסי שטר זה","לא נקרא ביטול אלא בושה","דלא בעי' דעתה ה\"נ כאן","עדות ריב\"ג על גט שנתן","מגורשת בלא דעתה","אם היה אומר לעדים ונהג כך"],"לא היה דין סיקריקון ביהודה בהרוגי מלחמה":["סיקריקון ביהודה בהרוגי מלחמה","לקח מסיקריקון וחזר ולקח מבעה\"ב","מכר לאיש או לאשה: הקודם","הלוקח מסיקריקון נותן רביע לבעלים","שהתה בפני סיקריקון י\"ב חודש","קודמין לכל אדם ליקח"],"אשרי אדם מפחד תמיד ומקשה לבו יפול ברעה":["אשרי אדם מפחד תמיד","מקשה לבו יפול ברעה","קושיה על המשל מפחד תמיד","פסוק אשרי אדם במחלוקת","אדם שמפחד תמיד","הקושי בלב מתקשה"],"שלח אליהם את נירון קיסר כשהגיע זרק חץ למ":["נירון קיסר והחץ שנפל בירושלים","ונתתי נקמתי באדום ביד עמי","נירון שנתגייר","הקב\"ה רוצה להחריב ביתו","ויצא ממנו ר\"מ","מעשה נירון וגיורו"],"שלח עליהם את אספסיינוס קיסר ובא וצר עליה":["אספסיינוס צר על ירושלים","צר עליהם שלוש שנים","שלח אספסיינוס קיסר על העיר","מצור אספסיינוס על ירושלים","מעשה המצור של שלוש שנים","שליחת אספסיינוס לירושלים"],"ג עשירים היו בה נקדימון בן גוריון שנקדה ":["שלושה עשירים בירושלים","נקדימון שנקדה לו חמה","בן כלבא שבוע ורעב ככלב","בן ציצית הכסת וכסתותיו","מרתא בת בייתוס וסולת נקייה","רעב בירושלים ושריפת המחסנים"],"עמד עליו נחשול שבים לטובעו אמר כמדומה אנ":["היתוש שנכנס לחוטמו של הרשע","יתוש שנכנס בחוטמו של הרשע","נקר במוחו שבע שנים","שמע קול הפטיש ושתק","נפח והכו לפניו: לנכרי ולישראל","פיו של נחושת וצפורניו של ברזל"],"בלע ה ולא חמל את כל נאות יעקב":["ששים רבוא עיירות של ינאי","כפר ביש וכפר שחליים","כפר דכריא שנשותיהן יולדות זכרים","ארץ ישראל גדלה בישיבתה","ארץ צבי: עורה לא מחזיק","ראיתי את המקום ואפילו שישים ריבוא"],"אי יש ששמע דבר מכפר סכניא של מצרים שיאמר":["ארוס וארוסתו שנשבו לבין העכו\"ם","אל תגע בי שאין לי כתובה ממך","ספדו לזה שפטפט ביצרו","אב ובנו שבאו על נערה מאורסה","אדם שנתן עיניו באשתו ולובן ביצה","בבא בן בוטא: לובן ביצה סולד"],"גדע בחרי אף כל קרן ישראל":["כרך ביתר ושמונים אלף קרני מלחמה","שני חלקים מים ואחד דם","בקעת ידים ושני נחלים","דמים בדמים נגעו בדמו של זכריה","דם זבחים שנשפך","נבוזראדן הרג בבקעה ובירושלים"],"ארבע מאות בתי כנסיות היו בכרך ביתר ובכל ":["ארבע מאות בתי כנסיות בביתר","ארבע מאות מלמדי תינוקות","דוקרין אותן בחוטריהן","כרכום בספריהם והציתום באש","בתי כנסיות וחורבנם בביתר","חורבן ביתר ובני בית רבן"],"חרש רומז ונרמז ובן בתירא קופץ ונקפץ במטל":["חרש רומז ונרמז בגיטין","בן בתירא: קופץ ונקפץ במטלטלין","פעוטות מקחם מקח במטלטלין","מחלוקת במטלטלין ודברי הכל בגיטין","ותני אף במטלטלין","כמחלוקת במטלטלין כך בגיטין"],"מחלוקת במטלטלין אבל בגיטין דברי הכל ברמי":["דברי הכל ברמיזה בגיטין","דרק במטלטלין ולא אף במטלטלין","אף במטלטלין בברור","חרש שנשאל ברמיזה","מחלוקת בגיטין ובמטלטלין","מקח וממכר של פעוט"],"אלו דברים אמרו מפני דרכי שלום":["כהן קורא ראשון מפני דרכי שלום","מערבין בבית ישן","בור קרוב לאמה מתמלא ראשון","עני המנקף בראש הזית","ר' יוסי: גזל גמור","אין ממחין ביד עניי עכו\"ם בלקט"],"משאלת אשה לחבירתה החשודה על השביעית":["שאלת נפה וכברה מאשה חשודה","אשת חבר לאשת עם הארץ","אבל משתטיל את המים לא תגע","אין מחזיקין ידי עוברי עבירה","מחזיקין ידי נכרים בשביעית","שאלת שלום לחשודה מפני דרכי שלום"],"ולא חישי שמא תסיטנו אשתו נדה":["הנותן לחמותו מעשר את שנתן","שמא תסיטנו אשתו נדה","המוליך חיטין לטוחן כותי","מחלפת המתקלקל בחמותו","בר בי רב ליכול חם ואני אוכל קר","שור מדישו אוכל: חילוף בטוחנת"],"נוטל הימנה כדי חלה ומניחה בכפישא או באנח":["נוטל כדי חלה ומניחה בכפישא","כשבא עם הארץ ליטול","שנגע חוזר לטבלו","דלתקן מכוון ודאי איכפ\"ל","חלה שהניחה עם הארץ בכלי","נוגע בחלה ואינו חושש"],"נוטל הימנה כדי תרומה ומניחה בכליו של חבר":["תרומה בכליו של חבר ואינו חושש","היכר בכלי גללים ואבנים","כלים של עם הארץ הראויין לחבר","תרומה שהונחה בכלי אדמה","נוטל כדי תרומה מכלי חבר","דנגע בה היכר מנח"],"האשה שאמרה התקבל לי גיטי צריכה שתי כיתי ":["התקבל לי גיטי: שתי כיתות עדים","שנים שאומרים בפנינו אמרה","שנים שאומרים קבל וקרע","ראשונים ואחרונים בעדים","ואחד מצטרף עמהן","צריכה שתי כיתי עדים"],"נערה המאורסה היא ואביה מקבלין את גיטה":["נערה מאורסה והאב מקבל גיטה","אין שתי ידים זוכות כאחת","רבי יהודה: רק האב מקבל","כל שאינה יכולה לשמור גיטה","מי מקבל גט לנערה מאורסה","שמירת הגט אינה מתגרשת"],"קטנה שאמרה התקבל לי גיטי אינו גט עד שיגי":["קטנה שאמרה התקבל לי גיטי","אין קטן עושה שליח","אביה אמר לה צא והתקבל","האומר תן גט במקום פלוני","נתנו לה במקום אחר: פסול או כשר","ר' אלעזר מכשיר במקום אחר"],"הוא שמגרש מדעתו קפיד":["אשה שאוכלת בתרומה עד קבלת גט","התקבל לי גיטי: אסורה בתרומה מיד","הוא שמגרש מדעתו קפיד","מראה מקום היא לו","התקבל לי גיטי במקום פלוני","ר\"א אוסר מיד על התרומה"],"ורבי אלעזר אוסר מיד אף דס ל מראה מקום הי":["ר\"א אוסר מיד אף במראה מקום","באמרה לך למזרח שהוא שם","שהלך למערב חיישי שפגשו","מראה מקום היא לו בגט","חשש פגישה במקום שנאמר","אסור מיד לפי ר\"א"],"האומר כתבו גט ותנו לאשתי גרשוה כתבו איגר":["כתבו גט ותנו לאשתי: גרשוה","פטרוה ופרנסוה לא אמר כלום","שלחוה שבקוה תרכוה","פטרוה דבריו קיימין","פיטרוה לא אמר כלום","רבי נתן: דייק בין פיטרוה לפטרוה"],"שלחוה שבקוה תרכוה הרי אלו יכתבו ויתנו":["בן א\"י לא דייק בלשון פטירה","שבקוה ותרכוה ככתיבת גט","לשון פטירה בין דבר לכתוב","עשו לה כראוי לא מועיל","דקדוק לשון פטירה בבבלי","תנא דידן לא דייק בלשון"],"גניבא כשיצא בקולר אמר תנו ד מאות זוז לר ":["גיטו כמתנתו: מתנת שכיב מרע","אמר תנו ארבע מאות זוז לר\"א","במצוה מחמת מיתה צריך קנין","אם עמד חוזר גיטו כמתנתו","שאמר מהיין ולא היין","כדי לייפות את כחו"],"מי שהיה מושלך לבור ואמר כל השומע את קולו":["מושלך לבור ואמר כתבו גט","בבואה דבבואה צרת אשתו","בשעת סכנה כותבין ונותנין","בריא שעלה לראש הגג ונפל","אם הרוח דחתו אינו גט","אם הוכיח סופו על תחילתו"],"שהוא שד כר י שראו דמות אדם וגם וראו בבוא":["מלמד תינוקות ובנו שליחות","שנים מכם כתבו גט לאשתו","ממנה אדם בנו שליח במקום אבא","אמר לשלשה תנו גט ור\"מ","הרי אלו יאמרו לאחרים ויכתבו","שעשאן ב\"ד"],"אם הוכיח סופו על תחילתו הרי זה גט ומעשה ":["אמר לעשרה כתבו גט לאשתי","אחד כותב ושנים חותמין","כולכם כתובו אחד כותב","אם מת אחד מהם הרי זה גט בטל","לב\"ד הגדול שבירושלים","אבל אנו מקובלין: שליחות ב\"ד"],"לשימשא עתיקתא יקרע תרנגולת שחורה לשתי וע":["רפואה בתרנגולת שחורה על הראש","לשימשא עתיקתא לחולה","בשר כחוש ויין מזוג לרפואה","מי בית המרחץ נהפכו כדם","ר\"ע ועבדי ריש גלותא","הכל ע\"פ מה שאומר להם ההיפך"],"עיכב שלמה אצלו עד שיגמור לבנות הבית עמד ":["שלמה ואשמדאי ואבדן הטבעת","כתיב תועפות ראם לו","מלאכי השרת ושדים","בלע את הטבעת והטיל את שלמה","הרגל ברקיע והרגל על הארץ","מה יתרון לאדם בכל עמלו"],"וזה היה חלקי מכל עמלי":["וזה היה חלקי מכל עמלי","שלמה כשוטה בסנהדרין","שלחו לנשי שלמה לבדיקה","רגליו נתונות באנפילאות","שם המפורש על הטבעת והשלשלת","אשמדאי פחד משלמה בלילות"],"מפני דם יביא עץ ארץ וערבה והדס לח וזית ו":["רפואות לכאב ראש","תבשיל של עשבים לכאב ראש","תרנגול הבר על כאב הראש","רפואה לקרום העין מעקרב","סנוורים וחבל מזנב סוס","כחול העין בשלושה מכחולים"],"וכשות שלא בזמנה תנא כשם שקשה שלא בזמנה כ":["כשות שלא בזמנה קשה","זמן הכשות תמוז וטבת","כשם שקשה שלא בזמנה","ימי ניסן ותשרי אינם מעלים","יפה בזמנה ומזיק שלא בזמנה","שלא בזמנה לאכילה"],"אמרו לו נכתוב גט לאשתך ואמר להן כתובו":["גט שנכתב ונחתם בלא ציווי","ביטול גט בחזרה על הציווי","כתיבה וחתימה ללא נתינה","תנו נותנין ברשות המגרש","הגט בטל כשחזר ונתנו","נתינה חוזרת לאחר ביטול"],"הא אמר תנו נותנין כר מ דמילי מימסרן לשלי":["שליחות בגט במילי מימסרן","תנו נותנין כר' מאיר","כתוב וחתום לא נמסר לשליח","שליחות בדבר שאינו נמסר","הבדל בין תנו לכתוב","מסירת הגט לשליח כר' יוסי"],"זה גיטיך אם מתי מחולי זה לאחר מיתה לא אמ":["גט על תנאי אם מתי","אם מתי: מעכשיו או לאחר מיתה","גט מהיום ולאחר מיתה","גט מחולי זה ומיתה ממנו","לאחר מיתה אינו גט","חולצת ולא מתייבמת"],"אם מתי שתי לשונות משמע א מעכשיו ב כלאחר ":["שתי משמעויות באם מתי","מעכשיו או כלאחר מיתה","מהיום כמעכשיו בלשון","הכרעה בלשון אם מתי","משמעות לשון מהיום","אם מתי כמ\"ד מעכשיו"],"ואפי דלרבא פשיטא דהלכה כרבי יוסי דה ז גי":["רבא ורב הונא בר' יוסי","פשיטא לרבא מספקא לרב הונא","שאני מת כאם מתי","כשאמות כלאחר מיתה","הלכה כר' יוסי מהמעשה","גט לאחר מיתה לר' יוסי"],"לא תתייחד עמו אלא בפני עדים אפי על פי עב":["ייחוד בלא עדים עם האשה","חוששין לזנות או לקידושין","ייחוד באפילה ומרגלות המטה","ריב\"י וחשש הקידושין","שפחה ועבד בייחוד","מה היא באותן הימים"],"ראוה שנתייחדה עמו באפילה או שישנה עמו תח":["נבעלה מכח ייחוד ומתנה","כספים אתנן ולא קידושין","ראוה שנבעלה חשש קידושין","מחלוקת ריב\"י בחשש קידושין","אף לא ראוה שנבעלה","כספים בחשש זנות בלבד"],"הרי זה גיטך ע מ שתתני לי מאתים זוז הרי ז":["גט על מנת לתת מאתים זוז","על מנת שתתני בשלושים יום","מעשה באיצטליתו שאבדה","תתן לו את דמיה","גט על תנאי תשלום","שלושים יום מגורשת או לא"],"ותתן ר ה והיא תתן ר י לכשתתן נפק מ שנתקר":["ותתן: והיא תתן או לכשתתן","נפקא מינה בגט שנקרע","גט שאבד ונצרך שני","לכשתתן כר' יהודה","תן לשון לכשתתן","ותתן בגט שניתן לתשלום"],"על מנת שתתני לי מכאן ועד שלשים יום וכו":["תנאי לזירוז ולא למקפיד","שלא אומרים שאינו מקפיד","מכאן ועד שלושים יום","נאמר לזרזה בלבד","תנאי זירוז בגט","תנאי כזירוז ולא כתנאי ממש"],"כל מקום ששנה רשב ג במשנתינו הלכה כמותו ח":["כלל הלכה כרשב\"ג במשנתנו","חוץ מערב צידן וראיה אחרונה","הנייר שאינו בעין","תנאי כפול ותנאי בדבר אחד","תנאי קודם למעשה","רשב\"ג בשאינו בעין"],"בגט דשכיב מרע אם לא מתי לא יהא גט ואם מת":["גט בשכיב מרע לא מתי","אדם לא מקדים פורענות לעצמו","תנאי קודם למעשה","בעינן הן קודם ללאו","אם מתי יהא גט","תנאי כפול בשכיב מרע"],"הרי זה גיטיך ע מ שתשמשי את אבא על מנת שת":["תנאי שמשה ושמינקה","שתי שנים ושמונה עשר חודש","כל עכבה שאינה הימנה","מת הבן או מת האב","ר' יהודה ורשב\"ג בתנאי שמשה","יום אחד מתוך שתי שנים"],"דשמשתו יום אחד הניקתו יום אחד ה ז גט":["סתם כמפרש יום אחד","תנאי רישא וסיפא בפירוש","מקל בתנאי רשב\"ג ומתניתין כרבנן","אין תנאי בכתובים שאינו כפול","כל סתם כמפרש","שני כתובים הבאים כאחד"],"אמר לה בפני שנים הר ז גיטך ע מ שתשמשי את":["שני תנאים מאחר ביטלו ראשונים","שני כתובים אינם מצטרפים","ביטול תנאי ראשון בשני","לא מצטרפים תנאים לקיומא","בפני שנים ביטול דבריו","תנאי שני מבטל ראשון"],"הר ז גיטך אם לא באתי מכאן עד ל יום":["תנאי ל' יום בהליכה והחזרה","אנטיפרס ביהודה או בגליל","בטל תנאו בחזרה","גט על מנת להתעכב בדרך","כל זמן שאעבור מכנגד פניך","שני תנאים לגליל ולעכבה"],"שאנטיפרס בגליל ורמינהי אנטיפרס ביהודה וכ":["שני תנאים בדרך לגליל","אנטיפרס בגליל או ביהודה","ורמינהי בכפר עותנאי","מטילין לחומרא בבינתים","בטל תנאו בחזרה לאנטיפרס","מגורשת ואינה מגורשת בדרך"],"ה ז גיטך כל זמן שאעבור מכנגד פניך ל יום ":["לא חוששין שמא פייס","הרי זה גיטך כל זמן שאעבור","תשמיש בלשון פניך","גט ישן כשימלאו ל' יום","חשש פיוס במחלוקת רבה","מתנה נאמנת לומר שלא באתי"],"ה ז גיטך אם לא באתי מכאן ועד י ב חדש ומת":["גט על מנת י\"ב חודש","מתוך י\"ב חודש ומת אינו גט","מעכשיו ומת בתוך י\"ב","כתבו בתוך י\"ב ונתנו לאחר","ר' יוסי: כזה גט","גט מעכשיו ומיתה בזמן התנאי"],"רבותינו התירוה לינשא בי ד דהתירו שמנן דע":["הוראת ר' יהודה הנשיא להתיר","זמנו של שטר מוכיח עליו","כשתתירוה לאלתר שלא בא","ר' יוסי ומעשה הנשיא","היתר מכח ר' יוסי","נתקיים תנאו במעשה"],"הכל מודים היכן שאמר לכשתצא חמה מנרתיקה ל":["לכשתצא חמה מנרתיקה","מעכשיו אמר כאם תצא","מות בלילה לאחר המיתה","הכל מודים בתנאי החמה","על מנת כאומר מעכשיו","תנאי מאורע שאינו בעיקר"],"לאחר שבוע שנה לאחר שנה חדש לאחר חדש שבת ":["לאחר שבוע שנה חודש שבת","לאחר שבת בשבא ותרי","ערב שבת לפני שבת","לאחר הרגל שלושים יום","שיעור לאחר בשם רבי","אין הלכה כמותו בזמנים"],"ונתן בידה מ מ לגגה חצרה וקרפיפה ותנ ה":["ונתן בידה לגגה וחצרה","המצא תמצא גם גגו","נכסים ודין ודברים בגט","גט אף שלא קנסי","קנין ונתינה בגט","חצרה וכתובה ונחלה"],"אמר לה כנסי שטר חוב זה או שמצאתו מאחוריו":["שטר חוב שאינו גט בלא אמירה","הא גיטיך נתינה ואמירה","גט מאחוריה בהרמה","כנסי שטר חוב ונעורה","עד שיאמר הא גיטך","אמירה שאינה מועילה"],"כשאמר לה הא גיטך לא מהני עד שיעקם את מתנ":["גט שנתן בידה והיא ישנה","כתב גט לעבדה ישן ומשמרתו","נתינה בשינה וחצר המשתמרת","גט שלא לדעתה ישן","ישן ומשמרתו בכפות","שלפתו מאחוריו ונתנו"],"היתה עומדת ברשות הרבים וזרקו לה":["גט שנזרק לרשות הרבים","קרוב לה מגורשת","מחצה על מחצה מגורשת ואינה","זריקת חוב קרוב ללוה","ד' אמות שלה ושלו","שיעור קרבה בזריקה לאשה"],"ד אמות שלה זהו קרוב לה ד אמות שלו זהו קר":["ד' אמות כקרבה לאשה","ד' אמות שלו לבעל","זהו קרוב לה ולא לו","שיעור קרבה בזריקה","ד' אמות כקניין","קרבה לאשה בזריקה"],"היתה עומדת על ראש הגג וזרקו לה":["גט שנזרק מגג לאשה","כשהגיע לאויר הגג","הוא מלמעלה והיא מלמטה","יצא מרשות הגג ונשרף","גג עם מעקה או פחות משלוש","שמואל ואבימי בגג משתמר"],"ונקרא שזה משתמר כשמואל א דמדובר בגג שיש ":["גג שיש לו מעקה","אבימי: פחות משלוש סמוך לגג","משתמר בגג כשמואל","מעקה כתנאי לגג משתמר","גג וכגג דמי","שיטת שמואל ואבימי בגט"],"ב ש פוטר אדם אשתו בגט ישן וב ה אוסרין":["ב\"ש וב\"ה בגט ישן","איזהו גט ישן","גזרה שמא יאמרו גיטה קודם לבנה","נישאת לא תצא","נתגרשה תינשא לכתחלה","ייחוד לאחר כתיבת הגט"],"לא אמרינן גזרה שמא יאמרו גיטה קודם לבנה":["גזירה שמא יאמרו גיטה קודם לבנה","גט ישן: ביטול הנישואין בדיעבד","אם נישאת לא תצא","שמואל: תינשא לכתחלה","הגזירה בגיטה קודם לבנה","משמואל על גט ישן"],"כתב לשום מלכות שאינה הוגנת לשום מלכות מד":["גט לשם מלכות שאינה הוגנת","כתב במזרח ובמערב","תצא מזה ומזה וצריכה גט","ממזר מזה ומזה","שינוי שם העיר בגט","ביטול כתובה ופירות בשתי מלכויות"],"ד מלכות שאינה הוגנת מלכות הרומיים שאין ל":["מלכות הרומיים שאין להם כתב","משום שלום מלכות","מטבע שטבעו חכמים בגיטין","הולד ממזר בתקנת חכמים","מפני מה תקנו מלכות בגיטין","שלום המלכות בתקנת הגט"],"היה במזרח וכתב במערב היינו סופר":["סופר בשילי כתוב בשילי","ר' מאיר בכתיבה במדינה אחרת","חכמים: לשם סנטר מגורשת","שמסרו מילי בהיני","כתיבה בעיר אחרת","מחלוקת ר\"מ וחכמים בכתיבה"],"יצא עליו קול איש פלוני כהן כתב גט לאשתו ":["קול כהן כתב גט לאשתו","תצא והדבר צריך בדיקה","קול אחר נישואין אינו משנה","לא מבטלים קול בנהרדעא","קול שאחר נישואין לא נבדק","שמא נתן בדיקת הקול"],"המגרש את אשתו ולנה עמו בפונדקי":["לינה בפונדקי אחר גירושין","בית שמאי ובית הלל בלינה","מודים בגירושין מאירוסין","בעילה כזנות בגט שני","לבו גס בה או לא","צורך בגט שני אחר לינה"],"בשראוה שנבעלה חלקו אם אדם עושה בעילתו בע":["בעילה כזנות בגט שני","מודים בנתגרשה מאירוסין","אם בראוה שנבעלה","אלא בשלא ראוה שנבעלה","גט שני לא לאחר לינה","לבו גס בה: הגדרת הגט"],"כנסה בגט קרח תצא מזה ומזה וכל הדרכים האל":["גט קרח וכנסה בו","לבן ננס ואיזה גט קרח","קשריו מרובין מעדיו","הכל משלימין על גט קרח","ר' עקיבא על קרובים בלבד","גזירה משום כולכם"],"באמר הרי את מותרת לכל אדם חוץ מפלוני":["היכן מצינו שזה אוסר וזה מתיר","יבם אוסר ומתיר במבעל","חכם מתיר נדר רק בחרטה","בעל מפיר נדר אשה","כריתות: לשון הגט שאינו כורת","כריתות בגט ע\"מ שלא תשתי"],"היום אי את אשתי ולמחר את אשתי מהו":["היום אשתי ולמחר אשתי","פסקה ממנו לגמרי","ר\"א ורבנן בהתרה","היתר לאחד לעולם","כיון דפסקה פסקה","תנאי בזמנים בגט"],"הרי את מותרת לכל אדם אלא לאבא ולאביך לאח":["מותרת לכל חוץ מקרוביו","אלמנה לכהן גדול","גרושה וחלוצה לכהן הדיוט","ממזרת ונתינה לישראל","כל מי שיש לה עליו קדושין","לרבות חייבי לאוין"],"לרבות שאר חיי כ כלל דסיפא לרבות שאר חייב":["שאר חייבי לאוין בהיתר","כלל דסיפא לאוין","לרבות שאר חיובי כריתות","רבוי חייבי לאוין מכלל","היקש כלל לפרטים","מותרת בשאר עבירות"],"חוץ מהפרת נדריך מהו בנשואין לא שייר או ו":["הפרת נדרים בנשואין","לא שייר בנשואין","ואישה יפירנו בנדרים","נדרים בתנאי הגט","היתר בהפרת נדר","פרט וכלל בהפרת נדרים"],"חוץ מתרומתיך מהו בנשואין הא לא שייר או ק":["תרומה בנשואין לא שייר","קנין כספו כתיב","תרומת אשה לבעל","תרומה בכלל התנאים","אשה נותנת תרומה","כספה נכתב לבעל"],"חוץ מירושתיך מהו בנשואין לא שייר או לשאר":["ירושה שלא שייר בנשואין","לשארו וירש אותה","ירושת אשה לשאר","הפרשת ירושה בגט","לא שייר ירושה","ירושה ושאר בשר"],"חוץ מקידושיך בשטר מהו אפשר דמקדש בכסף וב":["קידושין בכסף ובביאה","הוקשו הוויות להדדי","תיקו בקידושין בשטר","קידוש בשטר בלא כסף","לא מקדש בשטר","שטר קידושין בהוויות"],"גופו של גט הרי את מותרת לכל אדם":["גופו של גט ולשון ההיתר","ר\"י: ספר תירוכין לגבר","גופו של גט שחרור","בת חורין לעצמך","הרי את בת חורין לאשתו","מותרת לכל אדם לשפחה"],"אמר לאשתו הרי את בת חורין לא אמר ולא כלו":["בת חורין לאשה אינו כלום","לשפחה מותרת לכל אדם","לשון שחרור לאשה ושפחה","חסרון לשון שחרור","אין בלשון חורין כלום","הרי את בת חורין בלא גט"],"שלשה גיטין פסולין ואם נשאת הוולד כשר":["שלושה גיטין פסולין והולד","כתב בכתב ידו בלא עדים","יש עדים אבל בלא זמן","זמן אבל עד אחד","ר\"א בגט שנתנו בפני עדים","גובה מנכסים משועבדים"],"גט ישן שם לא תצא כאן תצא":["גט ישן בתצא ובלא תצא","הולד ממזר כר\"מ","לרבנן כאן לא תצא","תצא במקושר","שני מקומות של מחלוקת","מוקים כר\"מ"],"מנינא דסיפא למעט מביא גט ממה י נתנו ולא ":["למעט מביא גט מארץ ישראל","נתנו ולא אמר בפני נשים","יטול ויחזור ויתן לה","אין הולד ממזר","בפני שנים ואמירת הנוסח","הגט הנמסר בלא אמירה"],"שנים ששלחו שני גיטין שוין ונתערבו נותן ש":["שני גיטין שווים שנתערבו","נותן שניהם לזו ושניהם לזו","אבד אחד הרי השני בטל","חמשה שכתבו כלל בגט","כתב טופס לכל אחד","עדי מסירה ועדי חתימה"],"דלא כר א דעדי מסירה כרתי הא אינם יודעים ":["עדי מסירה כורתים הגט","כתיבה לשמה ונתינה לשמה","אינם יודעים באיזה מגרש","ר\"א בכתיבה לשמה","דלא כר\"א בעדי מסירה","לשמה בכתיבה ולא בנתינה"],"שני גיטין שכתבן זה בצד זה":["שני עדים עברים ויוונים","בעברית ויוונית כשר","עד עברי ועד יווני פסולין","עדים באים מתחת זה לזה","להכשיר ראובן בן יעקב","חתימה בלא לשון עד"],"להכשיר זה בראובן וזה בבן יעקב עד":["חתימה בשם אביו","עדים עברים ויוונים בעברית","סימן אביו בחתימת העד","עדים בשני שיטין","שמא חתמו שלא כדרך רגילותם","חתימה במקום קרוב לשם"],"שייר מקצת הגט וכתבו בדף השני והעדים מלמט":["עדים בדף השני כשר","חתימה בראש הדף מן הצד","הקיף ראשו בצד ראשו פסול","סופו של זה בצד סופו של זה","גט עברית ועדיו יוונית","איש פלוני עד כשר"],"גט מעושה בישראל כשר ובעכו ם פסול":["גט מעושה בעכו\"ם פסול","חובטין ואומרים עשה","כדין ושלא כדין מעושה","ריח הגט שלא כדין","רב משרשיא ור\"מ בדבר תורה","אגוריאות של עכו\"ם"],"גט המעושה בישראל כדין כשר שלא כדין פסול ":["כדין בכדין מיחלף","ואלה המשפטים לפניהם ולא לפני עכו\"ם","לא לפני הדיוטות שליחותם","אגוריאות שדיניהם כדיני ישראל","טעם הפסול בגט מעושה","ר\"מ בדותא היא"],"יצא שמה בעיר מקודשת הר ז מקודשת":["יצא שמה במקודשת ומגורשת","קול ושוברו עמו","יצא לה שם מזנה בעיר","אכלה בשוק גירגרה בשוק","ר\"מ: תצא ור\"ע: מוזרות בלבנה","כי מצא בה ערות דבר"],"בעולה נשואה ארוסה שלא לפלוני בעיר אחרת מ":["בעולה נשואה ארוסה אין חוששין","קול הברה ונרות דולקות","נשים טוות לאור הנר","אמתלא ואמרו דבר","כל קול שלא הוחזק בב\"ד","אמרו דבר זה הוא קול"],"כל קול שלא הוחזק בב ד אינו קול":["קול אחר נישואין אין חוששין","קול אחר אירוסין חוששין","הלכתא לא חיישינן לקול","קול שלא הוחזק בב\"ד","קול בלא עדות אינו קול","חילוק קול לאחר אירוסין"],"יצא עליה קול מראשון ובא אחר וקדשה קידושי":["קול מראשון וקידושי תורה","תצא והעמידו על בוריו","אם קידושי ראשון טובים","לא מבטלים הקול בנהרדעא","אשת איש שפשטה ידה","נאמנת לומר גירשתני"],"לא יגרש אדם את אשתו":["בית שמאי ובית הלל בערות דבר","אפילו הקדיחה תבשילו","ר\"ע: מצא אחרת נאה","ערות ודבר בשני הדברים","או ערוה או דבר","ערות דבר כמשמעו שניהם"],"דבר א ל ב ש ערות":["ערות דבר: שתי משמעויות","ב\"ש: או ערוה או דבר","שני עדים להלן דבר ברור","ערוה ודבר כמשמעו כאן","כי מצא בה ערות דבר","מה דבר כאן כשני עדים"],"זכה שני שלחה ד ושנאה האיש האחרון":["זכה שני שלחה ואם לאו קוברתו","שנאה האיש האחרון","כדאי הוא במיתה","הוציא רשעה והכניס רשעה","גירושין ראשון ושני","מותר בגירוש הרשעה"],"כי שנא שלח ר י אם שנאתה שלח רי ו שנאוי ה":["כי שנא שלח ר\"י ורי\"ו","שנאוי המשלח","זווג ראשון וזווג שני","מזבח מוריד עליו דמעות","המגרש אשתו ראשונה","והיא חברתך ואשת בריתך"]}