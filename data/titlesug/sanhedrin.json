{"בהגביה או הפליג":["מניין הדיינים לפי סוג הדין","שלשה לממונות ועשרים ושלשה לנפשות","מחלוקת ר\"מ וחכמים במוציא שם רע","מניין לעיבור החדש והשנה","סמיכת זקנים ועריפת עגלה בשלשה","הקרקעות והמטלטלין בדיין כהן"],"וכי לכו ע יש אם למקרא":["לטוטפות ארבע ולר\"ע אינו צריך","חלב וחלב שתי אם למקרא","הסומא באחת מעיניו ויראה","לא תבשל גדי בדרך בישול","יש אם למקרא בכתפי ופת","שתי אם למקרא ביראה"],"דיני ממונות בשלשה ואם היה מומחה לרבים דן":["דיין מומחה דן יחידי","כגון אני דן ביחידי","דין שטעה והדיין נותן לחוב","קבלת הדיין על עצמו","כשלא קיבלו רשות דינו דין","רשות הדיינים בדיני ממונות"],"אין מעברין את השנה אלא אם היתה תקופה חסי":["עיבור השנה בתקופה חסירה","מחלוקת ר\"י ורבי יוסי במנין","יום תקופה מתחיל או גומר","רוב חודש לתקופה חסירה","שתי ידות בחודש לעיבור","ט\"ז יום לפני החג"],"ו י ש א רו ש נ י א נ ש ים ב מ ח נ ה":["בירור שבעים הזקנים בקלפי","משה והשבטים בהפלת הפתקים","שני אנשים שנשתיירו במחנה","עשרים ושתים אלף פתקים","חמשה שקלים לגולגולת בבירור","ברירת הזקנים ללא קנאה בשבטים"],"מת לו מת אינו יוצא מפתח פלטרין שלו":["נשים לפני המיטה ביציאה","דוד הולך אחר המטה לפייס","מנהג הנשים בלוויית המת","נענש אבנר שלא מיחה","הכרות והברות בהספד דוד","ליווי המת בין האנשים לנשים"],"מקום שנהגו נשים לצאת אחר המיטה יוצאות לפ":["מנהג יציאת הנשים לפני המיטה","דוד ההולך אחר מטת אבנר","אבנר שנענש על שתיקתו","הכרות והברות בהספד","בתחלה להכרותו ולבסוף להברותו","מי ראוי לצאת לפני המיטה"],"ומוציא למלחמת הרשות על פי בית דין של שבע":["הוצאה למלחמת הרשות בב\"ד","דרך המלך אין לו שיעור","פרשת מלך לאיים בלבד","שלש מצוות בכניסה לארץ","תרעומת העם בבקשת מלך","כל דיני המלך מותרים"],"אין מוציאין למלחמת הרשות אלא ע פ ב ד של ":["שנה דיני המלך במלחמת הרשות","פרשת המלך לאימה ולא לחיוב","שלש מצוות בכניסה לארץ ישראל","זקנים ועמי הארץ בבקשת המלך","סדר מצוות המלך והעמלקי","כסא המלחמה בעמלק"],"רבי וריב ר וב ש ור ש ור ע כולם ס ל יש אם":["מי ס\"ל יש אם למקרא","טומאת יולדת נקבה שבעים יום","קרנות המזבח בשתי מתנות","כפרת הדם על מזבח החיצון","קרן אחת למצוה וארבע לעכוב","שבועיים קרינן ויש אם למקרא"],"אין מעברין את השנה בשני רעבון":["העיבור בשנת רעב","לחם הבכורים מבעל שלישה","למה לא עיבר אלישע השנה","שנת בצורת לא מעברים","לחם בכורים אחר העומר","שנה ראויה שלא נעשתה מעוברת"],"ת ק ל א י ר ב ה ל ו נ ש ים אלא שמנה עשרה":["ריבוי נשים עד שמונה עשרה","מסירות הלב ומגבלת הנשים","מחלוקת ר\"י ור\"ש בטעם הפסוק","אביגיל והכלל בריבוי נשים","משכון אלמנה לעשירה ולעניה","טעם לא יסור לבבו בנשים"],"דר י דרש טעמא דקרא ור ש לא דרש":["טעם הפסוק בלא תחבול אלמנה","מחלוקת ר\"י ור\"ש בדרישת הטעם","מדוע אסור לשכן בגד אלמנה","ריבוי נשים ודרישת הטעם","אפילו אחת שמסירה את לבו","שאין למשכן אלמנה ענייה"],"ל א י ר ב ה ל ו סו ס ים אבל מרבה כדי רכב":["מותר להרבות סוסים לרכבו","איסור ריבוי סוס אחד לבטל","לעבור בלאו על כל סוס","סוסי המלך לרכבו ופרשיו","הרבית סוס בלאו של לא ירבה","מלך מותר להרבות לצרכו"],"אין רוכבין על סוסו ואין יושבין על כסאו ו":["איסורים ביחס למלך","אין רוכבין על סוסו","אימת המלך שלא יראוהו מסתפר","שום תשים עליך מלך","כסא המלך ושרביטו","כבוד המלך במצבו הפרטי"],"אמר לו נאמן עלי אבא אביך שלשה רועי בקר":["לחזור מדברי הנאמן על אביו","מחלוקת ר\"מ וחכמים בחזרה","חזרה מהודאה בשבועה","דור לי בחיי ראשך","קבלה על עצמו דיין אחד","מי יכול לחזור בו מדבריו"],"נאמן עלי אבא כגון שקיבל עליו שיהיה דיין ":["נאמן עלי אבא כקבלה לדיין","קבלת דיין אחד בנאמנות","תנאי קבלת דיין על הנאמנות","נאמן עלי אבא בדיין יחיד","מתי הנאמן נתפס לדיין","אבא נאמן דיין אחד"],"לפני גמר דין מחלוקת אם יכול לחזור בו":["חזרה לפני גמר הדין","חזרה אחר גמר הדין","מחלוקת רל ורי\"ו בחזרה","כולם מודים בחזרה לפני הדין","גמר הדין ואי אפשר לחזור","חזרה בשניהם לפני פסק"],"ואלו הן הפסולין":["פסולי עדות המשחקים בקוביא","המלוה בריבית ומפריחי היונים","סוחרי שביעית ואוספי שביעית","אומנות אחרת שאינה פוסלת","פסולי עדות בשביעית","מי נחשב פסול בעדות לר\"י"],"ואלו הן הקרובין":["קרובי העדות ברשימה ארוכה","ביטול העדות לאחד מהקרובים","משנת ר\"ע בקרובים","האוהב והשונא בעדות","שונא שלא דיבר שלשה ימים","קרוב שנתרחק כשר"],"כיצד בודקים את העדים":["דרך בדיקת העדים בחדר","שנים מזכין ואחד מחייב","אחד מזכה ואחד מחייב בדיין","איש פלוני זכאי או חייב","מניין הדיינים בבדיקה","אופן גמר הדין והכרזה"],"הודה בפני שנים וקנו מידו כותבין שטר הודא":["הודאה בפני שנים בשטר","כתיבת שטר הודאה במקרקעין","קנין מידו בהודאה","הודאה במטלטלין בפני שלשה","הכרה שהיו לי לדיינים","מחלוקת רב ורב אסי בשטר הודאה"],"כל זמן שמביא ראיה סותר את הדין":["סתירת הדין בראיה חדשה","מציאת עדים אחר שלשים יום","ר\"ש בן גמליאל בראיה שנמצאה","אין הלכה כחכמים בסותר","הבאת ראיה מתחת פונדתו","סתירת דין אחר שלשים יום"],"הלכה כרבן שמעון בן גמליאל":["הלכה כרבן שמעון בן גמליאל","דין ראיה לאחר זמן בדיעבד","חכמים וחכם ביחס לסותר","מהדרינן בדיעבד בסתירה","הלכה כר\"ש בסתירת הדין","שאין הלכה כחכמים בסתירה"],"סנהדרין היתה כחצי גורן עגולה כדי שיהו רו":["ישיבת הסנהדרין כחצי גורן","סופרי הדיינים שכותבים מזכין ומחייבין","שלוש שורות של תלמידי חכמים","מחלוקת ר\"י בכתיבת הסופרים","סדר ישיבה והחלפת מקום","בירור מקום היושב בשורה"],"כיצד מאיימין את העדים":["איום על העדים בדיני נפשות","הבדל בין דיני ממונות לנפשות","דם קין ודמי אחיך","אדם נברא יחידי לשלום","שלום הבריות באדם יחיד","עדות מאומד ומשמועה"],"מצאו לו זכות פטרוהו ואם לאו יצא ליסקל וכ":["כרוז הנידון לסקילה","מציאת זכות לנידון לפני הוצאה","עדים ופרטי היום והשעה","הכרזת חטא לאחר מעשה","זכות לנידון במקום סקילה","מצאו לו זכות פטרוהו"],"וצ ל ביום פלוני בשעה פלונית מקום פלוני ש":["כרוז עבור הנידון ביום ובשעה","פרטי העדות לפני ההוצאה","מניעת זימום על ידי הכרוז","הכרזה בזמן פלוני ומקום פלוני","כי יש שידעו זכותו","הכרוז שמא ישנם יודעי זכות"],"היה רחוק מבית הסקילה כעשר אמות אומרים לו":["הודאה של הנסקל לפני המיתה","עכן שהתודה ונתכפר","מי שהתודה יש לו חלק לעוה\"ב","מיתתי כפרה על עוונותי","תודה במקום קרוב לסקילה","נתכפר לו בוידויו"],"נא לשון בקשה בשעה שאמר הקב ה ליהושע חטא ":["עכן ודרך הגורלות","יהושע ופסק הגורל על עכן","אל תוציא לעז על הגורלות","גורל הארץ ופסיקת עכן","לך הפל גורלות ביהושע","נא לשון בקשה בעכן"],"דף מה גמרא":["כיסוי האיש והאשה בסקילה","מחלוקת ר\"י וחכמים בערום","אותו ואותה בעירום","הכהן בגילוי לב האשה","הרהור ובושה בסקילת אשה","לבה נאה ושערה נאה"],"ו י ש ב ב נ י הו א ת ה מ ל ך ד ב ר ל אמ ":["בניהו שמשיב דבר יואב","קללות דוד על יואב","בניהו בשאלת הרצח","בניהו מחזיר דברי יואב למלך","דברי יואב לדוד ושיבת בניהו","בניהו מסר לדוד את דברי יואב"],"ו י אמ ר לו ה מ ל ך ע ש ה כ א ש ר ד ב ר ":["קללות דוד ליואב בזרעו","זב מרחבעם ומצורע מעוזיהו","מחזיק בפלך אסא ונופל ביאשיהו","קללות דוד שנתקיימו בבית יואב","זב מצורע וחסר לחם בזרע יואב","חסר לחם מיואב"],"ו י צ א יו א ב מ ע ם ד ו ד ו י ש ל ח מ ל":["יואב הורג את אבנר בשער","הרג עשאל ובחרבו השניה","מכה בדופן החמישית של אבנר","אבנר והבור והסירה","עמשא ולא נשמר מחרב יואב","שדנו דין סנהדרין באבנר"],"כל מקום ששנו חכמים דרך מניין אין מוקדם ו":["סדר מעשים בסמנים להעברת כתם","מעשה יום הכיפורים בסדר ובאיחור","סדר החליצה ומעשיה","סדר תמיד ומעשהו בלבד","מחלוקת סדר הרוק בחליצה","הקדמה ואיחור במעשה"],"ורבי ישמעאל דף נב האי את אביה היא מחללת ":["בת כהן מחללת אביה","ארור שזו ילד בבזיון","ביטול הכבוד במיתת בת כהן","ארבע מיתות הנסקלין","בית הסקילה גבוה שתי קומות","מצות הנסקלין והנשרפין"],"גמרא":["מיתה סתם היא חנק","אין להחמיר בשיטת המיתה","מיתה בידי שמים ובידי אדם","ארבע מיתות נמסרו למשה","בת כהן בשריפה ולא בחנק","ארבע מיתות לרבא"],"ע ר ו ת א מ ך ל א ת ג ל ה א מ ך ה יא משו":["עריות האם וקריאתה לסקילה","אשת אב ולשון הכתוב","גזירה שוה בסקילה לאוב וידעוני","אם ואשת אב בשאר גילוי","אשת האב כערות אב","משום אמו ולא משום אשת אביו"],"ע ר ו ת א ב יו ג ל ה לאמו שאינה אשת אביו":["ערות האב בגזירה שוה","גלה לאמו שאינה אשת אביו","ערות האם לאזהרה ולעונש","אשת האב ואיסור הקשה","שעשה הכתוב כאם לאזהרה","האם מופנית לקשת אב"],"מו ת יו מ תו בסקילה דד מ יה ם ב ם גז ש מ":["מות יומתו בסקילה","גזירה שוה לאוב וידעוני","דמיהם בם לסקילה","מיתה בסקילה ללא שוה","אוב וידעוני בסקילה","סקילה מדין אוב"],"ע ר ו ת א ב יך זו אשת אביך":["ערות אביך זו אשת אביך","לא ממש דגזירה שוה","ערות אב גלה כאן באישות","אשת אב כערוה באישות","גזירה שוה לא ממש","אשת האב בעניין האישות"],"ע ר ו ת א מ ך ל א ת ג ל ה לאמו שאינה אשת":["ערות האם כאם שהיא אשת אב","שאר אם לאזהרה ולעונש","כאם שהיא אשת האב","אמו שאינה אשת אביו לעונש","הכתוב מקיש את האם לאב","שעשה הכתוב כאמו"],"א מ ך ה יא ולא משום אשת אב":["נכרי הבא על אביו חייב שתים","מחלוקת ר\"י בנכרי על אחי אביו","ערות אשת אב לאחר מיתה","אשת אב ואשת איש בשתי עבירות","נכרי ובעונש שתי מיתות","חיוב כפול על אשת האב"],"המגדף אינו חייב עד שיפרש השם":["המגדף בשם המפורש בלבד","כינוי השם בדיון הסקילה","קורעים ולא מאחין בהגדפה","כל יום דנין בכינוי","הדיינים קורעים כשנשמע השם","הגדפה בכינוי ואי חיוב"],"איש איש לרבות את הנכרים שמוזהרין על ברכת":["ברכת השם לנכרים כישראל","נכרי נהרג בסייף בלבד","כינויי השם בחיוב","מות יומת ונקב שם לכינוי","איש כי יקלל לרבות כינויים","כגר כאזרח בנקיבת שם"],"לא דריש ויצו הני כל מצוה בפנ ע כתובה":["ע\"ז וגילוי עריות לבני נח","שפיכות דמים ושבע מצוות","ירק עשב וההיתר לבני נח","שרצים וסירוס לברכה","בני נח והאיסור כלאיים","מצוות בני נח ולא לברכה"],"בן נח נהרג בדיין אחד ובעד אחד שלא בהתראה":["בן נח נהרג בדיין אחד","בעד אחד ואיש ולא אשה","שפיכת דם העובר לבני נח","דמו ישפך בבן נח","בן נח והחנק לעוברין","עוברים במעי אמם לבני נח"],"כל ערוה שב ד ישראל ממיתין עליה בן נח מוז":["ערוות גר שהורתו שלא בקדושה","שאר אם ושאר אב בגר","אחות אם מאב לר\"מ","מותר בחמותו לאחר מיתה","נשא אשה ובתה לשני חיובים","עזיבת אב ואם לר\"א ורע\"ע"],"חומר בשבת משאר מצות":["חומר שבת בשעשה שתים","שגגה בלא מתכוון בשבת","ההבדל בין שבת לשאר מצוות","שתי מלאכות בהעלם אחד","שבת ושאר המצוות בשגגה","חייב שגג בשאר מצוות"],"מעשה בנכרית אחת שהיתה חולה ביותר אמרה אם":["נכרית שהזדהרה לעבודת פעור","הנצמדים לבעל פעור","הדבקים בה' ככשתי תמרות","סבטא בן אלס והפעור","ישראל אינם כנכרים בדבקות","עבודת פעור בחולי"],"הפוער עצמו לבעל פעור הר ז עבודתו אף דמיכ":["פיעור עצמו עבודה לבעל פעור","כוונה לבזיון בפעור","עבודת אליל בלא כוונה לעבדה","הפוער לעבודה ולא לכוונה","עבודה ובזיון בלא עבודה","מעשה הפעור ואף בלא כוונה"],"הזורק אבן למרקוליס זו עבודתו אף דמיכוין ":["זריקת אבן למרקוליס כעבודה","זורק אבן במרקוליס לסקילה","הנוטל אבן מהערימה חייב","נתינת מקום לחבירו בזריקה","הזורק למרקוליס בבית המדרש","שאלה בבית המדרש על הזריקה"],"הנותן מזרעו למולך אינו חייב עד שימסור למ":["הנותן מזרעו למולך דרך אש","מסירה למולך והעברה באש","מעשה מולך חייב בשני חלקים","מולך לא חייב בלא מסירה","הנותן למולך ולא העביר באש","מסירה ואש במולך"],"תנן כמ ד מולך לאו ע ז היא דתניא אחד למול":["מולך אינו עבודה זרה לת\"ק","מחלוקת רב אחד למולך ולאחר","ר\"ב ורחב\"א בלשון מולך","מולך עראי אפילו צרור","מולך לשם הכומרים","הכתוב מזכיר מולך בחומר"],"אינו חייב עד שימסרנו לכומרין ד ומזרעך לא":["מסירה לכומרין ולא להעביר","העברה בלא מסירה פטורה","לא תתן ללמד על מולך","לא תתן מסירה לכומרים","שלא מסר ולא העביר פטור","מסר לכומרים בדרך חלופה"],"מסר והעביר שלא למולך או מסר והעביר למולך":["העביר כל זרעו פטור","סומא וישן בהעברת הבן","בן בנו ובן בתו במולך","פתח זרעו לזרע כשר","בתתו מזרעו אף לפסול","מחלוקת העברת הזרע לקטנים"],"שלש כריתות בע ז למה אחת לכדרכה ואחת לשלא":["שלש כריתות בעבודה זרה","כרת למעביר שלא כדרכה","מגדף ועבודה זרה לכרת","הכרת תכרת בעולם הבא","כרת לעוה\"ב ונכרתה לעוה\"ז","אוב וידעוני בלאו אחד"],"דהכא תני בעל אוב וידעוני וגבי כריתות דתנ":["בעל אוב וידעוני בלאו אחד","חלוקה בלאו שאין מעשה","ידעוני שאין בו מעשה","חלוקה במיתה ובכרת","בעל אוב כנוטל פתח הקרא","מחלוקת ר\"ע ורבנן במעשה"],"מעשה במגדף עקימת שפתיו בבעל אוב הקשת זרו":["מעשה במגדף עקימת שפתיים","הקשת זרועות בעל אוב","מעשה בכפיפת קומה לרבנן","מקטיר לשד ומקטיר לחבר","אסור לצמיד נחשים ועקרבים","עדים זוממין בלא מעשה"],"בעל אוב זה המדבר בין הפרקים ומבין אצילי ":["בעל אוב ויודע בין הפרקים","אוב המעלה בזכורו ובגולגולת","שאל טורנוסרופוס לר\"ע בשבת","שאין מעלה עשן בשבת","האוב בשבת לעונה","ידעוני במניח עצם בפיו"],"המחלל את השבת בדבר שחייבין על זדונו כרת ":["חלול שבת שאין בו כרת ובשגגה","תחומין וכר\"ע בחילול שבת","הבערה לר\"י בחילול שבת","חילול שבת שחייב בזדון וכרת","שבת בשגגה חטאת","שבת שאין חייבים על שגגתו"],"דיש חילול שבת שאין חייבין על שגגתו חטאת ":["חילול שבת בתחומין לר\"ע","הבערה לר\"י בשבת","שבת שאין בה חטאת ולא כרת","חילול שבת בזדון ושגגה","תחומין וחילול שבת לר\"י","כרת וחטאת בחילול השבת"],"המקלל אביו ואמו אינו חייב עד שיקללם בשם":["מקלל אביו בשם בלבד","קללה בכינוי לר\"מ","חכמים פוטרים מקללת הכינוי","קללה בשם חייבת לדעת חכמים","מחלוקת ר\"מ וחכמים בכינוי","כינוי בקללת הורים"],"הבא על נערה המאורסה אינו חייב עד שתהא נע":["בא על נערה מאורסה בסקילה","נערה בתולה ומאורסה בבית האב","מיעוט שמסר האב לשלוחי הבעל","נערה מאורסה לר\"מ וחכמים","שניהם שווים בהריגה","הבא על נערה מאורסה בקטנה"],"נערה ולא בוגרת בתולה ולא בעולה מאורסה ול":["נערה מאורסה לר\"מ ולחכמים","בתולה ומאורסה בבית אביה","מסירת האב לשלוחי הבעל","בא על הנערה ונשואה","שתיק רב בדבר ומתו שניהם","מיעוטי נערה מאורסה"],"והך דשתיק אפי דומת האיש אשר שכב עמה לבדו":["מעשה חידודים לאו כלום","עשרה באו על בתולה","בתולה בעשרה בני אדם","תחילת ביאה בזנות לשריפה","רבי ורבי יהודה בבתולה","הבאת הארוסה בזנות לשריפה"],"המסית זה הדיוט בסקילה ונביא המסית בחנק ו":["המסית את ההדיוט בסקילה","העדים מאחורי הגדר","הסתה לעבודה זרה בחשאי","המסית בלא ניגוד לדין","הסתה אחרי יחוד ההסתה","מכמינין עדים לדין המסית"],"המדיח זה האומר נלך ונעבוד ע ז":["המדיח מדיחי עיר הנדחת","מכשף העושה מעשה לחייב","האוחז את העינים פטור","קשואין לוקטין חייב ופטור","הבדל בין מכשף לאוחז העינים","מעשה כשפים בחיוב"],"מיתתן במה":["מיתת מכשפה בסייף או בסקילה","מכשפה לא תחיה ובהמה בסקילה","אוב וידעוני ככלל מכשפים","למה נקרא שמן כשפים","גזירה שוה ישראל מנכרים","מכשפה לא תחיה מסמיכות ענין"],"ויאמרו החרטמם אל פרעה אצבע אלהים היא":["אצבע אלהים ואחיזת עיניים","שד אינו יכול לברוא בריה","נכרי שחתך גמל בחרב","חמור שנעשה גשר במים","אחיזת עיניים ולא כשפים אמיתיים","קנה חמור ונהפך לשוק"],"ותעל הצפרדע ותכס את ארץ מצרים":["צפרדע אחת מלאה ארץ מצרים","רבי עקיבא ונגעים באחת הצפרדע","הדרש על הצפרדע אחת","הקשת הצפרדע בדרש","מה לך אצל הגדה","צפרדע אחת שרקה"],"מאימתי חייב":["בן סורר ומורה באכילת בשר ויין","זולל וסובא בבן סורר","מאימתי נעשה בן סורר","מאכילת בשר ושתיית יין","לוג יין ומנה בשר לר\"י","בן סורר שאכל בחבורת מצוה"],"גנב משל אביו ואכל ברשות אביו משל אחרים ו":["בן סורר בגניבה מאביו ומאמו","גנב משל אביו ואכל ברשות אחרים","מצוי לו המעות ומפחד","משל אחרים ברשות אביו","ריב\"י בגניבה משל אביו ואמו","מחלוקת על סדר הגניבה"],"גנב משל אביו ואכל ברשות אביו אף שמצוי לו":["גנב משל אביו ואכל ברשות אביו","מפחד כשמצוי לו המעות","גניבה מאחרים ואכילה ברשות האב","בן סורר ומורה לפי הגניבה","אביו לא חושש כשגונב","גניבה ואכילה ברשות אחרים"],"היה אביו רוצה ואמו אינה רוצה אביו אינו ר":["אביו רוצה ואמו לא רוצה","שניהם רוצים בבן סורר","אם לא ראויה לאביו","הורים מסכימים לענישת הבן","רצון שני ההורים בבן סורר","אמו ראויה לאביו בבן סורר"],"היה אחד מהם גידם או חיגר או אלם או סומא ":["גידם וחגר אינם בן סורר","אלם סומא וחרש במום","מתרין בו בפני שלשה","ואינו נסקל עד שיהיו שלשה","חזר וקלקל נדון בכ\"ג","ונדון בשלשה הראשונים"],"בעינן קרא כדכתיב ודחי שהכא כוליה קרא יתי":["בעינן קרא כדכתיב בבן סורר","כולו קרא יתירא הוא","הכא דחינן קרא בבן סורר","שלשה לבן סורר בכתוב","לשון בננו זה בשלשה","הלכה מבן סורר ומורה"],"בן סורר ומורה נידון על שם סופו ימות זכאי":["בן סורר נידון על סופו","שמיתת רשעים הנאה להן","יין ושינה לרשעים הנאה","פיזור כנוס ושקט לרשעים","תכלית החיים לצדיקים ולרשעים","נידון על שם סופו לזכות"],"הבא במחתרת נידון על שם סופו":["הבא במחתרת נידון על סופו","שבר החבית בלא דמים פטור","החבית ודמים במחתרת","חייב על שבירת החבית","דמים בשבירת החבית במחתרת","גנב שבר כד ונזק"],"ואלו הן שמצילין אותן בנפשן":["מצילין בנפשן בשלושה","רודף אחר הזכר והנערה המאורסה","אין מצילין בנפשן בבהמה","המחלל שבת ועובד ע\"ז","רודף אחר בהמה לא נמלט","הציל בנפשו במצוה"],"ואלו הנהרגין הרוצח ואנשי עיר הנדחת":["הרוצח שכבש לתוך המים חייב","דחיפה לתוך המים פטור","שיסה כלב ונחש פטור","ר\"י מחייב בשיך הנחש","חייב בהכאה באבן או בברזל","אנשי עיר הנדחת והרוצח"],"בכפת חבירו והפנה עליו זרם מים ומת כוחו ה":["בכפת חבירו בזרם מים כוחו","זורק צרור והולך לצדדין חייב","כח ראשון וכח שני בגרמא","כח כחוש בהליכה לצדדין","הפנה זרם מים ומת חייב","גרמא בכח שני פטור"],"הכוהו עשרה בני אדם בעשרה מקלות בבת אחת ו":["עשרה בני אדם בהכאה אחת","האחרון חייב שקירב את מיתתו","כל נפש אדם לרבנן וריב\"ב","הכוהו עשרה בבת אחת","כל שהוא נפש לר\"ב","פטורים בזה אחר זה"],"המכה את חבירו באבן או באגרוף ואמדוהו למי":["המכה באבן ואמדוהו למיתה","היקל והכביד ומת","רגליים לדבר לר\"נ","רבי נחמיה פטור במכה מדודה","חיוב אחר הכבדה בהכאה","הכאה והקלה ואחר הכבדה"],"נתכוין להרוג בהמה והרג את האדם לנכרי והר":["נתכוין להרוג בהמה והרג אדם","נתכוין לנכרי והרג ישראל פטור","הכאה על מתניו ללבו","נתכוין לגדול והרג קטן","ר\"ש בכוונה להרוג","כוונה ונפילה על מקום אחר"],"רוצח שנתערב באחרים כולן פטורין ר י כונסי":["רוצח שנתערב באחרים פטורים","כונסין לכיפה לחייבי מיתות","נידונין בקלה בנשרפין","הנסקלין בנשרפין לר\"ש","ר\"ש וחכמים במיתה החמורה","הנהרגין בנחנקין לר\"ש"],"מי שנתחייב בשתי מיתות בית דין נידון בחמו":["נתחייב בשתי מיתות נידון בחמורה","נידון בזיקה הראשונה לר\"י","גברא קטילא מעבירה קלה","עבירה קלה וחזרה לחמורה","נידון על עבירה קלה ואחר חמורה","נתחייב כמה מיתות בחמורה"],"מיירי בנגמר דינו על עבירה קלה וחזר ועבר ":["גברא קטילא לא אמרינן","נגמר דינו בעבירה קלה","חזר ועבר עבירה חמורה","מיירי בדין לפני ההוצאה","עבירה קלה ונגמר דין","עבירה חמורה אחר קלה"],"מי שלקה ושנה":["שלקה ושנה מכניסין לכיפה","מאכילין שעורין עד התבקעות","מלקות כריתות וגברא בר קטלא","מפקיר נפשו מקרבין מיתתו","מלקות כרת אחת לעומת שתים","טעם השעורין לשנה במלקות"],"הכא במלקיות של כריתות עסקינן דגברא בר קט":["הכא עסקינן במלקיות כרת","גברא בר קטלא לא מקרבין מיתה","שתי כריתות איסור טעם בלבד","מפקיר נפשו מקרבים מיתתו","מלקות של שתי כריתות","מיתה מקורבת בהפקרת נפש"],"ההורג נפש שלא בעדים מכניסין אותו לכיפה ו":["ההורג נפש בלא עדים לכיפה","לחם צר ומים לחץ להורג","מכניסין לכיפה בהריגה בלא עדים","מאכילין לחם צר למכה","הורג בלא עדים בסדר הכיפה","סדר ענישה בהריגה ללא עדים"],"הגונב את הקסוה והמקלל בקוסם והבועל ארמית":["הגונב את הקסוה קנאים פוגעין","בועל ארמית וכהן ששמש בטומאה","פרחי כהונה מפציעין מוחו","כהן בטומאה לר\"ע בחנק","מקלל בקוסם ופגיעת קנאים","כהן בטומאה ובידי שמים"],"האוכל את הטבל שמואל מר א ולא יחללו את קד":["אוכל את הטבל ילף מתרומה","חילול חילול מתרומה למיתה","תרומה חוץ לארץ ברבים","מנותר ודרך כרת","חילול ברבים מחילול ברבים","טבל במיתה לשמואל"],"וכהן טמא שאכל תרומה טהורה":["כהן טמא שאכל תרומה טהורה","ושמרו את משמרתי לשמואל","כהן טמא ואכילת תרומה","לא ישאו עליו חטא לשמואל","שמירת משמרת לכהן טמא","כהן טמא בתרומה טהורה"],"כהן טמא שאכל תרומה טמאה אינו במיתה":["כהן טמא שאכל תרומה טמאה","ומתו בו כי יחללהו פרט","שמחוללת ועומדת פטור","תרומה טמאה בכהן טמא","פרט לתרומה שעומדת","כהן ותרומה טמאה בלא מיתה"],"זר שאכל את התרומה":["זר שאכל תרומה לוקה ולא במיתה","אני ה' הפסיק את הענין","רב תנא ופליג בזר שאכל","זר ואכילת תרומה במלקות","אל תאכלו קדש חוץ למיתה","זר שאכל לוקה בלא מיתה"],"וטמא ששימש כרב יוסף דבר אל אהרן ואל בניו":["טמא ששימש במיתה","וינזרו מקדשי ישראל לטמא","חילול חילול מתרומה לטמא","כרב יוסף בטמא ששימש","חילול ברבים עדיף בטמא","טמא ששמש בחילול קודש"],"טבול יום ששימש כר ס קדשים יהיו לאלהיהם ו":["טבול יום ששימש במיתה","קדשים יהיו לאלהיהם לר\"ס","וינזרו הוא לטבול יום","ענין הטמא לטבול יום","חילול מתרומה לטבול יום","טבול יום בעבודה במיתה"],"ומחוסר בגדים ר א מרי ו ומטו בה מדראבר ש ":["מחוסר בגדים ר\"א ומטו בה","וחגרת אתם אבנט והמיתה","בגדי כהונה בלא בגדים זרים","זר ששמש בלא בגדים","בגדיהם עליהם כהונתם עליהם","מחוסר בגדים במיתה"],"ומחוסר כפרה כר ה ד וכפר עליה הכהן וטהרה ":["מחוסר כפרה ר\"ה בטמא","וכפר עליה הכהן וטהרה","מכלל שהיא טמאה","טמא ששימש במיתה במחוסר כפרה","מחוסר כפרה וטומאה","כפרה לטמא ששימש"],"ושלא רחוץ ידים ורגלים בבאם אל אהל מועד י":["שלא רחוץ ידים ורגלים במיתה","בבואם אל אהל מועד ירחצו","רחיצת ידים ורגלים לכהן","ולא ימותו בכניסה למשכן","רחיצה בלא מים לא ימותו","כהן שלא רחץ במיתה"],"ופרועי ראש ד ופרע לא ישלחו ובתריה ויין ל":["פרועי ראש כשתויי יין במיתה","פרוע לא ישלחו ויין לא ישתו","איתקש פרוע ראש לשתויי יין","פרוע ראש ושכור בהקש","פרוע ראש במיתה בשימוש","פרוע ראש כהקש לשתויי יין"],"אבל ערל אונן יושב באזהרה":["ערל ואונן ויושב באזהרה","ערל מתורת משה לא למדנו","יחזקאל בן בוזי ולמד ערל","בן נכר ערל לב ערל בשר","ערל במשמרת בלא מיתה","ערל ביחזקאל"],"בעל מום לרבי במיתה וחכ א באזהרה":["בעל מום לרבי במיתה","אך אל הפרכת לא יבא פסול הגוף","מקודש פנים פיגול ונותר בהקש","בו ולא בבעל מום","פסול הגוף מפסול הגוף בהקש","טמא ששמש לא ילפי חילול מתרומה"],"המכה אביו ואמו אינו חייב עד שיעשה בהן חב":["המכה אביו ואמו בחבורה","המקלל מאביו לאחר מיתה","מקלל לאחר מיתה חייב","חומר המקלל מהמכה","מכה לאחר מיתה פטור","מכה אב לאחר מיתה ומקלל"],"הגונב נפש מישראל ת ק אינו חייב עד שיכניס":["גונב נפש עד שיכניסנו לרשותו","ישתמש בו והתעמר בו ומכרו","הגונב את בנו לר\"ב","גנב מי שחציו עבד","גונב נפש בהכנסה לרשות","חכמים פוטרים בגונב את בנו"],"אני שונה דלר ש מאחיו עד שיוציאנו מרשות א":["דלר\"ש מאחיו עד שיוציאנו","תני פטור לר\"ש","סתם ספרי ר\"ש וכולהו לר\"ע","סתם משנה ותוספתא לדעות","מחלוקת ר\"ש ור\"ע בגניבה מאחיו","אליבא דר\"ע בספרי ר\"ש"],"זקן ממרא על פי בית דין שנאמר כ י י פ ל א":["זקן ממרא בשלשה בתי דינין","בית דין שעל פתח הר הבית","זקן ממרא בבית הגזית","ממרא שחזר לעירו והורה לעשות","תלמיד שהורה לעשות פטור","זקן ממרא שהורה לעשות חייב"],"כי יפלא ממך דבר במופלא שבבית דין הכתוב מ":["כי יפלא דבר ודרשת יפלא","ממך זה יועץ דבר זו הלכה","בין דם לדם ובין דין לדין","בין נגע לנגע ודברי הערכין","ריבת זו השקאת סוטה","ארץ ישראל גבוהה מכל הארצות"],"ארץ ישראל גבוהה מכל הארצות אשר העלה ומכל":["ארץ ישראל גבוהה מכל הארצות","אשר העלה מכל הארצות","עליית ארץ ישראל מכל ארץ","גובה ארץ ישראל במשנה","ארץ ישראל והעליה בדבר","מעלת הארץ בהעלאה"],"ממך זה יועץ שיודע לעבר שנים ולקבוע חדשים":["יועץ שיודע לעבר שנים","הן העידו שמעברים כל אדר","חמץ בפסח לזה ולזה","לקבוע חדשים בעיבור השנה","עיבור האדר ושאר חמץ בפסח","יועץ העיבור והחמץ"],"דבר זה הלכה זו הלכות אחד עשר":["הלכות אחד עשר ועשירי","עשירי כתשיעי בשימור","מה תשיעי בעי שימור אף עשירי","לא בעי שימור כאחד עשר","משפט זה הדין בתו מאנוסתו","כריב\"א הנה הנה זמה"],"דם נדה בדם הירוק דלעקביא בן מהללאל טמא ו":["דם נדה בדם הירוק טמא","עקביא בן מהללאל וטמא","חכמים מטהרין בדם הירוק","דם ירוק בנדה לעקביא","דם נדה הטמא ע\"פ ירוק","דם הנדה לר\"ע בירוק"],"דם לידה לרב מעין אחד הוא התורה טמאתו והת":["דם לידה מעין אחד לרב","שני מעיינות לדם לידה ללוי","נסתם הטמא נפתח הטהור","התורה טמאתו והתורה טיהרתו","דם לידה במעין אחד","לוי ורב בדם הלידה"],"דם זיבה קישתה בחבלי לידה ג ימים בתוך י א":["דם זיבה בשלשה ימים","זיבה קישתה ג' ימים בי\"א","קישוי חבלי לידה בזיבה","דם זיבה כשתי תקופות","זיבה בחבלי לידה","זיבה בי\"א יום בקישוי"],"לר א אם שפתה שקטה מעת לעת וילדה הר ז יול":["לר\"א שפתה שקטה מעת לעת","יולדת בזוב שאינו מהלידה","ר' יהושע לילה ויום בזוב","כלילי שבת ויומו בזוב","שפתה מן הצער ולא מן הדם","זוב שאינו מהלידה לר\"א"],"בין דין לדין בין דיני ממונות דיני נפשות ":["בין דיני ממונות לדיני נפשות","דין לדין בדיני מכות","הבחנה בין סוגי הדינים","דיני נפשות ודיני מכות בין","בין דין לדין בהבחנה","הפרדת סוגי הדינים בתורה"],"דיני ממונות דשנים שדנו לשמואל דיניהם דין":["דיני שנים שדנו לשמואל","ב\"ד חצוף בדיני ממון","לדברי הכל אין דיניהם דין","דיני ממונות לשמואל ולר' אבהו","בית דין חצוף אינו דין","שנים שדנו בלא שיטה"],"דיני נפשות ונתתה נפש תחת נפש":["ונתתה נפש תחת נפש לממון","נתינה למעלה ממון ולמטה","דיני נפשות לר' בממון","נתינה בנפש כממון","תחת נפש בדין ממון","נפש תחת נפש בדיני ממונות"],"דיני מכות דלרבנן בשלושה ולרבי ישמעאל בעש":["דיני מכות בשלשה לרבנן","לר\"י בעשרים ושלשה במכות","מכות בשלשה ובעשרים ושלשה","מניין דיינים במכות","מכות לחכמים ולר' ישמעאל","דיני מכות במניין הדיינים"],"בין נגע לנגע בין נגעי אדם נגעי בתים נגעי":["נגעי אדם ונגעי בתים לבית","בהרת קדם לשער לבן","שני גריסין בנגעי בתים","נגעי בגדים לפריחה בבגדים","קרחת וגבחת בבגדים","טומאת נגעי אדם מסימנים"],"דברי אלו הערכין והחרמים והקדישות":["הערכין פחות מבן חדש","סתם חרמים לבדק הבית","סתם חרמים לכהן","קדש קדשים בקדשים קלים","צינורא שהקדש צריכה עשרה","הקדשות בצינורא ובפדיון"],"ריבת זה השקאת סוטה ועריפת העגלה וטהרת מצ":["מי מקנא ומי משקה בסוטה","מדידת עגלה ערופה מהטיבור או מהחוטם","טהרת מצורע בשמאל לר\"ש","השקאת סוטה על פי עד אחד","חלוקת רבנן באוזן ימנית של מצורע","מקור השקאת סוטה ועריפת העגלה"],"בשעריך זה לקט שכחה פיאה":["שיעור לקט שכחה ופיאה","שלש לעני וארבע לבעל הבית","פיאה מן העיסה לדעת ר\"י","מי שלא הפריש פיאה מן הקמה","שני שבלין לקט ושלשה אינם לקט","מחלוקת ב\"ש בשכחה ובפיאה"],"משרבו תלמידי שמאי והלל שלא שמשו כל צרכן ":["שתי תורות מחלוקת תלמידי שמאי והלל","מחלוקת שרבתה משום שלא שמשו","כשרבו מחלוקות נעשתה תורה שתי תורות","שמאי והלל וגורם המחלוקת","שלא שמשו רבותיהם כראוי","הסיבה לריבוי מחלוקת בישראל"],"משם כותבין ושולחין בכל מקומות כל מי שהוא":["מי ראוי לדיין בעירו","מדרגות הקידום של חכם ושפל ברך","ענוותן הוא בן העולם הבא","עולא בר אבא כמודל לענוה","ענוה כתנאי לישיבת הדין","מעלה להר הבית ולשכת הגזית"],"חומר בדברי סופרים מבדברי תורה":["אין תפילין מחומר תורה","חמש טוטפות חייב כדברי סופרים","עבירה על דברי סופרים בתוספת","הכופר בתפילין לעבור על תורה פטור","חומר דברי סופרים מדברי תורה","חיוב על תוספת חמש טוטפות"],"אינו חייב אלא על דבר שעיקרו מדברי תורה ו":["מי חייב על מצוה מדברי סופרים","רק תפילין כרבי יהודה","לולב וציצית אינם כתפילין","קשר עליון מדברי סופרים","גרוע ועומד בתפילין בית חיצון","עיקר מן התורה ופירוש מדברי סופרים"],"אין ממיתין אותו לא בב ד שבעירו ולא בב ד ":["הזקן הממרא מובא לבית הדין הגדול","מיתה ברגל לדעת ר\"ע","כתיבת שלוחים בדבר מיתת דיין","האם מענין דינו של מחויב מיתה","מיתה מיד לדעת ר\"י","משמרין אותו עד הרגל"],"והלא אמר ישמעו וייראו ולא יראו וייראו למ":["למה לא ענינו דינו של זה","ישמעו וייראו ולא יראו","ממיתים מיד בלא עיכוב","טעם דר\"י לא לדחות את הדין","ביאור הפסוק ישמעו וייראו","שליחים נכתבים לכל המקומות"],"נביא השקר":["נביא השקר מיתתו בידי אדם","כובש נבואה ונביא שעבר על דבריו","מתנבא בשם ע\"ז ואף לטהר טמא","הבא על אשת איש שנכנסה לנשואין","זוממי בת כהן ובועלה","שלשה מיתתן בידי אדם ושלשה בידי שמים"],"שלשה מיתתן בידי אדם ושלשה מיתתן בידי שמי":["כל מיתה בתורה סתם היא חנק","הנביא המדבר מה שלא נאמר לו","הנביא המדבר בשם ע\"ז","דרשת ואשר לא צויתיו","לחבירו צויתיו ונביא אחר","פסוק ומת הנביא ההוא לחנק"],"מדיחי עיר הנדחת רבנן בסקילה הדחה הדחה ממ":["מדיחי עיר הנדחת בסקילה לר\"ש בחנק","הדחה מנביא ודין מסית רבים","אין דנין הדיוט מנביא","עוקר הגוף בע\"ז ובשאר מצוות","מקצת הדרך בעבודה זרה","ללכת בה עשה ולא תעשה"],"ולא מקללת חכם אלישע שאף על חנם היא באה ד":["קללת חכם שאינה על חנם","בשער על עסקי השער","קללה שבאה על חנם","מדוע נכתב בשער בלא מיתה","ולא מקללת חכם אלישע","ביאור לשון בשער"],"אני אמית ואחיה יכול שתהא מיתה באחד וחיים":["תחיית המתים מן התורה","ישיר משה ודרשת הלשון","יבנה יהושע מכאן לתחיה","כל האומר שירה בעולם הזה","מיתה וחיים באחד כמחיצה ורפואה","יהללוך ללא ה' מכאן לתחיה"],"בשעה שהפיל נבוכדנצר הרשע את חנניה מישאל ":["ששה נסים ביום הכבשן","יחזקאל מחייה מתים בבקעת דורא","צף הכבשן ונפרץ הכבשן","יוצק זהב רותח לפיו של נבוכדנצר","נבוכדנצר ודרישת צלם הנהפך","ארבע מלכיות בכבשן האש"],"דניאל חנניה מישאל ועזריה דכתיב בהו אשר א":["חנניה מישאל ועזריה משאר השבטים","אשר אין בהם כל מום","שאנסו עצמם מן השחוק והשינה","דניאל מבני יהודה לבדו","כריבדא דכוסילתא בדניאל","כח לעמוד בהיכל המלך"],"כ ע ת ה ר אש ו ן ה ק ל א ר צ ה ז ב לו ן ":["אחרונים שהכבידו עול תורה","גליל הגוים לאחרונים","זבולון ונפתלי והאחרון הכביד","נס כעוברי הים ודורכי הירדן","אם חוזר בו מוטב","הקלו מעליהם עול תורה"],"עתידין ישראל דאכלי שני משיח":["אכילת משיח שני לעתיד","אין משיח שכבר נאכל בחזקיה","נברא העולם לדוד או למשה","מחלוקת למי נברא העולם","שיטת שמואל: למשה","ורי\"ו: העולם נברא למשיח"],"עתיד הקב ה להוציא נחל מבית קדשי הקדשים ו":["נחל יוצא מבית קדשי הקדשים","עץ המאכל והתרופה לעתיד","אבני טובות בשערי ירושלים","לגלוג התלמיד על רבי יהושע","אבני טובות שבספינה","דרשת אבנים טובות כעתיד"],"המחפש אחר טיבול ללחם אינו רעב וטול לחמו":["המחפש טיבול ללחם אינו רעב","נוטל לחמו מי שמבקש טיבול","משל לרעב שמחפש טיבול","סימן להעדר רעב בלחם","מי שאינו רעב אין לו לחם","פטור לחם למי שמבקש רוטב"],"מי שיש לו רווח בזקנו כו ע לא יכולים לו מ":["ביאור אשה טובה מתנה טובה","אשה רעה צרעת לבעלה","אשה יפה ואשרי בעלה","מילי מעלייתא דאשה","העלם עיניך מאשת חן","משוכבת חיקך שמור פתחי פיך"],"סימן זיר א רב א משרשי א חנינ א טובי ה ינ":["כל ימי עני רעים לבעלי תלמוד","טוב לב משתה תמיד לבעלי משנה","שני פירושים לכל ימי עני","אשה רעה וטובה לכל ימי עני","רחמני ואכזרי בפסוק עני","דעתו קצרה או רחבה לפסוק"],"הקורא פסוק של שיר השירים ועושה אותו כמין":["קריאת פסוק בזמנו מביאה טובה","שיר השירים כזמר במשתה","התורה חוגרת שק ומתאוננת","לכל זמן עיסוק: מקרא משנה תלמוד","בעלי תלמוד בהלכות החג","ודבר בעתו מה טוב"],"נבט ראה אש שיוצאת מאמתו סבר שהוא ימלוך":["נבט וחזון האש שיצאה מאמתו","ירבעם ולא נבט הוא המלך","סימן מלכות שטעה בו נבט","ראיה שנבט חשב למלוך","משל האש והמלכות","ירבעם יצא ממנו ולא מלכות"],"אחיתופל ראה צרעת שזרחה על אמתו סבר שהוא ":["אחיתופל וצרעת שזרחה על אמתו","בת שבע ולא מלכות מאחיתופל","איצטגניני פרעה וטעותם במי מריבה","הבן הילוד היארה תשליכהו","הטעות על עסקי מי מריבה","שלמה יצא מבת שבע"],"ושחטה שטים העמיקו ואני מוסר לכלם אמר הקב":["כל שאינו עולה לרגל עובר בעשה","מי שעולה לרגל ידקר בחרב","העמיקו לדבר כשטים לעשות שחיטה","שטים ואני מוסר לכלם בדברי הקב\"ה","הטעות מי יעלה לרגל על חרב","ביאור עולי רגל ודקירה בחרב"],"וביום פקדי ופקדתי עלהם חטאתם עת היא מזומ":["וביום פקדי ופקדתי עליהם חטאתם","יום פקודה עת לפורענות","פקדה חטא מזומנת לעונש","פרשת חטאים ביום הפקודה","עת פורענות בפסוק פקודה","ופקדתי את חטאתם בזמן"],"ויהי בעת ההיא וירד יהודה מאת אחיו עת מזו":["ירידת יהודה מאת אחיו לפורענות","עת מזומנת בירידת יהודה","ויהי בעת ההיא לפורענות","יהודה ואחיו בעת הפורענות","פסוק ירידה מאת אחיו בזמן","סיפור ירידת יהודה לדרשת העת"],"וילך רחבעם שכם מקום מזומן לפורענות בשכם ":["שכם מקום מזומן לפורענות","בשכם עינו את דינה ומכרו את יוסף","מלכות בית דוד נחלקה בשכם","ירבעם שיצא מפיתקה של ירושלים","רחבעם הולך לשכם לחטא","מקומות הרעה בשכם"],"וימצא אתו אחיה השילוני הנביא בדרך והוא מ":["שלמה חדשה ותורת ירבעם","אחיה השילוני ושניהם לבדם בשדה","שלמה חדשה שחידשו דברים","בת קול על בני אכזיב","כל הנהנה מן העולם הזה בלא ברכה","גוזל אביו ואמו בהנאה בלא ברכה"],"חבר הוא לאיש משחית חבר הוא לירבעם בן נבט":["חבר לאיש משחית לירבעם בן נבט","כשתי מקלות המתיזות זו את זו","ירבעם השחית ישראל לאביהם שבשמים","ביאור חבר הוא לאיש משחית","הקשר בין מקל למחלוקת","ירבעם החטיא חטאה גדולה"],"רגיל דרש בענין שלושה מלכים הללו דאין להם":["נדר החולה שלא לדרוש חזר בו","מנשה מופיע בחלום לרב","למחר נפתח בחברין","מהיכן מבצעים את המוציא","מדוע קורא מנשה לחבר","שלשה מלכים ודין חלקם לעוה\"ב"],"אחאב אח לשמים ד אח לצרה יולד":["אחאב אח לשמים אב לעבודה זרה","קלות אחאב כחמורות ירבעם","עמרי זכה למלכות בכרך אחד","אחאב זכה ל-22 שנים בכיבוד התורה","אין תלם שלא העמיד אחאב ע\"ז","עצור ועזוב בישראל לעולם הבא"],"ויצא הרוח ויעמד לפני ה ויאמר אני אפתנו ו":["רוח שקר בפי נביאי אחאב","נבות היזרעאלי ורוח השקר","צא ממחיצתי דבר שקרים","הנוקם נקמתו מחריב ביתו","רוח מלפני ה' ליפתות אחאב","דבר שקרים לא יכון לנגד עיני"],"ויעש אחאב את האשרה ויוסף וכו להכעיס את ה":["אחאב כפר באלהי ישראל","כתיבה על דלתות שמרון","אין לו חלק באלהי ישראל","אחאב להכעיס מכל מלכי ישראל","האשרה שעשה אחאב","הכופר בבורא נדחה מחלקו"],"ויבקש את אחזיהו וילכדהו והוא מתחבא בשמרו":["אחזיהו מוחק אזכרות וכותב ע\"ז","מתחבא בשומרון לשמות הקודש","אחזיהו קודר אזכרות ותחתיהן ע\"ז","כתיבת ע\"ז במקום שם ה'","מחיקת אזכרות בשומרון","ביאור מחיקת שם ה' בשומרון"],"מנשה א שנשה יה ב מנשה שהנשי את ישראל לאב":["שם מנשה מלשון נשיה","מנשה שהניא את ישראל מאביהם","נשי את ישראל לאביהם שבשמים","פירוש שמו של מנשה","שכחה כשם מנשה","שמות המלכים לשם מנשה"],"ולא יהי לעוה ב ד בן שתים עשרה שנה מנשה ב":["מנשה כאחאב אין לו חלק לעוה\"ב","שתים עשרה שנה במלכו וחמישים וחמש","הרע כאשר עשה אחאב","מנשה ואחאב בשלילת חלק העולם הבא","ארוך מלכות מנשה בירושלים","הרשע מנשה בלא חלק לעולם הבא"],"וגם דם נקי שפך מנשה הרבה מאד עד אשר מלא ":["מנשה הרג את ישעיהו","פסל משאוי אלף בני אדם","נפש צדיק אחד שקולה כעולם","פסל אחד נעשה לארבעה פרצופים","דם נקי שפך מנשה מאד","שכינה תראה ותכעס בפסלי מנשה"],"אחז העמידו בעלייה שנאמר ואת המזבחות אשר ":["אחז העמיד ע\"ז בעלייה","מזבחות על הגג של אחז","אחז ועבודה זרה בעליית הבית","מקום העבודה זרה של אחז","העלייה שהקטירו בה אחז","מזבחות אשר על הגג בעליית אחז"],"מנשה העמידו בהיכל שנאמר וישם את פסל האשר":["מנשה העמיד פסל האשרה בהיכל","פסל האשרה בבית שאמר ה' עליו","היכל ה' ומקום העבודה זרה","מנשה ואשרה בתוך הבית","אשים את שמי לעולם ופסל מנשה","שם מנשה בתוך ההיכל"],"אמון הכניסו לבית קדשי הקדשים ד כי קצר המ":["אמון הכניס ע\"ז לקודש הקודשים","קצר המצע מהשתרע לשני רעים","מסכה צרה מהתכנס ביחד","מי כתב כנס כנד מי הים","בכה יונתן על הפסוק","שני מושלים רעים לא יתכנסו"],"אחז בטל העבודה וחתם את התורה צור תעודה ח":["אחז ביטל את העבודה וחתם את התורה","צור תעודה חתום תורה בלמודי","חתימה על התורה בידי אחז","אחז שביטל את עבודת ה'","סתימת התורה בידי אחז","ביטול העבודה בימי אחז"],"אמון שרף את התורה והעלה שממית על גבי המז":["אמון שרף את התורה","אמון העלה שממית על המזבח","שריפת התורה והקטרת שממית","מעשי אמון במזבח","הקרבת שקץ על גבי המזבח","אמון מבטל את התורה במעשה"],"אחז התיר את הערוה מנשה בא על אחותו":["אחז התיר את העריות","מנשה בא על אחותו","אמון בא על אמו","כי הוא אמון הרבה אשמה","כלום יש לך הנאה ממקום שיצאת","להכעיס את בוראי"],"כשבא יהויקים אמר ראשונים לא ידעו להרגיזו":["יהויקים: הכסף והזהב שלנו","מיכה ופסלו המצוי לעוברי דרכים","פסל מיכה בעשן המערכה","ראשונים לא ידעו להרגיזו","לא מנו את יהויקים במלכים","הניח ה' למיכה משום פיו"],"מנשה מנו למרות אביו חזקיה דבן מזכה לאב ו":["מנשה נמנה למרות אביו חזקיהו","בן מזכה לאב ולא אב לבן","אחז לא נמנה מפני כבוד חזקיהו","גולגלתו של יהויקים זאת ועוד","אברהם לא הציל את ישמעאל","יהויקים לא נמנה כי נענש כבר"],"וישמח עליהם חזקיהו ויראם את כל בית נכתה ":["חזקיהו מראה לשליחי בבל את אוצרו","אשתו השקתה את השליחים","זין אוכל זין כלי מתכת","בית גנזיו של חזקיהו","חזקיהו שמח בשליחים","הראה להם ביתו ואוצרו"],"דורשי רשומות היו אומרים כולן באין לעוה ב":["כולן באין לעולם הבא לדעת דורשי רשומות","לי גלעד ולי מנשה פסוק על רשעים","מואב סיר רחצי זה גחזי","על אדום אשליך נעלי זה דואג","עלי פלשת התרועעי ודוד","ריעים זה לזה לעשותם"],"מדוע שובבה העם הזה ירושלים משבה נצחת וגו":["ישראל משיבה לנביא על שובבותה","אבותיכם איה הם והנביאים","עבד שמכרו רבו ואשה שגרשה בעלה","אי זה ספר כריתות אמכם","בעונותיכם נמכרתם לא בידי","דוד עבדי נבוכדנצר עבדי"],"בלעם הוא דלא שאינו לעוה ב הא אחריני כן ו":["בלעם אין לו חלק לעולם הבא","כלבים בעדר שהרגו את הזאב","תמות נפשי מות ישרים","מואב ומדין אין להם שלום","חולדה וחתול במשתה של חלב","ישובו רשעים לשאולה ואלו פושעי ישראל"],"וישבו שרי מואב עם בלעם ושרי מדין להיכן ה":["שרי מואב ומדין לאן הלכו","חוצפא מלכות בלא כתר","בלעם חיגר ברגלו אחת","שמשון חיגר בשתי רגליו","כלום יש אב ששונא את בנו","לינו פה הלילה והשיבותי"],"בלעם סומא באחת מעיניו היה שנא שתם העין":["בלעם סומא באחת מעיניו","קוסם באמתו שבא על אתונו","נפל וגלוי עינים לשון בלעם","בלעם ושמשון בלשון כרע שכב","שתם העין וגלוי עינים","בלעם וביאת האתון"],"וידע דעת עליון דעת בהמתו לא ידע דעת עליו":["בלעם לא ידע דעת בהמתו","ידע לכוון שעת כעס הקב\"ה","הלא אנכי אתנך לטעינא","ההסכן הסכנתי בלעם","דעת עליון לעומת דעת בהמה","אקראי בעלמא לדברי הבהמה"],"ויקם בלעם בבקר ויחבש את אתנו":["שנאה מבטלת שורה של גדולה","ויקם בלעם בבקר ולא לשמה","לעולם יעסוק אדם בתורה שלא לשמה","רות מזרע ארבעים ושתים קרבנות","מי מתקנא בבנו ותלמידו","ירושה כפולה לתלמיד ולבן"],"וענו אשור וענו עבר עד אשור עד אשור יהרגו":["עד אשור יהרגו ומשם ישעבדו","ענו אשור וענו עבר במלחמה","גזירת ענו אשור ועבר","פסוק עד אשור פורענות עתידה","הרוגים באשור ומשעבוד","כיצד נדרש ענו אשור ועבר"],"הנני הולך לעמי לכה איעצך אשר יעשה העם הז":["בלעם מקלל את עצמו ותולה באחרים","קלעים עם זונות בבית הישימות","זקינה מבחוץ וילדה מבפנים","עצה לזנות לשכור כלי פשתן","יין עמוני ויין נכרים","אלהיהם שונא זימה ובוא ואשיאך עצה"],"וישב ישראל בשטים ר א שטים שמה רי ה שנתעס":["שטים שמה שנתעסקו בשטות","ביאור השם שטים במדבר","ישראל בשטים לדרשת לשון השטות","שטים לדעת רי\"ה","וישב ישראל בשטים ומשמעו","עסק בדברי שטות בשטים"],"ותקראן לעם לזבחי אלהיהן":["ערומות פגעו בהן לדעת ר\"א","כולם נעשו בעלי קריין","ותקראן לעם לזבחי אלהיהן","ביאור ותקראן לעם בשטים","זבחי אלהיהן ומשמעות הקריאה","פגישה בערומות לפי ר\"א"],"רפידים ר א רפידים שמה רי ה שריפו עצמן מד":["רפידים שם מקום ושריפה מתורה","לא הפנו אבות אל בנים מרפיון ידים","כל מקום שנאמר וישב לשון צער","וישב ישראל בשטים ויחל לזנות","וישב יהודה לבטח איש תחת גפנו","ויקם ה' שטן לשלמה את הדד האדמי"],"הרגו בני ישראל בחרב אל חלליהם":["בלעם הרשע קיים ארבע מיתות","הרגו בני ישראל בחרב אל חלליהם","גיל בלעם שלשים ושלש או ארבע","פנקסו של בלעם והגיל","אנשי דמים ומרמה לא יחצו ימיהם","פנחס הרג את הליסטים בבלעם"],"כתיב דואג וכתיב דוייג":["דואג שיצא לתרבות רעה","תורתו של דואג משפה ולחוץ","מה תתהלל ברעה הגבור","יחזק ה' את דואג בשם רע","חיל בלע ויקאנו מבטנו","גם אל יתצך לנצח לדואג"],"יחתך ויסחך מאהל ושרשך מארץ חיים סלה אמר ":["יחתך ויסחך מאהל לדואג","איה ספר איה שקל במגדל הפורח","ארבע מאות קושיות לדואג ואחיתופל","שלש מאות הלכות במגדל הפורח","הקב\"ה לבא בעי ולא לתלמוד","דואג ואחיתופל שלא נפשטה קושייתם"],"והנה לקראתו חושי הארכי קרוע כתנתו ואדמה ":["חושי הארכי קרוע כתנתו לדוד","יפת תואר ודרשת סמוכין לדוד","מלך שכמותי יהרגנו בנו","עדיף לעבוד ע\"ז ולא לחלל השם","דוד כסוחר כותי שמוכר מעט מעט","בן סורר ומורה לכל נושא יפת תואר"],"ונקיתי מפשע רב אמר לפניו רבש ע מחול לי ע":["דוד נצטרע ששה חדשים","נסתלקה שכינה ופרשו סנהדרין","מחילה על חטא בת שבע","ששה חדשים לא נחשבים במנין","הבא על אשת רעהו לא ינקה","דוד וקבלת יסורין מחטא"],"בשעה שבנה שלמה את בית המקדש ביקש להכניס ":["שערים שדבקו בבית המקדש","עשרים וארבע רננות שלא נענו","אל תשב פני משיחך לדוד","שאו שערים ראשיכם לא נענה","שונאי דוד נהפכו כשולי קדירה","מחילה לדוד בכניסת הארון"],"יצר תינוק ואשה תהא שמאל דוחה וימין מקרבת":["יצר תינוק ואשה לשמאל דוחה","שלשה חלאים שחלה אלישע","אלישע שגירה דובים בתינוקות","שדחפו לגחזי בשתי ידים","ואלישע חלה אל חוליו","ימין מקרבת בתינוק ואשה"],"דור המבול אין להם חלק לעוה ב":["דור המבול אין להם חלק לעולם הבא","לא ידון רוחי באדם לעלם","נשמת דור המבול קשה בגיהנם","דור המבול התגאו בטובה","לאל סור ממנו הוא שאמרו","ישלחו כצאן עוילם וירקדון"],"מכל הבהמה הטהורה תקח לך שבעה שבעה איש וא":["מי שנעבדה בו עבירה לא נקלט בתיבה","הבהמה הטהורה שבעה שבעה","תבת עצי גפר ומבליגה","צהר תעשה לתבה אבנים טובות","אישות לבהמה ולא נעבדה בה עבירה","אבנים טובות לאור נח"],"תחתים שנים ושלשים תעשה":["תחתיים לזבל אמצעיים לבהמה","עורב משיב לנח: רבך שונאני","שנאת העורב לנח על שבעה ושנים","במותר לי נאסר לי בנאסר לא כל שכן","שלשה מדורי התיבה","ההבחנה בין מותר לאסור בשלוח עורב"],"ומנלן דנאסרו ד ובאת אל התבה אתה ובניך וא":["נח ואשתו נאסרו בתשמיש בתיבה","שלשה ששמשו בתיבה וכולם לקו","כלב נקשר ועורב נשאר רק","יונה מבקשת מזון מר ומסור לה'","עופות טהורים עם הצדיקים בתיבה","צער הבריות בתיבה ומזון לחיה"],"הזיקית לא ידע אבא נח מה אכלה עד שחתך רימ":["מה אכלה הזיקית בתיבה","תולעת מרימון לאכילת הזיקית","נח מגבל סובין במים לזיקית","אכילת הזיקית מן התולעת","נח לא ידע מה אכלה הזיקית","תולעת שנפלה מן הרימון"],"האריה חומו שחלה הזינו כדרב שהחום מזין לא":["חום האריה מזין עד שישה ימים","האריה ששבע מחום בלי מאכל","שיעור ימי הזנה בחום","חומו שחלה הזינו בתיבה","החום מזין לא פחות משש","אריה בתיבה ומכסה חומו"],"אורשינה עוף החול מצאו אבא נח שיושב בקינו":["אורשינה לא ביקשה אוכל","נח ואורשינה באכסניה","יהי רצון שלא תמות","אגוע עם קני וכחול ארבה ימים","עוף החול שישב בקינו","אורשינה ואורך ימי חיים"],"נחום איש גם זו היה רגיל דכל שהגיע עליו א":["נחום איש גם זו ודורון לקיסר","גם זו לטובה לנחום","עפר דאברהם שהפך לחרבות","הקיסר שמצא עפר בתיבה","אליהו ודורון הזהב","נחום שהסתכל בנסים"],"כשנפטר רבי יוסי שפעו מרזבי דציפורי דמא":["שפעו מרזבי ציפורי דמא בפטירת ר' יוסי","שור אחד ירעהו יום אחד","מי שאין לו שור ירעם יומיים","גזירת הרועה לפי שור","דינו של רועה בהמות שור אחד","ירעהו יום ושאין לו יומיים"],"אותו יתום שנתנו לו לרעות יומיים ולקח הבה":["יתום שרעה הבהמות והרגם","עור אחד לבעל שור ושני עורות לאין שור","סוף דין כתחילת דין","העורות לפי שיעור הבהמה","יתום מרעה מבהמה לשחיטה","יתום שקיבל לרעות שתי ימים"],"העובר בנהר יביא זוז אחד ושלא עובר יביא ש":["העובר בנהר משלם זוז אחד","מי שלא עבר משלם שני זוזים","תשלום דמי מעבר הנהר","מחיר המעבר בנהר לפי דין סדום","זוז לעובר ושני זוזים לאינו עובר","דינו של מי שלא עבר בנהר"],"ומי שהיה לו שורת לבנים כל אחד לקח אבן אח":["שורת לבנים ושקר האחד","כל אחד לקח אבן ואמר רק אחת","הגזלן בשורת לבנים","מי שטען שלקח אבן אחת","גזילת לבנים בשותפות","שנים עשר בעלי לבנים שכפרו"],"והזורע שומים או בצלים כל אחד לקח לו אחד ":["זורע שומים או בצלים ושקר","כל אחד לקח בצל אחד","גזילת הזורע מן הזרע","שמא לקח רק אחד","גזילת השומים לפי מנין","חלוקת השומים בין שותפים"],"ארבע דייני היו בסדום שקראי ושקרוראי זייפ":["ארבע דייני סדום ומעשיהם","שקראי ושקרוראי וזייפי","הכאת אשת חבירו שתתעבר שנית","פסיקת אוזן חמור חבירו בסדום","מטה דין ובעל הפצע","העובר בגשר משלם ארבעה זוז"],"אליעזר עבד אברהם הזדמן לשם הכוהו הגיע לפ":["אליעזר עבד אברהם בסדום","מקל לדיינים מתוך מחאה","תשלום החוב לדיין וכספו ישאר","אליעזר שהכה את הדיינים במקל","שכר הקזת דם באליעזר","דיני סדום לאליעזר"],"היתה להם מיטה כשהגיעו אורחין השכיבום עלי":["מיטת סדום שהארוך קוצר","אליעזר נדר שלא לישון על מיטה","מיטת סדום והמתחה","נדר אליעזר מיום מות אמו","כל עני מקבל דינר ולא לחם","תנאי הסדומים בהילולא"],"אותה הילולא שנקלע אליעזר לשם ולא הביאו ל":["הילולת סדום ואליעזר בקצה","הזמנתני מי הזמינך","לקח גלימתו וברח בכל סעודה","אליעזר אכל לכל סעודתם","ברח מן הסעודה בגלימה","תחבולה לאכילה בסדום"],"אותה ריבה שהוציאה לחם לעני בתוך כדה כשנת":["ריבה שהוציאה לחם לעני בכדה","דבש בחומה ודבורים שאכלו","זעקת סדום כי רבה","ריבה שנתגלתה מדבש","ביאור כי רבה על עסקי ריבה","הנתינה לעני שחטאה סדום"],"דתן שעבר על דת אל אבירם שאיבר עצמו מעשות":["דתן ואבירם: מורד ומסרב לתשובה","און שישב באנינות","אשת און בן פלת הצילתו","פלת שנעשו לו פלאות","בן ראובן שראה והבין","אשת קרח מסיתה לאיש"],"ויקמו לפני משה ואנשים מבני ישראל וגו מיו":["קראי מועד שידעו לעבר שנים","אנשי שם שהיה להם שם בעולם","משה שמע שחשדוהו באשת איש","כל המחזיק במחלוקת עובר בלאו","החולק על מלכות בית דוד ונחש","כל הנלחם ברבו כנלחם בשכינה"],"עשרת השבטים אינן עתידין לחזור":["עשרת השבטים אינם חוזרים לדעת ר\"ע","כיום הזה מאפיל ומאיר לר\"א","עשרת השבטים אין להם חלק לעולם הבא","אם מעשיהם כיום הזה אינם חוזרים","הדמיון לכיום הזה ביציאת השבטים","עזב ר\"ע לחסידותו והשיב"],"עשרת השבטים אין להם חלק לעוה ב":["שבטים בלא חלק לעולם הבא","ויתשם ה' מעל אדמתם באף","לעולם הבא יבואו בשופר גדול","הקדמה לשופר לעשרת השבטים","ר\"ע עזב לחסידותו על ישראל","דברי נבואה לגלות צפונה"],"ראהו שרחץ ראשו וישב לפני רב א ל ולא תמצא":["לא תמצא תורה במי שמחיה עצמו עליה","ולא תמצא בארץ החיים לרב","קללה או קריאה ולא תמצא","מקיש יציאה לביאה לגאולה","ביאת ישראל לארץ שנים מששים ריבוא","וענתה שמה כימי נעוריה לימות המשיח"],"אנשי עיר הנדחת אין להם חלק לעוה ב":["אנשי עיר הנדחת אין להם חלק","עדים והתראה לכל אחד ואחד","חומר ביחידים מביחידים בעיר הנדחת","נכסי צדיקים בעיר הנדחת אובדין","הנכסים של הרשעים בעיר הנדחת","הציל החמרה והגמלה העוברת"],"יצאו הן ולא שלוחין":["יצאו: ולא שלוחים","אנשים: אין פחות משנים","בני בליעל: בנים שפרקו עול","מקרבך ולא מן הספר","לאמר: עדים והתראה לכל אחד","לא נשים ולא קטנים בעיר הנדחת"],"אין לה רחוב לרי ש אינה נעשית עיר הנדחת ו":["אין לה רחוב לדעת רי\"ש","ר\"ע: עושים לה רחוב","אם מעיקרא משמע או השתא","עיר הנדחת שאינה נעשית","רחוב לעיר הנדחת לדעת ר\"ע","ביאור רחוב לעיר שנדחה"],"היו בה אילנות תלושין אסורין מחוברין מותר":["אילנות תלושין ומחוברין בעיר הנדחת","אילנות של עיר אחרת אסורים","יריחו ולא עיר אחרת על שמה","ארור האיש אשר יבנה את יריחו","באבירם בכורו ויסדה בשגוב צעירו","קללת יהושע על בניית יריחו"],"אחאב אוהבו היה וכהשגיע לנחם בבית האבלים ":["אחאב ואליהו בנחם בית האבלים","קללת יהושע מתקיימת לדורות","אליהו התשבי ביקש מטר","קללת משה דוחרה לא מתקיימת","מרב: מבי טבחי דאחאב","הנחל כרית והערבים מביאים לחם"],"ויהי מקץ ימים וייבש הנחל כי לא היה גשם ב":["שלוש מפתחות לא נמסרו לשליח","מפתח של תחיית המתים","אליהו קפדן והמפתח שאבד","משל הדלת ואיבוד המפתחות","חרון אף בעולם כאשר רשעים בו","לך אל אחאב ואתנה מטר"]}