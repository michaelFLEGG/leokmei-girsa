ָׁאוּל", "כָּל", "אִילַן", "סְרָק", "", "אַמָּה"], "אם העיר קדמה קוצץ ואינו נותן דמים, ואם אילן קדם קוצץ ונותן דמים,": ["אִם", "הָעִיר", "קָדְמָה", "קוֹצֵץ", "וְאֵינוֹ", "נוֹתֵן", "דָּמִים", "וְאִם", "אִילָן", "קָדַם", "קוֹצֵץ", "וְנוֹתֵן", "דָּמִים"], "לא יעשה אדם גורן קבוע בתוך שלו - אא\"כ יש לו נ' אמה לכל רוח,": ["לֹא", "יַעֲשֶׂה", "אָדָם", "גּוֹרֶן", "קָבוּעַ", "בְּתוֹךְ", "שֶׁלּוֹ", "", "", "יֵשׁ", "לוֹ", "", "אַמָּה", "לְכָל", "רוּחַ"], "מרחיקין את הנבלות ואת הקברות ואת הבורסקי מן העיר נ' אמה.": ["מַרְחִיקִין", "אֶת", "הַנְּבֵלוֹת", "וְאֶת", "הַקְּבָרוֹת", "וְאֶת", "הַבּוּרְסְקִי", "מִן", "הָעִיר", "", "אַמָּה"], "ת''ק: אין עושין בורסקי אלא למזרח העיר.": ["", "", "אֵין", "עוֹשִׂין", "בּוּרְסְקִי", "אֶלָּא", "לְמִזְרַח", "הָעִיר"], "ר''ע: לכל רוח הוא עושה, חוץ ממערבה, ומרחיק חמשים אמה.": ["", "", "לְכָל", "רוּחַ", "הוּא", "עוֹשֶׂה", "חוּץ", "מִמַּעֲרָבָהּ", "וּמַרְחִיק", "חֲמִשִּׁים", "אַמָּה"], "ר' יוסי: אף שהבור קודמת לאילן לא יקוץ, שזה חופר בתוך שלו וזה נוטע בתוך שלו.": ["", "יוֹסֵי", "אַף", "שֶׁהַבּוֹר", "קוֹדֶמֶת", "לָאִילָן", "לֹא", "יָקוֹץ", "שֶׁזֶּה", "חוֹפֵר", "בְּתוֹךְ", "שֶׁלּוֹ", "וְזֶה", "נוֹטֵעַ", "בְּתוֹךְ", "שֶׁלּוֹ"], "לא יטע אדם אילן סמוך לשדה חבירו – אא\"כ הרחיק ממנו ד'א, אחד גפנים ואחד כל אילן.": ["לֹא", "יִטַּע", "אָדָם", "אִילָן", "סָמוּךְ", "לִשְׂדֵה", "חֲבֵירוֹ", "", "", "הִרְחִיק", "מִמֶּנּוּ", "", "", "אֶחָד", "גְּפָנִים", "וְאֶחָד", "כָּל", "אִילָן"], "היו שרשים יוצאים לתוך של חבירו מעמיק ג' טפחים כדי שלא יעכב את המחרישה.": ["הָיוּ", "שָׁרָשִׁים", "יוֹצְאִים", "לְתוֹךְ", "שֶׁל", "חֲבֵירוֹ", "מַעֲמִיק", "", "טְפָחִים", "כְּדֵי", "שֶׁלֹּא", "יְעַכֵּב", "אֶת", "הַמַּחֲרֵישָׁה"], "אילן שהוא נוטה לרה\"ר - קוצץ כדי שיהא גמל עובר ורוכבו.": ["אִילָן", "שֶׁהוּא", "נוֹטֶה", "", "", "קוֹצֵץ", "כְּדֵי", "שֶׁיְּהֵא", "גָּמָל", "עוֹבֵר", "וְרוֹכְבוֹ"], "לרבי יהודה: גמל טעון פשתן או חבילי זמורות.": ["לְרַבִּי", "יְהוּדָה", "גָּמָל", "טָעוּן", "פִּשְׁתָּן", "אוֹ", "חֲבִילֵי", "זְמוֹרוֹת"], "לרבי שמעון: כל האילן כנגד המשקולת, מפני הטומאה.": ["לְרַבִּי