   "daf": "65b",
   "line": 4,
   "seg": 1,
   "ref": "Tosafot on Nedarim 65b:4:1",
   "text": "בכתובת אשתו - ולא אמרי' [דאין פותחין] בפרעון הכתובה דהוי נולד:",
   "dh": "בכתובת אשתו",
   "dhRule": "מקף",
