{"נזיר להזיר לעשות כינויי נזירות כנזירות ו":["כינויי נזירות כנזירות","ידות נזירות כנזירות","נזיר להזיר נזירות חלה על נזירות","נזירות חלה על נזירות","דרשת נזיר להזיר","כינויי נזירות וידותיהם"],"נדרים איש כי יפליא לנדור נדר נזיר להזיר ":["היקש נזירות לנדרים","לנדור נדר מקור הידות","מיפר נדרי בתו ובעל","מה נדרים עובר בבל יחל","נזיר להזיר לשון בני אדם","הקשי נזירות ונדרים זה לזה"],"יש תנא דמפיק לידות מ לנדור נדר":["מקור הידות בנדרים","לנדור נדר או כל היוצא","מחלוקת תנאים במקור הידות","ידות מכל היוצא מפיו","שתי דרשות לידות","מאין נלמדו ידות הנדר"],"כנדרי רשעים נדר בנזיר ובקרבן ובשבועה":["נדרי רשעים ונדרי כשרים","נדר בנזיר ובקרבן בלבד","נדרי כשרים לא אמר כלום","נדבה ונדר מה ההבדל","נדר של רשע ושל צדיק","הבחנת נדרי רשעים"],"האומר קונם קונח קונס הרי אלו כינויין לקר":["כינויי קרבן וחרם","כינויי נזירות וכינויי שבועה","אלו כינויין לנדרים","כינוי לקרבן ולחרם","כינויים לנדרים ולשבועה","רשימת כינויי הנדרים"],"כינויי כינויין דנדרים תני רב יוסף מקנמנא":["כינויי כינויין לקונם","כינויי כינויין לחרם ולנזירות","שמות חוזרים לכינויי נדר","מה דרש רב יוסף בכינויים","כינויי נדר שבכינוי","סדר כינויי הכינויים"],"כינויי כינויין דשבועה שבובאל ולא שבואל ש":["כינויי כינויין לשבועה","שבובאל ושבותיאל לא נדר","כינויי שבועה שאינם מועילים","אשיבתא וקרינשא לא אמר כלום","ספק כינויי שבועה","כינויי שבועה ואיזה מהם"],"נדר במוהי הרי אלו כינויין לשבועה":["במוהי לשבועה ולא במשה","כינויי שבועה במוהי","מוהי ומומתא שבועה","האומר במוהי משה","שבועה במומתא דאמר מוהי","כינוי שבועה ושם משה"],"האומר לחולין שאוכל לך לא כשר ולא דכי טהו":["לחולין שאוכל לך אסור","לחולין כחולין ולא קרבן","ירושלים ולא כירושלים","נדר באחד משמשי המזבח","מחלוקת ר' יהודה ור' מאיר בחולין","כאימרא כדירים נדר בקרבן"],"לחולין סבורה לאו לחולין אלא קרבן":["מכלל לאו אתה שומע הן","חולין שאוכל לך ולא שלא","דין לחולין לשון דרשה","תנאי ר' מאיר בלשון חולין","מכלל לאו בנדרי חולין","חלוקה בין חולין לקרבן"],"האומר קרבן עולה מנחה חטאת תודה שלמים שאנ":["קרבן שאוכל לך מחלוקת","ר' יהודה מתיר בקרבנות","לקרבן לא אוכל לך","מחלוקת ר' מאיר ור' יהודה בקרבן","כינוי קרבן בחיי הקרבן","אסור קרבן שאוכל לך"],"קרבן הקרבן כקרבן שאוכל לך אסור":["הא קרבן והא עולה","הקרבן בחיי קרבן","לקרבן לא אוכל לך למיעוט","ר' מאיר נעשה כאומר לקרבן","אם מודים חכמים בקרבן","הא דאמר קרבן ולא הקרבן"],"האומר לחבירו קונם פי מדבר עמך ידי עושה ע":["קונם פי מדבר עמך","אבר שנאסר בנדר","נדר פה ידים ורגלים","קונם על איברי הדיבור","הבדלי נדרים משבועות","איברים שנאסרו בקונם"],"חומר בנדרים מבשבועות שהנדרים חלין על המצ":["חומר נדרים מבשבועות","נדרים חלים על המצוה","שבועות חלות על יש ואין","השוואת נדר לשבועה","חומר בשבועה ובנדר","נדר על מעשה ודיבור"],"דווקא באמר חולין שאוכל לך הא אמר לחולין ":["חולין ממילא נסבה","לשון חולין בלא שאלה","מה נדרש בלשון לחולין","ואיידי דתני רישא תני חולין","מודר בחולין בלא שאלה","דווקא אמר חולין בלשון אוכל"],"קונם שאני ישן שאני מדבר שאני מהלך האומר ":["נדר ואיסור אינו תנאי","קונם עיני בשינה","נזהר באיסור ולא בתנאי","קונם שאני ישן למחר","קונם לאשה משמשך","נדר על שינה ודיבור"],"קונם עיני בשינה היום אם אישן למחר":["נזהר אדם באיסור ולא בתנאי","הנודר שינה היום ומחר","איסור ותנאי בנדר שינה","ישן היום ולא חיישינן","קונם עיני בשינה תנאי","תנאי בנדר על שינה"],"שבועה שאיני ישן שאיני מדבר שאיני מהלך אס":["שבועה שאיני ישן אסורה","שבועה שלא אוכל ושאוכל","קרבן לא אוכל לך מותר","ר' מאיר נעשה כאומר לקרבן","שבועה לעתיד מלשון שלילה","לקרבן יהא לא אוכל לך"],"מתני ר מ דר י לא שאני בין קרבן להקרבן":["לקרבן לא אוכל לך מחלוקת","מכלל לאו אתה שומע הן","נעשה כאומר לקרבן יהא","שלילה בקרבן ובהקרבן","ר' מאיר והקרבן לא אוכל","מה נאמר בקרבן לא לקרבן"],"שבועה לא אוכל לך הא שבועה שאוכל לך לא שב":["שאוכל ושלא אוכל בשבועה","שבועות שתים שהן ארבע","לשון שאוכל ודקדוק השבועה","אביי ורב אשי בשבועה שאוכל","שבועה שלא אוכל מלשון מסרבין","לשון שבועה דאכילנא"],"מכלל דהא שבועה שאוכל לך דלא אכילנא משמע":["שאוכל שתי לשונות משמע","אביי לא אמר כרב אשי","שלא אוכל משמע לא אוכל","תיקון לשון שבועה שאוכל","פסקה שאוכל לנדר ושבועה","ארבע שבועות בלשון אכילה"],"רק באמר הריני נזיר היום הריני נזיר למחר":["נזיר היום ונזיר למחר","נזירות בתוך נזירות","אין שבועה בתוך שבועה","יש נדר בתוך נדר","קושיית אין שבועה בתוך שבועה","הריני נזיר היום כפול"],"סתם נדרים להחמיר":["סתם נדרים לחומרא","ספק נזירות להקל כר\"א","המקדיש חייתו ובהמתו","ספק בכורות טעונים הוכחה","ממונו מכניס לספק","ספק נזירות לחומרא ולקולא"],"נדר בחרם ואמר לא נדרתי אלא בחרמו של ים":["נשאלין על נדר בתלמיד חכם","פותח לנודר תלמיד חכם","מחלוקת נשאלין על הדרישה","עם הארץ שבא לישאל","נדרים שנדר בלשון מסוייג","לא נדרתי אלא בחרמו של ים"],"וכולן אין צריכין שאלה בד א בת ח אבל בעם ":["כולן אין צריכין שאלה","עם הארץ נענש ומחמירים","ת\"ח בלא שאלה","הבדל בין תלמיד חכם לעם הארץ","שאלה לת\"ח וללא ת\"ח","עונשין ומחמירין לעם הארץ"],"עונשין כדתניא מי שנזר ועבר על נזירותו":["נזיר שעבר על נזירותו","נזקקין לנזיר שעבר","ל' יום ליחס נזירות מרובה","מנדים את מי שנזקק לו","ר' יהודה בנזיר שעבר","איסור כימים שנהג היתר"],"ר א בן יעקב אומר אף הרוצה להדיר את חבירו":["נדרי זירוזין להדיר חבירו","כל נדר שאדור יהא בטל","תנאי בר\"ה על כל נדר","זכור בשעת הנדר לתנאי","ר\"א בן יעקב בתנאי נדרים","סתם תנא לנדרי קלות ראש"],"הרוצה שיאכל אצלו חבירו ומסרב בו ומדירו נ":["נדר ללא זכירת התנאי","עקר לתנאו וקיים לנדרו","נדר בלא זכירה כלל","הנודר על דעת ראשונה","מחלוקת זכור ושאינו זכור","דרשה בפרקא ודרשה בתנא סתם"],"נדרי הבאי אמר קונם אם לא ראיתי בדרך הזה ":["נדרי הבאי","קונם אם לא ראיתי נחש","נדר שנאמר על דבר הבאי","קונם על דרך עולי מצרים","נדרים על דבר שאינו נעשה","נדר ביאור דרך ונחש"],"נדרי שגגות אם אכלתי ואם שתיתי ונזכר שאכל":["נדרי שגגות ואי ידיעה","אכל ושתה בשכחה","ראה אותן אוכלין תאנים","בש\"א ובה\"א בנדרי שגגות","אלו ואלו מותרין בשגגה","נדרי שגגה על אחרים"],"שהתפיס זכויותיו בב ד ואמר שאם לא יבוא עד":["נדרי אונסין ואסמכתא","התפיס זכויותיו ואנוס","גט מעכשיו נדרי אונסין","אסמכתא קניא בב\"ד","שמואל לאו שמיה ביאה","נדר אסמכתא וכסף בטעות"],"דינא דמלכותא דינא":["דינא דמלכותא בנדרים","מוכס שאין לו קצבה","מוכס העומד מאליו","נדר למוכס ודין המלכות","נדר לתשלום מכס","דינא דמלכותא במוכס"],"הרי נטיעות האלו קרבן אם אינן נקצצות טלית":["נטיעות קרבן ופדיון","טלית לשריפה ופדיון","קדושות עד שיקצצו","דליקה ורוח בנדר טלית","נדר בקדושה עד זמן","פדיון לקדושה בתנאי"],"ולא תני קדושות ואין קדושות":["קדושות ללא פדיון","נדר כשיש רוח ודליקה","תנא גם רישא יש פדיון","עבר היום ולא נקצצו","נטיעות נקצצות היום","נדר טלית מסופק בשריפה"],"הנודר מיורדי הים מותר ביושבי היבשה":["יורדי הים ויושבי היבשה","נדר מיורדי הים לפי כוונה","מי שדרכו לפרש בים","הואיל וסופו ליבשה סליק","מחלוקת על נודר מיורדי הים","נדר מיושבי היבשה ביורדי הים"],"חד מתני ארישא וחד מתני אסיפא":["מאן דתני ארישא ואסיפא","הנודר מיושבי יבשה","כוונת הנודר לדרך ים","ליורדי הים חלות שתי לשונות","לשון מתני ארישא ואסיפא","מי הכלול בשם יורדי הים"],"הנודר מרואי החמה אסור אף בסומין":["נודר מרואי החמה ובסומים","מדלא קאמר מן הרואין","נדר מרואי החמה לדגים","סומין אסורים לנודר מרואי החמה","לאפוקי דגים ועוברים","סומין ואף שאינם רואין"],"מדלא קאמר מן הרואין לאפוקי דגים ועוברים":["לשון מן הרואין מוציא דגים","דגים ועוברים שאינם רואין","מיעוט דגים ועוברים בנדר","לשון הרואין מוציא עוברים","נדר מן הרואין כלל ופרט","מדלא קאמר רואין ולא עוברים"],"הנודר משחורי הראש אסור בקרחין ובעלי שיבו":["נודר משחורי הראש לקרחים","שחורי הראש אנשים בלבד","נשים וקטנים בנדר שחורי הראש","קרחים ובעלי שיבות אסורים","שחורי הראש מלשון אנשים","נדר משחורי הראש בקטנים"],"ומותר בנשים וקטנים מדלא אמר מבעלי שער":["בעלי שער ולא שחורי ראש","נשים וקטנים מותרים בנדר","לשון שחורי הראש מיעוט","שאר בשר ושער בנדר","מבעלי שער לעומת שחורי ראש","בעלי שער כלל בנדר שחורי ראש"],"הנודר מן הילודים מותר בנולדים מן הנולדים":["נדר מן הילודים ומן הנולדים","ר' מאיר מתיר בילודים","הנודר מן הנולדים מותר בילודים","דברה תורה כלשון בני אדם","נולד לבית דוד בנדר","לשון נולד ולשון ילוד"],"שובתי שבת היינו מצווים על השבת":["נדר מבני נח ומזרע אברהם","עולי ירושלים וכותים בנדר","מצווה ועושה בישראל וכותים","נהנה לבני נח ולזרע אברהם","כי ביצחק יקרא לך זרע","שובתי שבת ומצווים"],"כיון דאיקדש אברהם נקראו על שמו ויצאו משם":["זרע אברהם ביצחק ולא בישמעאל","אברהם נקרא על שמו בנדר","ביצחק יקרא לך זרע בנדר","בני נח ויוצאי אברהם","ישראל וזרע אברהם בנדר","שאיני נהנה לזרע אברהם בישראל"],"כי ביצחק יקרא לך זרע ולא בישמעאל ביצחק ו":["ביצחק ולא בישמעאל ולא בעשיו","כל יצחק לא עשיו בזרע","זרע יצחק בלבד לנדר","יצחק ולא כל יצחק","מי נקרא זרע אברהם בנדר","כי ביצחק ולא לכל יצחק"],"שאיני נהנה מישראל לוקח ביותר ומוכר בפחות":["מוכר בפחות ולוקח ביותר","נדר מהנאה מישראל במקח","שוה בשוה בהנאת לוקח","שישראל נהנין לי ואין שומעין","כלי מן האומן ונאנס בידו","נאנסו בהליכה כשכיר"],"הלוקח כלי מהאומן לבקרו ונאנס בידו חייב ד":["ספסר שלקח חמור למכור","נושא שכר ונאנס בהליכה","בזבינא חריפא ומיצעא","הנאת לוקח וגזירת שוה","דרמי על אפיה בזבינא","מוכר לפי טובת הנאה"],"קונם שאני נהנה לערלים מותר בערלי ישראל ו":["נדר מערלים ומולים","הערלה שייכת לעכו\"ם","גדולה מילה בנדר","מילה דוחה שבת","מאוסה הערלה ואכילת מילה","גדולה מילה שכל זכיות משה"],"גדולה מילה שכל זכיות שעשה משה רבינו לא ע":["גדולה מילה ממשה רבנו","צפורה כרתה ערלת בנה","לא שטן אלא תינוק","משה התרשל במילה","ויפגשהו ה' ויבקש המיתו","אמול ואשהא שלושה ימים"],"וירק את חניכיו ילידי ביתו רב שהוריקן בתו":["וירק את חניכיו בתורה או בזהב","רב ושמואל בחניכי אברהם","חניכי אברהם שהוריקן","מחלוקת רב ושמואל בוירוק","חניכיו ילידי ביתו בזהב","וירוק חניכיו בזהב ובתורה"],"שמנה עשר ושלש מאות":["אליעזר כנגד שלש מאות ושמונה עשר","אברהם בן שלש שנים הכיר בוראו","השטן בגימטריה שס\"ד","רמ\"ג ורמ\"ח אברים","עיר קטנה ומשל היצר","אברהם ואברם בחשבון"],"החכמה תעוז לחכם זו תשובה ומעשים טובים מע":["כהונה מברכת אברהם למלכי צדק","ברכת עבד לפני ברכת קונו","ואין זרעו כהן","והוא כהן לאל עליון","ברכת אברהם הוציאה הכהונה","מלכי צדק וברכת כהונה"],"וכל דבר שאין עושין בו אוכל נפש מקום שמשכ":["שאין עושין בו אוכל נפש","מקום שמשכירין כיוצא בהן","אף שאין משכירין אסור","כראב\"א דר' אליעזר הוא","הנודר מדבר שאין בו אוכל נפש","דבר שאין בו אוכל נפש ומשכירין"],"מכלל דרישא אף שאין משכירין וכראב א דר אל":["מכלל דרישא אף שאין משכירין","כר' אליעזר בשאין משכירין","אסור אף שאין משכירין","שאר דברים מכלל לאו","משכירין כיוצא בהן לאיסור","כראב\"א בדבר שאין משכירין"],"המודר הנאה מחבירו":["מודר הנאה ושקילת חובו","מקום שנוטלין שכר תפול להקדש","חנן איבד מעותיו בחוץ לארץ","ישבע כמה הוציא ויטול","הניח מעותיו על קרן הצבי","מבריח ארי מותר למודר"],"כחנן דמבריח ארי בעלמא הוא ומותר":["כחנן מבריח ארי בעלמא","מי שהלך למדה\"י ופירנס אשתו","ישבע ויטול בהוצאה","גזירה שלא יפרע משום יפרע","כרבא ולא כרה\"ו במודר","גזירה שלא ליפרע משום ליפרע"],"ותורם את תרומתו ומעשרותיו לדעתו":["כהנים שלוחי דידן או דשמיא","קרבנות מודר הנאה ומחוסרי כפרה","זאת תורת הזב ותורת היולדת","מודר הנאה ודעת הכהן","מלמד מדרש ואינו מלמד מקרא","מודר הנאה ומלמד בניו מקרא"],"איבעיא להו כהני שלוחי דידן או שלוחי דשמי":["קטנה ומעוברת ומניקה במוך","זאת תורת היולדת לפקחת ושוטה","קרבן על אשתו השוטה","אדם מביא קרבן על אשתו","שלוחי דידן ושלוחי דשמיא בכהנים","קרבן על אשה שוטה ומעוברת"],"הכל צריכין דעת חוץ ממחוסר כפרה שהרי אדם ":["הכל צריכין דעת חוץ ממחוסר כפרה","אין מפריש חטאת חלב על חבירו","קרבן על אשתו השוטה","פסח על חבירו לא עשה כלום","שה לבית אבות לאו דאורייתא","האומר שוחט פסח על מי שיעלה ראשון"],"וזן המדיר את אשתו ואת בניו של מודר אף שה":["מזון בהמה למודר הנאה","זן את הטמאה ולא את הטהורה","מודר הנאה משיא בתו","נכסי אבי כלה אסורים על החתן","מוכרה לעכו\"ם או מאכילה לכלבים","מודר הנאה ובהמה טהורה וטמאה"],"המודר הנאה מחבירו מותר להשיא לו בתו":["המודר הנאה משיא בתו לחתן","בתו בוגרת ומדעתה","אין מוסרין שפחה לשמש","נכסי אביו של החתן במודר","בתו בוגרת מותרת בהשאה","נדר מבתו הבוגרת ומדעתה"],"המדיר בנו לתלמוד תורה":["מודר בן ללימוד תורה","מילוי חבית מים לאב מודר","הדלקת נר לאב מודר","כוס שלום למודר הנאה","כוס יין של בית האבל בבבל","מודר בן לתלמוד תורה לאב"],"המודר הנאה מחבירו ונכנס לבקרו":["מבקר חולה במודר הנאה","עומד ולא יושב במבקר","שואלו בשוק כשחלה בנו","גזירה שמא ישהא בישיבה","מבקר חולין מן התורה","גזירה שמא ישהא בעמידה"],"מיירי בשנכסי מבקר אסורין על החולה":["חולים בעריסתן ומבקרים","מה הבריות אומרים על מבקר","אם בריאה גיהנם יברא","נכסי מבקר אסורים על החולה","ביקור חולין ודרשה מן המקרא","גיהנם יברא אם בריאה"],"ואתה בן אדם עשה לך כלי גולה זו נר וקערה ":["בחוסר כל מה חסר לעני","עני אלא בדעה","קנה דעת מה חסר","חולה ומחילת עונות","שכח תלמודו ולימד שבעה פנים","אביי וחזרה על משנה"],"כובס ששמע לרבי כשגרס ור ח למד מהכובס וחז":["כובס ששמע לרבי","רבי ויוחנן בדעת המקום","אש של חולה של שמים","כשבא קיצו של אדם הכל מושלים","למשפטיך עמדו היום","אין מבקרים אלא למי שחלצתו חמה"],"לא באמבטי ולא במטה גדולה וקטנה":["מרחץ אמבטי ומטה בחולה","רוחץ עמו באמבטי גדולה","אוכל עמו על השולחן","תמחוי חוזר לבעה\"ב","מיסב עמו על המטה","מיסב עמו על המטה בחולה"],"לא יאכל עמו מן האבוס שלפני הפועלים":["אבוס הפועלים ומודר","אומן ברחוק ממנו","גזרו רחוק משום קרוב","אסור בקרוב מותר ברחוק","ר' מאיר בגזירת רחוק","ר' מאיר לגזור רחוק משום קרוב"],"בקרוב לכו ע אסור":["בקרוב לכולי עלמא אסור","ברחוק לר' מאיר גזירה","לרבנן לא גזרו ברחוק","קרקע לפניו בגזירה","מודר בעבודה ברחוק","ר' מאיר בגזירה לחלקו"],"המודר הנאה מחבירו לפני שביעית אינו יורד ":["מודר הנאה ושביעית","נכסים אלו עליך ונוטות","אוסר דבר שברשותו","שביעית ואכילה מן הנוטות","לרב ושמואל אוסר דבר שברשותו","שביעית ומודר הנאה מנטיעות"],"נכסים אלו עליך לפני שביעית אין יורד לתוך":["נכסים עליך ונכסי עליך","אדם אוסר דבר שברשותו לכשיצא","ר' יוסי בנכסים לשנה","נכסי ומרשותו בשביעית","מה ההבדל בין נכסי לנכסים אלו","אסור דבר שברשותו ר' יוסי"],"המודר הנאה מחבירו לא ישאילנו ולא ישאל ממ":["מודר הנאה במשא ומתן","לא ישאילנו ולא ישאל ממנו","גזירה שאלה משום השאלה","נדרו הנאה זה מזה","לא ילונו ולא ילוה","מודר הנאה במשא ומתן ולוה"],"לא ילונו שמהנה לו":["אביי גזירה לשאול משום להשאיל","ריב\"ח כגון שנדרו הנאה זה מזה","שאלה ודינה בנדרי הנאה","הלוואה מן המודר בגזירה","איסור שאלה ולהשאיל במודר","גזירה לשאול משום להשאיל"],"אמר לו השאילני פרתך אמר לו אינה פנויה":["פרה שאין דרכה לחרוש","מודר הנאה ואין לו מה יאכל","נותן לחנוני ואוכל","מניח על הסלע מופקר","פועלים מודר הנאה","הנודר שדי לחרוש בה"],"קונם פירות האלו עלי הן על פי הן לפי אסור":["פירות אלו עלי בחילופיהם","אוסר פירות חבירו על עצמו","חילופין כגידולין בנדר","נדר בע\"ח נפרעין","מדמקדש בערלה אינה מקודשת","חילופין וגידולין בנדר פירות"],"הריני עליך חרם המודר אסור":["הריני עליך חרם בעולי בבל","חרם בהר הבית ובמקומות","כותב חלקו לנשיא","אנשי גליל לא צריכין לכתוב","ר' יהודה כותב לנשיא","הריני עליך חרם בתקנה"],"איזה דבר של אותה העיר ותקנתן יכתבו חלקן ":["איזה דבר של אותה העיר","ותקנתן יכתבו חלקן לנשיא","כותב לנשיא שלא צריך לזכות","ר' יהודה אחד כותב לנשיא","אחד זה ואחד זה צריכין לזכות","כותב לנשיא ולהדיוט בחרם"],"המודר הנאה מחבירו ואין לו מה יאכל":["מתנה ונדר הנאה בבית חורון","סעודה לפניך כדי שיבא אבא","כל מתנה שאינה מקודשת","סופו מוכיח על תחילתו","מודר שבא לאכול בחצר הבן","סעודה בחצר לאביו ולא לשם מתנה"],"ואם הוכיח סופו על תחילתו אסור ומעשה גם ב":["סופו מוכיח על תחילתו מתנה","הן לפניך יבא אבא אסור","סעודתו מוכחת עליו","מדעתך הוא דאמר ליה","מתנה מוכחת על הקדשה","מתנה לאחר שהוכיחה סעודתו"],"אותו שאסר נכסיו על בנו הגזלן או משתמט מל":["אסר נכסיו על בנו הגזלן","סודר קנה על מנת להקנות","הקנאה על מנת להקנות","בנו שאינו בעולם נכסים","נכדו שיקנה שאינו בעולם","נכסי בנו הגזלן ומקח הנכדים"],"לא לחנם פיזר בן אלעשה מעותיו אלא להראות ":["בן אלעשה ותספורת כהן גדול","תספורת כה\"ג כעין לולינית","כסום יכסמו את ראשיהם","ראשו של זה בצד ראש זה","פיזור מעות בתספורת","תספורת כהן גדול בזהב"],"הנודר ממעשה קדרה אסור רק ממעשה רתחתא":["מעשה קדרה ומעשה רתחתא","קונם היורד לקדרה","נדר באיסור ירד לקדרה","קדרה שאני טועם בכל הנעשה","נדר מרתחתא ולא מקדרה","נדר מעשה קדרה כבשר"],"הנודר מן היורד לקדרה אסור ביורד לאלפס":["יורד לאלפס לפני קדרה","מן היורד לתנור אסור בפת","נדר מעשה תנור בכל הנעשה","הנודר מן היורד לקדרה ולאלפס","סדר מעשים בנדרי מאכלים","יורד לתנור בפת ובשאר נעשה"],"מן הכבוש אסור רק בכבוש של ירק":["כבוש שאני טועם בכל הכבושים","שלוק של בשר בנדר","דכביש דשליק דצלי דמליח","נדר מן השלוק כבשר","מאכלים מבושלים ומלוחים בנדר","שלוק ומליח בנדר מאכל"],"מן הצלי לר י אסור רק בצלי של בשר":["צלי שאני טועם בכל הצלויים","מן המליח רק של דג","נדר מן הדג לכל הדגים","מליח שאני טועם בכל המלוחים","ר' יהודה בצלי ובמליח","צלי ומליח בנדר מאכלים"],"דג שאני טועם אסור בגדולים ומותר בקטנים":["דג ודגה בנדר גדולים וקטנים","דגה שאני טועם לקטנים","נדרים הולכים אחר לשון בני אדם","דג בין חיים למבושלים","דג שאני טועם בגדולים ובקטנים","דגה לקטנים ודג לגדולים"],"הנודר מן החלב מותר בקום ור יוסי אוסר":["חלב וקום בנדר","מן הגבינה אסור במלוחה וטפלה","נדר מן הבשר ורוטב וקיפה","מעשה בביצים שנתבשלו עם בשר","ר' טרפון ובשר בתבשיל","הנודר דבר ונתערב באחר"],"מן העדשים אסור באשישים ור יוסי מתיר":["קרו לחלב חלב ולקומא קומא","מר כי אתריה ומר כי אתריה","מותר בקום ובחלב נדר","הנודר מן היין ותבשיל טעם יין","במקומו של ר' יוסי קומא דחלבא","בשר זה עלי וברוטבו וקיפו"],"הנודר מן הענבים מותר ביין מן הזיתים מותר":["ענבים ויין בנדר","זיתים ושמן בנדר","יוצא מהן בנדר ענבים","קונם זיתים וענבים ויוצא מהם","נדר פרי ויוצאיו","נדר מפרי לשמן ויין"],"הנודר מן התמרים מותר בדבש תמרים":["תמרים ודבש תמרים בנדר","ר' יוסי בן בתירא בשם תולדתו","חכמים מתירים ביוצא הימנו","שם תולדה בנדר","מסתוניות וחומץ סתוניות","נדר מתמרים ודבש ומה יוצא"],"הנודר מן היין מותר ביין תפוחים מן השמן מ":["יין תפוחים ושמן שומשמין","נדר מן הירק ליוצאי השדה","הנודר משמן בארץ ישראל","שמן זית בבבל לנודר","ספק איסור לחומרא בשמן","כרישין וקפלוטות בנדר"],"הנודר מן השמן בארץ ישראל מותר בשמן שומשמ":["שמן שומשמין בארץ ישראל","מקום שמסתפקין מזה ומזה","ספק איסורא לחומרא","בבבל אסור שמן שומשמין","רובא לא אזלינן בנדר שמן","שמן שומשמין ושמן זית מתירים"],"מן הכרוב אסור באיספרגוס מן האיספרגוס מות":["כרוב ואיספרגוס בנדר","גריסין ומקפה בנדר","מקפה ושום ר' יוסי מתיר","עדשים ואשישים בנדר","חטה וגריס לכוס ולאפות","איספרגוס בנדר כרוב"],"חטה שאני טועם אסור לאפות ומותר לכוס":["חטה לאפות וחטין לכוס","גריס לבשל וגריסין לכוס","חטה חטין לכוס ולאפות","גריס גריסין בין לבשל בין לכוס","הנודר מחטה לא לחיים","גריסין ומקפה לכוס ולבשל"],"הנודר מן הדגן":["הנודר מן הדגן ופול המצרי","חמשת המינין בנדר תבואה","דגן וכפרוץ הדבר הרבו","נדר דגן מותר בפירות האילן","דגן כל דמידגן משמע","נדר מדגן ומפירות אילן"],"דדגן כל דמידגן משמע":["דגן כל מה שמידגן משמע","כפרוץ הדבר הרבו לאתויי ירק","ראשית דגן תירוש ויצהר","נדרים בדגן ופירות האילן","הדגן ומאי כפרוץ הדבר","ירק וכפרוץ הדבר בנדר"],"הנודר מן הכסות מותר בשק וביריעה ובחמילה":["נדר מן הכסות בשק וביריעה","צמר ופשתים עולה עלי","אסור בפונדא ובפסקיא","הרועים יוצאין בשקים","יוצאין בשק עבה בגשמים","הכל לפי הנודר לר' יהודה"],"הנודר מן הכסות מותר בשק וביריעה ובחמילה ":["שק וביריעה בנדר כסות","חגורה חלולה ואזור רחב בנדר","מכנסים וכובע לנודר כסות","לא בתיבה ולא בקופה בנדר","רועים ולא רועים בלבד בשק","כל אדם בשק דברו חכמים בהווה"],"הנודר מן הבית לר מ מותר בעלייה וחכ א עלי":["נודר מן הבית ומן העלייה","עלייה בכלל הבית לחכמים","נדר מן הבית בלי העלייה","ר' מאיר בעלייה ובית","בית ועלייה בנדר","עלייה בבית לחכמים"],"הנודר מן המטה לר מ מותר בדרגש וחכ א דרגש":["מטה ודרגש בנדר","דרגש בכלל מטה לחכמים","נדר מן הדרגש מותר במטה","ר' מאיר במטה ודרגש","ר' מאיר במטה לחכמים","דרגש ומטה בנדר"],"הנודר מן העיר מותר ליכנס לתחומה ולא לעיב":["נדר מן העיר ותחומה ועיבורה","נדר מן הבית עד האגף","לעיבורה של עיר בנדר","נדר בית אסור מן האגף ולפנים","נדר מן העיר ולא מעיבורה","לתחומה ולא לעיבורה"],"קונם פירות האלו עלי קונם הן על פי":["אסור בחילופין ובגידולין של פירות","מעשה ידיך עלי בחילופין","שאת עושה עד הפסח","דבר שזרעו כלה בגידולי גידולין","שאין זרעו כלה אסורין","נדר לאשה עד הפסח"],"כלכלה שאמרו כלכלה של תאנים ולא של ענבים":["כלכלה של תאנים ולא ענבים","הנודר מפירות הקיץ","ר' שמעון בן גמליאל ענבים בתאנים","תאנים נקצצים ביד בנדר","ענבים לא נקצצים ביד","נודר מפירות הקיץ ענבים"],"עד הקציר עד שיתחיל העם לקצור קציר חטין א":["עד הקציר לפי מקום הנדר","עד הגשמים ורביעה שנייה","עד שיפסקו גשמים ונדר ניסן","עד הקיץ בגליל ובעמקים","לפי מקום הנדר בהר ובבקעה","עד הקציר בבקעה לשעורין"],"הנודר עד הקיץ בגליל וירד לעמקים אף שהגיע":["הנודר עד הקיץ בגליל וירד לעמקים","קיץ גליל ועמקים בנדר","זמן הקיץ לפי המקום","לא יועיל קיץ העמקים בנדר","אסור עד הקיץ בגליל ולא בעמקים","הנודר עד הקיץ לפי המקום"],"קונם יין שאיני טועם לשנה נתעברה השנה אסו":["נדר לשנה ושנה מעוברת","עד ראש אדר הראשון","אדר ראשון ואדר שני בנדר","שנה מעוברת בנדר לשנה","עד סוף אדר ופרשת אדר","שנה מעוברת ואדר בנדר"],"אלמא סתמא דאדר דאמר ראשון הוא לימא מתני ":["אדר הראשון והבחנה בשנה מעוברת","עד ר\"ח אדר השני במעוברת","מי שידע שהשנה מעוברת","סתמא דאדר ראשון בנדר","ר\"מ וכותב אדר שני תיניין","נדר עד ר\"ח אדר במעוברת"],"ר י קונם יין שאיני טועם עד שיהא הפסח לא ":["עד הפסח ועד שעת שתייה","עד הצום ועד לילו","עד השבת ועד לילי שבת","לשון עד בנדר ועד שעה","האומר לחבירו קונם שאני נהנה לך","הפרת נדר שלא על פי חכם"],"ר מ יש דברים שהן כנולד ואינן כנולד ואין ":["כנולד ואינו כנולד בנדר","קונם שאני נושא את פלונית","נדר בית שנכנס בו נחש","אין חכמים מודים לר' מאיר","מת הכלב כמו שנהרג הנחש","נדר מנחש בבית"],"ועוד אמר ר מ פותחין לו מן הכתוב שבתורה ו":["פותחין מן הכתוב בנדר","לא תקום ולא תטור לנדר","נדר שלא לפרנס עני","למה עלי לפרנסו עם כולם","קרובים נופלים לפני הגבאי","נדר שלא לתת לעני"],"שיאמר למה עלי לפרנסו אעשה זאת עם כולם":["קרובים קודמים לגבאי בפרנסה","נדר לפרנס ענייך במצוה","פתח מן הכתוב לנודר עני","הנופל קודם לקרובים","למה עלי לפרנסו","הנופל לקרובים בנדר פרנסה"],"פותחין לאדם בכתובת אשתו":["פותחין בכתובת אשתו","נדר מאשתו וכתובתה","מוכר שער ראשך ונותן כתובה","אין מסדרין לבעל חוב","מטלטלין אין משועבדין לכתובה","מטלטלין וכתובה בנדר"],"בקרקע ששווה ח מאות דינר ולא שהמטלטלין יש":["קרקע ששווה ח' מאות בכתובה","מטלטלין לא ישועבדו לכתובה","אין מקרעין שטר כתובה","ר' עקיבא בקרקע ולא במטלטלין","שטר כתובה לא נקרע בנדר","ר' עקיבא במטלטלין לכתובה"],"פותחין בימים טובים ובשבתות":["נדר שהותר מכללו הותר כולו","קונם יין שהיין רע למעיים","קונם בצל שרע ללב","שאני נהנה לזה קרבן ולזה קרבן","ר' מאיר מתיר את כל הבצלים","בצל ויין שאינם נהנה למעיים"],"פותחין לאדם בכבוד עצמו ובכבוד בניו":["פותחין בכבוד עצמו ובניו","נדר מבת אחותו וייפוה","בנות ישראל נאות הן","ר' ישמעאל והעניות מנוולתן","קונם כעורה ונעשית נאה","בנות ישראל ביופי בנדר"],"ר ישמעאל אומר אף כעורה ונעשת נאה שחורה ו":["כעורה שנעשית נאה בנדר","שחורה שנעשית לבנה","קצרה שנעשית ארוכה בנדר","ר' ישמעאל על ההכרה בנדר","ייפוי בנדר קצרה לארוכה","כעורה שהתייפתה"],"אביה ובעלה מפירין נדריה":["אביה ובעלה מפירין נדריה","לא נתרוקנה רשות לבעל","נדר אשה בנעוריה ובית אביה","מיפר האב לבד","נדר בנעוריה ובית אביה","מיפר בעל ואב"],"לא נתרוקנה רשות לבעל ד בנעוריה בית אביה":["אב מפר לבד במות הבעל","מקיש קודמי הויה שנייה לראשונה","בנדרים שלא נראו לארוס","נדריה עליה מפר האב","הויה שנייה ורשות הבעל","הויה שנייה בנדר שנישאה"],"נדרה והיא ארוסה נתגרשה בו ביום נתארסה בו":["נתארסה בו ביום למאה","כל שלא יצאה לרשות עצמה","אביה ובעלה האחרון מפירין","ארוסה שנתגרשה בו ביום","נדר ארוסה לא יצאה לרשות","ארוסה שנישאה בתוך יום"],"דרך תלמידי חכמים עד שלא היתה בתו יוצאה מ":["אב מפר לפני יציאת הבת","בעל מפר לפני כניסתה לרשותו","מיפר הבעל עד שתכנס לרשותו","מפר מראש את נדרי בתו","תלמידי חכמים הפרת נדרים","תלמיד חכם מפר לבתו"],"בוגרת ששהתה י ב חדש ואלמנה ל יום":["בוגרת שהתה י\"ב חודש","ר' אליעזר והבעל המפר","אין הבעל מפר עד שתכנס לרשותו","תרומה ונדרים בבעל ויבם","אכילה בתרומה ושאלת נדר","בעל מפר בתוך י\"ב חודש"],"ר א ומשנה ראשונה אמרו דבר אחד":["משנה ראשונה ונדרים דאורייתא","ששה חדשים בפני בעל ויבם","אין האשה אוכלת בתרומה עד חופה","נדרה על דעת בעלה","תרומה לא נאכלה בנדר","נדרה על דעת בעלה תרומה"],"שומרת יבם בין ליבם אחד בין לשני יבמין לר":["שומרת יבם והפרת נדרים","ר' אליעזר ור' יהושע ביבם","אין היבמה גמורה ליבם","זיקה ומאמר בשומרת יבם","אשה שקנה לעצמו מיפר","אשה שהקנו לו מן השמים"],"ר ע סבר אין זיקה ור י סבר יש זיקה":["מאמר לבית שמאי אירוסין או נשואין","נערה המאורסה ומפירים בשותפות","מאמר קונה קנין גמור בזיקה","כרבא כל הנודרת על דעת בעלה","מאמר בית שמאי מפר בשותפות","מאמר בבית שמאי לשותפות"],"האומר לאשתו כל הנדרים שתדורי מכאן עד שאב":["כל הנדרים עד שאבא ממקום","אם הפר נדרים שבאו לכלל איסור","הקם בא לכלל הפר","ר' אליעזר בהפרה ובאישור","נדרים שלא באו לכלל איסור","נדר האשה בשבוע מופר"],"הפרת נדרים כל היום יש בדבר להקל ולהחמיר":["הפרת נדרים בשבת ובחול","נדרה בלילי שבת וביום","עד שלא תחשך מפר","הפרה לאחר חשיכה אינה","הפרת נדרים לפי שעות היום","הפרה בשבת לפני שחשכה"],"לא יאמר אדם לאשתו בשבת מופר ובטל לך כדרך":["הפרה בשבת בלב בלבד","זה הדבר בפרשת נדרים","חכם ובעל בלשון הפרה","מבטל בלבו בשבת","בעל מפר וחכם מתיר","בעל מפר חכם מתיר בשבת"],"בפרשת נדרים ראב י להכשיר שלשה הדיוטות":["בפרשת נדרים ראב\"י להכשיר שלשה","ראשי המטות ביחיד מומחה","בשחוטי חוץ כר' שמעון","זה הדבר בשחוטי חוץ על השחיטה","מועדי ה' נאמרו ולא נאמרה פרשת נדרים","בן עזאי ובתוך הפרשה"],"קונם שאני נהנה לבריות":["נהנה לבריות ולקט שכחה ופאה","קונם כהנים לוים נהנים לי","בעל בכלל בריות או לא","נטולה אני מן היהודים יפר חלקו","נדרי עינוי נפש בבעל","לקט שכחה ופאה ליהנות"],"משמע שיכולה להיות ניזונת ממנו מכלל שבעל ":["בעל לאו בכלל בריות לפי רב נחמן","איתיביה רבא לרב נחמן","כוונת האשה על היתר שאסרה נפשה","נטולה מן היהודים שאינו עינוי","בעל כבריות ליהנות בפאה","בעל ונדר עינוי נפש"],"יכולה ליהנות בלקט שכחה ופאה ולא תני ובמע":["מעשר עני של דמאי בנדר","ר' אליעזר ודמאי ספקו לא טובל","לא נחשדו עמי הארץ על מע\"ע","מע\"ע המתחלק בתוך הבית","מע\"ע בגרנות מותר","הפקר נכסים ולא מפחד"],"קונם שאיני עושה על פי אבא ועל פי אביך וע":["נדר על פי אבא ואחי","שאיני עושה על פיך לא צריך הפרה","ר' עקיבא ור' יוחנן בן נורי בהפרה","שמא יגרשנה ותהי אסורה","הלכה כר' יוחנן בן נורי","נדר שלא לעשות על פי הורים"],"הלכה כרבי יוחנן בן נורי משמע דס ל דאדם מ":["הלכה כר' יוחנן בן נורי","אדם מקדיש דשלב\"ל","המקדיש עושה אשתו הקדש","הסנדלר ואין אדם מקדיש","קונמות אוסרים דבר שלא בא לעולם","ידי לעושיהן באשה שגורשה"],"נדרה אשתו וסבור שנדרה בתו נדרה בתו וסבור":["נדר לאשה במקום בתו","נדר בנזיר במקום קרבן","טעות בנדר ויחזור ויפר","יניא אותה דוקא בנדר","קריעה כשמת אביו ונמצא בנו","אחר כדי דיבור בנדר טעות"],"ד יניא אותה דוקא הוא":["קריעה על מת שנמצא חי","יצא ידי קריעה בתוך כדי דיבור","חולה שנתעלף וקרע","נדר בטעות בשני אנשים","בתוך כ\"ד כדיבור דמי","חולה שנתעלף וקרע לפני מות"],"אישה יקימנו ואישה יפרנו אמרה קונם תאנים ":["קיים לתאנים כולו קיים","הפר לתאנים עד שיפר לענבים","מקיש הפרה להקמה","ממנו יקימנו ממנו יפרנו","ר' ישמעאל ור' עקיבא בהקמה","אישה מקיימת ומפרת בתאנים"],"יודע אני שיש נדרים אבל איני יודע שיש מפי":["נדר ואיני יודע שמפירין","יודע שמפירין ואיני יודע שזה נדר","בלא ראות פרט לסומא","סומא בנדר ובהפרה","בלי דעת מרבה את הסומא","בלא ראות פרט לסומא לרבי"],"בלא ראות לר י פרט לסומא ולר מ לרבות את ה":["בלא ראות לרבות את הסומא","מבלי דעת לרבות את הסומא","גבי רוצח ביער וסומא","כל דבר מיעל ליער","בלי דעת כל דבר מידע","סומא בדעת ומבלי דעת"],"המדיר הנאה מחתנו והוא רוצה לתת לבתו מעות":["מתנה לבת במעות מחתן מודר","מה שאת נושאת ונותנת בפיך","יד אשה כיד בעלה לענין שיתוף","כר' מאיר יד אשה כיד בעלה","מבוי ועירוב בעבד ושפחה עברים","מעות לבת ולא לבעל"],"רב דווקא דאמ ל מה שאת נושאת ונותנת בפיך":["רב בקנין מה שתרצי עשי","קנאם בעל או לא בשתוף","עירוב מבוי ואשה בשיתוף","בשיש לה חצר באותו מבוי","מגו דזכיא לנפשה זכיא לאחריני","קנין מעות לאשה בשיתוף מבוי"],"ונדר אלמנה וגרושה יקום עליה כיצד":["נדר אלמנה וגרושה יקום","הריני נזירה לאחר ל' יום","כל שיצאה לרשות עצמה","נדר שנאמר לכשאנשא","מחלוקת ר' עקיבא בנדר אלמנה","נדר בשעת אלמנות וגרושין"],"אלמנה וגרושה שאמרה הריני נזירה לכשאנשא ו":["אלמנה לכשאנשא ונשאת מחלוקת","אשת איש לכשאתגרש ונתגרשה","ילל\"י וסימנא","שלמו יומי ולא נתגרשה","תלוי נפשה ביומי או בנישואין","נדר אלמנה ביום או בנישואין"],"תשע נערות נדריהן קיימין":["תשע נערות נדריהן קיימין","בת קטנה שנשאת וחזרה לאב","נערה יתומה ונדרה קיים","ג' נערות נדריהן קיימין","ר' יהודה בנערה שחזרה לאביה","נערה שחזרה לאביה ומשנשאת"],"זו דברי ר י חכ א ג נערות נדריהן קיימין ב":["ג' נערות נדריהן קיימין לחכמים","יתומה בחיי האב בנדר","בוגרת ויתומה בנדר נערה","חכמים בנערות נדרים","בוגרת ויתומה נדרן קיים","חכמים בנערות ג' נערות"],"קונם שאיני נהנה לאבא ולאביך אם עושה אני ":["נהנה לאבא ולאביך על פיך","נטולה מן היהודים אם משמשתך","רב נחמן לא יפר וחכמים יפר","שאסר הנאתו עד שישנה הלכה","הטיח פניו בטיט ללא הצלחה","נדר לאבא ולאביך חכמים מפירים"],"שאיני נהנית לאבא ולאביך אם אני עושה לפיך":["אשה שאסרה את בעלה להנאה","שאסר הנאתו עד שישנה הלכה","נדר שאסר נשא אשה ונשאלה","בשאלה חכם מתיר רק אם חל נדר","מקונם שאיני נהנה לפלוני ולמי שאשאל עליו","אשה שאסרה נפשה בשאלה"],"בראשונה היו אומרים שלש נשים יוצאות ונוטל":["שלש נשים יוצאות בכתובה","טמאה אני לך ושמים ביני לבינך","נטולה אני מן היהודים","חזרו לומר בטענת טמאה","תביא ראיה לדבריה","נטולה מן היהודים יפר חלקו"]}