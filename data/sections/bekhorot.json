"k": "m",
"letter": "א",
"how": "m",
"i": 2485,
"text": "/מתני'/.",
"next": "על אלו מומין שוחטין את הבכור: "
},
{
"daf": "לז:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2512,
"text": "נסדקה אע\"פ שלא חסרה.",
"next": ""
},
{
"daf": "לז:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2516,
"text": "נקבה מלא וכו'.",
"next": ""
},
