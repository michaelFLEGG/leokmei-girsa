   "dhs": "פותחין בנולד"
  },
  {
   "daf": "64b",
   "line": 4,
   "seg": 3,
   "ref": "Tosafot on Nedarim 64b:4:3",
   "text": "מאי טעם דרבי אליעזר - דמסברא יש לנו לומר דאין פותחין בנולד:",
   "dh": "מאי טעם דרבי אליעזר",
   "dhRule": "מקף",
