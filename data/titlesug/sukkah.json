{"בסוכה לשון פסולה א דאורייתא ב רבים דיניה":["מקור דין סוכה במקראות","למען ידעו: ידיעה לדורות","סוכה לעומת צל","קושיית אביי ממחיצות של ברזל","סוכה: ארעי או קבע","דרשות בשם סוכה"],"סוכה ישנה קודם לחג ל יום ב ש פוסלין וב ה":["סוכה ישנה לפני החג","סוכה שנעשתה לשם חג","מחלוקת ב\"ש וב\"ה בסוכה ישנה","שלושים יום קודם החג","כשרות סוכה מתחילת השנה","סוכה ישנה ולשם החג"],"סוכה תחת האילן כבתוך הבית":["סוכה תחת אילן כבית","סוכה על גבי סוכה","אילן כדין בית לסוכה","דירה בעליונה ובתחתונה","סוכה תחתונה בדיורי העליונה","ר\"י: סוכה כפולה ודיורין"],"אילן דומיא דבית שצילתו מרובה ובחמתו מרוב":["אילן שצילו מרובה מחמתו","אילן כבית בשיעור צל","חבטן של אילן אינו מצטרף","אילן שאינו מצטרף לסכך","לא גזרו שמא לא יערבנו","צל וחמה באילן לסוכה"],"פירס עליה סדין מחמה תחתיה מנשר ע ג קינוף":["כילה ומטה בתוך הסוכה","סדין על הסוכה ונויה","סדין מחמה ומנשר תחתיו","גובה כילה ומטה בסוכה","נויי סוכה בשיעור גובה","מחלוקת ר\"נ ור\"ח בסדינין"],"פירס סדין לנאותה כשרה ולא אמרי דתני רק א":["נויי סוכה: אם ממעטין בהם","סדין לנאות הסוכה כשרה","שאלת נויי הסוכה והמסתפק","מחלוקת על מקבל טומאה כסכך","כילה בסוכה גבוהה מעשרה","מטה שבתוך הסוכה ועשרה טפחים"],"הדלה גפן דלעת קיסוס וסיכך ע ג פסולה":["סכך מגידולי גפן ודלעת","קצוץ וחיבור הסכך","מחלוקת רב ושמואל בקצוץ","הכלל בחומר הסכך","סכך שנקטע מן הגידול","סכך שלא מקבל טומאה"],"קצצן לרב כשרה שמואל ינענע דחייש לתעשה ול":["ינענע הסכך מחשש תעשה","קצצן לרב, ינענע לשמואל","תלוי ולא פסוק פסול","תעשה ולא מהעשוי בסכך","קשר פתיל ושעת הסיכוך","לקיטת סכך והיותו עשייה"],"חבילי קש ועצים וזרדים אין מסככין בהן":["חבילי קש וגזירת אוצר","חוטט בגדיש אינו סכך","סכך מחבילות קש ועצים","חצים זכרים ונקבות לסכך","שווצרי היזמי והיגי בסכך","גזירה משום אוצר תבואה"],"חבילי קש משום גזירת אוצר וחוטט בגדיש תעש":["גזירת אוצר בחבילי הקש","תעשה ולא מן העשוי בסכך","חוטט בגדיש ואינו מדאורייתא","סכך שאין מסככין לכתחילה","שושי ושווצרי אם מסככין","מרור דאגם והאזוב"],"נסרים ר י מסככין ור מ אוסר":["נסרים לסכך ומחלוקת ר\"י ור\"מ","נסר ברוחב ארבעה טפחים","נסרים רחבים וגזירת תקרה","שני נסרים מצטרפים לסוכה","רווח בין הנסרים לסכך","שינה תחת נסר רחב"],"בנסרין ד חלקו בגזירת תקרה ובאין ד לכו ע ":["גזירת תקרה בנסרים ארבעה","מג' עד ד' אין שיעור","סכך של שלושה קנים","מקום נסר ודין קנים סתם","נסרים ד' לכולי עלמא פסולה","שיעור רוחב הסכך בסוכה"],"תקרה שאין עליה מעזיבה":["תקרה בלא מעזיבה ופיקפוק","פיקפוק בסכך ונטילת נסר","מחלוקת ב\"ש וב\"ה בתקרה","גזירת תקרה ופיקפוק הסכך","תקרה שאין עליה מעזיבה","ר\"מ: נוטל ואינו מפקפק"],"ב ה ד תעשה ב ש גזרת תקרה ואפי פקפק דווקא":["כשאין תקרה וגם יש ד'","גזירת כלים בנסרים משופין","גזירה בזכרים אטו נקבות","ביטול תקרה בסוכה","ר\"י שבקת ב\"ה: מחלוקת","נסרים משופין ונסרים שאינם"],"המקרה סוכתו בשפודין או בארוכות המיטה":["סוכה בשפודין וארוכות המיטה","פרוץ כעומד: מחלוקת ר\"פ ורהב\"י","חוטט בגדיש ופרוץ כעומד","שתי וערב בדין פרוץ","רווח בין השפודין כשר","סוכה מדפנות של מיטה"],"דפרוץ כעומד ר פ מותר רהב י אסור":["פרוץ וסוכה שאין בה מעדיף","חוטט בגדיש: מעדיף ושאין מעדיף","מי שיש לו מעדיף בסכך","אסור כאן במעדיף","ר\"פ ורהב\"י על הפרצה","שתי וערב בדיני סכך"],"משלשל דפנות":["דפנות תלויות: רחוק או גבוה","שיעור תליית הדפנות מלמעלה","דפנות שמשלשלין מלמטה","מחלוקת ר' יוסי בשיעור דפנות","שלשול דפנות בשלושה טפחים","דפנות מלמעלה ומלמטה"],"הרחיק הסיכוך מהדפנות ג ט פסולה":["סיכוך רחוק מהדפנות שלושה טפחים","בית שנפחת וסיכך עליו","אכסדרה וחצר המוקפת סכך","סוכה גדולה שסככוה בכולה","דופן עקומה ומחיצות הבית","שיעור ד' אמות תחת הסכך"],"בית שנפחת דמחיצותיו לבית":["אויר פוסל בשלושה טפחים","אויר וסכך פסול שמצטרפים","בגד שק עור ומפץ מצטרפים","סוכה מלאה שפודין פסולה","הפלגה בין סכך לאויר","אויר של פחות משלושה"],"סוכה כצריף או סמכה לכותל":["סוכה כצריף וסמוכה לכותל","ר\"א: סוכה בלא גג פסולה","מחלוקת ר\"א וחכמים בצריף","שיפוע גג כאהל","הגבהה או הפלגה מכותל טפח","סוכה שאין לה גג"],"בהגביה או הפליגה מכותל טפח סוכה כצריף כש":["צריף כשר בהפלגה מכותל","יחידאה: מכשירין בצריף","אהל מסיכוך ומשיפוע","כילת חתנים בתוך הסוכה","משנה דחכמים יחידאה","הפלגה טפח מן הכותל"],"מחצלת קנים גדולה לשכיבה מקבלת טומאה ואין":["מחצלת קנים: טומאה ושכיבה","מחצלת גדולה לסיכוך וקטנה","מחצלת שמקבלת טומאה","מחלוקת ר\"א בקנים לסיכוך","מחצלת כסכך וכמטה","גדולה וקטנה בדין טומאה"],"בגדולה לכו ע בסתם לסיכוך בקטנה לת ק לשכי":["מחצלת גדולה בסתם לסיכוך","קטנה לשכיבה לכולי עלמא","למה יש לחלק גדולה וקטנה","מחצלות בדין סכך ושכיבה","סתם מחצלת ודין הסתם","ברייתא על מחצלות הקנים"],"ישן תחת המטה תרגמה שמואל במטה עשרה":["אהל מטומאה תחת המטה","חלל התהום וטומאת אוהל","אהל שאינו בידי אדם","חצירות ירושלים על הסלע","מטה עשרה טפחים וטומאה","טומאת קבר התהום באוהל"],"הסומך סוכתו בכרעי המטה כשרה":["סוכה הסמוכה לכרעי המטה","עמידה בפני עצמה לסוכה","ר\"י: סוכה שאינה עומדת","שפודי ברזל לסמיכת סוכה","סיכוך על גבי המטה כשר","סוכה סמוכה למטה או נעוצה"],"אי מטעם שאין לה קבע או שמעמידה בדבר המקב":["סוכה שאין לה קבע","סוכה מעמידה בדבר מקבל טומאה","נעיצה בשפודי ברזל","סמיכה לעומת סיכוך על המטה","מחלוקת על קבע הסוכה","סוכה על גבי המטה כשרה"],"סוכה מדובללת ושצילתה מרובה מחמתה כשרה":["סוכה מדובללת וצילה מרובה","סוכה מעובה כשרה ללא כוכבים","צל וחמה בסכך הדליל","סכך מעובה כבית","כשרות סוכה לפי הכוכבים","צילה גדולה מחמתה"],"סוכה בראש העגלה או הספינה כשרה ועולין בי":["סוכה על עגלה או ספינה","סוכה באילן: עליה ביום טוב","סוכה שניתן לעמוד בלא אילן","סוכה בראש גמל","מנין ידי אדם ומנין אילן","עליה לסוכה ביום טוב"],"סוכה שהאילנות דפנות לה כשרה":["אילנות שהם דפנות לסוכה","מחיצה העומדת ברוח מצויה","נוף אילן ודין הוצאה","אילנות בקשין בתור דופן","סוכה בתוך נוף שאינו גבוה","הוצא ודפנא בדין סוכה"],"מחיצה רק שעומדת ברוח מצויה":["פטורי סוכה בשלוחי מצוה","בשבתך בביתך: פרט לעוסק במצוה","חתן וכונס בתולה פטורים","עוסק במצוה פטור מטומאה","אלמנה חייבת וכונס בתולה פטור","טרדת רשות וטרדת מצוה"],"בשבתך בביתך פרט לעוסק במצוה":["אבל ועוסק במת מצוה בסוכה","חתן ושושבינים פטורים מסוכה","שמחת חופה ופטור מסוכה","אבלים שחייבים בכל המצוות","אבל ותפילין ביום הראשון","נפקא מינה: סוכה ושמחת חופה"],"מעשה והביאו לריב ז לטעום התבשיל ולר ג ב ":["טעימה מחוץ לסוכה וכביצה","ארבע עשרה סעודות בסוכה","מי שלא אכל בליל הראשון","כביצה בעי סוכה ונטילה","מעוות לא יוכל לתקון","מעשה ר\"צ שאכל חוץ לסוכה"],"בא להחמיר ע ע אין בזה משום יוהרא":["אכילה חוץ לסוכה ולא בירך","יוהרא בברכה על כביצה","קצבה בסעודות סוכה","תשלומין לסעודת הלילה","מחלוקת ר\"א וחכמים בקצבה","ליל יום טוב אחרון לתשלומין"],"ראשו ורובו בסוכה ושולחנו בבית":["ראשו ורובו בסוכה ושולחנו בבית","נשים ועבדים פטורים מסוכה","קטן שאינו צריך לאמו","מעשה בכלתו של שמאי הזקן","ב\"ש וב\"ה בשולחן מחוץ לסוכה","שמאי מחמיר בקטן ובסוכה"],"האזרח להוציא הנשים כל לרבות הקטנים ואף ד":["האזרח: הוצאת נשים מסוכה","כל לרבות קטנים שהגיעו לחינוך","תשבו כעין תדורו לא נאמר","גרים בדין סוכה מן האזרח","אין לומדים ט\"ו ט\"ו לחיוב","אזרח: לתוספת עינוי ביוה\"כ"],"שבעת ימים סוכת קבע ובית ארעי":["סוכת קבע ובית ארעי","פינוי מן הסוכה בגשם","עבד שמזג כוס ורבו שפך","מותר לפנות בירידת גשמים","פינוי הסוכה משתסרח המקפה","משל העבד והכוס ונשפך"],"הדס הגזול והיבש אשרה ועיה נ נקטם ראשו נפ":["פסולי ההדס: גזול ויבש","הדס שנקטם ראשו","הדס שענביו מרובות","הדס עבות ולא זית","ירדוף אינו הדס: דרכי נעם","הדס: דרכי נעם והאמת"],"הדס ענף עץ עבת שחופין את עצו":["הדס: עץ עבת שחופין עצו","עבות ולא זית בהדס","את עצו ולא ערמון","שם הדס ודרשת עבות","פסול ירדוף בלולב","שמות המינים ומשמעותם"],"ערבה גזולה יבשה אשרה ועיה נ":["ערבה פסולה: גזולה ויבשה","ערבה שנשרו מקצת עליה","צפצפה אינה ערבה","ערבה נקטמה או נפרצה","ערבה כמושה בשיעור כשר","פסולי הערבה ונשירתה"],"רי ש שלשה הדסים ושתי ערבות לולב אחד ואתר":["שלושה הדסים ושתי ערבות","ר\"ע: הדס וערבה אחד","ר\"ט: הקטומים אף שלושתם","מניין הדסים ושל ערבה","ערבי נחל: כמה לכתחילה","מחלוקת ר\"ע ור\"ט בהדס"],"פרי אחד כפת אחד ענף עץ עבת ג":["לקיחה תמה ומעכבת זה את זה","הלכה כר\"ט בהדס","הוזילו ואי לא אדרוש","כפת בלא ו' ואגודה","קטומים מצויים מן השלם","לקיחה תמה בכל המינים"],"אתרוג הגזול והיבש אשרה ועיה נ ערלה ותרומ":["פסולי האתרוג: גזול ויבש","אתרוג עם חזזית על רובו","אתרוג שנטלה פטמתו","אתרוג כושי וכרתי","אתרוג קטן: אגוז או ביצה","מחלוקת ר\"י ור\"מ בגדול"],"פרי עץ הדר מנין שהוא אתרוג":["הדר: אתרוג מפרי עץ הדר","פלפלין אינם אתרוג","ערלה בלולב: היתר אכילה","אתרוג של מעשר שני בירושלים","אתרוג של תרומה טמאה","טעם העץ ופריו שוה"],"אגידת לולב לר י רק במינו":["אגידת לולב במינו בלבד","אגידה בחוט או משיחה","אנשי ירושלים ואגידת זהב","עיקר דקל לאגידת לולב","סכך רק מארבעת המינים","אגד לולב וחמשת המינים"],"ר י דאוגדין במינו אפי בסיב או בעיקר דדקל":["לקיחה תמה: הושענא בסודר","מאזוב בחוט ובכוש","הדס מצווה אסור בהריח","מין במינו אינו חוצץ","נסרי ארז בסיכוך סוכה","למגדלי הושענא: חציצה ביד"],"מנענעין לב ה בהודו לה תחילה וסוף ובאנא ה":["נענועי לולב: הודו והצליחה","איפה מנענעים לולב","מוליך ומביא ומעלה ומוריד","תנועות הלולב ורוחות רעות","הלחם על כבשי עצרת","תנופה מעכבת פורענות"],"והיכן מנענעין אהך דלולב שיש בו ג ט לנענע":["לולב שיש בו ג' טפחים לנענוע","מוליך ומביא לעצור רוחות","מעלה ומוריד לעצור טללים","תנופה למי ששמים וארץ","לגרות עיני שטן: לא להלכה","נענוע לולב והתגרות שטן"],"בא בדרך לא היה בידו ליטול לכשיכנס לביתו ":["נטילת לולב בדרך ובבית","נטילה על השולחן בביתו","לא נטל שחרית: בין הערביים","כל היום כשר ללולב","נטילת לולב לאחר הדרך","זמן נטילת לולב ביום"],"עבד אשה קטן מקרין אותו ועונה אחריהן מה ש":["עבד ואשה וקטן: מי עונה","גדול מקרא עונה הללויה","שומע כעונה: ענייה בהלל","מנהג הלל בברכות וכפילה","בן מברך לאביו ותבוא מארה","כפילה בהודאה: מנהג המדינה"],"בן מברך לאביו ועבד לרבו ואשה לבעלה ותבוא":["לברך לפני עשיית המצוה","ויעבר: הקדמה לברכה","שומע כעונה במקרא","קטן מקרא ועונה אחריו","ברכה לאחריו או לפניו","ברכת המצוות לפני עשייתן"],"לא רצה ליתן מבליע דמי אתרוג בלולב דאין מ":["לולב בשביעית ואתרוג במתנה","מבליע דמי אתרוג בלולב","מסירת דמי פירות שביעית","מזון שלוש סעודות בשביעית","פיגם והירבוזין בשביעית","לוקח מהפקר ולא ממשומר"],"בראשונה לולב ניטל במקדש שבעה ובמדינה יום":["לולב שבעה ימים במדינה","תקנת ריב\"ז לאחר החורבן","יום הנף אסור כולו","לולב במקדש שבעה ימים","זכר למקדש בלולב","בראשונה יום אחד במדינה"],"זכר למקדש רי ו דורש אין לה מכלל דבעי דרי":["דורש אין לה: מכלל דרישה","זכר למקדש בדרשת רי\"ו","דרשת רי\"ו על הדורש","כל מקום דורש אין לה","מכלל דבעי דרישה","משמעות זכר למקדש"],"יו ט ראשון דחג שחל בשבת הכל מוליכין לולב":["לולב בבית הכנסת בשבת הראשונה","יו\"ט ראשון לא בלולב חבירו","לולבים בחג שחל בשבת","לקחתם לכם משלכם","לולב גזול ושאול אינו כשר","ר' יוסי: הוציא בשבת ברשות"],"ולקחתם ביד כאו א":["לולב של ר\"ג שנתנוהו במתנה","מתנה על מנת להחזיר","לולב באלף זוז בספינה","לולב ביד אבא בתפילה","תפילין ולולב: מי טריד","חביבות המצוות על חכמים"],"מקבלת אשה מבנה ובעלה ומחזירתו למים בשבת":["קטן היודע לנענע בלולב","שבת מחזירין, יו\"ט מוסיפין","לולבים: החלפה וחזרה בחג","אשה שמקבלת מבנה ובעלה","מחלוקת ר\"י בהחזרת לולב","דין החלפת לולב במועד"],"מקבלת אשה מבנה ובעלה אפי שאינה בת חיוב":["קטן מתי נחשב לחיוב מצוה","קטן ותרומה בבית הגרנות","קטן ופסח: כזית צלי","נותנים לקטן צרור לזריקה","קטן עם טהרות בידיו","קטן לשמור תפילין ושמע"],"מצות ערבה":["ערבה ממוצא: הקפת המזבח","אנא ה' הושיעה נא בהקפה","יום חבוט החריות","יופי לך מזבח: ליה ולך","ערבות זקופות וגבוהות במזבח","שלקטו מערב שבת לגיגיות זהב"],"קלניא ונקרא מוצא שיצא ממס המלך ובאין וזו":["אסרו חג בעבותים עד הקרנות","נוטל לולב כבונה מזבח","העושה איסור לחג כמקריב","עצי שטים לעולם ולעולמי עלמים","כולנו לפטור העולם מדין","בני עלייה מועטים בדורות"],"והיית אך שמח לרבות לילי יו ט אחרון שיש ש":["שמחה בלילי יום טוב אחרון","יום טוב ראשון בלא שמחה","והיית אך שמח: לרבות ולחלק","לילי חג האחרון בשמחה","שמחה לפניו ביום אחרון","דרשת אך לרבות ולמעט"],"סוכה שבעה גמר מלאכול לא יתיר סוכתו אבל מ":["פירוק הסוכה ביום טוב אחרון","מוריד כלים מן המנחה","כבוד יום טוב אחרון של חג","גמר סעודה ואין מתירים סוכה","סוכה לא נפרקת לאחר הסעודה","כלים מהמנחה ולמעלה"],"דתני שואבה ושאבתם מים":["חליל בשמחת בית השואבה","שיר בכלי דוחה שבת או לא","שמחת שאיבה דוחה שבת","שיר של קרבן: בכלי או בפה","מחלוקת ריב\"י וחכמים בחליל","שאיבה חשובה מששת ימי בראשית"],"מי שלא ראה ירושלים בתפארתה לא ראה כרך נח":["מי שלא ראה ירושלים בתפארתה","בנין הורדוס בשיש ושיש לבן","דיופלוסטון של אלכסנדריא","קתדראות הזהב באלכסנדריא","עונים אמן בסודרין ובבימה","ישיבה לפי אומנות ופרנסת העני"],"מתני לא כר י דלא יפחות משבע ולא יוסיף על":["שבע ועד שש עשרה תקיעות","תקיעה ותרועה: אחת או שתיים","תקיעה תרועה תקיעה: סימן בעלמא","ר\"י: אין הבדל בין תקיעה לתרועה","מצוה או סימן בשופר","שופר בראש השנה כר\"י"],"יו ט ראשון של חג י ג פרים אילים שנים ושע":["קרבנות חג: י\"ג פרים","חלוקת הפרים בשמונה משמרות","חזרו לפייס בשמיני","מי שהקריב פרים לא יקריב למחר","פייס המשמרות בקרבן חג","פרים ואילים במשמרות הכהונה"],"בשמיני חזרו לפיס אפי כרבנן דאחת מב משמרו":["שבעים פרים כנגד שבעים אומות","פר יחידי כנגד אומה יחידה","משל המלך והסעודה הקטנה","פייס בשמיני בשתי משמרות","אוי לגויים שאבדו בלא כפרה","הקרבנות בחג ובשמיני"],"ג פרקים בשנה כל המשמרות שוות":["שלוש רגלים: משמרות שוות באימורים","חלוקת לחם הפנים בחג","מאחד שעריך: בשער אחד","נדרים ונדבות לא בחלוקה","סוכה וזמן: מה קודם","ממכרי האבות: אני בשבתי"],"אמורי הרגלים מה שאמרו ברגלים":["סוכה או זמן: מי קודם","יין וקידוש בחלוקת המשמרות","תדיר קודם בזמן חיוב","מצה ברישא ואחריה חמץ","ברכת היין לפני הקידוש","יום גורם ליין וסוכה לזמן"],"יו ט הסמוך לשבת בין לפניה ובין לאחריה":["חלוקת חלות ביום טוב סמוך לשבת","עשר חלות למשמר קבוע","נכנס נוטל שש והיוצא שש","ר\"י: נכנס שבע והיוצא חמש","נכנסים בצפון והיוצאים בדרום","בילגה טבעתה וחלונה סתומה"],"לפניה יו ט האחרון":["יום טוב סמוך לשבת לפני ואחרי","סעודת משמרות יחד","אלו מקדימים ואלו מאחרים","תקנה לאכילה יחד בחג","יום טוב האחרון לפניה","שאלו ואלו בסדר החלוקה"]}