{"עולות במועד באות מן החולין והשלמים מן המ":["עולות במועד מן החולין","שלמי חגיגה לב\"ש ולב\"ה","ישראל יוצאין בנדרים ונדבות","עולות נדרים ביו\"ט לא באות","שלמי שמחה ממעשר","פסח ט\"ו מחולין"],"עולות נדרים ונדבות במועד באות ביו ט לא ב":["ממעשר בטופל","מסת מהחולין כאשר יברכך","ב\"ש אחר יום ראשון ממעשר","אחר אכילה ראשונה ממעשר","יוצא ביו\"ט במעשר בהמה","שמא יעשר ביו\"ט וצבוע באדום"],"מי שלא חג ביו ט ראשון של חג חוגג כל הרגל":["מי שלא חג ביו\"ט ראשון","מעוות לא יוכל לתקן","ר\"מ ורשב\"י על מעוות","הבא על הערוה והוליד ממזר","ת\"ח הפורש מן התורה","חוגג כל הרגל"],"חוגג כל הרגל ד וחגתם שבעת ימים וה ה לפסח":["חגתם שבעת ימים","וה\"ה לפסח שבעה","חוגג כל הרגל כולו","שבעה ימים של פסח","חג כל הרגל בשבעה","כל הרגל ולא יום ראשון"],"היתר נדרים פורחין באויר ואין להם על מה ש":["היתר נדרים פורחין באויר","הלכות שבת כהררים התלוין","חגיגות ומעילות כהררים","הן הן גופי תורה","הלכות שיש להן על מה שיסמכו","עבודות טהרות ועריות"],"והחיות רצוא ושוב כמראה הבזק כאש מהכבשן ו":["והחיות רצוא ושוב כמראה הבזק","החיות כאש מהכבשן","החיות ומבין החרסים","מראה הבזק בחזון יחזקאל","כמראה הבזק הכבשן","חיות הקודש ברקיע"],"והנה רוח סערה באה מן הצפון מבבל לכבוש כל":["רוח סערה באה מן הצפון","לכבוש כל העולם תחת נבוכדנצר","שלא יאמרו ביד אומה שפלה","מסר את בניו","הצפון הוא בבל","מלכות נבוכדנצר בחזון"],"והנה אופן אחד בארץ אצל החיות מלאך סנדלפו":["אופן אחד בארץ מלאך סנדלפון","סנדלפון גבוה מחבריו","קושר כתרים לקונו","שם המפורש והכתר מעצמו","ברוך כבוד ה' ממקומו","סנדלפון וכתר היושב"],"פניהם פני אדם ופני אריה ופני שור ופני נש":["פני אדם ופני אריה בחיות","ה' מתגאה על כולם","פני הכרוב פני אדם","פני שור לכרוב תינוק","אדם היינו גדול","ארבע פנים בחיות"],"שש כנפים לאחד כשביהמ ק קיים ו ארבע כנפים":["שש כנפים כשבית המקדש קיים","ארבע כנפים כשלא קיים","שרות בהם שירה","שמכסות רגליהם","נתמעטו הכנפים","כנפי הכרובים בבית המקדש"],"לבושיה כתלג חור ושער ראשיה כעמר נקא בישי":["לבושיה כתלג ושער ראשיה כעמר","קוצותיו תלתלים בישיבה","שחורות כעורב במלחמה","שני כסאות לדוד","אחד לדין ואחד לצדקה","סתרי תורה ליועץ וחכם"],"בתו של אחר ביקשה מרבי לפרנסה תמה רבי וכי":["בתו של אחר ביקשה פרנסה","זכור תורתו ולא מעשיו","אש וסכסכה ספסל רבי","ומה למתגנין כך למשתבחין","יבקשו תורה מפיהו","שמועות דכולהו רבנן"],"אחר זמר יווני לא פסק מפיו וספרי מינין נו":["זמר יווני ספרי מינין","ספרי מינין נושרין מחיקו","צמר נקי מתוקן מיורה","ת\"ח עם יראה","אחר שנתרחק מהתורה","אחר ותלמידי חכמים"],"יוסי בן יועזר אומר לא לסמוך יוסי בן יוחנ":["לסמוך ביום טוב","הראשונים לא לסמוך והאחרונים לסמוך","הלל ומנחם לא נחלקו","נשיאים ואבות בית דין","יהודה בן טבאי ושמעון בן שטח","שמעיה ואבטליון"],"שלשה מהראשונים לא לסמוך ושנים מהאחרונים ":["שלשה מהראשונים לא לסמוך","שניים מהאחרונים לסמוך","יהודה בן טבאי אב\"ד","שמעון בן שטח נשיא","עד זומם והריגה","מורה הלכה בפני ב\"ש"],"נוטלין לידים לחולין למעשר ולתרומה ולקודש":["נטילה לחולין למעשר לתרומה","טבל לחולין אסור למעשר","טבל לקודש אסור לחטאת","מדרס בגדי עם הארץ","יוסי בן יועזר חסיד שבכהונה","יוחנן בן גודגדא על טהרת הקודש"],"לחולין ומעשר צריך נטילת ידים":["חולין ומעשר נטילת ידים","תרומה וביכורים מיתה וחומש","טבילה מדרבנן למעשר","אכילה בחולין ונגיעה","אכילת לחם ואכילת פירות","נוטל לפירות מגסי הרוח"],"חולין שנעשו על טהרת הקודש כקודש":["חולין על טהרת הקודש כקודש","מעלה שלא שנה בפנ\"ע","יוחנן שאכל על טהרת הקודש","מטפחתו מדרס לחטאת","כקודש דמו","חולין כת\"ק או כתרומה"],"סנדל טהור מהו חבית סתומה מהו":["סנדל טהור מהו","חבית סתומה מהו","עבר ונשא טמא או טהור","ר' אילא ור' זירא","ספק טומאה בחבית","טומאה של עבר ונשא"],"חומר בתרומה":["נאמנות עם הארץ על טהרת יין","בשעת הגיתות והבדים","חבית תרומה מעם הארץ","הפרשתי רביעית קדש נאמן","מדומעות כדי יין ושמן","שמן לכשיבוא אליהו"],"ובגליל לא כר ל שרצועה של כותים מפסקת":["ובגליל לא נאמנים","שרצועה של כותים מפסקת","שידה תיבה ומגדל","אהל זרוק אינו אהל","כלי חרס מוקף צמיד פתיל","קודש ניצל בצמיד פתיל"],"מודיעים עצמה קדר יוצא וחבר נכנס כלפנים":["מודיעים עצמה בכלי חרס","קדר יוצא וחבר נכנס","נאמנים לקודש","ניטלין ביד אחת","משקים עצמן טמאין","כלים שטמא שבעה"],"הגבאים שנכנסו לבית וגנבים שהחזירו הכלים":["גבאים שנכנסו לבית נאמנים","נאמנים על הקודש בירושלים","בשעת הרגל על התרומה","גבאין נכנסו לבית כולו טמא","בנכרי עמם אינם נאמנים","מאימת נכרי ומאימת מלכות"],"דגבאין שנכנסו לבית כולו טמא ואינם נאמנים":["גבאין נכנסו לבית טמא כולו","נכרי עמם ואימת מלכות","נאמנות הגבאים לתרומה","נפק\"מ בנכרי שאינו חשוב","אינם נאמנים כלל","מפחדים מנכרי"],"לא מניחה לרגל אחר שכולם משמשו ברגל":["לא מניחה לרגל אחר","טהרה ברגל התורה","באמת היא טמאה","לחד יניחנה לרגל אחר","כרבנן וכר' יהודה","טהרת הרגל ואמת הטומאה"],"משעבר הרגל היו מעבירים על טהרת העזרה":["מעבירין על טהרת העזרה","עבר ביום ששי לא העבירו","מטבילין כלי המקדש","הזהרו שלא תגעו בשולחן","הכלים שבמקדש יש להם שניים","מזבח הזהב והנחושת"],"הזהרו שלא תגעו בשולחן ובמנורה הוקש לשולח":["הזהרו שלא תגעו בשולחן","מנורה אינה צריכה","כלי עץ לנחת אינו מקבל טומאה","לחם הפנים חם בסילוקו","ציפוי שולחן שמתכת","שולחן עץ שחיפהו שייש"]}