"k": "m",
"letter": "א",
"how": "m",
"i": 3904,
"text": "מתני'.",
"next": "האחין והשותפין שחייבין בקלבון - פטורין ממעשר בהמה, "
},
{
"daf": "נז.",
"k": "m",
"letter": "א",
"how": "m",
"i": 3942,
"text": "מתני'.",
"next": "הכל נכנסין לדיר להתעשר, חוץ מן כלאים, וטרפה, ויוצא דופן, ומחוסר זמן, והיתום."
},
{
"daf": "נז:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3970,
"text": "יתום ",
"next": ""
},
{
"daf": "נח.",
"k": "dh",
"letter": "א",
"how": "ref",
