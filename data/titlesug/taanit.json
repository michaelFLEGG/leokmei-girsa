{"העובר לפני התיבה ביו ט אחרון האחרון מזכי":["שליח ציבור ביום טוב אחרון","ר' יהושע נקרא רי\"ה","מזכיר ביום טוב אחרון בשחרית","העובר לפני התיבה במזכיר","רי\"ה ור\"י ב\"ב: זיהוי המזכיר","שליחות התפילה ביום טוב אחרון"],"שלשה שאלו שלא כהוגן":["שלושה ששאלו שלא כהוגן","אליעזר ושאלת הנערה לבנו","שאול: העושר ובת המלך למכה","יפתח ושאלת הנדר שלא כהוגן","כנסת ישראל ושאלת הגשם","הקב\"ה משיב כהוגן לשואל"],"יורה זמנו במרחשוון אבל באותה שנה בניסן":["יורה במרחשון ושאלה בניסן","רעב שבע שנים בימי יואל","הזורעים בדמעה ברנה יקצרו","אכילה ורעב בשבע שנים","ירושלים של מעלה ושל מטה","גשם שירד בניסן ביואל"],"גשמים נעצרין בשביל פוסקי צדקה ברבים ואין":["גשמים נעצרים מפני מניעת צדקה","עשר תעשר: נסיון בצדקה","מן, באר ועמוד ענן בזכות","מטר לאחד ולרבים","מיתת מרים ואהרן ונסתלק","אולת אדם תסלף דרכו"],"בשלשה במרחשון שואלין את הגשמים":["שאלת גשמים: מרחשון או ז' בו","אחרון ישראל והנהר פרת","שאלת גשמים בבבל ובארץ","יום ששים לתקופה בגולה","הלכה כר\"ג ותקופה עמוקה","צריכים מים: ארץ ישראל ובבל"],"הלכה כר ג":["הלכה כרב ביום שישים","מזכירים בגולה כרב","שמואל: בבל אין צורך במים","תקופה עמוקה ומזכירים בגולה","הלכתא כלאחר שישים","לא נזכרים מים בבבל"],"הגיע י ז במרחשון ולא ירדו גשמים היחידים ":["תעניות יחידים ותעניות ציבור","תענית בי\"ז במרחשון","ג' תעניות לב\"ד על הציבור","תענית שני חמישי שני","אין מתחילין תענית בחמישי","תענית מותרת ברחיצה ובסיכה"],"יחידים א רבנן ב מתענין שני וחמישי ושני":["יחידים מתענים שני וחמישי ושני","הפקעת שערים בחמישי","דעת רבנן על תעניות יחידים","מגילת תענית ופסקה בר\"ח","שמפסיקין בר\"ח וביו\"ט","תעניות שמפסיקות בר\"ח"],"עברו אלו ולא נענו":["שלוש עשרה תעניות על הציבור","נועלין מרחצאות וחנויות בתענית","בשני מטין, בחמישי מותרים","ממעטין במשא ומתן ובנישואין","מתריעין בתעניות הרבות","יחידים חוזרים ומתענים עד ניסן"],"סדר תעניות כיצד דשבע אחרונות ולא ראשונות":["סדר ההתחלה בתענית: קטן וגדול","נחש חוה ואדם בתיקון התענית","שבע אחרונות ולא ראשונות","ראש הנשיא מתחיל בתפילה","אהרן ואלעזר ואיתמר בתענית","בקלקלה מתחילים מהקטן"],"נשיא ואב ב ד אדם אחר מניח להם כדי שיתביי":["אב בית דין ונשיא מתביישים","נשיא ואב בית דין בתענית","הנהגת הנשיא ואב בית דין","בושה לנשיא בתענית","מניחים להם כדי להתבייש","כדי שיתביישו יותר בתענית"],"ומניח במקום תפילין ד לשום לאבלי ציון לתת":["תפילין במקום פאר תחת אפר","אבלי ציון: פאר תחת אפר","מניח במקום תפילין בתענית","אפר ופאר לאבלי ציון","מקום תפילין לאבלי ציון","פאר תחת אפר: דרשה לתענית"],"נתנה עלי בקולה מרב זה ש ץ שאינו הגון היו":["שליח ציבור שאינו הגון","נתנה עלי בקולה: פירוש רב","ש\"ץ שאינו הגון לפני התיבה","דרשת נתנה בקולה לש\"ץ","קול שליח ציבור בתענית","הש\"ץ הנזוף בתפילת התענית"],"א סדר תעניות ברביעה ראשונה היינו רביעה א":["רביעה ראשונה: מתי מתריעים","ירדו ולא צמחו בתענית","נשתנו אבל יבשו: לא מתריעין","תפילת שוא בנתקנו מעט","סדר תעניות בשלוש הרביעות","צמחו ונשתנו מתריעין מיד"],"בג פרקים נושאים כפיהם בכל תפילה":["נשיאת כפיים בשלושה פרקים","נשיאת כפים במנחה ובנעילה","גזירה אטו שכרות בנשיאת כפים","הלכה כר\"מ בנשיאת כפים","נוהגים כר\"מ במנחה","ר\"נ: הלכה כר' יוסי בכפים"],"שכור אסור בנשיאת כפים נסמך לנזיר שאסור ב":["שכור אסור בנשיאת כפים","שכור כנזיר: איסור יין","חרצן מותר לשכור","שכור ומום בנשיאת כפים","הקישוי לנזיר לקולא","שכור כנזיר דרבנן"]}