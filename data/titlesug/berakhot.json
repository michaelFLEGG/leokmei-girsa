{"אין אומרין בפני המת אלא דבריו של מת":["דברי תורה בלבד בפני המת","אסור דברי חול בפני מת","מה מותר לומר בפני המת","אין לדבר בפני המת דברי העולם","אף בדברי תורה יש גבול","שיח בפני המת ודברי תורה"],"ואתנה לך את לוחת האבן והתורה והמצוה אשר ":["כל התורה נתנה למשה מסיני","לוחות תורה מקרא ומשנה","ארבעה חלקי התורה מסיני","הלוחות והמצוה נתנו למשה","תורה שבכתב מסיני כולה","חלקי התורה כולם מסיני"],"תפלה נשמעת בביהכנ ס במקום רנה":["שכינה בבית הכנסת לעשרה","מניין עשרה ושכינה","שלשה בדין ושנים בספר","תפלה בציבור במקום רנה","שכינה עמו אפילו אחד","עשרה לשכינה קדמה"],"מאמתי זמן קר ש שחרית":["זמן קריאת שמע של שחרית","משיכיר בין תכלת ללבן","מחלוקת תנאים על זמן שמע","עד שלוש שעות כדרך מלכים","קריאה עד הנץ החמה","זמן שמע לרבי אליעזר"],"רבי יהושע עד ג שעות הלכה כריה ש":["הלכה כרבי יהושע בזמן שמע","קורא אחר שלוש שעות לא הפסיד","שלא יאמר יוצר אור בזמן","קורא בעונתה יותר מהעוסק בתורה","שכר קריאה בזמנה","ברכות שלא הפסיד הקורא"],"ב ש בערב כל אדם יטה ויקרא בבוקר יעמוד":["בית שמאי ובית הלל בקריאה","בערב יטה ובבוקר יעמוד","הטיה וזקיפה בשמע","בשכבך ובקומך שכיבה וקימה","בשבתך ובלכתך חיוב המצוה","בין ישיבה לעמידה בשמע"],"דא כ נימא בבוקר ובערב ב ש בשכבך ובקומך ש":["כונס בתולה פטור משמע","טרדה דמצווה ולא טרדה דרשות","עמידה וקריאה בדרך","הטיה וזקיפה לר\"א","עשייה ופטור בכל מצוה","חיוב שמע באלמנה שלא טרודה"],"בשחר מברך ב לפניה וא לאחריה":["מספר ברכות שחרית וערבית","יוצר אור ובורא חושך","מקום שאמרו להאריך","להזכיר מידת לילה ביום","ברכת הלילה והיום","לחתום בשם שלא לחתום"],"יוצר אור ובורא חושך ולא נוגה להזכיר מידת":["נוסח יוצר אור ולא נוגה","אהבה רבה או אהבת עולם","גולל אור מפני חושך","מי נותן נוגה לאור","ברכה לפני שמע בערבית","תנ\"ה ורבנן כקרא"],"לא שתעקר יצא מ ממקומה אלא שתהא טפלה לשעב":["גאולה אחרונה משכחת ראשונה","שעבוד מלכויות ופסוק יעקב","לא שיעקר אלא שיטפל לישראל","עושה חדשה מלחמת גוג ומגוג","משל לזאב ואחר כך ארי","ישראל אחרונות משכחות ראשונות"],"קורא להגיה מתכוון היינו לקרות":["קריאה בהגיה בלא כוונה","מצוות צריכות כוונה","קריאת שמע ככתבה","שמע בכל לשון ששומע","והיו בהוויתן שלא למפרע","קורא ומשמיע לאזנו"],"בפרקים לר מ שואל מפני הכבוד ואצ ל משיב":["שואל משיב מפני הכבוד","שאילת שלום בפרקים","שואל מפני היראה באמצע","הלל ומגילה פוסק","הפסקה בין פרק לפרק","ר\"מ ושלום לכל אדם"],"קורא את שמע ולא השמיע לאזנו יצא לרבי יוס":["השמעה לאזנו בקריאת שמע","קורא ולא דקדק","קרא למפרע לא יצא","קורא וטעה חוזר למקום","דעת ר' יוסי בהשמעה","חרש שאינו שומע"],"שמע רבי יוסי השמע לאזנך ת ק בכל לשון":["חרש המדבר ואינו שומע","הכל כשרים לקרות המגילה","קטן כשר לקריאת המגילה","כוונת הלב בקריאה","השמעה לאזנו כר\"מ","קטן שהגיע לחינוך"],"האומנין קורין בראש האילן והנדבך משא כ בת":["חתן פטור מקריאת שמע","מעשה ברבן גמליאל בחתנותו","אומנין קוראין בראש האילן","לא אבטל ממנו מלכות שמים","קריאה בלילה הראשון לחתן","חתן שעשה מעשה חייב"],"מוטל לפניו ושאינו מוטל לפניו לא":["האונן פטור מקריאת שמע","אונן ומוטל לפניו","בשבת מיסב ואוכל בשר","אונן מחזיר פניו ואוכל","מתוך שנתחייב באלו נתחייב בכולן","דין אונן בתשמיש המטה"],"נשים ועבדים וקטנים פטורין מקר ש ותפילין":["נשים ועבדים פטורים משמע","מזוזה ותפלה חובה לנשים","זכור ושמור לנשים","נשים בברכת המזון מדאורייתא","בן מברך לאביו ועבד לרבו","נשים חייבות בקדוש היום"],"פטורין מקר ש אפי שיש בה מלכות שמים דמעשה":["שמע ותפילין לנשים","הזמן גרמא ונשים","זכור ושמור כל שישנו בשמירה","בן מברך לאביו ואשה לבעלה","אשתו ובניו מברכין לו","קטן ושיעור דרבנן"],"בעל קרי מהרהר בלבו ואינו מברך לפניה ולאח":["בעל קרי מהרהר בלבו","הרהור כדבור בברכות","ברכת המזון לבעל קרי","תפלה דבר שהצבור עסוקין בו","שלא יפסיק בתפלה אלא יקצר","בהתחיל תפלה דרבנן"],"הרהור כדבור דאי לאו שיוציא בשפתיו כבסיני":["הרהור כדבור ולא כדבור","בעל קרי שאינו מוציא בשפתיו","מהרהר כר\"א","בעל קרי שנזכר בתפלה","קר\"ש וברכת המזון דאורייתא","שיוציא בשפתיו כבסיני"],"נהגו העולם כתלת סבי לקולא":["שלוש הנהגות לקולא","ראשית הגז נוהג בארץ בלבד","כלאים בד\"ת אינם מקבלין טומאה","טבילה ונטילה כרבי יהושע","מחמיר מאריכין לו ימיו","גדר טבילת מ' סאה"],"עמד בתפלה ונזכר שהוא בעל קרי לא יפסיק אל":["בעל קרי ונזכר בתפלה","ירד לטבול ויכול לעלות","מים סרוחים לטבילה","מרחק מן הצואה ד' אמות","מגמגם וקורא בתורה","בעל קרי לא יקרא יותר משלשה"],"קורא בתורה ונזכר אינו מפסיק ועולה אלא מג":["קורא בתורה ונזכר מגמגם","בעל קרי ג' פסוקים בתורה","צואה כנגדו בתפלה","זורקה לאחוריו ד' אמות","מתפלל לצדדין בלא אפשר","בעל קרי לא יפסיק"],"רבי נחוניא בן הקנה התפלל":["תפלה בכניסה לבית המדרש","הודאה ביציאה מבית המדרש","שלא יארע דבר תקלה על ידי","שלא אכשל בדבר הלכה","לא אומר טמא טהור","ר' נחוניא בן הקנה ותפלתו"],"בכניסתו יהר מ ה אלהי שלא יארע דבר תקלה ע":["שמחה בחברי ולא תקלה","ר' נחוניא ושמחה בחברים","תפלה בכניסה ובצאת","שלא יכשלו חברי בהלכה","טמא טהור ואשמח בהם","בכניסה ובצאת לבית המדרש"],"ר ג בכל יום ויום מתפלל אדם שמנה עשרה רי ":["מתפלל י\"ח בכל יום","מעין י\"ח לשגורה בפיו","העושה תפלתו קבע","הולך במקום סכנה","רוכב על החמור ומתפלל","יכוין לבו כנגד בית קדשי הקדשים"],"טעה ולא הזכיר ר ח בעבודה ריב ל חוזר לעבו":["טעה ולא הזכיר ראש חודש","חוזר לעבודה או לראש","עקר רגליו וחזרה לראש","תחנונים אחר התפלה","שים שלום וחזרה לעבודה","בהודאה נזכר חוזר"],"כינסו עשרה בשבת הרגל והתפללו ואח כ יצאו ":["מתפלל ביחיד עם הציבור","תפלה מיושב כשבא לביתו","חזר והתפלל מעומד","טרחה בתפלה וחזרה","תפלה שבת הרגל בעשרה","הנהגת הזקנים שלא תפלל"],"תפלת המוספין ראב ע רק בחבר עיר וחכ א גם ":["תפלת מוסף ביחיד","יחיד שלא בחבר עיר","הלכה כר\"י מראב\"ע","מוסף בנהרדעא לשמואל","מוסף בתוך עמודי בית הכנסת","ר' ינאי שהתפלל פעמיים"],"יחיד שלא בחבר עיר":["מוסף ביחיד אם יכול לכוין","שלא הזכיר ראש חודש בערבית","מתפלל מוסף כשאין חבר עיר","למה נהג כן ר' זירא","אם לא כיוון דעתו","תפלה מחזירין ביחיד"],"היושב בתענית בשבת קורעין לו גז ד של שבעי":["תענית בשבת וענוג שבת","חנה הטיחה דברים כלפי מעלה","אליהו הטיח והקב\"ה הודה","משה הטיח דברים כלפי מעלה","שלוש מקראות שהחזיקו ישראל","גדולה תפלה ממעשים טובים"],"וידבר ה אל משה לך רד א ל הקב ה למשה משה ":["משה מתחזק בתפלה","כלום נתתי לך גדולה","משל למלך שכעס על בנו","תופס בבגדו של הקב\"ה","הרף ממני ואשמידם","משה דבר זה תלוי בי"],"ואעשה אותך לגוי גדול רבש ע ומה כסא של של":["כסא של שלש רגלים בכעס","בושת פנים מאבות","משה בקש גדולה לעצמו","לא בקש עליהם רחמים","כסא של רגל אחד","ראו פרנס שהעמיד עליהם"],"ויחל משה את פני ה":["ויחל משה את פני ה'","מסר עצמו למיתה עליהם","אש של עצמות זכר לאבות","שבועה בשם הגדול","אלמלא נשבעת בשמים וארץ","שבועה קיימת לעולם"],"ותדבר אלהם ככוכבי השמים וכל הארץ הזאת אש":["דברי תלמיד ודברי הרב","אלו ואלו דברי תלמיד","משה אמר בשמי לישראל","מה אני אומר להם עכשיו","בשם הקב\"ה הלכתי ואמרתי","תלמיד מכאן ואילך"],"מבלתי יכלת ה":["אומות העולם יאמרו תש כחו","מלך אחד יכול לעמוד","לל\"א מלכים אינו יכול לעמוד","נסים וגבורות על הים","מבלתי יכלת ה'","שכח כנקבה ואינו יכול להציל"],"ויאמר ה סלחתי כדבריך":["סלחתי כדבריך","אשרי תלמיד שרבו מודה לו","החייתני בדבריך","לעולם יסדר שבח ואח\"כ יתפלל","גדולה תפלה ממעשים טובים","גדולה תענית מן הצדקה"],"התשכח אשה עולה":["גם אלה תשכחנה ואנכי לא אשכחך","שכחה לפני כסא כבוד","מעשה העגל ומעשה סיני","עולות אילים ופטרי רחמים","שכחה לפני הקב\"ה","שמא תשכח מעשה סיני"],"מזכירין גבורות גשמים בתחיית המתים":["גבורות גשמים בתחיית המתים","הבדלה בחונן הדעת","ברכה רביעית בפני עצמה","שאלה בברכת השנים","ר\"ע ור\"א בברכה רביעית","מקום ההזכרה בתפלה"],"האומר על קן צפור יגיעו רחמיך ועל טוב יזכ":["על קן צפור יגיעו רחמיך","מודים מודים משתקין אותו","הודאה על הטובה ולא על הרעה","חייב לברך על הרעה","על טוב יזכר שמך","כשתי רשויות"],"מודים מודים משתקין אותו דנראה כשתי רשויו":["משתקין כשתי רשויות","על הטובה ולא על הרעה","מברך על הרעה כשם שעל הטובה","מי שאומר על קן צפור","ברכת הטוב והמטיב","מה מותר להזכיר בתפלה"],"על קן צפור יגיעו רחמיך":["מפני קנאה במעשה בראשית","שבחו של הקב\"ה ברוב שבחים","שירד לפני רבה","סיימת לכל שבחי דמרך","שלושת השבחים מאנשי כנה\"ג","יראת שמים אוצר הקב\"ה"],"האומר יברכוך טובים הר ז דרכי מינות":["יברכוך טובים דרכי מינות","עובר לפני התיבה וטעה","סרבנות לפני התיבה","שאור ומלח וסרבנות","טעה בראשונות חוזר לראש","האמצעיות אין להן סדר"],"העובר לפני התיבה צריך לסרב ואם אינו מסרב":["שלשה רובן קשה ומיעוטן יפה","סירוב בעובר לפני התיבה","ישאל אדם צרכיו באמצעיות","ראשונות כעבד מסדר שבח","אחרונות כעבד שקיבל פרס","מאריך יותר מדאי לפני התיבה"],"המתפלל וטעה סימן רע לו":["המתפלל וטעה סימן רע","ש\"צ סימן רע לשולחיו","ר' חנינא בן דוסא מתפלל על החולים","שגורה תפלתי בפי","מקובל או מטורף","שלוחו של אדם כמותו"],"דמתני אמתני באבות ואיכא דמתני אברייתא":["מתני' באבות או בברייתא","לכוין לבו באחת מהן","אם אינו יכול לכוין בכולן","יכון לבו באבות","סדר ברכות באבות","כוונה בתפלה לאחת"],"זרק אביונות ואכל קפריסין":["מי נוהג כרבי עקיבא","כלאים בכרם וערלה","ספק ערלה בארץ ישראל","שומר לפרי בערלה","ערלה בקליפי רמון","בית שמאי ובית הלל בערלה"],"שני תלמידים שישבו לפני בר קפרא והביאו לפ":["מברך על הפרגיות לפני הכרוב","לגלוג על המברך","שלקות ופרגיות שהכל נהיה","חביב עדיף או מזין","בר קפרא נותן רשות לברך","שניהם לא הוציאו שנתן"],"ובשבת חייב לבצוע על שתי ככרות דלחם משנה":["חייב לבצוע על שתי ככרות","בצע על הכל ולא כרעבתנות","לחם משנה בשבת","החזיק שנים ובצע אחד","לחם ערוב והמוציא","המוציא לעשות מצוה אחרת"],"בירך על פירות האילן בורא פרי האדמה יצא":["ברכה על פירות האילן","עיקר אילן ארעא","בורא פרי העץ על פירות הארץ","הכל נהיה בדברו","יבש המעין ונקצץ האילן","מביא ואינו קורא"],"דעיקר אילן ארעא היא וכר י":["יבש המעין ונקצץ האילן","מביא וקורא לר' יוחנן","ר' יוחנן בברכת האילן","מקור הברכה בפירות","מביא ואינו קורא כרבי","הכל נהיה בדברו בלבד"],"כל ברכה שאין בה הזכרת השם אינה ברכה":["ברכה בלא הזכרת השם","ברכה בלא מלכות אינה ברכה","ברוך כרב דלא עברתי","ולא שכחתי להזכיר שמך","תני ולא שכחתי","מלכותך עליו בברכה"],"על דבר שאין גדולו מן הארץ אומר שהכל נהיה":["שהכל נהיה בדברו על החומץ","מין קללה אין מברכין","מין שבעה עדיף","מברך על איזה שירצה","מינים הרבה לפניו","נובלות וגובאי"],"אי מחלוקת בשברכותיהן שוות":["מין שבעה ומין חביב","ברכות שוות ושאינן שוות","מקדים המוקדם בפסוק","ארץ חטה ושעורה וגפן","לשיעורין נאמר הפסוק","חטה לנכנס לבית המנוגע"],"אכל י ג לחמי כיסנין ולא בירך":["לחמי כיסנין ולא ברך","קביעות סעודה ומוציא","מוציא על לחמניות","בחתונת ריש גלותא","סילוק השולחן וגמר הסעודה","הלכה כרבי מונא"],"הרגיל בשמן רב שמן מעכבו":["הרגיל בשמן רב","שמן מעכב מלברך","שלוש תכיפות בתורה","תכף לסמיכה שחיטה","ברכה תכף לתלמידי חכמים","ויברכני ה' בגללך"],"ברך על היין שלפני המזון פטר היין שלאחר ה":["ברכה על היין לפני המזון","פטר היין שלאחר המזון","פטר הפרפרת את הפת","ב\"ש אף לא מעשה קדרה","הסבו אחד מברך לכולן","מברך לכולם אחר המזון"],"ברך על הפת פטר את הפרפרת":["הפרפרת ופטורה מהפת","מעשה קדרה והברכה","איבעיא בברכה על הפרפרת","תיקו בברכה ראשונה","פטר הפת את הפרפרת","ב\"ש בברכה ראשונה"],"איבעיא ב ש ארישא דאפי מעשה קדאה לא פטרה":["תיקו בבית שמאי","איבעיא מעשה קדרה","לא פטרה מעשה קדרה","ברכה על הפרפרת לא פטרה","הוכחה בברכות המזון","הספק בפטור"],"הסבו אחד מברך לכולן":["הסבה בפת ולא ביין","הסבה גם ביין","סדר ההסבה","אורחין נכנסין ויושבין","מים לכל אחד","יין כל אחד מברך לעצמו"],"היוצא בימי ניסן ורואה אילנות המלבלבים ר ":["ברכה על אילנות המלבלבים","מברכין על הריח","כל הנשמה תהלל יה","אבוקה כשנים וירח כשלשה","אבוקה יחד עמו או חוץ","עדיף לנפול לכבשן האש"],"הביאו לפניו מליח תחלה ופת עמו":["מברך על העיקר ופוטר הטפל","מליח ופת עמו","הכלל בברכה על טפל","מברך על המליח ופוטר הפת","פת טפלה למליח","ברכה על העיקר בלבד"],"עיר היתה לינאי המלך בהר המלך שמוציאים ממ":["סעודה שאין בה מלח","סעודה שאין בה שריף לח","אילן לינאי המלך","עיר גופנית בארץ ישראל","נישואי כהנים לכהנות","ערים גדולות וישובן"],"אכל ענבים ותאנים ורמונים":["ג' ברכות על ענבים ותאנים","ברכה אחת מעין שלש","אפילו אכל שלק","השותה מים לצמאו","בורא נפשות רבות","ר' טרפון ובורא נפשות"],"כל שהוא כביצה ביצה טובה ממנו":["ביצה טובה משש לוגין סולת","ביצה צלויה לחה","ביצה צלויה רכה","ביצה צלויה קשה","ביצה מבושלת חוץ מבשר","כל שהוא כביצה"],"ריש גלותא לרב ששת אע ג דרבנן קשישי אתם":["ריש גלותא ורב ששת","קשישי אתם בשלמא","זקנים הם הרבנים","כבוד הרבנים לפני ריש גלותא","שאלה מריש גלותא לרב ששת","רב ששת ומעמדו"],"אכל טבל ומעשר בטבל טבול מדרבנן בעציץ שאי":["אכל טבל ומעשר","טבל טבול מדרבנן בעציץ","מעשר ראשון שהקדימו בכרי","מעשר שני שלא נפדו","מעשר שני על אסימון","הקדש שחללו על קרקע"],"משה תקן ברכת הזן כשירד המן":["משה תקן ברכת הזן","יהושע תקן ברכת הארץ","דוד ושלמה בונה ירושלים","הטוב והמטיב כנגד הרוגי ביתר","הטוב שלא הסריחו","מטיב שניתנו לקבורה"],"כל שלא אמר ארץ חמדה טובה ורחבה בברכת האר":["ברית ותורה בברכת הארץ","מי שחותם מנחיל ארצות","הפוחת מאחת מגונה","הודאה בתחילה ובסוף","צריך לזכור בה ברית","לא יצא ידי חובה בלא ברית"],"ניתי מר ונתני א ל ברכהמ ז איני יודע ואשנ":["רב ששת וברכת המזון","ברית תורה ומלכות בברכה","נשים ועבדים בברכה","זקף רב ששת צוארו כנחש","למה עזב תנאים ואמוראים","ברכהמ\"ז בלא ברית תורה"],"ישב אחרי ר ג ור ג לפני ר ה טעה ולא הזכיר":["טעה ולא הזכיר של שבת","טעה ולא הזכיר של ראש חודש","טעה ולא הזכיר של יום טוב","חוזר לראש בהטוב והמטיב","בתפלה מחזירין וברכה לא","ברכת המזון אינה חובה"],"כיצד מזמנין":["כיצד מזמנין בשלשה ובעשרה","זימון במאה ובאלף","ברכו בעשרה ובמאה","לפי רוב הקהל מברכים","במקהלות ברכו את ה'","מניין הזימון"],"שלשה שאכלו כאחת אין רשאין ליחלק":["מניין שאכלו כאחת","ששה נחלקין עד עשרה","עשרה אינם נחלקין עד עשרים","שתי חבורות באותו בית","מים ביין לר' אליעזר","שלשה משלש חבורות"],"ג שישבו לאכול כאחת אף שכ א אוכל מככרו אי":["שלשה משלש חבורות אינם מזמנין","זימון שלא זומנו עליהם","מטה שנגנבה חציה טהורה","מקבלת טומאה מכאן ולהבא","טומאה לא למפרע","חלוקה פרחה טומאה"],"שכח והכניס אוכלין לתוך פיו בלא ברכה":["שכח והכניס אוכלין בלא ברכה","משקין בולען","מאיס פולטן","מסלקן לצד אחד ומברך","ימלא פי תהלתך","ברכה לפני הכנסה לפה"],"אכל ושתה ולא ברך מהו שיחזור ויברך":["אכל ולא ברך חוזר ומברך","שום וריחו נודף","גמר סעודתו יחזור ויברך","טבל ועלה ברוך אשר קדשנו","ברכה בעלייה מהטבילה","ואידחי אידחי"],"וברך ברכהמ ז והביא כוס של ברכה לר נ א ל ":["כוס של ברכה לילתא","פרי בטנה של אשה","שישלח כוס אחרת לפייסה","היין שבחבית יין ברכה","מרוכלים ירבו דברים","ברכה לפייס אשה כועסת"],"אין מסיחין על כוס של ברכה":["אין מסיחין על כוס של ברכה","אין מברכין על כוס פורענות","שותה כפלים לא יברך","אוכל ומהלך מברך מעומד","אוכל מעומד מברך מיושב","יושב ומברך בכולהו"],"אין מברכין על הנר ובשמים של נכרים מתים ע":["ברכה על הנר של נכרים","בשמים של נכרים ועבודה זרה","נר שלא שבת","אור ששבת ממלאכת עבירה","מלאכה דהיתר כאור חולה","עששית שדלקה כל היום"],"נכרי שהדליק מישראל וישראל מנכרי מברכין ע":["נכרי שהדליק מישראל","ישראל מנכרי מברכין","נכרי מנכרי אין מברכין","גזירה משום נכרי ראשון","עמוד ראשון המוציא שלהבת","תוספת ההיתר בברכה"],"הרואה בתי ישראל בישובן מברך מציב גבול אל":["ברכה על בתי ישראל בישובן","בתי אוה\"ע בחורבנן","ברכה על קברי ישראל","קברי נכרים בושה אמכם","בית שהיו בו ס' אופין","ברוך דיין האמת"],"גשמים הטוב והמטיב והך דמשיצא חתן לקראת כ":["ברכת הגשמים הטוב והמטיב","מודים על כל טפה","גשם מועט והטוב והמטיב","ילדה אשתו זכר","מת אביו ויורשו","שינוי יין אינו צריך ברכה"]}