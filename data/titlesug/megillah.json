{"את יום י ד ואת יום ט ו את הפסיק הני בי ד":["קריאת מגילה בי\"ד ובט\"ו","את הפסיק: בי\"ד ובט\"ו","הניתוק בין יום י\"ד לט\"ו","שני ימי הקריאה בזמנם","הפסיק במקרא מגילה","זמן הקריאה לכל מקום"],"בזמניהם זמנו של זה לא זמנו של זה כשושן ו":["זמן הקריאה לכל מקום","כשושן ולא בי\"ג","בזמניהם: לכל עיר זמנה","אין ערים שוות בזמן הקריאה","זמנו של זה לא זמנו של זה","הבחנה בין ערי חומה לפרזות"],"מקרא מגילה עדיף מתלמוד תורה מדבית רבי":["מקרא מגילה קודם לתלמוד תורה","מקרא מגילה עדיף מת\"ת","מדבית רבי: מקרא מגילה במקום תורה","דחיית תלמוד תורה למקרא מגילה","עדיפות מקרא מגילה","מקרא מגילה ולימוד התורה"],"מת מצווה עדיף מת ת מדמבטלין ת ת להוצאת מ":["מת מצוה עדיף ממקרא מגילה","סדר עדיפות המצוות בהלוכה","פרסום הנס וכבוד הבריות","דחיית לא תעשה מפני כבוד הבריות","מת מצוה ודחיית פסח ומילה","מצוות שדוחות את התורה"],"עיר גדולה כל שיש בה עשרה בטלנין פחות מכך":["עשרה בטלנין מקדימין ומאחרין","עיר גדולה ודין הקדמה","מקדימין במגילה ומאחרין בחגיגה","הקדמה והאחרה לפי היישוב","חודש שנכנס בשני ובחמישי","ימים לחדשים ולא שעות"],"עשרה בטלנין ממלאכתם שבבית הכנסת":["עשרה בטלנין בבית הכנסת","מגילה מקדימין ולא מאחרין","ולא יעבור: דרשת שמואל","חדשים לשנים ולא ימים","עד חדש ימים: ימים לחדשים","ימי הקריאה ותקופת החודש"],"קסרי וירושלים חרבו שתיהן או ישבו שתיהן א":["קסרי וירושלים: מתי תאמן","יגעתי ומצאתי אם תאמן","אל תתגרה ברשע שהשעה משחקת לו","גרמניא דאדום והמלחמות","חורבן שתי ערים בהשוואה","התגרות ברשעים מותרת"],"קראו מגילה באדר הראשון ונתעברה השנה קורי":["קריאה באדר הראשון והשני","בין אדר ראשון לאדר שני","מתנות לאביונים באדר ב","קריאה בשנה מעוברת","מגילה בשנה מעוברת","הקריאה חוזרת באדר השני"],"אין בין יו ט לשבת אלא אוכל נפש בלבד":["יום טוב ושבת: אוכל נפש","מכשירי אוכל נפש ביום טוב","הוא ולא מכשיריו","לכם לכל צורכיכם","היתר מכשירי אוכל נפש","ההבחנה בין יום טוב לשבת"],"הא לענין מכשירי אוכל נפש שוין שאסור":["מכשירי אוכל נפש שוין","הוא ולא מכשיריו","לכם ולא לנכרים וכלבים","לכל צורכיכם ביום טוב","הכשר מעיו\"ט למכשירין","איסור מכשירי אוכל נפש"],"אין בין שבת ליוה כ אלא שזה זדונו בידי אד":["שבת ויום כיפור לתשלומין","חייבי כריתות שלקו נפטרו","זדונו בידי אדם או בכרת","מודר הנאה ודריסת הרגל","כלי אוכל נפש במודר","נדרים ונדבות לאחריות"],"הא לענין תשלומין שוין שפטור":["פטור תשלומין ביום כיפור","מלקות לחייבי כריתות","מודר הנאה: דריסת הרגל","אחריות בנדר ובנדבה","זב הרואה שתי ראיות","בל תאחר בנדר ובנדבה"],"הא לענין כלי אוכל נפש שוין שאסור":["כלי אוכל נפש שוין לאיסור","נדר וחובת אחריות","זב: שתי ראיות שלוש ראיות","למשכב ומושב וספירת שבעה","זב מטמא ומביא קרבן","מזובו: מקצת זבים מביאין קרבן"],"לענין בל תאחר שוין שעובר":["בל תאחר בנדר ובנדבה","נדר חייב באחריות","זב: שתים לטומאה ושלוש לקרבן","למשכב ומושב שוין","מזובו וכפר עליו הכהן","אחריות כנשיאת על הכתף"],"הא למשכב ומושב וספירת שבעה שוין":["זב למשכב ומושב","ספירת שבעה בזב","מנה שתים וקראו טמא","שלוש ראיות: קרבן","למשכב ומושב שוין לזב","ספירה לזב והקרבן"],"וכי יטהר לכשיפסוק מזובו ולא מזובו ונגעו":["מזובו וספר: שבעה ימים","שומרת יום כנגד יום","למעט ולרבות מזובו","ספירה כדין שתי ראיות","וכי יטהר לכשיפסוק","ספירה בזב מדרשה"],"אין בין מצורע מוסגר למוחלט אלא פריעה ופר":["מצורע מוסגר ומוחלט","פריעה ופרימה למצורע","טהור מתוך הסגר","תגלחת וצפרים לטהרת מצורע","שילוח ממחנות לטומאה בביאה","צרעת תלויה בגוף או ברפואות"],"הא לענין שילוח מג מחנות ולטמא בביאה שוין":["שילוח מצורע לשלוש מחנות","מוסגר: פריעה מעיקרא","כל ימי הנגע בו יטמא","צרעת תלויה בגופו","טהור מתוך הסגר: תגלחת","מצורע נרפא ברפואות"],"אין בין ספרים לתפלין ומזוזות":["ספרים בכל לשון ותפילין באשורית","רשב\"ג: יוונית בספרים","תרגום מקרא ואינו מטמא ידיים","כתיבה בכתב אשורי בלבד","תלמי ושבעים זקנים ביוונית","שינויים בתורה יוונית"],"אבל שוין לענין שצריך לתופרן בגידין ושמטמ":["שבעים זקנים ותרגום יוונית","תלמי המלך וכתבו לי תורה","מקרא תרגום אינו מטמא ידיים","י\"ב שינויים בתרגום","כתיבה ביוונית בס\"ת בלבד","תפילין ומזוזות באשורית"],"אין בין כהן משוח למרובה בגדים אלא פר הבא":["כהן משוח ומרובה בגדים","פר הבא על כל המצות","עשירית האיפה לכהן שעבר","שני כהנים וחזרה לכהונה","פר מביא מרובה בגדים","רבי מאיר במינוי כהן גדול"],"הא לענין פר יום הכפורים ועשירית האיפה שו":["במה גדולה ובמה קטנה","נידר ונידב בבמה קטנה","פסחים וחובות בבמה גדולה","קרבנות שקבוע זמנם","צבור והקרבה בבמה גדולה","הכלל בבמות ופסחים"],"פסחים כעין פסחים חובות שקבוע זמנם":["פסחים על במה גדולה","חובות שקבוע זמנם","צבור מקריבים פסחים בלבד","במה גדולה לחובות קבועים","כעין פסחים בבמה גדולה","פסחים וחובות בבמה"],"שמעתי שמקריבין בבית חוניו בזמן הזה":["בית חוניו וקדושה ראשונה","קדושה ראשונה לשעתה ולעתיד","קלעים להיכל בזמן הזה","מקרבנות בית חוניו","ערי יהושע שמוקפות חומה","אין אחריה היתר בירושלים"],"מסורת מאנשי כנסת הגדולה כל מקום שנא ויהי":["ויהי לשון צער במקרא","ויהי בימי אחשורוש: צער","מסורת אנשי כנסת הגדולה","ויהי בשאר מקומות לשבח","ויהי: צער או שמחה","ויהי ערב ויהי בקר"],"אחשורוש א אחיו של ראש נבוכדנצר שנקרא ראש":["אחשורוש: אח לראשו","שהושחרו בימיו כקדרה","אחשורוש ונבוכדנצר דומים","הזוכרו: אח לראשו","שהכל רשין בימיו","אחשורוש ברשעו מתחילתו"],"הוא אחשורוש ברשעו מתחילתו סופו וכן בעשו ":["הוא אחשורוש: רשעו מתחילתו","עשו ודתן ואבירם לרעה","ברשעו מתחילתו ועד סופו","אחשורוש כעשו ואחז","רשעים מתחילתם לסופם","פרשת אחשורוש ברשעה"],"אברם הוא אברהם בצדקו מתחילתו סופו וכן במ":["אברם הוא אברהם בצדקו","צדיקים מתחילתם ועד סופם","אברהם כמשה ואהרן ודוד","צדקו מתחילתו לסופו","הוא בצדקו מתחילה","שם אברהם משמעות הצדק"],"המולך שמלך מעצמו לא מזרע המלוכה ומעצמו ל":["המולך: מלך מעצמו","מלך שלא מזרע המלוכה","מלכות לשבח או לגנאי","אחשורוש מלך מעצמו","המולך לא מזרע מלכים","מלך בלי יורשין"],"מהודו ועד כוש הודו וכוש בשתי קצוות העולם":["מהודו ועד כוש: שתי קצוות","הודו וכוש גבי הדדי","מלכות על כל העולם","שתי קצוות העולם","מהודו עד כוש במלכותו","גבולות המלכות מהודו"],"שבע ועשרים ומאה מדינה בתחילה שבע אח כ עש":["שבע ועשרים ומאה מדינה","שבע בתחילה עשרים בסוף","מאה מדינה בסוף הקצבה","מספר המדינות במלכות","מאה מדינות בסופו","מנין המדינות בתחילה ובסוף"],"בימים ההם כשבת המלך וכתיב בתריה בשנת שלו":["כשבת המלך: כשנתיישבה דעתו","בשנת שלוש למלכו","שבעים שנה לגלות בבל","אחשורוש חישב ולא טעה","חשבון מלכות בבל ופרס","שבעים לגלות ולא לחורבן"],"חיל פרס ומדי הפרתמים ובסוף המגילה למלכי ":["חיל פרס ומדי הפרתמים","מלכי מדי ופרס בתנאי","התנו בניהם מדי ופרס","פרתמים: שתי מלכויות","סדר המלכים מדי ופרס","תנאי המלכים בין מדי לפרס"],"בהראתו את יקר תפארת גדולתו שלבש בגדי כהו":["בהראתו את יקר תפארתו","בגדי כהונה של אחשורוש","יקר תפארת גדולתו","המלך לבש בגדי כהונה","הראה עושרו לבגדי כהונה","תפארת גדולתו בבגדי כהן"],"ובמלאות הימים עשה המלך לכל העם הנמצאים ב":["משתה לכל העם בשושן","קירב הרחוקים תחילה","מלך פיקח מול טפש","קירוב הרחוקים לפני העיר","משתה לעם הנמצא בשושן","הרחוקים לפני הקרובים"],"תלמידי רשב י נתחייבו ישראל כליה שנהנו מס":["סעודת הרשע ותלמידי רשב\"י","נתחייבו ישראל כליה","דחאם רשב\"י: רק בשושן","השתחוו לצלם נבוכדנצר","סעודה ונהנו ממשתה הרשע","רשב\"י דוחה את תלמידיו"],"בחצר גנת ביתן המלך א כ א מקום הראוי לו ב":["חצר גנת ביתן המלך","מקום הראוי לו בחצר","חצר וגינה לביתן","חצר שפתחה לגינה","לא החזיקתן עד שהכניסן","מבנה החצר והגינה"],"חור א מעשה נקבים חורים ב מילת לבנה חיור":["חור: מעשה נקבים","חור ולבנה חיור","מילת חור במשמעות","נקבים ולבנה","חור ונקב בביאור","שני פירושי חור"],"מטות זהב וכסף א הראוי כסף והראוי זהב ב ר":["מטות זהב וכסף","הראוי כסף והראוי זהב","רגליהם זהב במטות","זהב וכסף במטה","מטה כסף ומטה זהב","מטות ורגליהם"],"רצפת בהט ושש אבנים שמחטטים אחריהם למוצאן":["רצפת בהט ושש","אבנים שמחטטים אחריהם","בהט ושש ברצפה","אבני רצפה לחיפוש","רצפה של אבנים יקרות","אבנים למציאתן"],"ודר וסחרת א דרי דרי סחור שורות סביב ב אב":["ודר וסחרת: סביב ומאירה","דרה ודרור לבעלי סחורה","אבן מאירה כצהרים","סחרת ודר כאבנים","סביב ומכס לסוחרים","שלוש משמעויות ודר"],"והשקות וכלים מכלים שונים ראשונים כלו מזה":["כלים שונים מכלי בלשאצר","ראשונים כלו בבלשאצר","שותים בכלי המקדש","כלים מכלים שונים בשתייה","בשתייה מכלי המקדש","שתיית כלי בלשאצר"],"ויין מלכות רב שהשקה כ א יין הגדול ממנו":["יין מלכות רב","השקה יין הגדול ממנו","יין מלכות לפי גדולה","יין המלך בכל אחד","השקאה לפי מעלה","יין הרב לכל אחד"],"והשתיה כדת כדת תורה אכילה מרובה משתיה אי":["השתיה כדת ואין אונס","כדת תורה אכילה מרובה","אין אונס: יין מדינתו","שתיה כדת לפי מדינה","אכילה מרובה משתיה","יין מדינתו ללא אונס"],"לעשות כרצון איש ואיש כרצון מרדכי והמן שנ":["כרצון איש ואיש","כרצון מרדכי והמן","איש: מרדכי והמן","שנקראו איש בעשייה","לעשות כרצון מוסכם","איש ואיש שני הצדדים"],"גם ושתי עשתה משתה נשים בית המלכות ולא בי":["משתה נשים בית המלכות","לא בית הנשים לעבירה","ושתי והסתכלות בעבירה","בית המלכות ולא הנשים","שניהם לעבירה ולא לנשים","משתה נשים ושתי"],"ביום השביעי התחילו בדברי תיפלות מדיות נא":["ביום השביעי ושתי ערומה","מדיות ופרסיות נאות","כשדיי ושתי ערומה","ושתי נשחטת ערומה בשבת","ביום השביעי בדברי תפלות","ערוה בשבת כעונשה"],"ותמאן המלכה ושתי למה א שפרחה בה צרעת ב ז":["ותמאן המלכה ושתי","ושתי מסרבת: צרעת וזנב","צרעת שפרחה בה","מאונה של ושתי","זנב לשתי המלכה","סירוב ושתי ועונשה"],"ויקצף המלך מאד למה ששלחה לו שומר אורוות ":["ויקצף המלך מאד","שומר אורוות אבא","אבי לא השתכר כך","אחשורוש השתטת","ושתי מקללת את המלך","קצף המלך על ושתי"],"ויאמר המלך לחכמים רבנן ידעי העתים לעבר ש":["חכמים ידעי העתים","מיום שגלינו ניטלה עצה","אין דנים דיני נפשות","לך לעמון ומואב","ידעי העתים לשנים","השתמטות החכמים מהדין"],"והקרב אליו אמרו לפניו מלאכי השרת כלום הק":["והקרב אליו: כרשנא","כרים בני שנה כישראל","שתר אדמתא תרשיש מרס","מזבח אדמה ובגדי כהונה","בשר המן במנחות","מלאכי השרת מדברים"],"ויאמר ממוכן המן שמוכן לפורענות שההדיוט ש":["ויאמר ממוכן: המן מוכן","המן מוכן לפורענות","הדיוט שנמנה קופץ בראש","ממוכן לפורענות","המן כהדיוט בסוף","מוכן לפורענות מבוא"],"להיות כל איש שרר בביתו אלמלא זה לא נשתיי":["להיות כל איש שרר בביתו","אגרות השניות ושוטה","שכל איש שורר בביתו","נשתייר מישראל באגרות","החזיקוהו לשוטה","אלמלא הסרת השוטה"],"ויפקד המלך פקידים דוד עשה בדעת יבקשו נער":["ויפקד המלך פקידים","כל שיש לו בת ישא אחת","אחשורוש באיולת יבעל כולם","דוד בדעת: בתולה לאחת","החביאו ממנו בתולות","פקידות להביא בתולות"],"איש יהודי ושמו מרדכי מוכתר בשמות בן יאיר":["איש יהודי ושמו מרדכי","בן יאיר שהאיר עיני ישראל","בן שמעי ששמע תפלתו","בן קיש שהקיש בשערי רחמים","מוכתר בשמות מרדכי","שמות מרדכי ומשמעותם"],"דרשה בדברי הימים ואשתו היהודיה בת פרעה ש":["ואשתו היהודיה: בת פרעה","מגדל יתום כאילו ילדו","שכפרה בעבודה זרה","שמות מרדכי מדברי הימים","כלב שמרד בעצת מרגלים","מרדכי בן יאיר ועוד"],"ויהי אמן את הדסה היא אסתר א שהצדיקים נקר":["אסתר: הדסה והסתרה","שהצדיקים נקראו הדסים","אסתהר ירח בפי אוה\"ע","בינונית כהדסה וירוקה","חוט של חסד על אסתר","ביאור שם אסתר"],"כי אין לה אב ואם מעולם כשנתעברה מת אביה ":["אין לה אב ואם","מת אביה בהיותה בהריון","נולדה ומתה אמה","יתומה מעולם","אביה מת קודם לולדתה","ללא הורים מעת הלידה"],"ובמות אביה ואמה לקחה מרדכי לו לבת לבית ל":["מות אביה ואמה לקח לבת","לבית ולא לבת","מרדכי לקח לאשה","לקח לו לבית לאשה","מרדכי ואסתר לבית","לבת או לאשה"],"וישנה ואת נערותיה לטוב א האכילם מאכל יהו":["וישנה ואת נערותיה לטוב","מאכל יהודי לנערות","שומן חזיר ושבע מאכל","זרעונים כדניאל וחביריו","האכילם מאכל יהודי","טוב של מאכל כשר"],"ששה חדשים בשמן המר א מבושם ב שמן זית שלא":["ששה חדשים בשמן המר","מבושם ושמן זית","שמן מר: שלא הביא שליש","שמן מבושם לששה חדשים","שמן זית מר בשמן","ביאור שמן המר"],"בערב היא באה ובבקר היא שבה למדנו שבחו של":["בערב היא באה ובבקר שבה","שלא שימש ביום","שבחו של אסתר","שבה בבקר ולא שימש","ערב ובקר לאסתר","אסתר לא שימשה ביום"],"ותהי אסתר נשאת חן לכל אחד נדמתה כאומתו":["ותהי אסתר נשאת חן","לכל אחד נדמתה כאומתו","חן בעיני כל רואיה","נדמתה לכל כאומתו","חן ודמות אסתר","אסתר נדמתה לכל"],"ותלקח אסתר בחדש טבת ירח שנהנה גוף מהגוף ":["ותלקח אסתר בחדש טבת","ירח שנהנה גוף מהגוף","טבת: לחבבה על המלך","חיבוב אסתר בטבת","גוף מהגוף בטבת","לקיחת אסתר לחבב עליו"],"ויאהב את אסתר מכל הנשים מכל הבתולות טעם ":["ויאהב את אסתר מכל הנשים","טעם שביקש טעם","משתה גדול למדינות","כבוד אסתר ולא גילתה מולדתה","מתנות לשרים לכבודה","אהבה ומשתה לאסתר"],"ובהקבץ בתולות שנית לקח עצה ממרדכי אין אש":["בהקבץ בתולות שנית","לקח עצה ממרדכי","אסתר לא מגדת מולדתה","צניעות ברחל ושאול","צניעות שמסרה סימנים","צניעות אסתר בלי גילוי"],"ואת מאמר מרדכי אסתר עשה מראה דם נדה לחכמ":["ואת מאמר מרדכי אסתר עשה","מראה דם נדה לחכמים","אסתר ושמירת נדה","אסתר שעשתה מאמר מרדכי","דם נדה ואסתר","מאמר מרדכי ודין נדה"],"כאשר היתה באמנה אתו עומדת וטובלת ויושבת ":["כאשר היתה באמנה אתו","עומדת וטובלת ויושבת","טובלת בחיק מרדכי","אמנה של אסתר ומרדכי","יושבת בחיק מרדכי","אמנה ביניהם בטהרה"],"קצף בגתן ותרש":["קצף בגתן ותרש","שבעים לשון של מרדכי","הקציף אדון על עבדיו","בגתן ותרש ארס בספל","מרדכי יודע שבעים לשון","קצף עבדים והצלת מרדכי"],"אחר הדברים האלה שברא הקב ה רפואה למכה":["אחר הדברים האלה: רפואה","שברא הקב\"ה רפואה למכה","הרפואה לפני המכה","רפואה ככה לפי הדברים","ברא רפואה למכה","אחר הדברים הרפואה"],"ויבז בעיניו לשלח יד במרדכי לבדו":["ויבז בעיניו לשלח יד במרדכי","מרדכי ואחר עם מרדכי","ואחר כל היהודים","ביזוי המן והעם","מרדכי לבדו והעם כולו","כיצד הוגדר הפגיעה במרדכי"],"הפיל פור הוא הגורל":["הפיל פור הוא הגורל באדר","שמח שנפל בחודש אדר","אדר שבו מת משה","הפור באדר ולא ידע","גורל אדר ומיתת משה","המן שמח בחודש אדר"],"ישנו עם אחד כשא ל שמפחד מאלוקיו א ל כבר ":["ישנו עם אחד מפוזר","ישנו מהמצות","עם אחד ודתיהם שונות","אוכלים ומתחתנים איתנו","מפוזר ומפורד בין העמים","עם אחד שאינו שוה"],"יכתב לאבדם ועשרת אלפים ככר כסף אשקול":["עשרת אלפים ככר כסף","המן הקדים שקלי ישראל","שמשמיעין על השקלים","שקליהם לפני שקילת המן","הקדמת השקלים באחד באדר","כסף המן לשקול על ישראל"],"ויאמר המלך להמן הכסף נתון לך והעם לעשות ":["הכסף נתון לך והעם לטוב","משל התל והחריץ","מכור לי תילך בחנם","תל ושדה בחנם","הלואי על העם בכסף","התל לבעל החריץ"],"ויסר המלך את טבעתו גדולה הסרת טבעת שהחזי":["ויסר המלך את טבעתו","הסרת טבעת החזירתו למוטב","ארבעים ושמונה נביאים","שבע נביאות שלא החזירום","טבעת לחזרה למוטב","הסרה מועילה לכל ישראל"],"מ ח נביאים ושבע נביאות נתנבאו לישראל":["מ\"ח נביאים ושבע נביאות","מקרא מגילה בלי שינוי","מעבדות לחירות שירה","הלל על נס חוץ לארץ","כיבוש ארצות להלל","נבואה שהוצרכה לדורות"],"איש מן הרמתיים צופים א אחד ממאתים צופים ":["איש מן הרמתיים צופים","בא משתי רמות","מבני קורח בראש העולם","מאתים צופים נביאים","רמתיים: צופים לאלוקים","רמתים מכמה צדדים"],"שבע נביאות שרה מרים דבורה חנה אביגיל חול":["שבע נביאות: שרה ומרים","ואבי יסכה זו שרה","מרים הנביאה בנבואתה","דבורה ופתילות למקדש","חנה ורמה קרני","נביאות ישראל בשמות"],"מלאכי זה מרדכי שהיה משנה למלך ומסקינן תי":["מלאכי: זה מרדכי","מלאכי זה עזרא","ארבע נשים יפיפיות","שרה רחב אביגיל ואסתר","רחב זינתה ויעל בקולה","נשים יפות במקרא"],"ותתחלחל המלכה א פירסה נדה ב הוצרכה לנקבי":["ותתחלחל המלכה: נדה","הוצרכה לנקביה","ותתחלחל ושתי","המלכה נבהלה ביציאתה","פירסה נדה בבהלה","ביאור התחלחלות המלכה"],"תקרא אסתר להתך דניאל א חתכוהו מגדולתו ב ":["תקרא אסתר להתך דניאל","חתכוהו מגדולתו","דברי מלכות נחתכין","דניאל נחתך על פיו","להתך לא נחתך","ביאור התך במגילה"],"לדעת מה זה ועל מה זה שמא עברו על התורה ד":["לדעת מה זה ועל מה זה","שמא עברו על התורה","מזה ומזה כתובים","חשש מעברה על התורה","מה זה ועל מה זה","שאלת מרדכי על המעשה"],"ויגידו למרדכי את דברי אסתר ולא התך שאין ":["ויגידו למרדכי את דברי אסתר","ולא התך: אין משיבין","מרדכי לא השיב על הקלקלה","אין משיבין על הקלקלה","דברי אסתר בלי תשובה","אין מתעכבים על קלקלה"],"ובכן אבוא אשר לא כדת עד עכשיו באונס ועכש":["ובכן אבוא אשר לא כדת","עד עכשיו באונס","ועכשיו ברצון","אסתר נכנסת לא כדת ברצון","אונס ורצון באסתר","אבוא אשר לא כדת"],"וכאשר אבדתי אבדתי כשם שאבדתי מבית אבא כך":["וכאשר אבדתי אבדתי","כשם שאבדתי מבית אבא","אובד ממך כמו מבית אבי","אסתר אובדת כאשר אבדה","אבדה מבית אביה","אבדתי כשם מבית אבא"],"ויעבר מרדכי א העביר יו ט א דפסח בתענית ב":["ויעבר מרדכי: תענית בפסח","העביר יום טוב בתענית","ערקומא דמיא","מרדכי עבר ערקומא","עבר יום טוב א' דפסח","מרדכי ותענית בפסח"],"ויהי ביום השלישי ותלבש אסתר מלכות ר ח לב":["ותלבש אסתר מלכות","לבשתה רוח הקודש","ביום השלישי ותלבש","רוח הקודש לבשה את אסתר","אסתר לבשה מלכות","מלכות ורוח הקודש"],"ויהי כראות המלך את אסתר נשאה חן ויושט המ":["ג' מלאכי השרת נזדמנו","אחד הגביה צוארה","שמשך חוט של חסד","שרביט והעמידו על מאתים","מלאכים באסתר לפני המלך","אמות ומלאכים בעמידת אסתר"],"מה בקשתך עד חצי המלכות א ולא הכל ב לא דב":["מה בקשתך עד חצי המלכות","לא הכל ולא דבר שחוצץ","חצי המלכות ולא ביהמ\"ק","בקשת אסתר ולא ביהמ\"ק","חצי מלכות שלא יחצוץ","שאלת אסתר במלכות"],"בלילה ההוא נדדה שנת המלך":["בלילה ההוא נדדה שנת המלך","שנת מלכו של עולם","נדדו עליונים ותחתונים","שנת אחשורוש ופחד להמן","ספר הזכרנות לזכרון","אין אוהב להודיעני"],"וימצא כתוב שמשי הסופר מוחק וגבריאל כותב ":["וימצא כתוב: שמשי מוחק","גבריאל כותב בספר","כתב שלמעלה","שמשי הסופר מוחק","גבריאל הכותב ולא שמשי","כתב למעלה בזכרון"],"לא נעשה עמו דבר לא שאוהבים למרדכי אלא שש":["לא נעשה עמו דבר","לא שאוהבים למרדכי","ששונאים להמן","לא נעשה לשנאה להמן","שנאה להמן ולא אהבה","מרדכי ללא פעולה"],"ועשה כן למרדכי א ל איזה מרדכי א ל היהודי":["ועשה כן למרדכי: איזה מרדכי","מרדכי היהודי הרבה יש","היושב בשער המלך","מכס בכפר או צד נהר","אל תפל דבר מכל","מי מרדכי אצל המלך"],"ויקח המן את הלבוש ואת הסוס":["ויקח המן את הלבוש","מרדכי מלמד הלכות קמיצה","ורחץ וספר במרחץ","כחוש מימי תעניתו","בנפל אויבך אל תשמח","על במותימו תדרוך"],"ויקרא לפניו ככה יעשה לאיש אשר המלך חפץ ב":["וישב מרדכי אל שער המלך","בתו זרקה עביט על ראש","אבי ומרדכי המוליך","נפלה מהגג ומתה","לשקו ולתעניתו","בת מרדכי מתה מהגג"],"והמן נדחף אל ביתו אבל על בתו וחפוי ראש ע":["והמן נדחף אל ביתו","חפוי ראש על העביט","על בתו ולא על מרדכי","המן נדחף בראש חפוי","בתו המתה בעביט","המן אבל על העביט"],"ויספר המן לזרש אשתו ולכל אהביו ויאמרו לו":["ויספר המן לזרש אשתו","כל אומר דבר חכמה חכם","חכמיו של המן","אפילו באומות חכם","זרש ואוהביו בחכמה","חכם בדבר חכמה מכל אומה"],"אם מזרע היהודים מרדכי שאם הוא משאר שבטים":["אם מזרע היהודים מרדכי","משאר שבטים יכלת לו","מיהודה ידך בערף","בנימין ואפרים ומנשה","מרדכי מיהודה אי אפשר","שבט מרדכי והיכולת"],"כי נפל תפול לפניו ב נפילות שאומה זו כשעו":["כי נפל תפול לפניו","שתי נפילות לאומה זו","כשעולין עד לכוכבים","נפילה בעלייה לכוכבים","שתי נפילות של המן","אומה עולה לכוכבים"],"וסריסי המלך הגיעו ויבהילו שהביאוהו בבהלה":["סריסי המלך הגיעו ויבהילו","הביאוהו בבהלה","לא רחץ מטינופו","בהילו להביאו בטינוף","מן בהלה לא רחץ","סריסים מביאים את המן"],"כי אין הצר שוה בנזק המלך לא חושש לנזק המ":["כי אין הצר שוה בנזק המלך","לא חושש לנזק המלך","שהרג ושתי ועכשיו אותי","המן לא דואג לנזק המלך","הרג ושתי ואחר כך אני","צר ואין נזק למלך"],"ויאמר המלך ויאמר לאסתר בלי מתורגמן כיון ":["ויאמר המלך לאסתר בלי מתורגמן","כיון שאמר מבית שאול","אסתר מבית שאול","בלי מתרגם: שאול","מבית שאול ושפה מדוברת","המלך דיבר ישירות עם אסתר"],"ותאמר איש צר המן הרע הראתה כלפי אחשורוש ":["איש צר המן הרע","הראתה כלפי אחשורוש","מלאך סטרה כלפי המן","אסתר מראה לאחשורוש","צר והרע: הראתה ומלאך","שני כיוונים באיש צר"],"והמלך קם בחמתו והמלך שב מקיש שיבה לקימה ":["והמלך קם בחמתו","שיבה לקימה בחימה","מלאכי השרת כשלוחי המן","עקרו אילנות מבוסתנו","קם בחמתו ושב","מלאכים עוקרים אילנות"],"וכששב והמן נופל על המטה שהפילו מלאך עליה":["והמן נופל על המטה","הפילו מלאך עליה","ויי מבית ומחוץ","המן על המטה במלאך","נפילה על מטת אסתר","מלאך מפיל את המן"],"ויאמר חרבונה באותה עצה היה כיון שראה כן ":["ויאמר חרבונה","באותה עצה היה","כשראה כן ברח מיד","חרבונה והעצה להמן","ברח כשראה את המלך","חרבונה ברח מיד"],"וחמת המלך שככה א לה וא לאחשורוש ב על אסת":["וחמת המלך שככה","לה' ולאחשורוש","על אסתר ושתי","חליפות ובנימין חמש","לבנימין חמש חליפות","רמז למרדכי בחמשה לבושים"],"ואת פרשנדתא עשרת בני המן צריך לאמרם בנשי":["ואת פרשנדתא עשרת בני המן","צריך לאמרם בנשימה אחת","ויזתא למותחה","שירות על גבי לבינה","אריח על גבי לבינה","מלכי כנען אריח על אריח"],"ויאמר המלך בשושן הרגו היהודים ומה שאלתך ":["ויאמר המלך בשושן הרגו","סטרו מלאך על פיו","היהודים הרגו בשושן","מה שאלתך מלאך סטרו","בשושן ומלאך על הפה","שאלת המלך והסטירה"],"ובבאה לפני המלך אמר עם הספר יאמר בפה מה ":["ובבאה לפני המלך אמר","יאמר בפה מה שכתוב","אמר עם הספר","דברי הספר בפה","אמירה בפה לא בספר","אסתר מדברת מן הספר"],"דברי שלום ואמת שצריכה שרטוט כאמיתה של תו":["דברי שלום ואמת","שצריכה שרטוט כאמיתה","כאמיתה של תורה ס\"ת","שרטוט האמת בדברי השלום","דברי שלום כספר תורה","אמת ושלום כשרטוט"],"דברי הצומות וזעקתם ומאמר אסתר שניהם קיים":["דברי הצומות וזעקתם","שניהם קיים את דברי הפרים","מאמר אסתר וקיום הצומות","זעקתם ומאמר אסתר","שני דברים קיימו הפורים","קיום דברי הפורים"],"ורצוי לרוב אחיו ולא לכל שפירשו ממנו מקצת":["ורצוי לרוב אחיו","גדול תלמוד תורה מהצלת נפשות","גדול ת\"ת מבנין ביהמ\"ק","גדול ת\"ת מכבוד אב ואם","שנות יעקב בבית עבר","חשבון שנות ישמעאל ויעקב"],"דווקא כשעתיד לחזור בלילי י ד ובבן עיר בל":["הישבים בערי הפרזות","כשעתיד לחזור בלילי י\"ד","בן עיר בלילי ט\"ו","פרוז בן יומו","בן כפר קורא עם העיר","הכפרים מספקים מזון לאחיהם"],"הכל כשרין לקרות את המגילה חוץ מחש ו ר י ":["הכל כשרין לקרות את המגילה","חרש שוטה וקטן","ר\"י מכשיר בקטן","חרש דיעבד לא יצא","שמע ישראל לאזנו","הא דתורם וכוונת הלב"],"חרש דיעבד לא כרבי יוסי דקר ש שלא השמיע ל":["חרש דיעבד לא כר' יוסי","שמע ישראל לאזנו","ר' יוסי בקריאת שמע","כוונת הלב בקריאת שמע","תורם לכתחילה כר\"מ","קטן שהגיע לחינוך"],"קריאת המגילה ד והימים האלה נזכרים ביום":["קריאת המגילה בלילה וביום","מילה ביום השמיני","טובלין ומזין","הוקשה טבילה להזיה","ביום והזה ורחץ","הימים האלה נזכרים ביום"],"לקריאת ההלל ממזרח שמש עד מבואו רב יוסף ז":["לקריאת ההלל ממזרח שמש","לתקיעת שופר יום תרועה","לנטילת לולב ביום הראשון","למוספין דבר יום ביומו","לוידוי פרים ביום הכפורים","לסמיכה ושחיטה ביום"],"ויושב משא כ בתורה ד ואתה פה עמד עמדי אף ":["ויושב ולא עומד","עמדי לרב שלא ישב","עומד ולומד יושב ושונה","שוחה ר\"ח בישיבה","רכות מעומד קשות מיושב","משה ועד ר\"ג למדו מעומד"],"אין פורסין על שמע ואין עוברין לפני התיבה":["אין פורסין על שמע","ואין עוברין לפני התיבה","אין קורין בתורה בפחות מעשרה","בקרקעות תשעה וכהן","אין מפטירין בנביא","הבדלו מתוך העדה: עשרה"],"מגז ש ששם הבדלו מ תוך העדה ועדה י דעדה ע":["מגז\"ש הבדלו מתוך העדה","ונקדשתי בתוך בני ישראל","כל שבקדושה עשרה","עדה ממרגלים לעשרה","קדושה בעשרה מגז\"ש","הזמנת עשרה לקדושה"],"הקורא בתורה לא יפחות משלשה פסוקים":["הקורא בתורה לא יפחות משלשה","לא יקרא למתורגמן יותר מפסוק","בנביא שלשה פסוקים","שלוש פרשיות קורין אחד אחד","מדלגין בנביא ולא בתורה","כדי שלא יפסוק המתורגמן"],"שלשה פסוקין ר א כנגד תורה נביאים וכתובים":["שלשה פסוקין כנגד תורה נביאים וכתובים","ר\"א: שלושה כנגד שלושה","כנגד תורה נביאים וכתובים","שלשה פסוקים לשלשה חלקים","קריאה כנגד שלוש קבוצות","פסוקים כנגד תורה נביאים"],"מומין בפניו ידיו רגליו":["מומין בפניו ידיו רגליו","ידיו בוהקניות לא ישא כפיו","חיפני ובישני לא ישא","תנ\"ה שלא עובר","סומא באחת מעיניו","דש רגיל בעירו מותר"],"איני עובר בצבועין חיישינן שמא מינות נזרק":["איני עובר בצבועין","חיישינן שמא מינות","תפלתו עגולה כאגוז","אין ראיה לתפילין מרובעות","צבועין ומינות בציבור","תפלה עגולה ותפילין מרובעות"],"האומר יברכוך טובים הרי זו דרך המינות":["האומר יברכוך טובים","על קן צפור יגיעו רחמיך","המכנה בעריות","ומזרעך לא תתן להעביר למולך","מודים מודים כשתי רשויות","שמע שמע ומכים בפטיש"],"על קן צפור או שמטיל קנאה במעשה בראשית":["על קן צפור ומדות רחמים","שמע שמע מגונה","האל הגדול הגבור והנורא","הכל בידי שמים חוץ מיראה","רב יוסף המכנה קלון אביו","אומרים שלושה ממשה"],"מביהכנ ס לביהמ ד מותר ולהיפך אסור":["מביהכנ\"ס לביהמ\"ד מותר","מביהמ\"ד לביהכנ\"ס אסור","ביהמ\"ק: מקום תורה לריב\"ל","ולרי\"ו ביהמ\"ק לתפילה","כרב פפי בין בית לבית","ביהכנ\"ס וביהמ\"ד להיפך"],"בני עיר שהלכו לעיר אחרת ופסקו עליהן צדקה":["בני עיר שהלכו לעיר אחרת","צדקה לעניי עירם","ביחיד לעניי אותה עיר","גזר תענית ונכנסו אליו","ת\"ח המתעסק בצרכי ציבור","צדקה ליחידים ולעיר"],"ר מ אין מוכרים של רבים ליחיד שמורידין או":["ר\"מ: אין מוכרים של רבים ליחיד","מורידין מקדושתו","מעיר גדולה לקטנה","ברב עם הדרת מלך","אם כן גם לא מעיר גדולה","מכר מרובה למרובה"],"מעיר גדולה לקטנה יש קדושה אבל בפחות מי ל":["מעיר גדולה לקטנה יש קדושה","אבל בפחות מעשרה לא","מרבים לפחות מרבים","נחוש ברב עם הדרת מלך","קדושת עיר בפחות מעשר","מכירת קדושה בעיר גדולה"],"לר מ מוכרים בית הכנסת רק על תנאי שאם ירצ":["מוכרים בית הכנסת על תנאי","וחכ\"א מוכרים ממכר עולם","למרחץ בורסקי טבילה","ר\"י לשם חצר","ריבית צד אחד מותרת","עיסקא מכר ומוכר אוכל פירות"],"לר מ אין בו ריבית כר י שצד אחד בריבית מו":["ריבית צד אחד לר\"מ","מכר שדהו ומוכר אוכל פירות","לוקח אוכל פירות אסור","לכולי עלמא צד אחד אסור","ריבית על מנת להחזיר","ר\"י מתיר ריבית"],"ועוד אר י בית הכנסת שחרב":["בית הכנסת שחרב אין מספידין","אין מפשילין חבלים","מפני עגמת נפש עשבים","אין אוכלים ושותים בבית הכנסת","אין מטיילים ביהכ\"נ","רבא: ת\"ח מותרים בבית"],"ביהכ נ וביהמ ד אין נוהגים בהן קלות ראש א":["ביהכ\"נ וביהמ\"ד ללא קלות ראש","אין ישנים אפי' עראי","מספידין הספד רבים","שלא יעלו בהן עשבים","בבבל על תנאי עשויין","ת\"ח מותרים בביתא דרבנן"],"חביבין ישראל לפני הקב ה שבכל מקום שגלו ש":["חביבין ישראל לפני הקב\"ה","שכינה עמהם בגלותם","למצרים לבבל ולאדום","שב עמהם מקראי","שכינה עמהם בכל מקום","ישראל בגלות עם השכינה"],"בבבל שכינה בביהכ נ דהוצל או בביהכ נ דיכנ":["בבבל שכינה בביהכ\"נ","אבוה דשמואל ולוי יצאו","ר\"ש לא יצא","ואהי למקדש מעט","בתחילה גרסתי בביתי","ביהכ\"נ שבחו\"ל בארץ ישראל"],"למה תרצדון הרים גבננים תרצו דין עם סיני ":["למה תרצדון הרים גבננים","תרצו דין עם סיני","בעלי מום אצלו יהיר","הרים גבננים ודין סיני","אתם בעלי מום לפני סיני","הרים בעלי מום"],"בא אדר משמיעין על שקלים מפרש וכלאים זמן ":["באחד באדר משמיעין על השקלים","מפרש וכלאים זמן זריעה","עלת חדש בחדשו","שקלים בר\"ח אדר","שלושים יום לפני החג","שבועיים לשאלת הלכות"],"בפסח קורין במועדות שבתו כ":["בפסח קורין במועדות","פסח גלגל ופסח יאשיהו","שביעי דפסח ויהי בשלח","כל הבכור למחר","סימן משך תורא קדש","הפטרת פסח בשני ימים"],"מקום שפסקו בשבת שחרית קורין במנחה מקום ש":["מקום שפסקו בשבת שחרית","קורין במנחה בשני וחמישי","פותח רואה גולל מברך","בתרגום אפשר לטעות","הקורא לא יסייע למתורגמן","קריאה במנחה ובשבת הבאה"]}