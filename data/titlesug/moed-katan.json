{"ראב י מושכין המים מאילן לאילן אבל לא ישק":["השקאת שדה במועד - מחלוקת ראב\"י וחכמים","השקיית זרעים ששתו לפני המועד","השקאה לשדה מטוננת והתייבשה","מרביצין שדה לבן בשביעית","הרבצה והשקאה בערב שביעית","השקיית שדה מותרת לכולי עלמא"],"שדה מטוננת לחה והתייבשה מותר לכו ע להשקו":["שדה מטוננת שהתייבשה","הרבצה לזלף בגינה למהר הגידול","הרבצה בשביעית ובמועד","דין השקאה כשדה גריד","זרעים ששתו מותרים במועד","ביאור תנאי ההשקאה במועד"],"צדין את האישות והעכברים משדה האילן והלבן":["צידת מזיקים משדה האילן והלבן","דעת ר\"י בשדה הלבן","אישות - בריה חסרת עינים","חורי נמלים - חנק זה את זה","מחריבין חורי נמלים במועד","נהר בלי גשר - רחוק פרסה"],"אישות בריה שאין לה עינים נפל אשת בל חזו ":["מהי אישות - בריה חסרת עינים","אישות בשדה: מה מותר לצוד","נפל אשת בל חזו שמש","חורי נמלים: הפרדה וחנק","צידה בלי גשר ומרחק פרסה","הכשרת צידה בשתי עברי נהר"],"רבי מאיר אומר רואין את הנגעים להקל אבל ל":["ר' מאיר: רואין נגעים להקל","לא להקל ולא להחמיר בנגעים","מחלוקת ר\"מ וחכמים בראיית נגעים","הסגר ראשון ושני בכהן","ביאור 'במוסגר' ו'במוחלט'","שאם להקל אף להחמיר"],"לא להקל ולא להחמיר שאם להקל אף להחמיר":["שותפות בין הסגר לטומאה","מוחלט מותר בתשמיש","ימי ספרו וימי חלוטו","עיבור עוזיהו בימי חלוטו","צוותא דעלמא או אשתו","בטהור: אין תועלת בהסגר"],"שהמלקט מתאבל כל היום ולערב לא ואפי צרורי":["מלקט ומתאבל ערב החג","שמחת הרגל על המלקט","צרורין בסדינו וכוונת ר\"מ","אבל במועד: מלקט בשמחה","מתי נאסר אבל במלקט","שמחת הרגל מתנגשת באבל"],"אין חופרין כוכין וקברות במועד אבל מחנכין":["חפירת קבר והכנת כוכין במועד","בריכה לכביסה במועד","ארון המת בחצר: מנסר בצינעה","מחלוקת ר\"י ורשב\"ג בנסרים","מותר לגזוז ולכבס במועד","עשיית ארון לקברו במועד"],"כוכין בחפירה קברות בבנין ותנ ה":["מה מותר בכוכין וקברות במועד","מחנכין כוכין והרחבתם","הנברכת והבקיע - בריכות","צרכי מת בחצר לגזוז ולכבס","מנסר המנוסרין ודין הנסור","הארון בחצר ודין רשב\"ג"],"אין נושאין נשים במועד לא בתולות ולא אלמנ":["נישואין במועד - ביטול שמחה","שמחה בשמחה: אין מערבין","הכנת תכשיטים לאשה במועד","מכליב ומסרג במועד","פריה ורביה ודחייה למועד","מחזיר גרושתו אינו שמחה"],"שאין מערבין שמחה בשמחה":["ביטול פריה ורביה לא נדחה","עוסק באשתו ובחגך","טורח במועד ודין הנישואין","מותרין בערב הרגל לשמחה","ידחה למועד: שמחה עיקר","מתי נדחית מצוה לשמחה"],"נפרדו מרשב י ובבוקר שבו להיפרד שתלמיד הנ":["ברכות רשב\"י לתלמיד הנפרד","פלס מעגל רגלך במצוה","לך שיברכוך - ביאור ברכות","ברכה שלא תבייש ולא תתבייש","שתזרע ולא תקצור: ברכת הבנים","שלא תראה שנה חדשה"],"מעמידין תנור וכירים וריחים במועד":["העמדת תנור וריחים במועד","כיבוש הריחים בתחילה","ר\"י: אין מכבשין את הריחים","הכנת כירים בחג","מלאכת מועד: תנור וכירים","האם מותר להעמיד תנור"],"עושין מעקה לגג ולמרפסת מעשה הדיוט אבל לא":["מעקה לגג מעשה הדיוט","תיקון כלים שנשברו במועד","לא לכוון מלאכתו במועד","סדקים: מעגילה ביד וברגל","כובש זיתים ומה שאוכלים","כיבוש הדיוט באבנים בלי טיט"],"הדיוט באבנים בלי טיט או בהוצא ענפי דקל ו":["הדיוט מכבש באבנים בלי טיט","כיבוש בענפי דקל ודפנה","הוצאת ענפים להדיוט","בלי טיט - מלאכת הדיוט","הדיוט מול אומן בכיבוש","ענפי דקל ודפנא דפנה"],"וכן מי שהיה יינו בבור ואירעו אבל או אונס":["יין שאירע לו אבל - זולף וגומר","ר\"י: עושה לימודים שלא יחמיץ","ר\"י ור' יוסי בזיפות היין","ביטול הגפה במועד לשכר","הלכה כר' יוסי ביין ובשכר","חבית שכר מוגף - שש מול שמונה"],"שאינו מודה ביין שזול לר י לר י שאינו מוד":["מחלוקת ר\"י ור' יוסי בשמן","שאינו מודה ביין שזול","שינוי במועד לדעת ר' יוסי","הלכה כר' יוסי לשכר","יין שהטעוהו בלי שינוי","שמן שיקר ודין ר' יוסי"],"הל מועד כהל כותים שאין למידות זו מזו היכ":["הלכות מועד אינן כהלכות כותים","זיפות כלי ולא חבית","כלי זפתין לכתחילה לחסרון","היכן שהוחזק הוחזק - זיפות","מועד כשבת: פטור ואסור","זיפות חבית לטירחא"],"קצרו מהמחובר במועד ושאלו רבה בנו דטוחנין":["טחינה בתלוש ולא במחובר","דישה בפרות ודין ר\"י","ר' יוסי: לא ס\"ל כמותו","קצירה מן המחובר במועד","שאלה לרבה בנו בטחינה","דשים בבהמות אינו שינוי"],"מכניס פירותיו מפני הגנבים ושולה פשתנו מה":["הכנסת פירות מפני הגנבים","שולה פשתן מן המשרה","הכנסה בצנעא ולא ביום","אבוקות ופועלים בלילה","מלאכה בלי כוונה במועד","הכנסת קורות בצנעה"],"יכניסם בצנעא":["בלילה יותר פרהסיא","הכנסה ביום ודין הפרהסיא","אם כיוון מלאכתו - יאבד","מדוע לא נכנסים בלילה","צנעה בהכנסת הקורות","הכנסה בצנעא: ביאור הטעם"],"אין לוקחין בתים עבדים ובהמה אלא לצורך המ":["קנייה של בתים ועבדים במועד","שכר פעולה במועד לצורך","שטר בלי מכירה במועד","סופר כותב לאין מה יאכל","מלאכות שהותרו בערב הרגל","מועד טירחא: התרה בהפסד"],"שכר פעולה לעבוד במועד כי אין לו מה יאכל":["שכר פעולה כשאין מה יאכל","הפעולה מותרת לצורך המועד","מלאכות שהותרו לצורך פרנסה","כתיבה שהותרה לקידושין","מועד טירחא: הפסד ולא סיכון","אין מה יאכל - כל המלאכות"],"אין מפנין מבית לבית אבל מפנה לחצרו":["העברת כלים לחצר אחרת","אין מפנין מבית לבית","מפנה לחצירו - בתוך החצר","כלים מבית האומן לחצר אחרת","חושש לכלים - מפנה לחצר","פינוי מחצר לחצר"],"מחפין את הקציעות בקש ר י אף מעבין":["חיפוי קציעות בקש","ר\"י: אף מעבין קציעות","מכירה בצנעה לצורך המועד","ציידים וגרוסות בצנעה","ר' יוסי: הם החמירו על עצמן","מוכרי פירות במועד בצנעה"],"אלו שמותרין במועד לחד מותרין בימי אבלן ו":["מותרין במועד בימי אבלן","אסורין במועד לחד","גילוח וכיבוס באבל","גילוח בתער וכיבוס במים","כשתכפוהו אבליו הותר","אבלות בימי מועד: מחלוקת"],"קצץ צפורניו במועד בביהמ ד בפיו וזרקם":["קיצוץ צפורניים בביהמ\"ד","זורקם ואינו מיאוס בפה","קובר צדיק שורף חסיד","רבי: מותר לגזוז לזוג","גילוח שפם מזוית לזוית","פרעה אמה וזקנו אמה"],"מותר לארס בחוה מ אף דמקח וממכר שמא יקדמנ":["ארוסין במועד ואין נשואין","קידושין בשטרי פסיקתא","דיוצאת ב\"ק: יקדמנו אחר","תפילה על זיווג בלי קללה","חשד: אין אדם נחשד בלי","מי שחשוד - שמח בחשדו"],"אין כותבין שט ח במועד אם אינו מאמינו או ":["כתיבת שטר במועד מאמין","אין כותבין ספר תורה במועד","ר\"י: כותב תפילין לעצמו","טווה ציצית על יריכו","כותב לאחרים בחינם","כותב ומוכר כדי פרנסה"],"כותב וטווה לאחרים בטובה בחינם":["כותב לאחרים בחינם במועד","מערים ומוכר את שלו","חוזר וכותב לעצמו ומוכר","הלכה כריו\"ס בכתיבה","כותב ומוכר ברווח לפרנסה","כתיבה ומכירה: דין ר\"י"],"הקובר את מתו קודם לרגל":["קבורה לפני הרגל ובטול גזירות","שלשה ימים מבטל שבעה","שמונה ימים מבטל שלשים","עצרת כשבת או כרגל","ר\"א: עצרת כשבת","הלכה כא\"ש בשבעה ובשלושים"],"גזרות בטלו ולא ימים לא גילח ערב הרגל אסו":["גילוח ערב הרגל ודין אבל","הלכה כא\"ש רק בשלושים","רבא: הלכה כא\"ש בשבעה","שמואל כמיקל באבל","אנוס בשבת: מגלח בשבעה","מחלוקת במגלח לפני הרגל"],"יום א לפני עצרת ועצרת הרי י ד משלושים":["תשלומין לעצרת במנין שלושים","תשלומין לחג המצות ולעצרת","יום אחד לפני ר\"ה","יום לפני החג: הרי כ\"א","מנין תשלומין לחג ושמיני","ימי תשלומין לשלושים"],"אין קורעין חולצין מברין במועד אלא קרוביו":["קריעה ומבירה במועד לקרובים","ביטול קריעה במועד לחכם","מברין על מטה זקופה","קורע על אדם כשר","העומד ביציאת נשמה","המשנה: רק קרובים"],"ובחכם הכל קורעין וחולצין ומברין עליו":["קריעה בחכם לכל הקרובים","קורע כשמתים בניו קטנים","לא בכה על אדם כשר","דומה לספר תורה שנשרף","קריעה בביציאת הנשמה","כשאין כל אלה - המשנה"],"חייב שתי קריעות על הגויל והכתב המגילה ו ":["שתי קריעות על גויל וכתב","קריעה על תפילין שנאכלו","זרוע אדם במזיד ובשוגג","ביאור קרע שתים במגילה","אכלה בת היענה לתפילין","קריעה על הגויל והכתב"],"אין מוליכין לבית האבל בטבלא אסקוטלא קנון":["הוליכה לבית האבל בסלים","ברכת אבלים במועד בשורה","מנחמין ונפטרין במועד","מטה ברחוב: הרגל ההספד","מטה של נשים לעולם לא","עשירים כעניים מפני הבושה"],"בראשונה עשירים מוליכין בסל מזהב ועניים ב":["תקנת השוואה בין עשירים לעניים","סל מזהב ולסל נצרים","זכוכית לבנה וצבועה","מגלין פני עשירים","דרגש וכליכה כעין סולם","תקנת ר\"ג בכלי פשתן"],"נשים במועד מענות אבל לא מטפחות כף אל כף":["נשים מענות ומטפחות במועד","הסמוכות למטה מטפחות","בר\"ח חנוכה ופורים","קינה - אחת מדברת","קינות נשים ומה נאמר בהספד","לעתיד בלע המות - הספד"],"אוי להליכה אוי למשא":["הספד: מספיד יספידוהו","אוי להליכה אוי למשא","הספד על עשיר שירד מנכסיו","אחינו הסוחרים באחריתם","מי מתאבל ומי מתגאה","והחי יתן אל לבו"],"מנחמים יושבים ע ג קרקע כבאיוב":["מנחמים יושבים על הקרקע","אינם מדברים עד שיפתח","אבל בראש כאיוב","חתן בראש כחתן יכהן","ישיבת המנחמים כאיוב","אבלים מנחמם וסרוחים"]}