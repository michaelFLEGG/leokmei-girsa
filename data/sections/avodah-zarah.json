{
"daf": "מג:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2764,
"text": "רשב\"ג אומר וכו'.",
"next": ""
},
{
"daf": "מג:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 2770,
"text": "מתני'.",
"next": "רבי יוסי אומר: שוחק וזורה לרוח או מטיל לים."
},
{
"daf": "מז.",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2890,
"text": "מתני'.",
"next": "מי שהיה ביתו סמוך לעבודת כוכבים ונפל - אסור לבנותו."
},
{
"daf": "מז:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 2901,
"text": "מתני'.",
"next": "שלשה בתים הן: בית שבנאו מתחלה לעבודת כוכבים - הרי זה אסור; "
},
{
"daf": "מז:",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2910,
"text": "מתני'.",
"next": "שלש אבנים הן: אבן שחצבה מתחלה לבימוס - הרי זו אסורה; "
},
{
"daf": "מח.",
"k": "m",
"letter": "א",
"how": "m",
"i": 2918,
"text": "מתני'.",
"next": "שלש אשרות הן: אילן שנטעו מתחלה לשם עבודת כוכבים הרי זו אסורה; "
},
{
"daf": "מח.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 2934,
"text": "איזו אשרה?",
"next": "כל שיש תחתיה עבודת כוכבים, ר\"ש אומר: כל שעובדין אותה."
},
{
"daf": "מח.",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 2939,
"text": "איזהו אשרה.",
"next": ""
},
{
"daf": "מח:",
"k": "m",
"letter": "א",
"how": "m",
"i": 2955,
"text": "לא ישב בצילה, ואם ישב טהור; ולא יעבור תחתיה, ואם עבר טמא.",
"next": "היתה גוזלת את הרבים, ועבר תחתיה - טהור."
},
{
"daf": "מח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2957,
"text": "לא ישב בצילה.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2962,
"text": "ולא יעבור תחתיה, ואם עבר - טמא.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2967,
"text": "היתה גוזלת את הרבים, ועבר תחתיה - טהור.",
"next": ""
},
{
"daf": "מח:",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2974,
"text": "זורעין תחתיה ירקות בימות הגשמים אבל לא בימות החמה, ",
"next": " והחזירין - לא בימות החמה ולא בימות הגשמים; "
},
{
"daf": "מט:",
"k": "m",
"letter": "א",
"how": "m",
"i": 3009,
"text": " מתני'.",
"next": "נטל ממנה עצים - אסורין בהנאה."
