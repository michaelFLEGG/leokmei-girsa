"k": "m",
"letter": "ד",
"how": "m",
"i": 3500,
"text": "מתני'.",
"next": "מת האב בתוך שלשים בחזקת שלא נפדה, עד שיביא ראיה שנפדה;"
},
{
"daf": "מט:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3522,
"text": "הוא לפדות ובנו לפדות הוא קודם לבנו וכו'.",
"next": ""
},
{
"daf": "נא.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3581,
"text": "שלשים של עבד חמשים של אונס ושל מפתה וכו'.",
"next": ""
},
{
"daf": "נא.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3583,
"text": "חוץ מן השקלים.",
"next": ""
},
{
"daf": "נא.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 3591,
"text": "מתני'.",
"next": "אין פודין לא בעבדים ולא בשטרות ולא בקרקעות ולא בהקדשות."
},
