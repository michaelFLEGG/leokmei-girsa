{"שָׂעִיר הַנַּעֲשֶׂה בִּפְנִים ויוה'כ תּוֹלֶה, עַד שֶׁיִּוָּדַע לוֹ וְיָבִיא בְּעוֹלֶה וְיוֹרֵד.": ["", "", "", "", "", "", "", "", "", "", "", ""], "שָׂעִיר הַנַּעֲשֶׂה בַּחוּץ ויוה''כ מְכַפֵּר, שנא': מִלְּבַד חַטַּאת הַכִּפּוּרִים, עַל מַה שֶּׁזֶּה מְכַפֵּר זֶה מְכַפֵּר, מַה הַפְּנִימִי אֵין מְכַפֵּר אֶלָּא עַל דָּבָר שֶׁיֵּשׁ בָּהּ יְדִיעָה, אַף הַחִיצוֹן אֵין מְכַפֵּר אֶלָּא עַל דָּבָר שֶׁיֵּשׁ בָּהּ יְדִיעָה.": ["", "", "", "", "", "", "שְׁנָא", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "לר''י: שְׂעִירֵי הָרְגָלִים וּשְׂעִירֵי רָאשֵׁי חֳדָשִׁים מְכַפְּרִין, ": ["לְר", "", "", "", "", "", "", ""], "ר\"ש: שְׂעִירֵי הָרְגָלִים מְכַפְּרִין, אֲבָל לֹא שְׂעִירֵי רָאשֵׁי חֳדָשִׁים.": ["", "", "", "", "", "", "", "", "", ""], "ר''מ: כָּל הַשְׂעִירִין כַּפָּרָתָן שָׁוָה עַל טֻמְאַת מִקְדָּשׁ וְקָדָשָׁיו.": ["", "", "", "", "", "", "", "", "", ""], "ר''ש: שְׂעִירֵי רָאשֵׁי חֳדָשִׁים מְכַפְּרִים עַל הַטָּהוֹר שֶׁאָכַל אֶת הַטָּמֵא, ": ["", "שׁ", "", "", "", "", "", "", "", "", ""], "וְשֶׁל יוה'כ מְכַפֵּר עַל שֶׁאֵין בָּהּ יְדִיעָה בַּתְּחִלָּה ויֵשׁ בָּהּ יְדִיעָה בַּסּוֹף.": ["", "", "", "", "", "", "", "", "", "", "", "", ""], "ר\"ש בֶּן יְהוּדָה אוֹמֵר מִשְּׁמוֹ: ": ["", "", "", "", "", ""], "מוֹסִיף עֲלֵיהֶן שֶׁל יוֹה''כ שֶׁמְכַפְּרִין עַל הַטָּהוֹר שֶׁאָכַל אֶת הַטָּמֵא, ": ["", "", "", "", "", "", "", "", "", "", ""], "ר\"ש אוֹמֵר: כְּשֵׁם שֶׁדַּם הַשָּׂעִיר הַנַּעֲשֶׂה בִּפְנִים מְכַפֵּר עַל יִשְׂרָאֵל, כָּךְ דַּם הַפָּר מְכַפֵּר עַל הַכֹּהֲנִים.": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "החלה הַפְּנִימִית נֶאֱכֶלֶת, וְהַחִיצוֹנָה נִשְׂרֶפֶת. ": ["הַחַלָּה", "", "", "", ""], "ר''א: ״הַשֶּׁרֶץ וְנֶעְלַם מִמֶּנּוּ- עַל הֶעְלֵם שֶׁרֶץ חַיָּיב, ולא עַל הֶעְלֵם מִקְדָּשׁ. ": ["", "", "", "", "", "", "", "", "", "וְלֹא", "", "", ""], "ר'ע: וְנֶעְלַם מִמֶּנּוּ וְהוּא טָמֵא עַל הֶעְלֵם טוּמְאָה חַיָּיב, ולא עַל הֶעְלֵם מִקְדָּשׁ. ": ["", "", "", "", "", "", "", "", "", "", "וְלֹא", "", "", ""], "רי''ש: וְנֶעְלַם וְנֶעְלַם שְׁתֵּי פְּעָמִים לְחַיֵּיב עַל הֶעְלֵם טוּמְאָה וְעַל הֶעְלֵם מִקְדָּשׁ.": ["", "שׁ", "", "", "", "", "", "", "", "", "", "", ""], "״שְׁבוּעָה שֶׁלֹּא אוֹכַל״, וְאָכַל כׇּל שֶׁהוּא לר''ע:– חַיָּיב. ": ["", "", "", "", "", "", "לְר", "", ""], "א''ל לר''ע: הֵיכָן מָצִינוּ בְּאוֹכֵל כָּל שֶׁהוּא שֶׁהוּא חַיָּיב שֶׁזֶּה חַיָּיב? ": ["אָ", "לָ", "לְר", "", "", "", "", "", "", "", "", "", ""], "א''ל ר''ע: וְכִי הֵיכָן מָצִינוּ בִּמְדַבֵּר וּמֵבִיא קׇרְבָּן שֶׁזֶּה מְדַבֵּר וּמֵבִיא קׇרְבָּן?": ["אָ", "לָ", "", "", "", "", "", "", "", "", "", "", "", ""], "שבועה שלא אוכל, ואכל פת חטין ופת שעורין ופת כוסמין - אינו חייב אלא אחת.": ["שְׁבוּעָה", "שֶׁלֹּא", "אוֹכַל", "וְאָכַל", "פַּת", "חִטִּין", "וּפַת", "שְׂעוֹרִין", "וּפַת", "כּוּסְּמִין", "אֵינוֹ", "חַיָּיב", "אֶלָּא", "אַחַת"], "שבועה שלא אוכל פת חטין ופת שעורין ופת כוסמין, ואכל - חייב על כל אחת ואחת.": ["שְׁבוּעָה", "שֶׁלֹּא", "אוֹכַל", "פַּת", "חִטִּין", "וּפַת", "שְׂעוֹרִין", "וּפַת", "כּוּסְּמִין", "וְאָכַל", "חַיָּיב", "עַל", "כָּל", "אַחַת", "וְאַחַת"], "שבועה שלא אשתה, ושתה משקין הרבה - אינו חייב אלא אחת.": ["שְׁבוּעָה", "שֶׁלֹּא", "אֶשְׁתֶּה", "וְשָׁתָה", "מַשְׁקִין", "הַרְבֵּה", "אֵינוֹ", "חַיָּיב", "אֶלָּא", "אַחַת"], "שבועה שלא אשתה יין ושמן ודבש, ושתה - חייב על כל אחת ואחת.": ["שְׁבוּעָה", "שֶׁלֹּא", "אֶשְׁתֶּה", "יַיִן", "וְשֶׁמֶן", "וּדְבַשׁ", "וְשָׁתָה", "חַיָּיב", "עַל", "כָּל", "אַחַת", "וְאַחַת"], "שבועה שלא אוכל, ואכל אוכלין שאינן ראוין לאכילה, ושתה משקין שאינן ראוין לשתיה פטור.": ["שְׁבוּעָה", "שֶׁלֹּא", "אוֹכַל", "וְאָכַל", "אֳוכָלִין", "שֶׁאֵינָן", "רְאוּיִן", "לַאֲכִילָה", "וְשָׁתָה", "מַשְׁקִין", "שֶׁאֵינָן", "רְאוּיִן", "לִשְׁתִיָּה", "פָּטוּר"], "שבועה שלא אוכל, ואכל נבילות וטריפות, שקצים ורמשים - חייב, ור' שמעון פוטר.": ["שְׁבוּעָה", "שֶׁלֹּא", "אוֹכַל", "וְאָכַל", "נְבֵילוֹת", "וּטְרֵיפוֹת", "שְׁקָצִים", "וּרְמָשִׂים", "חַיָּיב", "וְר", "שִׁמְעוֹן", "פּוֹטֵר"], "אמר קונם אשתי נהנית לי אם אכלתי היום, והוא אכל נבילות וטריפות שקצים ורמשים ": ["אָמַר", "קוֹנָם", "אִשְׁתִּי", "נֶהֱנֵית", "לִי", "אִם", "אָכַלְתִּי", "הַיּוֹם", "וְהוּא", "אָכַל", "נְבֵילוֹת", "וּטְרֵיפוֹת", "שְׁקָצִים", "וּרְמָשִׂים"], "הרי אשתו אסורה.": ["הֲרֵי", "אִשְׁתּוֹ", "אֲסוּרָה"], "ר' ישמעאל: אינו חייב אלא על העתיד לבא, שנא: להרע או להיטיב.": ["", "יִשְׁמָעֵאל", "אֵינוֹ", "חַיָּיב", "אֶלָּא", "עַל", "הֶעָתִיד", "לָבֹא", "שְׁנָא", "לְהָרַע", "אוֹ", "לְהֵיטִיב"], "א''ל ר\"ע: א\"כ מנין דברים שאין בהן הרעה והטבה א''ל: מריבוי הכתוב.": ["אָ", "לָ", "", "", "", "", "מִנַּיִן", "דְּבָרִים", "שֶׁאֵין", "בָּהֶן", "הֲרָעָה", "וַהֲטָבָה", "אָ", "לָ", "מֵרִיבּוּי", "הַכָּתוּב"], "שהיה בדין שיהא חייב כדברי ר' יהודה בן בתירא.": ["שֶׁהָיָה", "בַּדִּין", "שֶׁיְּהֵא", "חַיָּיב", "כְּדִבְרֵי", "", "יְהוּדָה", "בֶּן", "בְּתֵירָא"], "א\"ר יהודה בן בתירא: מה אם הרשות שאינו מושבע עליו מהר סיני - הרי הוא חייב עליו, מצוה שהוא מושבע עליה מהר סיני - אינו דין שיהא חייב עליה.": ["", "", "יְהוּדָה", "בֶּן", "בְּתֵירָא", "מָה", "אִם", "הָרְשׁוּת", "שֶׁאֵינוֹ", "מוּשְׁבָּע", "עָלָיו", "מֵהַר", "סִינַי", "הֲרֵי", "הוּא", "חַיָּיב", "עָלָיו", "מִצְוָה", "שֶׁהוּא", "מוּשְׁבָּע", "עָלֶיהָ", "מֵהַר", "סִינַי", "אֵינוֹ", "דִּין", "שֶׁיְּהֵא", "חַיָּיב", "עָלֶיהָ"], "שבועת שוא נוהגת באנשים ובנשים, ברחוקים ובקרובים, בכשרין ובפסולין, בפני ב\"ד ושלא בפני ב\"ד, ומפי עצמו, וחייבין על זדונה מכות ועל שגגתה פטור.": ["שְׁבוּעַת", "שָׁוְא", "נוֹהֶגֶת", "בַּאֲנָשִׁים", "וּבְנָשִׁים", "בִּרְחוֹקִים", "וּבִקְרוֹבִים", "בִּכְשֵׁרִין", "וּבִפְסוּלִין", "בִּפְנֵי", "", "", "וְשֶׁלֹּא", "בִּפְנֵי", "", "", "וּמִפִּי", "עַצְמוֹ", "וְחַייָּבִין", "עַל", "זְדוֹנָהּ", "מַכּוֹת", "וְעַל", "שִׁגְגָתָהּ", "פָּטוּר"], "שבועת העדות נוהגת באנשים ולא בנשים, ברחוקין ולא בקרובין, בכשרין ולא בפסולין, ואינה נוהגת אלא בראוין להעיד, בפני בית דין ושלא בפני ב\"ד מפי עצמו, ": ["שְׁבוּעַת", "הָעֵדוּת", "נוֹהֶגֶת", "בַּאֲנָשִׁים", "וְלֹא", "בְּנָשִׁים", "בִּרְחוֹקִין", "וְלֹא", "בִּקְרוֹבִין", "בִּכְשֵׁרִין", "וְלֹא", "בִּפְסוּלִין", "וְאֵינָהּ", "נוֹהֶגֶת", "אֶלָּא", "בִּרְאוּיִן", "לְהָעִיד", "בִּפְנֵי", "