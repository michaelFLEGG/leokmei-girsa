"text": "רבי נחמיה אומר מאתים ושלושים כנגד שרי עשרות וכו'.",
"next": ""
},
{
"daf": "יח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2599,
"text": "מעיד ומעידין אותו.",
"next": ""
},
{
"daf": "יח:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 2626,
"text": "חולץ וחולצין כו'.",
"next": ""
},
{
"daf": "יח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2665,
"text": "כשהוא מתנחם כו'.",
"next": ""
},
{
"daf": "יח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2669,
"text": "מלך לא דן ולא דנים אותו לא מעיד ולא מעידין.",
"next": ""
},
{
"daf": "כ.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2775,
"text": "וכשמברין אותו כל העם מסובין על הארץ והוא על הדרגש.",
"next": ""
},
{
"daf": "כ:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 2844,
"text": "פורץ לעשות לו דרך.",
"next": ""
},
{
"daf": "כא.",
"k": "m",
"letter": "א",
"how": "m",
"i": 2855,
"text": "ת''ק: לֹא יַרְבֶּה לּוֹ נָשִׁים - אלא שמנה עשרה.",
"next": "ר''י: מרבה הוא לו, ובלבד שלא יהו מסירות את לבו."
},
{
"daf": "כא.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2874,
"text": "שמונה עשרה ",
"next": ""
},
{
"daf": "כא:",
"k": "m",
"letter": "א",
"how": "m",
"i": 2921,
"text": "לֹא יַרְבֶּה לּוֹ סוּסִים אלא כדי מרכבתו.",
"next": "וְכֶסֶף וְזָהָב לֹא יַרְבֶּה לּוֹ מְאֹד - אלא כדי ליתן אספניא."
},
{
"daf": "כא:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2930,
"text": "וכסף וזהב לא ירבה לו אלא כדי ליתן אספניא.",
"next": ""
},
{
"daf": "כא:",
"k": "dh",
"letter": "ה",
"how": "ref",
"i": 2957,
"text": "וכותב ספר תורה לשמו.",
"next": ""
},
{
"daf": "כד.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 3218,
"text": "אמר לו: נאמן עלי אבא, \\ אביך \\ שלשה רועי בקר, ",
"next": "לר''מ: יכול לחזור בו, וחכ''א: אינו יכול לחזור בו."
},
{
"daf": "כד:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 3258,
"text": "ואלו הן הפסולין",
"next": "המשחק בקוביא והמלוה בריבית, ומפריחי יונים, וסוחרי שביעית."
},
{
"daf": "כד:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3262,
"text": "משחק בקוביא ",
"next": ""
},
{
"daf": "כד:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3298,
"text": "ומפריחי יונים.",
"next": ""
},
{
"daf": "כז:",
"k": "m",
"letter": "א",
"how": "r",
"i": 3519,
"text": "ואלו הן הקרובין:",
"next": "אחיו, ואחי אביו, ואחי אמו, ובעל אחותו, ובעל אחות אביו, ובעל אחות אמו, ובעל אמו, וחמיו, וגיסו. הן ובניהן וחתניהן, וחורגו לבדו."
},
{
"daf": "כח:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3590,
"text": "ובעל אמו הוא ובנו וחתנו.",
"next": ""
},
{
"daf": "כח:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3607,
"text": "חורגו לבדו.",
"next": ""
},
{
"daf": "ל.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3773,
"text": "שנים אומרים זכאי כו'.",
"next": ""
},
{
"daf": "ל.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3781,
"text": "גמרו את הדבר היו מכניסין כו'.",
"next": ""
},
{
"daf": "ל.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3802,
"text": "ואין עדותן מתקיימת בב\"ד עד שיעידו שניהן כאחד.",
"next": ""
},
{
"daf": "לא.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3877,
"text": "ומניין לכשיצא לא יאמר הריני מזכה וחבירי מחייבין כו'.",
"next": ""
},
{
"daf": "לא.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 3885,
"text": "כל זמן שמביא ראיה - סותר את הדין.",
"next": "אמר לו: כל ראיות שיש לך - הבא מיכן עד שלשים יום, "
},
{
"daf": "לא.",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3899,
"text": "אמר לו הבא עדים כו' ארשב''ג מה יעשה כו'.",
"next": ""
},
{
"daf": "לב.",
"k": "m",
"letter": "א",
"how": "m",
"i": 3955,
"text": "אחד דיני ממונות ואחד דיני נפשות בדרישה ובחקירה,",
"next": "שנאמר מִשְׁפַּט אֶחָד יִהְיֶה לָכֶם."
},
{
"daf": "לב.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3989,
"text": "אחד דיני ממונות ואחד דיני נפשות בדרישה ובחקירה,",
"next": ""
},
{
"daf": "לב:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 4032,
"text": "דיני ממונות פותחין כו'.",
"next": ""
},
{
"daf": "לג.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4054,
"text": "דיני ממונות מחזירין כו'.",
"next": ""
},
{
"daf": "לג.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4065,
"text": "היכי דמי שיקול הדעת? ",
"next": ""
},
{
"daf": "לג:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4096,
"text": "דיני נפשות כו'.",
"next": ""
},
{
"daf": "לג:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 4104,
"text": "ואין מחזירין לחובה.",
"next": ""
},
{
"daf": "לג:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 4110,
"text": "ד''מ הכל מלמדים זכות וחובה ד''נ הכל מלמדים זכות ",
"next": ""
},
{
"daf": "לד.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4118,
"text": "דיני נפשות המלמד זכות אינו מלמד חובה.",
"next": ""
},
{
"daf": "לה.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4217,
"text": "דיני ממונות גומרין בו ביום כו'.",
"next": ""
},
{
"daf": "לה.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 4228,
"text": "לפיכך אין דנין דיני נפשות בערב שבת.",
"next": ""
},
{
"daf": "לו.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4278,
"text": "דיני ממונות הטמאות והטהרות מתחילין מן הגדול כו'.",
"next": ""
},
{
"daf": "לו.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 4303,
"text": "דיני נפשות מתחילין מן הצד.",
"next": ""
},
{
"daf": "לז.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4346,
"text": "סנהדרין היתה כחצי גורן עגולה, ",
"next": ""
},
{
"daf": "לז.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 4365,
"text": "שלש שורות של ת''ח יושבין לפניהן כו'.",
"next": ""
},
{
"daf": "לז.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 4370,
"text": "כיצד מאיימין את העדים?",
"next": "על עידי נפשות, היו מכניסין אותן ומאיימין עליהן: "
},
{
"daf": "לז:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4393,
"text": "שמא תאמרו מאומד ",
"next": ""
},
{
"daf": "לז:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 4418,
"text": "הוו יודעים כו' דמו ודם זרעו תלויים בו עד סוף העולם",
"next": ""
},
{
"daf": "לח.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4450,
"text": "לפיכך כל אחד ואחד חייב לומר: בשבילי נברא העולם.",
"next": ""
},
{
"daf": "לח.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4461,
"text": "ולהגיד גדולתו כו'.",
"next": ""
},
{
"daf": "מ:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4726,
"text": "רבי יוסי אומר.",
"next": ""
},
{
"daf": "מ:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 4733,
"text": "מכירים אתם אותו.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4750,
"text": "התיר עצמו למיתה?",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4807,
"text": "מעשה ובדק כו'...מה בין חקירות כו'.",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 4827,
"text": "אחד אומר כו' זה בשלושה וזה בחמשה עדותן בטלה.",
"next": ""
},
{
"daf": "מג.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 4928,
"text": "אחד עומד והסודר בידו..",
"next": ""
},
{
"daf": "מג.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 4950,
"text": "אפילו הוא כו'.",
"next": ""
},
{
"daf": "מג.",
"k": "m",
"letter": "ד",
"how": "m",
"i": 4959,
"text": "מצאו לו זכות - פטרוהו, ואם לאו - יצא ליסקל, וכרוז יוצא לפניו: איש פלוני בן פלוני יוצא ליסקל על שעבר עבירה פלונית, ופלוני ופלוני עדיו, כל מי שיודע לו זכות - יבא וילמד עליו.",
"next": ""
},
{
"daf": "מג.",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 4962,
"text": "וכרוז יוצא לפניו לפניו",
"next": ""
},
{
"daf": "מג:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 5000,
"text": "היה רחוק מבית הסקילה כעשר אמות, אומרים לו: התודה, שכן דרך כל המומתין מתודין, שכל המתודה יש לו חלק לעולם הבא.",
"next": "שכן מצינו בעכן, שאמר לו יהושע בני שִׂים נָא כָבוֹד לַה' אֱלֹהֵי יִשְׂרָאֵל וְתֶן לוֹ תוֹדָה, וַיַּעַן עָכָן אֶת יְהוֹשֻׁעַ וַיֹּאמַר אָמְנָה אָנֹכִי חָטָאתִי לַיהֹוָה אֱלֹהֵי יִשְׂרָאֵל וְכָזֹאת וְכָזֹאת עָשִׂיתִי"
},
{
"daf": "מג:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 5011,
"text": "תן תודה.",
"next": ""
},
{
"daf": "מד.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 5032,
"text": "חטא ישראל.",
"next": ""
},
{
"daf": "מד:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 5096,
"text": "מנין שכיפר לו וידויו וכו'.",
"next": ""
},
{
"daf": "מד:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 5104,
"text": "אם אינו יודע להתוודות כו' רבי יהודה אומר כו' לנקות עצמן.",
"next": ""
},
{
"daf": "מד:",
"k": "m",
"letter": "ד",
"how": "m",
"i": 5114,
"text": "משנה.",
"next": "היה רחוק מבית הסקילה ארבע אמות - מפשיטין אותו את בגדיו."
},
{
"daf": "מז.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 5298,
"text": "לא היו קוברין כו'.",
"next": ""
},
{
"daf": "נ.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 5609,
"text": "רבי שמעון אומר שריפה סקילה חנק הרג",
"next": ""
},
{
"daf": "נד.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 5941,
"text": "הבא על כלתו כו'.",
"next": ""
},
{
"daf": "נד.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 5945,
"text": "הבא על הזכור ועל הבהמה, והאשה המביאה את הבהמה בסקילה.",
"next": "אם אדם חטא בהמה מה חטאה? "
},
{
"daf": "נו.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 6084,
"text": "המגדף אינו חייב עד שיפרש השם.",
"next": ""
},
{
"daf": "סג.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 6637,
"text": "אבל המגפף והמנשק המכבד והמרבץ כו'.",
"next": ""
},
{
"daf": "סג:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 6667,
"text": "הנודר בשמו והמקיים בשמו הרי זה בלא תעשה.",
"next": ""
},
{
"daf": "סד.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 6753,
"text": "הנותן מזרעו למולך אינו חייב עד שימסור למולך ויעביר באש.",
"next": "מסר למולך ולא העביר באש, העביר באש ולא מסר למולך, "
},
{
"daf": "סה.",
"k": "m",
"letter": "א",
"how": "m",
"i": 6814,
"text": "בעל אוב - זה פיתום המדבר משחיו, וידעוני זה המדבר בפיו. הרי אלו בסקילה. והנשאל בהם באזהרה.",
"next": ""
},
{
"daf": "סו.",
"k": "m",
"letter": "א",
"how": "m",
"i": 6907,
"text": "המחלל את השבת בדבר שחייבין על זדונו כרת ועל שגגתו חטאת.",
"next": ""
},
{
"daf": "סו.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 6913,
"text": "המקלל אביו ואמו אינו חייב עד שיקללם בשם.",
"next": "קללם בכנוי, רבי מאיר מחייב, וחכמים פוטרין."
},
{
"daf": "סו.",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 6915,
"text": "חכמים ",
"next": ""
},
{
"daf": "סו:",
"k": "m",
"letter": "א",
"how": "m",
"i": 6950,
"text": "הבא על נערה המאורסה - אינו חייב עד שתהא נערה, בתולה, מאורסה, והיא בבית אביה.",
"next": "באו עליה שנים, הראשון - בסקילה, והשני - בחנק."
},
{
"daf": "סז.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7002,
"text": "המסית - זה הדיוט, ",
"next": ""
},
{
"daf": "סז.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7004,
"text": "והמסית את ההדיוט. ",
"next": ""
},
{
"daf": "סז.",
"k": "dh",
"letter": "ה",
"how": "ref",
"i": 7031,
"text": "המכשף זה העושה מעשה וכו'.",
"next": ""
},
{
"daf": "סח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 7143,
"text": "ועד שיקיף זקן התחתון כו'.",
"next": ""
},
{
"daf": "סט:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7221,
"text": "בן ולא בת.",
"next": ""
},
{
"daf": "ע:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7309,
"text": "אכל בחבורת מצוה.",
"next": ""
},
{
"daf": "ע:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 7316,
"text": "אכל בעיבור החודש.",
"next": ""
},
{
"daf": "ע:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 7323,
"text": "אכל מעשר שני בירושלים.",
"next": ""
},
{
"daf": "ע:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 7325,
"text": "אכל נבילות וטריפות שקצים ורמשים.",
"next": ""
},
{
"daf": "ע:",
"k": "dh",
"letter": "ה",
"how": "ref",
"i": 7331,
"text": "אכל דבר שהוא מצוה ודבר עבירה.",
"next": ""
},
{
"daf": "עא.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 7340,
"text": "אינו נעשה בן סורר ומורה עד שיאכל בשר וישתה יין.",
"next": ""
},
{
"daf": "עא.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 7349,
"text": "גנב משל אביו ואכל ברשות אביו, משל אחרים ואכל ברשות אחרים, ",
"next": "משל אחרים ואכל ברשות אביו - אינו נעשה בן סורר ומורה, "
},
{
"daf": "עא.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7357,
"text": "ריב''י עד שיגנוב משל אביו ומשל אמו.",
"next": ""
},
{
"daf": "עא.",
"k": "m",
"letter": "ה",
"how": "m",
"i": 7369,
"text": "היה אביו רוצה ואמו אינה רוצה, אביו אינו רוצה ואמו רוצה - אינו נעשה בן סורר ומורה עד שיהו שניהם רוצין.",
"next": "ר''י: אם לא היתה אמו ראויה לאביו - אינו נעשה בן סורר ומורה."
},
{
"daf": "עא.",
"k": "m",
"letter": "ז",
"how": "m",
"i": 7400,
"text": "היה אחד מהם גידם או חיגר או אלם או סומא או חרש - אינו נעשה בן סורר ומורה, שנאמר ותפשו בו אביו ואמו - ולא גדמין, והוציאו אתו - ולא חגרין, ואמרו - ולא אלמין, בננו זה - ולא סומין, איננו שמע בקלנו - ולא חרשין.",
"next": "מתרין בו בפני שלשה, ומלקין אותו. חזר וקלקל - נדון בכ''ג."
},
{
"daf": "עא:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 7406,
"text": "ומתרין בפני שלשה.",
"next": ""
},
{
"daf": "עא:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7412,
"text": "חזר וקלקל נידון בכ''ג ונסקל רק שיהו שם ג' הראשונים ",
"next": ""
},
{
"daf": "עא:",
"k": "m",
"letter": "ג",
"how": "m",
"i": 7416,
"text": "ברח עד שלא נגמר דינו ואח''כ הקיף זקן התחתון - פטור, ",
"next": "ואם משנגמר דינו ברח ואח''כ הקיף זקן התחתון - חייב."
},
{
"daf": "עא:",
"k": "m",
"letter": "ה",
"how": "m",
"i": 7451,
"text": "בן סורר ומורה נידון על שם סופו, ימות זכאי ואל ימות חייב.",
"next": "שמיתת רשעים הנאה להן ולעולם, לצדיקים רע להן לעולם, "
},
{
"daf": "עב.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 7467,
"text": "הבא במחתרת נידון על שם סופו.",
"next": "היה בא במחתרת ושבר את החבית, אם יש לו דמים - חייב, "
},
{
"daf": "עב.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 7473,
"text": "בא במחתרת ושבר.. אם אין לו דמים פטור.",
"next": ""
},
