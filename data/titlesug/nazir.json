{"הריני נזיר מן החרצנים זגים תגלחת טומאה ה":["נזירות מן החרצנים והזגים","הריני נזיר מכל דקדוקי נזירות","נדר נזירות כולל הכל","ביטול הרישא בנזירות","נזיר מן תגלחת וטומאה","נזירות כוללת כל דקדוקיה"],"הריני כשמשון כבן מנוח כבעל דלילה כמי שעק":["נזיר כשמשון ונזירות מוגבלת","הריני כשמשון - נזיר","כמי שנקרו פלשתים עיניו","נדר בלשון שמשון","דמיון לשמשון מחייב נזירות","מה מדמים לשמשון בנזירות"],"מה בין נזיר עולם לנזיר שמשון":["הבדל בין נזיר עולם לנזיר שמשון","נזיר שמשון אין קרבן טומאה","נזיר שמשון מותר בטומאה","נזיר שמשון לא אמר כלום","ר\"ש: לא חלה נזירות כלל","ר\"י: איידי דתנא בנזיר עולם"],"האומר הריני נזיר עולם הר ז נזיר ומה בין ":["ר\"י ור\"ש בנזיר שמשון","קרבן לא מייתי אבל נזירות חלה","איידי דתנא בנזיר עולם","אם נזר כשמשון - קרבן","נזירות שמשון בדעת ר\"י","מתני' ואיזו מחלוקת בשמשון"],"אמר הריני נזיר אחת גדולה הריני נזיר אחת ":["אחת גדולה ואחת קטנה","מכאן ועד סוף העולם","נזירות כאחת גדולה: ל' יום","סוף העולם - שלושים יום","הכל נחשב לנזירות בינונית","הריני נזיר שלשים יום"],"ה ק ארוך לי הדבר כמכאן ועד סוף העולם":["נזירות עד מקום פלוני","החזיק בדרך - אומדים ימים","כעפר הארץ וכשער ראש","שאני שערות ויום אחד","נזיר לעולם - לא עולם","דבר בעל קיצבה לא נשנה"],"הריני נזיר ויום אחד הריני נזיר ושעה אחת ":["נזיר יום ושעה - נזיר שתים","אחת ומחצה: נזיר שתים","שעה אחת מצטרפת ליום","נזירות אינה לשעות","יום אחד ושעה אחת חשבון","חצי נזירות ונזירות שתיים"],"הריני נזיר שלשים יום ושעה אחת נזיר שלשים":["ל' יום ושעה - ל' ואחד יום","נזירות אינה לשעות","שעה מוסיפה יום לנזירות","נזירות לא מצטמצמת לשעות","שלושים ואחד יום בנזירות","שעה אחת תוספת לחשבון"],"הריני נזיר כשער ראשי וכעפר הארץ וכחול הי":["נזיר כשער ראש כעפר וכחול","ר' יהודה: נזיר לכל ימיו","אחת לשלושים יום מגלח","מלא הבית או הקופה","אחת גדולה לעומת סתם","הריני נזיר כמנין ימות החמה"],"אמר אמרה פרה זו הריני נזירה אם עומדת אני":["נדר נזירה בפרה ודלת","בש\"א נזיר ובה\"א לא","פרה רבוצה והעמדתה","כסבורה פרה זו אינה עומדת","נזיר מבשרה ואם עמדה","מחלוקת ב\"ש וב\"ה בנדר פרה"],"ב ה ת במעשה דפרה רבוצה לפניו":["מחלוקת בנזיר מבשרה פרה","ב\"ש: עיקר רצונו להעמיד","ב\"ה: עיקר רצונו משום רובצת","מבשרה לא הוי נזיר","כשעמדה מאליה לב\"ש","שיטת ב\"ש ובשר בענבים"],"מזגו לו את הכוס ואמר הריני נזיר ממנו ה ז":["מזגו לו כוס ואמר הריני נזיר","אשה שיכורה: לא נתכוונה לנזירות","שיכור: אינו נזיר לכמאן דאמר קרבן","נזיר ממנו - לשון מוחלטת","סבור שיביאו כוס אחרת","לשון נזירות לשיכור"],"מזגו לו את הכוס ואמר הריני נזיר ממנו הרי":["נזיר לשיכור כאמר הרי עלי קרבן","לשון מוחלטת ולשון קרבן","אשה שיכורה והכוס","הכוס שאחרת תצערהו","אמירה בשכרות לא נחשבת","ביאור מעשה באשה שיכורה"],"הריני נזיר ע מ שאשתה יין ואטמא למתים הר ":["נזיר על מנת לשתות יין","יודע נזירות ולא יודע איסור","ר\"ש: מתיר באיסור לא ידוע","סבור שחכמים מתירין לי","קובר מתים ומותר ביין","נזירות על תנאי שנאסר"],"המחלוקת אם חלק ר ש גם ברישא":["ר\"ש: מחלוקת גם ברישא","מתנה על מנת שכתוב בתורה","תנאו בטל: דברי רבינא","על מנת כחוץ דמי","ריב\"ל ורבינא בתנאי נזירות","ברייתא דרבינא בנזיר על תנאי"],"הריני נזיר ועלי לגלח נזיר ושמע חבירו ואמ":["שני נזירים מגלחים זה את זה","ואני עלי לגלח נזיר","אם היו פקחים מגלחין זה את זה","מגלחין נזירים אחרים","חברו שנדר בנזירות","גילוח נזיר של חברו"],"הרי עלי לגלח חצי נזיר ושמע חבירו ואמר וא":["הרי עלי לגלח חצי נזיר","ר\"מ: נזיר שלם לכל אחד","חכמים: חצי נזיר לכל אחד","חבירו אומר ואני חצי נזיר","חצי נזיר ומחלוקת ר\"מ","לגלח חצי נזיר לשנים"],"הריני נזיר לכשיהיה לי בן ונולד לו בן הרי":["נזיר לכשיהיה לי בן","בת טומטום ואנדרוגינוס","הפילה אשתו - חובה ונדבה","ר\"ש: בן קיימא חובה","חזרה וילדה: הראשון והשני","נדר תלוי בלידת בן"],"הריני נזיר ונזיר כשיהיה לי בן התחיל מונה":["נזיר ונזיר כשיהיה לי בן","מונה את שלו ואחר בנו","משלים את שלו ואח\"כ מונה","מניח את שלו ומונה של בנו","נדר כפול על לידת בן","חישוב נזירות כפולה בלידה"],"הריני נזיר לכשיהא לי בן ונזיר מאה יום נו":["נזירות מאה יום ולידה בשבעים","לאחר שבעים סותר","אין תגלחת פחות מל' יום","לא הפסיד כלום בשבעים","נדר בן ונזירות מאה יום","מה סותר נזירות בלידה מאוחרת"],"מי שנזר והוא בבית הקברות אף היה שם ל יום":["נזר בבית הקברות אינו נספר","יצא ונכנס עולין מן המנין","ר\"א: לא בו ביום","הימים הראשונים יפלו","נזירות בבית הקברות וקרבן","יציאה ממקום טומאה לספירה"],"מי שנזר נזירות הרבה והשלים את נזירותו וא":["נזירות רבות ובאה לארץ","ב\"ש: נזיר שלושים יום","ב\"ה: נזיר בתחילה","הילני המלכה ושבע שנים","הורוה ב\"ה לנזור שבע נוספות","נזירות עשרים ואחת שנה"],"מי שהיו שתי כיתי עדים מעידות אותו":["שתי כיתות עדים בנזירות","נחלקה העדות ואין נזירות","ב\"ה: יש בכלל חמש שתים","עדים שנזר שתים או חמש","מחלוקת עדים בנזירות","כלל העדות לב\"ה"],"האשה שנדרה בנזיר והיתה שותה ביין ומטמאה ":["אשה נזירה שסופגת ארבעים","הפר בעלה ולא ידעה","ארבעים מלקות לנזירה","סופגת מכת מרדות","אשה שהופרה ושתתה יין","ר\"י: מכת מרדות לאשה"],"האשה שנדרה בנזיר והפרישה את בהמתה ואח כ ":["הפרת בעל ובהמה מופרשת","שלו או שלה הבהמה","חטאת תמות ועולה תקרב","מעות סתומין לנדבה","מעות מפורשין: דמי חטאת לים","דמי שלמים ליום אחד"],"נזרק עליה אחד מן הדמים אינו יכול להפר":["נזרק דם: אין הפרה","ר\"ע: אפילו נשחטה","תגלחת הטהרה ותגלחת הטומאה","ר\"מ: הפרה בתגלחת הטהרה","אשה מנוולת: הפרה בטומאה","הפסד קדשים: נשחטה אין הפרה"],"שתגלחת מעכבת ניוול ויכול להפר":["ניוול תגלחת מעכבת והפרה","נזרק דם: מותרת מיד ביין","אין ניוול אחרי הזרקת דם","נשחטה הבהמה אין הפרה","משום הפסד קדשים בהפרה","הפרה בשחיטה ובהזרקה"],"האיש מדיר את בנו בנזיר ואין האשה מדרת את":["איש מדיר בנו ואשה לא","גילח או שגילחוהו קרוביו","מיחה או שמיחו קרוביו","בהמה מופרשת: חטאת תמות","מעות סתומין לנדבה","הדרת הבן בנזירות אב"],"האיש מגלח על נזירות אביו ואין האשה מגלחת":["איש מגלח על נזירות אביו","אשה לא מגלחת על נזירות אביה","ר' יוסי: הרי אלו לנדבה","מי שהיה הוא ואביו נזירים","מעות סתומים על נזירות אב","תנאי לגילוח על מעות האב"],"מי שנדר בנזיר ונשאל לחכם ואסרו מונה משעה":["נשאל לחכם שאסרו: מונה משעה שנדר","נשאל והתירו: בהמה מופרשת","ב\"ה לב\"ש: הקדש טעות","במי שטעה וקרא לתשיעי עשירי","לא השבט קידשו","כתוב שקידש העשירי"],"מי שנדר בנזיר והלך להביא את בהמתו ומצאה ":["נדר לפני גניבת בהמה","נזר לאחר חורבן המקדש","נחום המדי והתרת נזירות","אילו ידעתם שחרב המקדש","נזר לפני חורבן ולא אחריו","טעות נחום המדי בנזירים"],"היו מהלכין בדרך ואחד בא כנגדן":["הריני נזיר שזה פלוני ושאינו","נזירות לפי דברי הכל","ב\"ש: כולן נזירין","ב\"ה: מי שלא נתקיימו דבריו","הרתיע לאחוריו - אינו נזיר","ר\"ש: חובה או נדבה"],"ראה את הכוי ואמר הריני נזיר שזה חיה שאינ":["ראה כוי ואמר הריני נזיר","שזה חיה ובהמה","אחד מכם נזיר: כולם נזירים","שאין זה חיה ולא בהמה","נזירות על זיהוי כוי","כולכם נזירין - הרי כולן"],"כל איסורי שבתורה אין היתר מצטרף לאיסור ח":["איסורי נזיר: היתר מצטרף לאיסור","משרת - פת מצטרפת לאיסור","שאור מצטרף בל תקטירו","הקטרה בפחות מכזית","כזית בכדי אכילת פרס בכותח","מדוכות תרומה וחולין שנפלו"],"נזיר חופף ומפספס אבל לא סורק":["נזיר חופף ומפספס אך לא סורק","דבר שאין מתכוין לר\"ש","סורק להסיר נימין מדולדלות","חופף כר\"ש: אין מתכוין","איסור סריקה לנזיר","ביאור חפיפה וספוס לנזיר"],"חופף ומפספס וכר ש דבר שאין מתכוין מותר":["דבר שאין מתכוין מותר לנזיר","סורק: לכל הדעות מתכוין","ביאור איסור סריקה בנזיר","חפיפה בלי מתכוין","ר\"ש וסריקה כמתכוין","הפסקה בשער של נזיר"],"רבי ישמעאל לא יחוף באדמה מפני שמשרת את ה":["חפיפה באדמה משרת את השער","גזירה מפני המשרת","באדמה שאינה משרת השיער","ר' ישמעאל: לא יחוף באדמה","טעם איסור חפיפה באדמה","משרת את השער או גזירה"],"מפני שמשרת את השער או גזירה מפני המשרת ת":["מפני שמשרת השער או גזירה","באדמה שאינה משרת השיער תיקו","ספק בטעם איסור האדמה","טעמי איסור חפיפה באדמה","תיקו בשאלת המשרת","איסור חפיפה באדמה לנזיר"],"נזיר שהיה שותה יין כל היום חייב רק אחת":["נזיר ששותה כל היום: חייב אחת","אל תשתה והוא שותה: עכאו\"ב","נזיר מגלח כל היום: חייב אחת","מטמא למתים כל היום","אזהרה אחת לכל היום","אזהרות לנזיר ברצף"],"שלשה מינין אסורין בנזיר הטומאה והתגלחת ו":["שלושה מינים אסורים בנזיר","טומאה ותגלחת סותרין, יין לא","חומר בטומאה מתגלחת","יוצא מן הגפן לא הותר מכללו","טומאה סותרת את הכל","חומר ביוצא מן הגפן"],"וטומאה שסותרת לא תותר מכללה ק ו מיין שאי":["קל וחומר מיין וטומאה לנזיר","טומאה שסותרת הותרה מכללה","שכר ויין מיזיר","תגלחת שעשה בה מגלח","טומאה סותרת הכל ותגלחת לא","קל וחומר בדין מטמא וסותר"],"תגלחת טומאה כיצד":["תגלחת טומאה: ר\"ע ור\"ט","זב בשלישי ובשביעי ומגלח","מביא קרבנות בשמיני","נזיר טהרתו תלויה בימיו","מצורע טהרתו בתגלחתו","מביא קרבן אם היה מעורב שמש"],"תגלחת הטהרה כיצד היה מביא ג בהמות חטאת ע":["תגלחת טהרה: שלוש בהמות","שחוטה את השלמים ומגלח","ר\"א: רק על החטאת","החטאת קודמת בכל מקום","הביא ג' ולא פירש: רשב\"ג","מי קרב לחטאת ומי לעולה"],"היה נוטל שער ראש נזרו ומשלח תחת הדוד":["שער נזיר משלח תחת הדוד","גילח במדינה: לא משלח","בתגלחת הטהרה ולא הטומאה","הכל משלחין חוץ מטמא במדינה","ר\"מ: הכל משלחין תחת הדוד","שער נזירות ודוד הדשן"],"היה מבשל את השלמים או שולקן":["זרוע ומצה לנזיר לאחר הבישול","הותר לשתות יין אחר הניפה","ר\"ש: נזרק עליו אחד מן הדמים","נוטל זרוע מן האיל","הכהן מניף על כפי הנזיר","הותר יין כשנזרק דם"],"גילח על הזבח ונמצא פסול תגלחתו פסולה וזב":["גילוח על זבח פסול: תגלחת פסולה","גילח על חטאת שלא לשמה","ר\"ש: אותו הזבח לא עלה","גילח על שלושתן ונמצא כשר","תגלחת כשרה לפי אחד מהם","זבח פסול ותגלחת לשם"],"דנזיר שגילח על שלמי נדבה יצא":["נזיר שגילח על שלמי נדבה יצא","נתן על האש אשר תחת השלמים","לא כתב על שלמיו","גילוח על שלמי נדבה פסול","ראיה מנתן על האש","שלמי נדבה אינם לנזיר"],"מי שנזרק עליו אחד מן הדמים ונטמא":["מי שנזרק עליו דם ונטמא","ר\"א: סותר את הכל","חכמים: יביא שאר קרבנותיו","מעשה במרים התרמודית","בתה מסוכנת ומתה","נזיר בדם שנטמא: מרים התרמודית"],"סותר דר א היינו סותר קרבנותיו":["סותר ר\"א היינו קרבנותיו","מעשה מרים התרמודית ובתה","ביאור סותר בדעת ר\"א","הודיעוה על בתה ומתה","מרים התרמודית: תטהר","שאר קרבנותיה ותטהר"],"משוח מלחמה עדיף מסגן דחזי למלחמה או סגן ":["משוח מלחמה ומול הסגן","סגן עדיף לטומאה","משוח מלחמה לחייתו","סגן לכה\"ג כשאירע פסול","ביחד בדרך נזיר ומת מצוה","כה\"ג נזיר ודין הטומאה"],"עד שלא יאמר יש לי בדין":["כללות האמורות בכהן גדול","לאביו אינו מיטמא אבל מצוה","דין כללי לכהן ונזיר","כללות נזיר כמו כהן גדול","ילמד מכהן גדול לנזיר","כללות המצוה בגזרה"],"או כלך לדרך זו":["מכהן הדיוט לנזיר: מיטמא לאביו","לאביו לאחיו ולאמו","לאחותו: שמע שמת לה מת","נפשות ומת: הרחוקים והקרובים","הרי שהלך לשחוט פסחו ולמול","גזירה שוה לאחותו ולאמו"],"על אלו טומאות הנזיר מגלח":["טומאות שעליהן הנזיר מגלח","מזה בשלישי ובשביעי וסותר","כזית מן המת וכזית נצל","מלא תרווד רקב ושדרה","עצם כשעורה על מגעו ומשאו","מתחיל למנות לאחר טהרה"],"כל הנצוק טהור חוץ מדבש הזיפים והצפיחית":["נצוק טהור חוץ מדבש הזיפים","צפיחית ומקפה של גריסין","ב\"ש: אף המקפה של גריסין","סולדת לאחוריה - טומאה","נוזל טהור לנזיר","מקפה של פול ודבש הזיפים"],"שני מתים שקברן זה עם זה נעשו גלגלין זה ל":["שני מתים בקבר אחד: נעשו גלגלין","רקב הבא משני מתים טמא","קבר כל אחד בפני עצמו","רקב כמלא תרווד","עמדו על מלא תרווד רקב","גלגולין של מתים מקברים זה בזה"],"גזז שערו וקברו עמו נעשה לו גלגלין":["שער שנגזז וקבור עם המת","נעשה לו גלגלין","כל שבמת טמא חוץ משיניים","שער ושינים וצפורן בחיבורן","טומאת שיניים ושער ביחד","שער שנקבר עם גופו"],"פירשה מהו":["פרשה: נשאלה שאלה במחלוקת","כיון דלא מקיימא בדלא אכלה","בריה שמקורה חיה או מעלמא","פירשה לחיה ולבריה","מהו פרש שנפל מחיה","שאלה בפרש בעלי חיים"],"עורו מהו כיחו וניעו מהו":["עורו של מת: מהו מטמא","כיחו וניעו מהו","אם כל אלו הוי גלגלין","איך יתכן רקב שמטמא","השקו למת במי דקלים","שלקו במי טבריה לעור"],"מת שחסר אין לו רקב ולא תפוסה ולא שכונת ק":["מת שחסר אין לו רקב","אין לו תפוסה ושכונת קברות","מת שיש לו רוב ורובע","חי לעולם אין לו רקב","אבר אחד ומת במשנה","שם חי ושם מת לרקב"],"הרקיב כשהוא חי וחזר ומת מהו":["הרקיב כשהיה חי וחזר ומת","כי גמירי רקב דאירקיב במת","השתא מיהא מיית","טעמא משום חי ולא מת","שום מת יש לו רקב","שום חי אין לו רקב"],"נמלה שחסרה מהו":["נמלה שחסרה: שיעור או בריה","שיעור כעדשה בנמלה","בהם ולא מקצתן","נפלה בה נשמה","החומט תחילת ברייתו כעדשה","שיעורא גמירי לה"],"רובע עצמות מן שדרה וגולגולת מאי":["רובע עצמות משדרה וגולגולת","תני חצי קב עצמות","שדרה וגולגולת אין בהן רובע","שמאי מחמיר בעצם אחד","רבא ושמאי בעצם מן השדרה","רבנן מודים ברובע עצמות"],"אבל הסככות והפרעות ובית הפרס וארץ העמים ":["טומאות שאין הנזיר מגלח עליהן","סככות ופרעות ובית הפרס","הגולל והדופק ורביעית דם","זב וזבה וסגר מצורע עולין","ימי ספרו וגמרו לא מגלח","מתחיל ומונה מיד ואין קרבן"],"ואלו הן הסככות אילן המיסך על הארץ ופרעות":["סככות: אילן המיסך על הארץ","פרעות - היוצאות מן הגדר","הסככות ופרעות לנזיר","אילן שמיסך על הארץ","פרעות שיוצאות מן הגדר","הגדר ואילן מיסך כטומאה"],"רבי אליעזר משום ר יהושע":["טומאה שמגלחים עליה חייבים על ביאת מקדש","ר\"א משום ר' יהושע","טומאה שאין הנזיר מגלח עליה","לא תהא זו קלה מן השרץ","ר' מאיר: חומר בטומאת מת","אחריות לביאת מקדש לפי טומאה"],"אר ע דנתי לפני רבי אליעזר מה אם עצם כשעו":["קל וחומר מעצם כשעורה","אין דנין ק\"ו מהלכה","רביעית דם שמטמא באהל","ר\"א: אין דנין כאן מק\"ו","ר' יהושע: יפה אמרת","הלכה ולא קל וחומר בטומאה"],"עצם כשעורה הלכה ורביעית דם ק ו ואין דנין":["עצם כשעורה הלכה ורביעית ק\"ו","רביעית דם הלכה ועצם ק\"ו","אין דנין ק\"ו מהלכה","שתי דרכים בהלכה וק\"ו","הלכה או קל וחומר בטומאה","מדוע אי אפשר לדון מק\"ו"],"מת אחד מהן אמר ר יהושע יבקש אחד מן השוק ":["ספק טומאה בשני אנשים: דרך שידור","יבקש אחד מן השוק בנזיר","סופרין שלשים ומביאין קרבנות","חטאת העוף ועולת בהמה לספק","בן זומא: מי שומע לו","קרבן טומאה וקרבן טהרה בספק"],"נזיר שהיה טמא בספק ומוחלט בספק אוכל בקדש":["נזיר טמא בספק: אוכל בקדשים","תגלחת הנגע דוחה תגלחת הנזיר","בספק אינה דוחה","אחר ששים יום אוכל בקדשים","אחר מאה ועשרים יום שותה יין","תגלחת נגע ודין הספק"],"בד א בנזירות מועטת אבל בנזירות בת שנה או":["נזירות מועטת ונזירות בת שנה","אוכל בקדשים אחר שתי שנים","ארבע תגלחות בנזירות שנה","תגלחת ראשונה: צפורים וחטאת","תגלחת רביעית: קרבן טהרה","ציפורין לקבורה בספק טומאה"],"חומר בעבדים מבנשים שהוא מפר נדרי אשתו וא":["חומר בעבדים מבנשים בהפרת נדר","מפר נדרי אשתו ולא עבדו","הפר לאשתו עולמית","הפר לעבדו יצא לחירות","משלים נזירותו בעבד שהופר","הפרה לאשה ולעבד: הבדל"],"עבר מכנגד פניו ר מ לא ישתה ורבי יוסי ישת":["עבר מכנגד פניו: ישתה או לא","ר\"מ: לא ישתה","ר' יוסי: ישתה","עבד שהפך לחירות ונזיר","מחלוקת ר\"מ ור' יוסי בעבד","הפקעת עבד ויין לנזיר"],"בשמואל דהמפקיר עבדו יצא לחירות וא צ גט ש":["המפקיר עבדו יצא לחירות","לא צריך גט שחרור","ר\"מ כשמואל","ר' יוסי לא כשמואל","לא ישתה: שיהא לה צער","ישוב ויבוא וישתה יין"],"נזיר שגילח ונודע לו שהוא טמא":["נזיר שגילח ונודע שטמא","טומאה ידועה סותרת","טומאת תהום אינה סותרת","מערה וטומאה צפה","חזקת טמא טמא וחזקת טהור","ירד לטבול במערה: טומאת מת"],"וכי ימות מת עליו בפתע פתאום עליו במחוורת":["טומאת התהום: מה נחשב","מכיר באחד בסוף העולם","כל שאינו מכירו בסוף העולם","המוצא מת מושכב לרחבה של דרך","תרומה טמא ונזיר טהור","טומאת התהום גמרא גמירי לה"],"כל הניטלין והנגררין ספיקן טמא מפני שהן כ":["ספק טומאה בניטלין וברגררין","הנזרקין ספיקן טהור","מה טמא ומה טהור בספק","כזית המת והמאהיל על פני טומאה","מטמא מלמעלה כלמטה","ספק טומאה לאיתויי זב"],"המוצא מת בתחילה מושכב כדרכו נוטלו ואת תפ":["מוצא מת כדרכו ושכונת קברות","מצא שנים נוטלן ואת תפוסתן","מצא שלשה: בודק הימנו","בין זה לזה ארבע אמות ושמונה","שכונת קברות בכ' אמה","מצא אחד בסוף כ' אמה"],"מצא פרט למצוי מת פרט להרוג מושכב פרט ליו":["מצא פרט למצוי: חובה לדעת","מת פרט להרוג","מושכב פרט ליושב","כדרכו פרט לשראשו בין ירכותיו","מת שחסר אין לו תפוסה","שמא עכו\"ם הוא"],"כל ספק נגעים בתחילה טהור עד שלא נזקק לטו":["ספק נגעים בתחילה טהור","משנזקק לטומאה ספקו טמא","לטהרו או לטמאו: פתח בטהרה","בהרת קודמת לשער לבן","שער לבן קודם לבהרת טהור","ר\"י: כיהה וטהור"],"לטהרו או לטמאו הואיל ופתח בו הכתוב בטהרה":["ר\"י: כיהה ופתח בטהרה","לטהרו או לטמאו - פתיחה בטהרה","בהרת ושער לבן: סדר הקדימה","ספק נגעים ומסקנת ר\"י","הקודם בהרה או שער לבן","סדר ראיית הבהרת והשער"],"בשבעה דרכים בודקין את הזב עד שלא נזקק לז":["שבעה דרכים לבדיקת הזב","משנזקק לזיבה אין בודקין","אונסו וספיקו ושכבת זרעו","המכה את חבירו ואמדוהו למיתה","ר\"נ: פטור שרגלים לדבר","בדיקת זב לפני הזיבה"],"והזב את זובו לראיה שלישית איתקש לנקיבה":["בדיקה שלישית ורביעית בזב","והזב את זובו: ראיה שלישית","ר\"א דרש אתים","רבנן לא דרשי אתים","בשלישית בודקין, ברביעית לא","ביאור דרישת אתים בזב"],"נזיר היה שמואל כדברי ר נהוראי שנא ומורה ":["שמואל היה נזיר לדעת ר' נהוראי","ומורה לא יעלה על ראשו","מורה של בשר ודם בשמואל","ויאמר שמואל איך אלך","מורא מבשר ודם שעל שמואל","ר' יוסי: אין מורה אלא בשר ודם"],"חטוף וברך וכן א ל ר ה לרבה בנו":["חטוף וברך או העונה אמן","גדול העונה אמן מן המברך","ר\"ה לרבה בנו: מברך עדיף","ר\"נ: השמים כך הוא","גוליירים מתגרין וגבורים נוצחין","ת\"ח מרבים שלום בעולם"]}