"daf": "נב.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3673,
"text": "וכולם אין נוטלין בשבח.",
"next": ""
},
{
"daf": "נג.",
"k": "m",
"letter": "א",
"how": "m",
"i": 3719,
"text": "מתני'.",
"next": "מעשר בהמה נוהג בארץ ובחוצה לארץ, בפני הבית ושלא בפני הבית, בחולין אבל לא במוקדשים."
},
{
"daf": "נג.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3734,
"text": "בפני הבית ושלא בפני הבית.",
"next": ""
},
{
"daf": "נג:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3750,
"text": "בחולין אבל לא במוקדשין.",
