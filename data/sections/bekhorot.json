},
{
"daf": "מ.",
"k": "dh",
"letter": "ז",
"how": "ref",
"i": 2788,
"text": "מומין אלו מנה וכו'.",
"next": ""
},
{
"daf": "מ.",
"k": "dh",
"letter": "ז",
"how": "ref",
"i": 2795,
"text": "ופיו דומה כשל חזיר.",
"next": ""
},
{
"daf": "מ.",
"k": "dh",
"letter": "ז",
"how": "ref",
"i": 2798,
"text": "ושניטל רוב המדבר שבלשונו.",
"next": ""
},
{
"daf": "מ.",
"k": "m",
"letter": "ח",
"how": "m",
"i": 2801,
"text": "מתני'.",
"next": "ומעשה שהלחי התחתון עודף על העליון, ושאל ר\"ג לחכמים, ואמרו: הרי זה מום."
},
{
"daf": "מ:",
"k": "m",
"letter": "א",
"how": "m",
"i": 2813,
"text": "מתני'.",
"next": "אוזן הגדי היתה כפולה, "
},
{
"daf": "מ:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2823,
"text": "או שאין בה שלש חוליות וכו'.",
"next": ""
},
{
"daf": "מ:",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2831,
"text": "מתני'.",
"next": "רבי חנינא בן אנטיגנוס אומר: את שיבלת בעיניו, ושנפגם עצם ידו ורגלו, ושנפרק עצמו של פיו, עינו אחת גדולה ואחת קטנה, "
},
{
"daf": "מ:",
"k": "dh",
"letter": "ו",
"how": "ref",
"i": 2843,
"text": "עינו אחת גדולה וכו'.",
"next": ""
},
{
"daf": "מ:",
"k": "m",
"letter": "ז",
"how": "m",
"i": 2851,
"text": "מתני'.",
"next": "זנב העגל שאינה מגעת לערקוב, "
},
{
"daf": "מא.",
"k": "m",
"letter": "ב",
"how": "m",
"i": 2860,
"text": "מתני'.",
"next": "על אלו מומין שוחטין את הבכור, ופסולי המוקדשין נפדין עליהן."
},
{
"daf": "מא.",
"k": "m",
"letter": "ד",
"how": "m",
"i": 2865,
"text": "מתני'.",
"next": "ואלו שאין שוחטין עליהן לא במקדש ולא במדינה: חוורור, והמים שאין קבועין, וחוטין הפנימיות שנפגמו אבל לא שנעקרו, "
},
{
"daf": "מא.",
"k": "dh",
"letter": "ו",
"how": "ref",
"i": 2883,
"text": "והזקן והחולה והמזוהם.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "ז",
"how": "ref",
"i": 2886,
"text": "ושנעבדה בו עבירה וכו'.",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2915,
"text": "וחכ\"א אינו בכור כו'.",
"next": ""
},
{
"daf": "מג.",
"k": "m",
"letter": "א",
"how": "m",
"i": 2982,
"text": "/מתני'/.",
"next": "מומין אלו, בין קבועין בין עוברים - פוסלין באדם."
},
{
"daf": "מג.",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3008,
"text": "יתר עליהן באדם.",
"next": ""
},
{
"daf": "מג:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3022,
"text": "ובעלי חטרות ר' יהודה כו'.",
"next": ""
},
{
"daf": "מג:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3026,
"text": "הקרח פסול.",
"next": ""
},
{
"daf": "מג:",
"k": "m",
"letter": "ה",
"how": "m",
"i": 3040,
"text": "מתני'.",
"next": "אין לו גבינין או אין לו אלא גבין אחד - זהו גבן האמור בתורה."
},
{
"daf": "מג:",
"k": "dh",
"letter": "ו",
"how": "ref",
"i": 3050,
"text": "רבי דוסא אומר כו'.",
"next": ""
},
{
"daf": "מג:",
"k": "m",
"letter": "ז",
"how": "m",
"i": 3056,
"text": "מתני'.",
"next": "החרום פסול."
},
{
"daf": "מד.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3084,
"text": "סכי שמש.",
"next": ""
},
{
"daf": "מד.",
"k": "m",
"letter": "ד",
"how": "m",
"i": 3099,
"text": "מתני'.",
"next": "עיניו גדולות כשל עגל או קטנות כשל אווז, "
},
{
"daf": "מד.",
"k": "dh",
"letter": "ה",
"how": "ref",
"i": 3112,
"text": "חוטמו גדול כו'.",
"next": ""
},
{
"daf": "מד.",
"k": "dh",
"letter": "ו",
"how": "ref",
"i": 3115,
"text": "הצימם והצימע.",
"next": ""
},
{
"daf": "מד:",
"k": "m",
"letter": "א",
"how": "m",
"i": 3134,
"text": "מתני'.",
"next": "דדין שוכבין כשל אשה, כריסו צבה, טיבורו יוצא, נכפה אפילו אחת לימים, רוח קצרה באה עליו, המאושבן, ובעל גבר."
},
{
"daf": "מד:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3159,
"text": "המאושבן ובעל גבר.",
