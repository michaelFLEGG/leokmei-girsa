{"כל שתשמישו ביום נולד ביום תרנגולת":["תשמיש ביום ולידה ביום תרנגולת","עטלף מולד בלילה","זיהוי ביצה לפי זמן התשמיש","ביצה בקן תרנגולת שנבדק","ספנא מארעא ורחוקה מקן","כל ששומעת קולו ביום"],"שחט צפור מערב יו ט אין מכסין אותו ביו ט":["כיסוי צפור ששחטו מערב יום טוב","הפרשת חלה מעיסה בחג","חלת חוץ לארץ באכילה","הפרשת חלה ביום טוב","גלגל עיסה בערב החג","שמואל וחלה שקרא עליה שם"],"ב ש אין מוליכין את הסולם משובך לשובך":["סולם משובך לשובך ביום טוב","מטהו מחלון לחלון בחג","מחלוקת ב\"ש וב\"ה על ההטחה","שובכו מוכיח עליו לב\"ה","הרואה אומר להטיח גגו","ברשות היחיד מותר בחג"],"מחלוקת ברשות הרבים":["מחלוקת ברשות הרבים בסולם","לכולי עלמא ברשות היחיד","דב\"ש אית דרב וב\"ה לית","גזירת מראית העין בחג","שטיחת כסות בחמה","ב\"ה מתירין אפילו ברשות הרבים"],"לב ש לא יטול אא כ נענע מבעוד יום":["נטילה ביום טוב ונענוע מבעוד יום","עומד ואומר זה וזה אני נוטל","ברירה בבריכה ראשונה","מחלוקת ב\"ש וב\"ה בלקיחת דגים","ברירה לטהר הפתחים","ביטול הטלטול בשמנים כחושים"],"מחלוקת בבריכה ראשונה אי גזרי שמא יחזור ב":["ברירה למחר בבריכה שנייה","ברירה ומת בבית","שמא ימצאו כחושים ויעזבם","למפרע אין ברירה","טומאת פתחים וברירה","חשב להוציאו מן החלון"],"זימן שחורים ומצא לבנים לבנים ומצא שחורים":["ביצים שחורות ולבנות במנין","זימן שחורים ומצא לבנים","שנים ושלשה בקן ומחוצה","רוב וקרוב הולך אחר הרוב","הביצה מחוץ לקן","אחרים הם בדף"],"מיירי כשמצא לבנים במקום שחורים ולהיפך וק":["הביצה לפני הקן בדף","ביצים שנמצאו במקום אחר","רוב וקרוב בביצים","לבנים במקום שחורים","מחלוקת על הדף","הלכה רוב וקרוב לביצים"],"ב ש אין נוטלים את העלי לקצב עליו בשר וב ":["נטילת עלי לקצב בשר ביום טוב","איסור העור לפני הדורס","קרש לשבירת עצמות","טבח וסכין אצל בהמה","מדוכה ותבלין שאין מוליכין","בהמה משנשחטה לתבירא עומדת"],"ושוין שאם קצב עליו בשר שאסור לטלטלו":["איסור טלטול מלאכה לאיסור","במיוחדת לקצוב בשר מותר","דבר שמלאכתו לאיסור","חס עליה ונמלך ולא שובר","קצב עליו בשר ועליו איסור","מדוכה אצל תבלין מוליכין"],"ב ש אין מסלקין את התריסין ביו ט וב ה מתי":["מסלוק תריסי חנויות ביום טוב","החזרה ביום טוב אף לב\"ה","ב\"ש אוסרים תריסין","התריסין בחנויות ביום טוב","מחלוקת על סילוק תריסין","מסלקין תריס בלי ציר"],"שמודים ב ש שמסלקין התריסין ביו ט":["ציר מהצד ואסור לכולי עלמא","ציר באמצע ואטו ציר מן הצד","שמודים בתריסין בלי ציר","ב\"ש וב\"ה במסלוק התריסין","חלקו בציר באמצע","גזירה אטו ציר מהצד"],"ב ש אין מוציאין קטן לולב וס ת לרה ר וב ה":["הוצאת קטן ולולב לרשות הרבים","הוצאה שלא לצורך ביום טוב","יסוד מחלוקת ב\"ש וב\"ה בהוצאה","עולת נדבה ביום טוב לוקה","לא התירו הוצאה שלא לצורך","הוצאת ספר תורה ברשות הרבים"],"יסוד מחלוקת ב ש וב ה":["חלה ומתנות לכהן ביום טוב","הוצאת תרומה ומתנות ביום טוב","גזירת ב\"ש על מתנות שנשחטו","ר\"י מתיר אפילו תרומה","מתנות שנשחטו והורמו אמש","מתנות שנשחטו והורמו היום"],"נחלקו על מתנות שנשחטו והורמו אמש להוליכן":["הלכה כר\"י בהוצאת תרומה","תרומה אסורה ומתנות מותר","טפלה דר\"י מתיר","רב יוסף הורה כר\"י","אגב שנשחטו והורמו היום","מחלוקת על תרומה ומתנות"],"הבורר קטניות ביו ט ב ש בורר אוכל ואוכל":["בורר קטניות ביום טוב","בורר כדרכו בחיקו ובקנון","ב\"ש בורר אוכל ואוכל","רבן גמליאל מדיח ושולה","איסור בטבלא ובנפה בחג","מיון קטניות בחיק ובתמחוי"],"ב ש אין משלחין ביו ט אלא מנות":["משלוח מנות ביום טוב","שלשה מינים בשילוח","רבי שמעון מתיר בתבואה","כלים בני שילוח ביום טוב","סנדל מסומר וכלאים במשלוח","כל שנאותין בו משלחין אותו"],"ובלבד שלא יעשנו בשורה דהיינו ג בני אדם":["כלאים בבגד למלבוש ולכיסוי","מצעות רכים ומפסיק בבגד","ערדלין אין בהן כלאים","כיס מעות וכיס זרעים בכלאים","בקשים ממושב קשה מותר","ר\"י מתיר מושב קשה"],"תפורין למלבוש שאין תפורין לכסויי":["חימום והכלאה בבגד בחג","כלאים שאין דרך חמום בהם","כיס מעות שאין מחממין","וילון והשמש המתחמם","ערדלין ובגדי כלאים בחג","מה נחשב דרך חמום"],"זכור את יום השבת לקדשו זכרהו מאחר שבא לה":["זכור את יום השבת בחג","אופין מיום טוב לשבת","אפוי ומבושל בחג לשבת","איסור בישול ואפייה לשבת","את אשר תאפו אפו","תקנה מיום טוב לחול"],"אמרו על שמאי הזקן כל ימיו אכל לכבוד שבת ":["שמאי הזקן וכבוד השבת","הלל הזקן ומדת שם שמים","בהמה נאה לשבת","מנהג שמאי ומנהג הלל","מדה אחרת של הלל","לשם שמים בכל מעשה"],"ערובי תבשילין רב צריכין דעת מניח לא מי ש":["ערובי תבשילין צריכין דעת","עירב על כל נהרדעא","מי שלא הניח יסמוך על שלי","עירוב תבשילין לשנה אחרת","פושע בעירוב לא סומכים","עירוב תבשילין ודעת המניח"],"חל להיות אחר השבת":["הטבלה במוצאי שבת","ב\"ש מטבילין הכל לפני השבת","ב\"ה כלים לפני השבת ואדם בשבת","כלי בשבת לא שמא יעבירנו","בור בחצר ובור ברשות הרבים","נדה טובלת בבגדיה"],"לכו ע כלי בשבת לא שמא יעבירנו בשבת ד א ב":["גזירה בכלי שנטמא ביום טוב","מטבילים מגב לגב","השקה אטו הטבלה","דלי טמא והוא טהור","אב הטומאה וולד הטומאה בחג","בגדים שאין לה ונשים ערמה"],"ב ש לא יחם אדם חמין לרגליו אא כ ראויין ל":["חמין לרגליו רק לשתייה","מדורה רק לב\"ה","מחמם עצמו כנגד מדורה","אבר אחד וכל גופו בחימום","ב\"ש אוסרים אבר מדורה","חמין לשתייה בחג"],"מדורה רק לב ה דלב ש אסור ואין הבדל בין א":["הבדל בין אבר לכל הגוף","מדורה לבית הלל בלבד","איסור מדורה לבית שמאי","התחממות כנגד אש בחג","מדורה ליום טוב","ישיבה כנגד מדורה"],"שלשה דברים החמיר ר ג כב ש":["שלשה דברים החמיר ר\"ג","טומנין חמין מיום טוב לשבת","זקיפת מנורה ביום טוב","אפיית פתין גריצין","חומרת בית אבא ורבן גמליאל","רקיקין במקום גריצין"],"בלא הניח עירובי תבשילין ולב ה דהתירו כדי":["מי שלא הניח עירובי תבשילין","אופין לו פת אחת ומדליקין נר","הקלה כדי חייו בחג","צולין דג קטן לנשכח","הטמנה מוכיחה לשם שבת","חנניה ואליבא דב\"ש בהטמנה"],"ר ג אף אמר שלשה דברים להקל וחכמים אסרו":["מוגמר ביום טוב להריח ולא לגמר","הסדינין שפרסו על בית המטות","ערדסקאות של ברזל לקטורת","חכמים אסרו שלשה הקלות","מכבדין בית המטות ביום טוב","גמר ומיעוט הריח בחג"],"מחלוקת לגמר אבל להריח לכו ע מותר":["בית ר\"ג מכבד בחג","פוקקין נקביהן מיום טוב","א\"כ אף בשבת מותר בהריח","להריח מותר לכולי עלמא","הקטורת בבית רבן גמליאל","לגמר אסור והריח מותר"],"שלשה דברים ראב ע מתיר וחכמים אוסרים":["פרתו יוצאה ברצועה שבין קרניה","מקרדין את הבהמה ביום טוב","שלשה דברים ר\"ע מתיר","שוחקין פלפלין ברחים ביום טוב","ר\"י ומקרצפין ולא מקרדין","אפילו עישר מעדרו שלא שלו"],"ואפי שראב ע עישר מעדרו בכל שנה י ג אלף ע":["עשירות מעדר שאינו שלו","מתוך שלא מיחה נקרא על שמו","אל השכנה שנקראה על שמו","מחיית בעלות ופרסום שמו","ר\"ע ושכנתו","כשלא מיחה בה נקראת"],"הרחים של פלפלין טמאה משום שלשה כלים":["רחיים של פלפלין וטומאתן","שלשה כלים קבול כברה ומתכת","תחתונה כלי קבול","טומאת הרחיים בשלושה כלים","אמצעית כלי כברה","עליונה כלי מתכת"],"תחתונה כלי קבול אמצעית כלי כברה עליונה כ":["כלים ברחיים לטומאה","הכלי העליון כלי מתכת","הכברה האמצעית ברחיים","טומאה ברחיים לפי חלקיהם","קבול למטה ומתכת למעלה","מנין הכלים בטומאת רחיים"],"עגלה של קטן טמאה מדרס נטלת בשבת ונגררת ר":["עגלה של קטן טמאה מדרס","גרירה על כלים ואיסור חריץ","כל הכלים אין נגררין חוץ מעגלה","גרירת מטה כסא וספסל","חריץ בקרקע לדעת ר\"י","עגלה נגררת שכובשת"],"טמאה מדרס שנסמך עליה":["עגלה נגררת בלא חריץ","ר\"י בחריץ בקרקע אסור","מטה כסא וספסל לגרירה","תרי תנאי בעגלה לר\"י","הקפדה שלא יתכוין לחריץ","גרירה מותרת בכלי מכובד"],"דאין צדין ביו ט מביברין דחיה ועופות":["צידה ביום טוב בביברין","צפור דרור שדרה בבית","צפור למגדל וצבי לבית","ביבר מקורה וצידה","ר\"י וחכמים בצידת חיה ועוף","ביבר קטן וגדול בצידה"],"רשב ג לא כל הביברין שוין וכו שמואל הלכה ":["רשב\"ג הלכה בביברין","לא כל הביברין שוין","שמואל הלכה כרשב\"ג","זמרה תהיה ללא הבחנה","הבחנה בין הביברין","גמרא גמורה ולא חלקו"],"ספק מוכן אסור ור ג מתיר ומעשה נמי בנכרי":["ספק מוכן ואסור ביום טוב","שוחטים מהנגרין ולא מהרשתות","ר\"ג מתיר ספק מוכן","הלכה כר\"י ביום טוב לצייד","מצאן מקולקלין מערב יום טוב","ספק נצודו ביום טוב"],"בהמה מסוכנת לא ישחוט":["בהמה מסוכנת ושחיטה ביום טוב","שהות ביום לאכול כזית צלי","ר\"ע וכזית חי מבית הטביחה","הפשט ונתוח לפני אכילה","דרך ארץ באכילת בשר","שום ובצל מראש הקצב"],"הפשט ונתוח בעולה והוא הדין לקצבים":["אכילה לפני הפשט ונתוח","שתיה בבת אחת ודרך ארץ","תורמוס מר ושונאי ישראל","חצובא מקטע רגלי רשעים","מפני מה נתנה תורה לישראל","מימינו אש דת למו"],"לר י הנשיא שאסור לבודקו כר ש":["לבדוק כר\"ש מול ר\"י הנשיא","הלכה כר\"י ומותר לבדוק","ר\"ז ודין ר\"ש בשם חכמים","סברא ונשיאות בבדיקה","אסור לבדוק לכתחילה","בדיקת בהמה כשיטת חכמים"],"בהמה שמתה לא יזיזנה ממקומה":["בהמה שמתה לא יזיזנה ממקומה","מעשה ברבי טרפון והחלה","שלא יזיזם ממקומם","נבלה לפני הכלבים","כלבים ונבלה לדעת ר\"י","החלה שנטמאת והבהמה"],"מתני אפי כר ש שמחתכין הנבלה לפני הכלבים":["חיתוך נבלה לפני כלבים","בעלי חיים בריאים שמתו","בבהמת קדשים כדוגמת חלה","במסוכנת מדויק כשיטתו","נבלה שלא התנבלה מערב שבת","בע\"ח בריאים שמתו אסורים"],"אין נמנין על הבהמה לכתחלה ביו ט":["שותפות בבהמה ביום טוב","נמנין על הבהמה מערב יום טוב","לא יאמר בסלע בשתים","מביא שתי בהמות ואומר זו כזו","שיעור חלקים במחצה ולשליש","פסיקת דמים על בהמה בחג"],"אין פוסקין דמים לכתחלה על הבהמה ביו ט":["פסיקת דמים בבהמה לכתחילה","זו כזו בשתי בהמות","חלקים למחצה לשליש לרביע","הבהמה והמחיר בחג","אסור לפסוק מחיר ביום טוב","קניית חלק בבהמה ביום טוב"],"ר י שוקל אדם בשר כנגד הכלי או כנגד הקופי":["שקילת בשר כנגד הכלי","כף מאזנים אינה מעלה","טבח אומן ושקילה ביד","מנה כנגד מנה ביום טוב","הלכה כר\"י בשקילה","בית יד בבשר אסור"],"אפילו לשמרו מן העכברים":["שקילת מנה כנגד מנה בחג","ר\"ח ור\"ש בבכורות","בזיון קדשים בשקילה","סימן בבשר ג' קרנות","כף הקופיץ והשקילה","לשמרו מן העכברים"],"אין משחיזין את הסכין ביו ט אבל משיאה על ":["השחזת סכין ביום טוב","משחזת אבן ואבן ועץ","העברת שמנוניתה בסכין","הלכה כר\"י בשחיזה","סכין על פי הסל לחידוד","מעביר שמנונית מותר"],"דווקא במשחזת אבן אבל במשחזת עץ מותר":["לחדד אסור במשחזת אבן","משחזת עץ מותר לחדד","הלכה כר\"י בכלי אוכל נפש","ראה שרבא מעביר סכין","הוראה נגד המעשה","משיאה אחברתה בלבד"],"לא יאמר אדם לטבח שקול לי בדינר בשר":["לא יאמר לטבח שקול לי בדינר","שמות חלקי בשר בכל מדינה","ממלא מדותיו מערב יום טוב","ברורי המדות בחג","מלא לי כלי זה ולא במדה","מדה ללקוחות ביום טוב"],"כשקונה חלק קטן לא יזכיר דמים אלא בשמות":["שמות חלקים בשר לפי המקום","סורא תרטא ונרש חלקא","אבא שאול במדות","מצוי המדות בחול","בכלי מידה לא ימלאנו","מדות ממולאות לפני החג"],"הולך אצל חנוני הרגיל אצלו וא ל תן לי ביצ":["מקח בלא סכום מדה","ביצים ואגוזים במנין אצל חנוני","שלא יזכיר סכום המקח","מבקש מרועה גדי או טלה","מנחתום ככר אחת ביום טוב","קניה בלי מדה בחג"],"מבקש מרועה הרגיל אצלו גדי או טלה אחד ומט":["רשב\"א ואיסור סכום המקח","אפרסקין ורמונים בלא מדה","בעל הבית מונה בתוך ביתו","טבח כף או ירך בחג","קנייה במנין לא במשקל","כ' ביצים נ' אגוזים"],"אין נוטלין עצים מן הסוכה אלא מהסמוך לה":["עצים מן הסוכה ביום טוב","סמוך לדפנות מותר לנטול","שמן הנר שמצפה לכיבוי","תנאי בסוכה ואתרוג לשבעה","חג הסוכות ושבעת הימים","לא מהני תנאי בסוכה"],"מהסוכה לא דסתר אהל ומהסמוך לדפנות מותר":["תנאי לחצאין בסוכה","פירות על הסוכה עד מוצאי חג","אתרוג לכל יום לפי ר\"א","איני בודל מהם כל בין השמשות","עצי סוכה שחלה עליהם קדושה","שבעה אתרוגים לשבעה ימים"],"מביאין עצים מהשדה מהמכונס ומהקרפף אפילו ":["הבאת עצים מהשדה ביום טוב","קרפף מוגדר לפי סמיכות לעיר","עצים מהמכונסין שבקרפף","בית שמאי ובית הלל במפוזרים","ר\"ש ורשב\"א במכונסין","עלי קנים ועלי גפנים אסורים"],"מביאין עצים רק מהמכונסין שבקרפף":["עלי קנים שנפזרו ברוח","כלי מאתמול מותר להביא","יחידאה כרשב\"א בקרפף","מפוזרים שבקרפף נחלקו","מכונסין שבשדות ובעיר","הבאה מכונסת ביום טוב"],"אין מבקעין עצים מהקורות או מהקורה שנשברה":["בקיעת עצים מקורה שנשברה","לא בקרדום ולא במגרה","אלא בקופיץ לבקיעה","קורה שנשברה מערב יום טוב","ערימת קורות אסורה לבקיעה","בקופיץ לבקיעה ביום טוב"],"אין מבקעין מערימת קורות ולא מקורה שנשברה":["מערימת קורות אסורה","מקורה שנשברה ביום טוב","קורה שנשברה מאתמול","בקיעה בקופיץ כתנא","אסור לבקוע מערימה","הכשר בקיעה מקורה ישנה"],"מיירי בלבנים בלא טיט":["לבנים בלא טיט לבנין מחדש","מוקצה בלבנים שנותרו","ר\"נ וכר\"מ לבנים ביום טוב","חותמות שבקרקע מתיר","חותמות שבכלים לא מפקיע","מסיקין בכלים ושברי כלים"],"אין פוחתין את הנר מפני שהוא עושה כלי":["פחמין ביום טוב אסור","פוחתין את הנר מפני כלי","חותכין את הפתילה באור","ר\"י מתיר חיתוך פתילה","הנר ויצירת כלי","איסור עשיית פחמין"],"אין פוחתין את הנר ואין עושין אלפסין חרני":["אלפסין חרניות בחג","מתיר ר\"י אלפסין חרניות","ערניות היינו קערות כפריות","פחית נר ועשיית כלי","כלי חרס מסוג מסוים","פירוש אלפסין חרניות"],"המצפה לשלחן אחרים רב עולם חשך בעדו":["המצפה לשלחן אחרים","שלשה חייהן אינם חיים","עולם חשך בעדו ממצפה","שאשתו מושלת עליו","שיסורין מושלין בגופו","התנא הקמא יכול להפלותו"],"אין שוברין את החרס ואין חותכין הנייר לצל":["שוברין חרס וחותכין נייר בחג","גורפין תנור וכירים ביום טוב","מכבשין אפר ולא גורפין","מנהיגין בהמה במקל ביום טוב","ר\"ח התיר לאשתו","צלה לי אווז צעיר ביום טוב"],"אין שוברין חותכין גורפין דמתקן כלי":["שוברין חותכין גורפין מתקן כלי","אם אי אפשר מותר כר\"י","תנורים בטיט לפני נהר פרת","טוח באפר מותר","הכנה מאתמול לתנור בטיט","רבא לשמשו לצלות אווז"],"ר א נוטל קיסם משלפניו לחצוץ שיניו ומגבב ":["קיסם לחצוץ שיניים ביום טוב","מגבב מהחצר ומדליק","ר\"א וחכמים בהוצאת אור","מוציאין אור מהעצים והאבנים","מלבנין רעפים לצלות","אוכלי בהמה אין בהן תיקון כלי"],"אוכלי בהמה אין בהן משום תקון כלי ברכין":["עצי בשמים להריח ביום טוב","קוטמו להריח חייב","שובר החבית לאכול גרוגרות","גזירה על הריח בקטמה","מקלות הראויים להריח","שבות להריח אסור ולא גזרו"],"אין מוציאין את האור וכו דמוליד ביו ט":["אין מוציאין אור ביום טוב","מוליד ביום טוב באור","כיבוי אש נחשב הולדה","הולדה ביום טוב באש","איסור כיבוי אש בחג","הטעם לאיסור כיבוי"],"ועוד א ר אליעזר עומד אדם על המוקצה ערב ש":["עומד אדם על המוקצה ערב שבת","חכמים עד שירשום מכאן ועד כאן","אין ברירה לתינוקות תאנים","מחשבה לשבת קובעת במלאכה","המעביר תאנים בחצירו לקצות","נגמרה מלאכה לא אוכלין עראי"],"תינוקות שטמנו תאנים לשבת ולא עישרו למוצ ":["תינוקות שטמנו תאנים לשבת","עישור לפני מוצאי שבת","מחשבת שבת קובעת בתאנים","אוכלין עראי ופטורים","מלאכה שלא נגמרה","בניו ובני ביתו בתאנה"],"כל שחייבין עליו משום שבות משום רשות משום":["שבות ביום טוב כשבת","לא עולין באילן ביום טוב","לא דנין ולא מקדשין בחג","אין בין יום טוב לשבת אלא אוכל נפש","משום מצוה ביום טוב","כל אלו ביום טוב אמרו"],"אילן שמא יתלוש":["אילן שמא יתלוש ביום טוב","בהמה שמא יחתוך זמורה","מים שמא יעשה חבית","גזירה שמא יתקן כלי שיר","טפיחה ומספוק ורקוד אסורים","הטעם לאיסור רקוד בחג"],"מתני דכרגלי הבעלים מיירי בשני רועים":["בהמה שביד רועה כרגלי הבעלים","מתני' בשני רועים","הלכה כר\"ד בבהמה","מסר בהמה לרועה ביום טוב","בנו או הרועה בחג","כרגלי הבעלים או הרועה"],"שור של פטם כרגלי כל אדם של רועה כרגלי או":["שור של פטם כרגלי כל אדם","שאל כלי מחבירו מערב יום טוב","כלי שנתנו ביום טוב כרגלי השואל","רגיל ושאיל לאו ברשותו","שמא ימצא אדם אחר ושאל","רועה של העיר כרגלי העיר"],"הגחלת כרגלי הבעלים ושלהבת בכל מקום":["גחלת כרגלי הבעלים ושלהבת בכל מקום","גחלת של הקדש מועלין בה","המוציא גחלת לרשות הרבים חייב","שלהבת פטור בהוצאה","לא נהנין ולא מועלין בשלהבת","הבדל בין גחלת לשלהבת"],"נהרות המושכין ומעינות הנובעין כרגלי כל א":["נהרות ומעינות כרגלי כל אדם","במכונסין קונים שביתה","הקנאת מים מכונסים לשביתה","נהר מושך לא נקנה","מקח מים בהכנה לחג","מכונסין ולא שנובעים"],"מי שהיו פירותיו בעיר אחרת":["פירות מעיר אחרת לא יביאו","ערב לשכנים לפירות","מנות לאורחים שזכו מערב יום טוב","מי שזמן אורחים לא מוליך מנות","ערב הוא פירותיו כמוהו","הבאת מנות ביום טוב לאורחים"],"אין משקין ושוחטין את המדבריות":["אין משקין ושוחטין את המדבריות","בייתות הלנות בעיר","מדבריות הלנות באפר","משקין שתהא נוחה להפשיטה","מדבריות נכנסות ברביעה ראשונה","גרוגרות וצמוקין מוקצה לר\"ש"],"משקין שתהא נוחה להפשיטה":["שחיטת מדבריות ביום טוב","בייתות יוצאות ורועות חוץ לתחום","מדבריות אינן נכנסות בחמה","מוקצה לר\"ש בגרוגרות ובצמוקין","דברי ר\"ש ולא ס\"ל","לדברי רבנן בייתות הן"]}