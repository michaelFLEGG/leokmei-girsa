{"ז ימים קודם שריפת הפרה מפרישין כהן ללשכת":["הפרשת כהן לבית האבן","שבעה ימים לפני שריפת הפרה","כלי אבן וגללים בבית האבן","מקום בית האבן בצפון מזרח","מחלוקת הצדוקים על מעשה הפרה","מה הוא בית האבן"],"כל שבעת הימים זורק ומקטיר ומיטיב ומקריב ":["סתירה בסדר הטבת הנרות והקטורת","הקטרת קטורת קודם הטבת הנרות","אבא שאול על הטבת הנרות","זריקה בכל שבעת הימים","שיטת רבי עקיבא בהזאת הפרה","מזרחית צפונית נותן מזרחית צפונית"],"א מתני דלא כר ע דפליג ארבנן הזאת טהור טמ":["הזאה על טמא לטהרה","הזאה בשיעור ומחלוקת ר' עקיבא","הטבת נרות אחרי הקטורת","פייס כאבא שאול","סדר הזאת הדם על המזבח","חטאת שתים שהן שתים"],"מסרו לו זקנים מזקני בי ד וקורין לפניו שי":["העמדת כהן גדול במקדש שני","הכהן הגדול מאחיו בכוח ובעושר","מונעין אכילה לפני יום הכיפורים","יוסי בן גמלא ומרתא בת בייתוס","טעם מינוי כהן גדול מאחיו","כה\"ג שלא למד במקדש"],"שמא לא למד במקדש שני כינאי שקיבל ממרתא ב":["כינאי ומרתא בת בייתוס","יוסי בן גמלא בכהן גדול","כהן גדול שלא למד במקדש","גדלוהו משל אחיו","כך היה במקדש ראשון","מינוי כהן גדול לפי כוח ועושר"],"מסרוהו זקני ב ד העלוהו לאבטינס השביעו ונ":["ספרים שקוראים לכהן גדול","איוב ועזרא ודברי הימים לפניו","השבעת הכהן הגדול ביום הכיפורים","חכם דורש או הם דורשין","כהן גדול בוכה ומתיישב","דניאל כקריאה אחרונה"],"יט":["לשכות הכהן הגדול והעזרה","לשכת פרוה ומלח שמדיחין","לשכת העץ והכשר לבנים","הפרהדרין והשבעת הכהן","שלא תזוח דעתו של כהן גדול","שתי לשכות בסמיכות"],"בקש להתנמנם פרחי כהונה מכין באצבע צרידה":["כהן גדול שעמד להתנמנם","פרחי כהונה מכין באצבע צרידה","לילה בלי שינה בירושלים","אליהו הנביא ולפתח חטאת רובץ","שטן ביום הכיפורים","הסעדה בדברי תורה לכהן גדול"],"צרדה בגודל והלך הקול בביהמ ד":["מעסיקין בפה ולא בנבל","זכר למקדש בגבולין","ירושלים ללא שינה בלילה","שטן ביום הכיפורים","משיח ואליהו לפתח חטאת","צרידה בגודל כנגד הנמנום"],"בכל יום תורמין בקריאת הגבר או סמוך לו לפ":["קריאת הגבר ותרומת הדשן","תרומה בקריאת הגבר ובחצות","זמן הקרבת הקרבנות ביום הכיפורים","אברים שפקעו מעל המזבח","חצי להקטרה וחצי להרמה","בוקר לבוקרו של לילה"],"אברים שפקעו מע ג המזבח":["אברים שפקעו מעל המזבח","חצות כגבול להחזרה ומעילה","רב: חצי להקטרה וחצי להרמה","בוקר לבוקרו של לילה","תמיד ויום הכיפורים בחצות","אשמורה ראשונה לרגלים"],"לא תיקנו תחילה א דעבודת לילה אברים ופדרי":["סדר המערכה והעצים לכהן","הקודם זוכה בארבע אמות המזבח","איסור מנייה בטלאים","לא ימד ולא יספר","מי שנתמנה על הציבור","שאול ודוד במעשה נחל"],"פיס השני מי שוחט זורק מדשן פנימי מדשן המ":["הזכייה בשחיטה ובזריקה","סדר הפיסה של הכהנים","מי שוחט מי זורק בקרבן","לא מפייסין אלא לעבודה אחת","ב' דפנות ורגל לכבש","ראש ופדר בהילוכו של קרבן"],"איבעיא ומסיק שרק לעבודה אחת מפייסין":["רגל עם הראש להגדיל מתנה","שוחט דחביבות או זורק","זורק מקבל ודרך הילוכו","הפשטה וניתוח בחוץ","ראש ופדר מן הקרבן","פדר מבית השחיטה"],"פיס השלישי חדשים לקטורת באו והפיסו רביעי":["פייס חדשים לקטורת","הפיסה לפי משמרות שבת","בין הערביים אין מפיסין תמיד","קטורת מפיסין בבוקר","רביעי חדשים עם ישנים","ראב\"י ור\"י ליתן להו"],"לא שנה בקטורת מפני שמעשרת ועולה שכיחא":["דלא כראב\"י בהמעלה לכבש","שיטת רבא בהפיסה","שעיקר ההפיסה ברוב העם","מלוי או ישכר בהפיסה","מעלה לכבש ומעלה למזבח","קטורת שמתעשרת אינה מתחלפת"],"תמיד קרב בט עצמו":["מי קרב בתמיד של בין הערביים","ניסוך המים בתמיד של שחר","פייס יג יד טו טז","פייס רק בשל ציבור","ערכו עצים בתמיד","הפשטן וניתוחן שווין"],"ניסוך המים רק בתמיד של שחר":["ניסוך המים רק בשחר","ניסוך על רגליו ורגמוהו","תמיד של בין הערביים בשני גזרי עצים","איל קרב ביא' בשר","פייס הפעמים יג עד יז","פייס על קרבן ציבור"],"א ברק ב עלה ג אף בחברון ד האיר עד חברון ":["אברהם קיים את כל התורה","תפילת מנחה של אברהם","הזמן שבין שחר לשמש","שחר ואיילת השחר","יום המעונן ושטיחת עורות","השמש וחום הקיץ כמשל"],"כניסה לעזרה רק אחר טבילה":["טבילה לפני הכניסה לעזרה","חמש טבילות ועשרה קידושין","טעם הטבילה לכהן גדול","קל וחומר מבן זומא","מצורע שטובל בשער ניקנור","טבילה לתיקון כעין דאורייתא"],"טעם לטבילה זו":["סכין ארוכה ושחיטה בחוץ","חלקו של ר\"י באחולי עבודה","מחלוקת על הטבילה לפני העבודה","ה' טבילות חוץ מראשונה","שחיטה בעזרה בתוך עבודה","כל אדם צריך טבילה"],"פשט ירד וטבל עלה ונסתפג":["פשיטה והלבשה של כהן גדול","שתי קידושין בפשיטה ובהלבשה","רבנן ור\"מ על קידוש הבגדים","לבש בגדי חול אחר הפשיטה","הביאו בגדי זהב","תמיד של שחר ואהרון והמחתה"],"רבנן ב קידושי אפשיטה ואלבישה":["שתי קידושין לרבנן ולר\"מ","ר\"מ: קידוש אחד בלבישה","בגדי חול אחר הפשיטה","אהרון מוציא את המחתה","הביאו לבית הפרווה","קידוש ידיים ורגליים בפשיטה"],"הביאו לבית הפרווה פרסו סדין בוץ בינו לעם":["הכהן הגדול לובש פלוסין","בגדי לבן בשחר ובין הערביים","לר\"מ: י\"ב מנה וח' מאות זוז","הכל ל' מנה משל ציבור","סדר מחיר בגדי הכהן הגדול","פרווה ובוץ לבגדי הכהן"],"לה":["בגדי כהן שעשתה לו אמו","עבודת יחיד במסירה לציבור","כתונת של מאה מנה","ולא הניחוהו ללובשה","בגדים משל ישמעאל בן פיאבי","הלל מחייב את העניים"],"בא לו אצל פרו שעמד בין אולם למזבח":["מיקום הפר בין האולם למזבח","מיקום הכהן וסמיכת שתי הידיים","וידוי על הפר בתפילת כהן גדול","אני וביתי אנא השם","מי מתוודה על פר כהן גדול","ראשו לדרום ופניו למערב"],"לו":["ראשו לדרום ופניו למערב","מקום הסמיכה לר' ולרבי שמעון","ידיים בין שתי קרנות של זבח","וידוי על עוון חטאת ואשם ועולה","מחלוקת ר\"מ וחכמים בנוסח הוידוי","עויתי פשעת וחטאתי ללשון משה"],"בא למזרח עזרה וצפון מזבח סגן מימינו וראש":["סגן מימין וראש בית אב משמאל","שני שערים וגורלות לכהן גדול","בן גמלא עשה זהב","צפונה לפני ה' צפון כולו פנוי","סגן מהלך לימין רבו","גורל אחד על כל אחד"],"צפון מזבח צפונה לפני ה צפון כולו פנוי ור":["מלאכי השרת מיכאל גבריאל רפאל","הסגן מהלך לימין רבו","שיעור גורלות שווים","שיטול י\"ב בב\"א","משקעו גלגל ידות לסכינים","נברשת דהילני וזמן קריאת שמע"],"אלו לגנאי בית גרמו דלחה פ אבטינס דקטורת ":["אבטינס בית קטורת מתמר","בית גרמו ואופין מבפנים","שכר מאפים מאלכסנדריה","הזכרת בית גרמו לשבח","הכבוד במקום ניכר לאבותיהם","מגילת סממנים מאבטינס"],"בית גרמו שלא רצו ללמד שלא ילמד אדם שאינו":["בית גרמו שלא רצו ללמד","שלא ילמד אדם שאינו מהוגן","קטורת מתמר של בית אבטינס","מאומני אלכסנדריא בפיתן","שכרם של המאפים כפול","ריב\"נ ומגילת הסממנים"],"טרף שלא יכוון קלפי עץ חול ומחזקת רק ב יד":["קלפי של עץ וחול","סגן מימין או משמאל","שמעון הצדיק שמש בימין","זהורית שמלבינה ונר מערבי","אש המערכה ועצי שלוש","גזלן מעוול וחומץ"],"מא":["קינין מתפרשות בלקיחת בעלים","ולקחה ועשה לשם חטאת","הפריש מעות ואח\"כ אמר","מוסיף חובה מדמי חטאת","חטאת למיתה משעת הפרשה","עשיר שהביא קרבן עני"],"קשר לשון זהורית בשעיר המשתלח כנגד בית שי":["קשר לשון זהורית לשעיר המשתלח","קשר לנשחט כנגד בית שחיטתו","עץ ארז ושני תולעת","כריכה תנאי באגודה אחת","שעיר ופרה כבד וחלוקה","מצורע שקל"],"ולנשחט קשר כנגד בית שחיטתו שלא יתערב בחב":["שיעור הכובד והחלוקה","מרי'ו: שלושה לשונות","שחיטת זר בפרה ובפרו","רב ושמואל על שחיטת זר","סימן מרבה וממעיט","פטירתו של רב\"ק בסימן"],"כל הפרשה משמע מוציא מיד ומשמע ממילא":["הוצאת הפרה מחוץ למחנה","שחיטת הפרה בזר","קבלה והזאה בכהן הדיוט","שריפה כשרה להזאה","השלכת עץ ארז לאש","אסיפת האפר והנחתו"],"שחטו וקבל במזרק את דמו נותנו לממרס בו":["דם שחיטה נשמר על הרובד","חתיית המחתה ומעוכלות","בכל יום חותה בשל כסף","כה\"ג בתמיד ובשל זהב","הכנסת קטורת ביום הכיפורים","כבדה ויד קצרה לכהן"],"וכל אדם לא יהי באוה מ תני היכל אבל בעזרה":["איסור לאדם בקודש בזמן הכפרה","כפרה בעדו ובעד ביתו","קטורת מכפרת על לשון הרע","פרישה בין האולם למזבח","שתי פרישות: היכל ולפני ולפנים","כפרת כהן משיח ושעירי עכו\"ם"],"כאן במחתה דקטורת ולא דגחלים דהוציאו לו כ":["מחתה של קטורת ולא גחלים","כף ריקן מלשכת הכלים","בשיניו אין עושין כן","מחתה בימין וכף בשמאל","ריב\"ק וחופן ארבע קבין","קטורת בערסן לחולה"],"מהלך בהיכל עד שמגיע לבין שתי הפרוכת המבד":["מהלך בהיכל עד הפרוכת","אמה טרקסין בין שתי הפרוכות","מחלוקת רבי יוסי ורבנן בפרוכת","היכן מהלך הכהן בהיכל","שולחן ומזבח בצפון ודרום","ישראל לא הצריכן הכתוב לשליח"],"ולרבנן ה מ במשכן ובמקדש":["שתי פרוכות במקדש שני","בין שלחן למזבח או מנורה לכותל","שולחנות בצפון ודרום","אמה טרקסין כפנים או כחוץ","אורכי ההיכל ורוחבו","שיטת ר\"מ על מקום ההליכה"],"החיצונה היתה פרופה מן הדרום ופנימית מן ה":["הפרוכת החיצונה והפנימית","הופך פניו לדרום בהגיעו לצפון","צבר הקטורת על הגחלים","תפילה קצרה בבית החיצון","ארון וכבין שני הבדים","צבר הקטורת פנימה או חוצה"],"במקדש שני והגיע למקום ארון וכבין שני הבד":["ארון שנגנז עם צנצנת המן","במקדש שני לא היה ארון","יאשיהו גנז את הארון","נתינת הקטורת לפני ה' בענן","מעלה עשן ואם לא נתן","שתי הקטרות שלימה וחסירה"],"משניטל ארון אבן השתייה שם מימות נביאים ר":["אבן השתייה מימות הנביאים","הזאת הדם למעלה ושבע למטה","כמצליף בדם הפר והשעיר","זהב שבהיכל ושני הזהב","נטל דם הפר והניח דם השעיר","עירה דם הפר לתוך דם השעיר"],"נד":["ארון גלה לבבל או נגנז","עשרת הדברות בארון","ויהיו שם עד היום הזה","גפרית ומלח בארץ ישראל","ארון בלשכת העצים","מעשה בכהן וקרדום"],"ויצא אל המזבח אשר לפני ה זה מזבח הזהב":["מזבח הזהב ומזבח החיצון","מתחיל מחטא ויורד","שירי הדם על היסוד","דם המערבי והדרומי מתערב","מחלוקת ר\"ע וריה\"ג על סדר הזאה","מקרן מזרחית צפונית"],"ויצא אל המזבח לפנים מן המזבח ולא חוץ למז":["ר\"ע וריה\"ג מהיכן מתחיל","מקום ריה\"ג מתחיל ור\"ע פוסק","קרן ראשונה שפגע בה","כרב\"י בפנים מחוץ","ים שלמה על י\"ב בקר","כל פינה דרך ימין למזרח"],"כל מעשה יום הכפורים האמור על הסדר":["הקדמה במעשי היום לחבירו","הקדים דם השעיר לדם הפר","הזאה חוזרת מבפנים ומבחוץ","ממקום שפסק מתחיל","הקדמה בבגדי לבן ובגדי זהב","והיתה זאת לחקת עולם אחת"],"ר י הקדים בדברים הנעשין בבגדי לבן בפנים ":["כל פעם אחת בשנה לחקת עולם","זאת ואחת לבן וזהב","שירים מעכבים ביום הכיפורים","אם כלה כפר לר\"י","הקטורת לפני שחיטת הפר","חיסר אחת מן המתנות"],"שעירי שנים שני שיהו שוין שעיר דאי לא כשר":["שני שעירי יום הכיפורים","שני כבשי מצורע ושיעור תהיה","כבשים לתמיד ולא בשווין","שעירי יוה\"כ ששחטן בחוץ","שלמים שנשחטו קודם פתיחת היכל","מחוסר הגרלה כמחוסר מעשה"],"שעיר המשתלח סמיכה וידוי אנא השם נופלים ע":["מסירת השעיר המשתלח למוליכו","כבש מפני בבלים","כהנים בכלל ישראל","מצורע עשיר ועני לקרבן","שאלו לר\"א חלה שעיר","דחאם בדברים שלא שמע מרבו"],"אפי כר י דכהנים בכלל ישראל":["אשה חכמה את ר\"א","מיתת חוטאי העגל","רב ולוי: זביח בסייף","לא עבדו ע\"ז","כבש עשו בבלים ואלכסנדריים","תנוח דעתך שהנחת דעתי"],"סז":["מיקירי ירושלים מלווים עד סוכה","עשר סוכות מירושלים לצוק","המלווין לצוק","אחרון שרואה מרחוק","זהורית בסלע ובין קרניו","הרי מזון ומים לאחרון"],"ר מ י סוכות וי ב מילין":["זהורית בסלע ולא כולו","קשירה מבפנים ולא מבחוץ","אברים אם מותרין בהנאה","גזירה במדבר עזאזל","מכפר על מעשה עוזא ועזאל","משפטי תעשו ודברים ששטן משיב"],"פר ושעיר קרען והוציא אימוריהן נתנן במגיס":["פר ושעיר נשרפים מחוץ למחנה","קליעה עור על בשר","יוצא ממחנה אחת","ר\"ש: חוץ לשלוש מחנות","בית הדשן נשרף","נחרך ואינו אפר"],"סח":["שריפת הפר והשעיר במחנה","טעם מחנה שלישית","בית הדשן ומקום השריפה","נחרך אינו אפר לטומאה","ניתוח הפר והשעיר","מטמא בגדים משיצאו"],"אמרו לכה ג הגיע שעיר למדבר שעשו דירכאות ":["הגעת השעיר למדבר","דירכאות והניפו בסודרין","ירושלים לשעיר המשתלח","לשון זהורית בפתח ההיכל","בית חדודו במדבר","מצוותו נעשית במדבר"],"ש מ בית חדודו במדבר קיימא":["מצוות השעיר נעשית במדבר","בית חדודו קיים במדבר","ר\"י וכשהגיע למדבר","הלבנת הזהורית בשעיר","השלמת השעיר המשתלח","נעשית מצוותו"],"איבעיא אי בגדי כהונה ניתנו ליהנות בהן שא":["בגדי כהונה ניתנו ליהנות","שנה תחת הראש מול כלאיים","קריאה בבגדי כהונה","תפילין מן הצד","אבנט כה\"ג וכהן הדיוט","חכמים אסרו נימא בבשר"],"אם בבגדי בוץ קורא קדש פשט ירד טבל לבש בג":["קריאה בבגדי בוץ ופשט","לבש בגדי זהב וקידש","איל העם ושבעה כבשים","פר העולה ושעיר בחוץ","מתי מטיב הנרות","סדר עבודה מתוקן לר\"א"],"איבעיא פר ושעיר או רק שעיר עם של בין הער":["אילו ואיל העם לשם חטאת","סדר עבודה מתוקן כר\"א","תמיד של שחר ותמיד של בין הערביים","ר\"ע: מקרא דמוספין","אחד של שחר וששה של בין הערבים","ר\"י ואיל אחד לראב\"ש"],"כה ג משמש בשמונה והדיוט בד באלו נשאלין ב":["כה\"ג משמש בשמונה כלים","הדיוט בארבעה כלים","אורים ותומים רק למלך","שש כפול ששה","משזר ח' למעיל ופרוכת","חשן ואפוד כ\"ח"],"שש כפול ששה משזר ח מעיל יב פרוכת כד אפוד":["שש כפול ששה לכל כלי","מעיל י\"ב תכלת","פרוכת כ\"ד ואפוד כ\"ח","תעשנו ולא לאחר","מקרע בגדי כהונה לוקה","לא יזח חושן מאפוד"],"אסור ולא בכרת דבחצי שיעור דאסור":["חצי שיעור באיסור","אסור רק מדרבנן בשבועה","שבועת העדות בראויין להעיד","משחק בקוביה שאינו בר הגדה","כרת רק באוכל ושותה","איסור רחיצה סיכה סנדל"],"חצי שיעור מדאורייתא רי ו אסור דחזי להצטר":["חצי שיעור מדאורייתא","תענו את נפשותיכם","ענוי ביום הכיפורים כמלאכה","למען ענותך לסומין","ספק ענוי באיסור","נחש עפר לחמו"],"אכל ושתה בהעלם אחד חטאת אחת אכילה ומלאכה":["אכל ושתה בהעלם אחד","אכילה ומלאכה שתי חטאות","אין ענוש כרת על עינוי","אזהרה דיום ודלילה","שבת בתשיעי","תשיעי ועשירי באכילה"],"ר ל אין אזהרה בעינוי דא א ויקשה דנכתוב א":["ענוי בשבת ויום הכיפורים","על עיצומו של יום כרת","מתי מחייב כרת בעינוי","ללמוד ממלאכה לעינוי","שבת שבתון בגופיה","סוף היום ותחילתו בעינוי"],"פב":["תינוקות אין מענין ביוה\"כ","חינוך לפני שנה ושנתיים","בן ח' ט' מחנכין לשעות","השלמה מדרבנן ומדאורייתא","סמוך לפרקן","שני חינוכים"],"שנתיים בחולה שנה בבריא":["גיל חינוך לשעות בתינוק","י\"א לשעות וי\"ב משלימין","השלמה דרבנן ליכא","חינוך בתינוקת לפני פרקה","י\"ג מדאורייתא בתינוק","שני חינוכים בתינוק"],"עוברה שהריחה מאכילן עד שתביא נפשה חולה ע":["עוברה שהריחה מאכילין","אכילה בחולה על פי בקיאין","רוטב עצמה לעוברה","מאכילין עד שיאמר די","שומן עצמו שפקו\"נ","לחש לעוברה שהריחה"],"עוברה שהריחה בשר קודש או חזיר תוחבין פלך":["חולה מאכילין על פי בקיאין","חולה אומר צריך ורופא א\"צ","שומעין לחולה דלב יודע","רוח שטות דחולה","שנים באומר א\"צ","רובא בדעות לא בעדות"],"אחזו בולמוס מאכילין אפי דברים טמאים עד ש":["בולמוס מאכילין דברים טמאים","נשכו כלב שוטה","חושש בגרונו בשבת","מפולת ספק נפשות","האירו עיניו משיבחין","בולמוס מאכילין הקל קל"],"האירו עיניו אביי משיבחין בין טוב לרע ובט":["טבל ונבילה ושביעית","טבל ותרומה תנאי","בולמוס אוכלים דבש ומתיקה","אביי: דוקא אחר אכילה","בולמוס וכפאו לרועה","קיפחת את הרועה"],"חטאת ואשם ודאי מכפרין מיתה ויוה כ מכפרין":["חטאת ואשם ודאי מכפרים","מיתה ויוה\"כ עם התשובה","אשם תלוי לכפרה שאינה גמורה","תשובה על עשה ולא תעשה","מלא תשא ולמטה תשובה","תשובה מכפרת על לאוין"],"אשם ודאי מכפר אשם תלוי לכפרה שאינה גמורה":["מיתה ויוה\"כ עם התשובה","לא ינקה שמו מכפרה","על כריתות ומיתות ב\"ד","ד' חלוקי כפרה","עבר על עשה ושב","ג' ותשובה עם כל אחד"]}