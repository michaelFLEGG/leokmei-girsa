{"ברביעיות יושב ומלמד תשב ר תורה שנא את מי":["מה עושה הקב\"ה בלילה","גחלי רתמים לשיחה בלי תורה","חוט של חסד למי שעוסק בלילה","תורה בעוה\"ז ושכר בעוה\"ב","מיטטרון מלמד תורה","תורה לשמה ותלמוד בלילה"],"למינים את רב ספרא דאדם גדול הוא וויתרו ל":["רב ספרא והמינים","משל הנושה לשני בני אדם","צדיק ורשע בעולם הזה","אברהם מתווכח על סדום","חלילה לך להמית צדיק עם רשע","ידיעה מיוחדת לישראל ועונש"],"רתיחתו רגע א ד כי רגע באפו ב חבי כמעט רג":["כעס הקב\"ה ברגע אחד","תרנגול לבן בשלש שעות","אין מתפללים מוסף בשלש שעות","הקב\"ה יושב ועוסק בתורה","אסור להפוך בתורה","זעם מול רחמים בשעת הדין"],"ולהקרבה סגי בג יומי והך דשואלין בהלכות ה":["בדיקת קרבן ל' יום או ג'","מחוסר אבר לבני נח","טריפה מלחיות זרע","כוותך עייל ולא שלמין","בדיקה מחוסר אבר לקרבן","תמים לבני נח ולקרבן"],"ואלו אידיהן של עובדי כוכבים קלנדא וסטרנו":["אידיהן של עובדי כוכבים","קלנדא וסטרנורא לר\"מ","כל מיתה שיש בה שריפה","יום תגלחת זקנו ובלוריתו","יום שעלה בו מן הים","משתה בנו של עכו\"ם"],"קלנדא ח ימים אחר תקופה סטרנורא ח ימים לפ":["קלנדא שמונה ימים אחר תקופה","אדם הראשון וקיצור היום","שמונה ימים טובים לאלו ולאלו","הוא קבעם לשם שמים","סימנך אחור וקדם צרתני","יום שמאריך והולך לשמחה"],"ק פ שנה ותו לאו והך דתני ריב ב מלכות פרס":["מלכות פרס בפני הבית","ק\"פ שנה של מלכות יון","כ\"ב שנה בלא השתעבדות","חשבון שנים אחר חורבן הבית","ר\"פ: ישאל לסופר","ששת אלפים שנה לעולם"],"יום תגלחת זקנו והנחת בלוריתו או והעברת ב":["פולחן ברומי כל שבעים שנה","אדם שלם על חיגר ברומי","עור פניו של ר\"י","יום תגלחת והעברת בלוריתו","נבואת יעקב פלסתר","מחזה רמאי וזייפן ברומי"],"עיר שיש בה עבודת כוכבים חוצה לה מותר":["מהו ללכת לעיר של ע\"ז","עיר של ע\"ז וחוצה לה","דרך מיוחדת לאותו מקום","הולך בדרך אחרת מותר","תוכה לה מותר","הליכה למקום עבודה זרה"],"לא ישתה אדם מים לא מן הנהרות ולא מן האגמ":["שתיית מים מנהר ואגם","סכנת עלוקה במים","שתיה מכוסה בלילה","החמין לבולע נימא של מים","רביעית חומץ לבולע צרעה","מחלוקת על שתיה בלילה"],"עיר שיש בה עבודת כוכבים והיו בה חנויות מ":["חנויות מעוטרות בעיר של ע\"ז","עיטור בורד והדס אסור","נהנה מהריח אסור","עטרה במכס יום ע\"ז","נושא ונותן בשוק של ע\"ז","עיקור בהמה לנושא ונותן"],"דווקא מעוטרות בוורד והדס שנהנה מן הריח":["קל וחומר: נהנה אסור","הנאה מן הע\"ז ביום אידם","ר' נחמן ומכס יום ע\"ז","אסור ליהנות מן העטרה","מכירה שאינה מותרת כמהנה","עיקור לנושא ונותן"],"בהמה תיעקר ואין צעב ח כאביי ד את סוסיהם ":["הקדש ע\"ז בזמן הזה","עיקור בהמה כהחרם","נועל דלת והיא מתה מאליה","לא תעשון כן לה' אלהיכם","מטיל מום בבעל מום","רועה דקה לא מעלין ולא מורידין"],"אלו דברים אסורים למכור לעכו ם":["מה אסור למכור לעכו\"ם","תרנגול לבן וקטיעת אצבע","לבונה ואצטרובלין למכירה","אין מקריבים חסר לע\"ז","סתם דברים מותרים ופירושן אסור","ר\"מ: דקל טב אסור"],"איצטרובלין פירי דארז ולא ארז שאין לו עיק":["אצטרובלין ובנות שוח","פירי ארז ולא ארז","חבילה פחותה משלושה מינים","לבונה זכה למכירה","אלפני עוור ולא אלפני דלפני","מכירה לגוי שיקטיר"],"תלוי במנהג ומקום שאסרו לייחד שחשודין על ":["מכירת בהמה לגוי לפי מנהג","שגוי חס על בהמתו","רב חזר בו מההיתר","שחשודין על הרביעה","מקום שאסרו לייחד בהמה","הפרדת זכרים מנקבות בקנייה"],"איבעיא להו שור של פטם מהו תיבעי לרבי יהו":["שור של פטם ביום אידם","ר' חסר אלף מטבעות","שור פטם ואיסור מלאכה","שחוט או חי ביום אידם","לא להקריב אלא למחר","משהה שור עד שיכחוש"],"אין מוכרין להם דובין ואריות וכל דבר שיש ":["מכירת דובים ואריות לעכו\"ם","בנייה עם עכו\"ם בבימוסיאות","סילקי גרדום ואיצטדייא","הגיע לכיפה של ע\"ז","בית מרחצאות מותר לבנות","נזק לרבים במכירה"],"ארחבר ח מרב חיה גסה הרי היא כבהמה דקה לפ":["חיה גסה כבהמה דקה","ארי שבור מותר למכור","תיובתא דרב חנן בר רבא","נזק לרבים בחיה גסה","רבינא מיישב את הסתירה","מכירה במקום שמוכרים דקה"],"ר ח וריו נ הלכו בדרך הגיעו לב שבילין חד ":["שני שבילין לעכו\"ם ולזונות","נלך לפתח בית זונות","נכוף את יצרנו ונקבל שכר","מזימה תשמור עלך תבונה","לא ילך לפתח עכו\"ם","מדבר זימה תשמור עליך תורה"],"ת ר כשנתפסו רבי אלעזר בן פרטא ורבי חנינא":["תורה ללא גמילות חסדים","ממונה ת\"ח על קופת צדקה","כל העוסק בתורה בלבד","מעות פורים בצדקה בטעות","בעל חרב אינו בעל ספר","פתיחה בדברי ר' אלעזר בן פרטא"],"ת ר כשחלה רבי יוסי בן קיסמא הלך רבי חנינ":["מעות פורים שחולקו לעניים","מחלקך יהי חלקי","חנינא בן תרדיון בבקורו","אומה זו מן השמים המליכוה","מן השמים ירחמו","תמה אם לא ישרפו את ספר תורה"],"ת ר ההולך לאיצטדינין ולכרקום וראה שם את ":["הולכים לאיצטדינין ולכרקום","מושב לצים באיצטדינין","מפני שצווח ומציל","מפני ישוב מדינה","לטרטיאות לר\"מ","מקום שמזבלין לע\"ז אסור"],"כי אם בתורת ה חפצו":["אין אדם לומד אלא ממקום חפצו","כי אם בתורת ה' חפצו","בתחילה על שם הקב\"ה","לעולם ילמד ואחר יהגה","לעולם ליגרס איניש","גרסה כתיב ולא טחנה"],"וכל אשר יעשה יצליח אריב ל שכל העוסק בתור":["כל העוסק בתורה נכסיו מצליחין","מי רוצה חיים נצור לשונך","סור מרע ועשה טוב","תורה משולש בכתובים","לא ימוש ספר התורה הזה","והיה כעץ שתול על פלגי מים"],"לא תחנם לא תתן להם חנייה בקרקע":["לא תחנם לא תתן להם חן","לא תחנם לא תתן חנייה","לא תחנם מתנת חנם","לא תחינם לשון חנינה","תנ\"ה על כל אלו הענינים","לשון לא תחנם ולא תחונם"],"ממנה מת ולא חלק על אבוה דשמואל שאמר שאיל":["מת שמסריח ונהפך על פניו","כבוד למת ובית השחיטה","אבוה דשמואל ומת המסריח","טיפה מחתכת לסימנין","מסייע לרב להפיכת המת","הרוצה שלא יסריח מתו"],"לר מ אין משכירין להם בתים בארץ ישראל ואצ":["השכרת בתים ושדות לעכו\"ם","לר\"מ בארץ ישראל","בסוריא מוכרין בתים","בחו\"ל מוכרין ומשכירין","מכניס לתוכו ע\"ז","מרחץ שנקרא על שמו"],"לוקחין מהן בהמה לקרבן":["בהמה לקרבן מעכו\"ם","משום רובע או נרבע","רועה שלהם לא מוסרים","כמו שהשיש מפחד מהמכתב","שלא לייחד נקבות אצל נקבות","אלמנה לא תגדל בר בי רב"],"וידום השמש וירח עמד עד יקום גוי אויביו ה":["וידום השמש וירח עמד","מה כתוב בספר הישר","דום השמש ליהושע","וזרעו יהיה מלא הגוים","תמות נפשי מות ישרים","ספר הישר ספר האבות"],"ויעמד השמש בחצי השמים ולא אץ לבוא כיום ת":["חשבון עמידת השמש ליהושע","כ\"ד ל\"ו ומ\"ח שעות","הלכה שש ועמדה י\"ב","כיום תמים ולא אץ לבוא","תוספת ריב\"ל לחשבון","ביאתו וכעמידתו שוות"],"ויאמר ללמד בני יהודה קשת הנה כתובה על ספ":["ספר הישר שלושה ספרים","קשת כתובה על ספר הישר","ספר הישר ומשנה תורה","ידך בעורף אויביך","מלחמה שצריכה לימוד","ויאמר ללמד בני יהודה"],"וירם הטבח את השוק והעליה וישם לפני שאול":["שוק ואליה בהנפה","שוק וחזה לשם הנפה","שוק ושופי מונח על השוק","והעליה סומכת את השוק","וירם הטבח את השוק","סדר הנחת חלקי הזבח"],"היו עולין במעלה או יורדין בירידה לא יהא ":["ישראל למעלה ועכו\"ם למטה","אל ישוח לפניו שמא ירוץ","שאלו להיכן הולך","ירחיב לו את הדרך","עד אשר אבא אל אדוני שעירה","ויעקב נסע סכותה"],"מעשה בתלמידי ר ע שהיו הולכים לכזיב פגעו ":["תלמידי ר\"ע מול הליסטים","אשרי ר\"ע ותלמידיו","שלא פגע בהן אדם רע","רב מנשה ופגעו בו גנבים","יה\"ר שתהיו מנודים","אריה אכל את שלא התיר נידוי"],"בת ישראל לא תיילד את הגויה מפני שמילדת ב":["בת ישראל מילדת לגויה","נכרית מילדת בת ישראל","בת ישראל לא תניק בן נכרית","נכרית מניקה בן ישראל","מילדת בן לע\"ז","בהסכמת רשותה של נכרית"],"מתרפאין מהן ריפוי ממון אבל לא ריפוי נפשו":["ריפוי ממון ולא נפשות","מסתפרין מהן ברה\"ר","ספק חי ספק מת במין","ודאי מת מתרפאין מהם","בן אחות ר\"י והנחש","יעקב איש כפר סכניא"],"ריפוי ממון בהמתו ריפוי נפשות גופו אף בשא":["בן אחות ר\"י שהכישו נחש","אשריך בן דמא שגופך טהור","ריפוי נפשות בחינם אסור","הרופא שואל ולא מוציא שם רע","מקרא מן התורה שמותר","לא עברת על דברי חביריך"],"ורפואתם מי שאור ושמן זית ומלח ומבר א משמ":["מכה שמחללין עליה שבת","שחליים בחומץ להפסקת דם","מי שאור ושמן זית ומלח","משמן אווז על נוצת אווז","גרעיני זיתים שרופים לשיניים","פדעתא סכנה ומחללין שבת"],"ומחלות העין האלו כגון ריר ועין דוקרת ועי":["מחלות עין ומותר לכחול","מרחץ מסוכנת לו חמה","צנון לחמה לחום","חמימי לעקיצת עקרב","חומץ לסיבורי אחר הקזה","הקזה אחר אכילת שחליים"],"עשרה דברים מחזירין את החולה לחליו וחליו ":["עשרה דברים מחזירים את החולה","בשר שור ושומן ובשר צלי","ביצה צלויה ושחלים","תגלחת ומרחץ וגבינה","אף אגוזים ואף קשואין","שקשין לגופו כחרבות"],"קינסא קיסמין דולקים עד שנשרה זיפתו":["קינסא קיסמין דולקים","עד שנשרה זיפתו","ר\"א ורבינא בקינסא","והלכתא שאסור","זיפת דולקת לרפואה","ריפוי באש של קיסם"],"חלב חיישי למאכל":["חלב טהור וטמא מעורבים","חלב לבן וחלב ירוק","אי אפשר להעמיד בקיבה","יש מן הטמא בגומות","חשש לגבינה מחלב טמא","הכרעה בחלב שנתערב"],"כשנסמך והלך ר י הנשיא על כתפי ר שמלאי שמ":["בימינו תתיר אף את הפת","שמן התיר בית הדין","יוסף שריא שם התיר","זה גיטך אם לא באתי","גט מותנה בי\"ב חודש","הורה נשיא ולא הודו לו"],"שתיתאה תבשיל קמח קליות או עדשים שנותן בת":["שתיתאה בחיטי ושעורי","עדשים בחומץ אסור לכולי עלמא","רב שרי ואבוה דשמואל אסרי","שתיתאה של ברזילי הגלעדי","גזירה משום גזירה בשתיתאה","סלי שתיתאה לשוקי נהרדעא"],"ואלו מותרין באכילה חלב שחלבו עכו ם וישרא":["חלב שחלבו עכו\"ם וישראל רואהו","דבש ודבדבניות לא מכשירים","כבשין בלי יין וחומץ","טרית שאינה טרופה","שלחין אסורין לר' יוסי","חגבים מן הסלולה ומן ההפתק"],"תנינא להא דת ר יושב ישראל בצד עדרו של עכ":["ישראל יושב בצד עדר עכו\"ם","עכו\"ם חולב ומביא לישראל","דבר טמא כשיושב אינו רואה","פחד מלערב בזמן ישיבה","אינו חושש שיערב","חלב בידי עכו\"ם בשעת ישיבה"],"במקומו של ר מ היו עובדין אותה פעם אחת בש":["מיעוטא גזר שאר מקומות","עבודה פעם בשנה לר\"מ","אנדרטי של מלכים בכרכים","בעומדין על פתח מדינה","כרכים וכפרים באיסור","רבנן לא חיישי למיעוט"],"המוצא שברי צלמים הרי אלו מותרין":["שברי צלמים מותרים","תבנית יד או רגל אסורה","כיוצא בהן נעבד","שברי ע\"ז בעומדין על בסיסן","שמואל מתרגם את השברים","מציאת שברי עבודה זרה"],"אפי שברי עבודת כוכבים והך דקתני שברי צלמ":["שברי ע\"ז על בסיסן כשמואל","תבנית יד ותבנית רגל","מצא שברי עבודה זרה","אסורין מפני שכיוצא בהן","שברים מותרין שאינם עומדים","סיפא ורישא במציאת צלם"],"למימרא שלזה משתחווים ולא לדבר אחר":["זבחי מתים לכל משתחוים","מזלות מותרין חוץ מחמה ולבנה","פרצופין מותרין חוץ מאדם","צורה מותרת חוץ מדרקון","מיצר ומפלגח לשלושה ציירי","שילשול קטן לשום"],"ושמשין שאי אפשר לעשות כמותן מי שרי והתני":["לא תעשון אתי כדמות שמשי","ד' פנים ביחד אסורין","פרצוף אדם לבד אסור","אשר בשמים לרבות חמה ולבנה","שמשין במדור העליון","לעובדם אפילו שילשול קטן"],"תניא אמר להם רבי יוסי והלא כבר נאמר ואת ":["עגל הזהב ושריפה לעפר","אסא ומפלצת בנחל קדרון","נחל קדרון לא מגדל צמחין","מפלצתה שמפליא ליצנותא","וכתת נחש נחשת במדבר","טחון היטב עד דק לעפר"],"זאת היתה לי כי פקודיך נצרתי בשכר שפקודיך":["זאת היתה לי כי פקודיך נצרתי","מקום תפילין בראש הולמתו","נזר ועדות לבית דוד","ואדניה מתנשא להולמו","רצים נטולי טחול וחקוקי כפות","כלילא בנזר המלך"],"שאל פרוקלוס בן פלוספוס את ר ג בעכו שהיה ":["ר\"ג ופרוקלוס במרחץ אפרודיטי","אין משיבין במרחץ","היא באה בגבולי","נעשה אפרודיטי נוי למרחץ","אם נותנים לך ממון הרבה","את שנוהג בו משום אלוה"],"וענה לו בחוץ כשיצא דאסור להרהר בבית המרח":["תשובה גנובה לפרוקלוס","אסור להרהר במרחץ ובית הכסא","פעור יוכיח והכרעה גנובה","זו עבודתה בכך","בטובת רבן גמליאל כטובת אחרים","הנפנה בלילה במקום שנפנה ביום"],"הנכרים העובדים את ההרים ואת הגבעות הן מו":["הרים וגבעות של עובדי כוכבים","לא תחמוד כסף וזהב עליהם","אלהיהם על ההרים ולא ההרים","אשירה אסורה מפני תפיסת ידי אדם","ר\"ע: הר גבוה וגבעה נשאה","ועץ רענן דע שיש שם ע\"ז"],"רב ח מר ל איכא בנייהו בין ת ק לריה ג דלת":["צפוי הר אינו כהר לתנא קמא","לריה\"ג צפוי הר כהר","אילן שנטעו ולבסוף עבדו","ואשריהם תשרפון באש","רבנן: עיקר אילן שרי","ר\"ש: לכו\"ע צפוי הר אינו כהר"],"מי שהיה ביתו סמוך לעבודת כוכבים ונפל אסו":["בית סמוך לע\"ז שנפל","כונס ארבע אמות ובונה","שלו ושל ע\"ז נידון מחצה","אבניו עציו ועפרו מטמאין","שקץ תשקצנו כשרץ","כנדה לר\"ע במשא"],"ולא מרווח לעכו ם ר ח מסורא דעושה זה לבית":["בית הכסא לעכו\"ם בלילה","איזהו צנוע הנפנה בלילה","גודר בקוצים וברקנים","מרווח לעכו\"ם מותר","בית הכסא לתינוקות","ר\"ח מסורא על הבית"],"שלשה בתים הן בית שבנאו מתחלה לעבודת כוכב":["שלשה בתים לע\"ז","בית שבנאו לעבודה זרה","סיידו וכיידו וחידש","הכניס ע\"ז והוציאה מותר","נוטל מה שחידש","בית שעברה בו ע\"ז ויצאה"],"רב המשתחוה לבית אסרו והיינו דס ל תלוש ול":["המשתחוה לבית אסרו","תלוש ולבסוף חברו כתלוש","בנאו אף שלא השתחוה","השתחוה אף שלא בנאו","בנה והשתחוה חשיב אחד","לא חשיב ארבעה לענין ביטול"],"שלש אבנים הן אבן שחצבה מתחלה לבימוס הרי ":["שלש אבנים לעבודה זרה","אבן שחצבה לבימוס","סייד וכייד נוטל מה שסייד","העמיד עליה ע\"ז וסילקה","ומותרת אחר סילוק הע\"ז","אבן שנעשתה לשם ע\"ז"],"א ר אמי והוא שסייד וכייד בגופה של אבן ול":["סייד וכייד בגופה של אבן","נוטל מה שחידש מהני","לא אמרינן כשסייד כאבן","אבן שחצבה לעכו\"ם ותיאסר","ר' אמי על גוף האבן","ביטול בסייד בגוף האבן"],"שלש אשרות הן אילן שנטעו מתחלה לשם עבודת ":["שלש אשרות לע\"ז","אילן שנטעו לשם ע\"ז","גידעו ופיסלו והחליף","נוטל מה שהחליף","העמיד תחתיה ע\"ז ונטלה","אשרה מוסרת לא מתבטלת"],"דבי ר ינאי והוא שהבריך והרכיב בגופו של א":["הבריך והרכיב בגופו של אילן","המשתחוה לאילן תוספתיה אסורה","גידעו ופיסלו אין לא גידעו לא","שמואל כריב\"י באילן שנטעו","הא מני רבנן היא","ואשריהם תשרפון מול תגדעון"],"לא ישב בצילה ואם ישב טהור ולא יעבור תחתי":["ישיבה בצל אשרה","עבירה תחת אשרה טמא","אשרה שגוזלת את הרבים","טהור בעבר תחתיה","צל אשרה לטומאה","הוציא מן האשרה הטומאה"],"דלרבי יוסי זה וזה גורם אסור ורבנן זה וזה":["זה וזה גורם לר' יוסי","שדה שנזדבלה בזבל ע\"ז","נוטעין יחור של ערלה","שדה תזרע או תבור","מה שמשביח בעור פוגם בבשר","מודה ר' יוסי בהבריך והרכיב"],"נטל ממנה עצים אסורין בהנאה":["עצים מן הע\"ז בתנור","אפה בו את הפת אסורה בהנאה","נתערבה באחרות כולן אסורות","ר\"א יוליך הנאה לים המלח","אין פדיון לעבודה זרה","נטל הימנה כרכור אסור"],"וצריכא כרכור אפי דיש לאיסור בעין לא מודה":["הלכה כר\"א בפת","פת שלא בעין לרבנן","חבית אפילו מותרת לר\"ח","יין נסך בחמריה","קח ד' זוזי וזרוק בנהר","כרכור ובין איסור בעין"],"כיצד מבטלה":["כיצד מבטלה ע\"ז","קירסם וזירד מבטלה","נטל ממנה מקל או שרביט","שיפה לצרכה אסורה","שיפה שלא לצרכה מותרת","ביטול ע\"ז בהשחזה"],"אותן שפאין מה תהא עליהן פליגי בה ר ה ורח":["שפאיה של ע\"ז מה תהא עליהן","עכו\"ם ששיפה לצרכו מותרת","ישראל ששיפה אסורה","עבודת כוכבים שנשתברה","עובדין לשברין לשמואל","שברי שברים מותרים"],"במרוחקות והך דבצד מרקוליס היינו בצד ד אמ":["שברים במרוחקות מהמרקוליס","שלושה נראות עמו אסורות","נשרו ממנו לכולי עלמא","מרקוליס קטן בצד גדול","נראות עמו אסורות לכו\"ע","עובדין לשברין וחשש נפילה"],"ארחב י מר א כתוב אחד אומר ותראו את שקוצי":["עמהם ועליהם בדבר של נוי","מעות בכיס קשור לצווארו","כסות מקופלת על ראשו","כלי נוי משכילתא","כל שהוא לפנים מן הקלקלין","אין קלקלין לפעור ולא למרקוליס"],"עבודת כוכבים שהיה לה גינה או מרחץ נהנין ":["ע\"ז שהיה לה גינה או מרחץ","נהנין שלא בטובה ולא בטובה","היה שלה ושל אחרים","ע\"ז של עכו\"ם אסורה מיד","ע\"ז של ישראל לא תאסר עד שתיעבד","נהנה בטובת הע\"ז"],"אביי בטובה בטובת כומרין שלא בטובה שלא בט":["בטובה בטובת כומרין","לאפוקי טובת עובדיה דשרי","שלא בטובת כומרין אסור","כש\"ל ארישא מאן דמתני אסיפא","היה שלה ושל אחרים אביי","בטובת אחרים שלא בטובת כומרין"],"עכו ם מבטל עבודת כוכבים שלו ושל חבירו וי":["עכו\"ם מבטל ע\"ז שלו ושל חבירו","ישראל אין מבטל ע\"ז של עכו\"ם","המבטל מבטל משמשיה","משמשין מותרין והיא אסורה","ביטול משמשים כביטול הע\"ז","הנאה מן המשמשין אחר ביטול"],"מתני לר ש ברבי עכו ם מבטל עבודת כוכבים ש":["עכו\"ם מבטל של ישראל לר\"ש","שנית לנו בילדותך","ושם בסתר כתיב","ישראל אדעתא דעכו\"ם פלח","בזקנותו ישראל לא בטיל","ע\"ז של ישראל אין לה ביטול עולמית"],"כיצד מבטלה קטע ראש אזנה ראש חוטמה ראש אצ":["כיצד מבטלה ראש אזנה","פחסה אף שלא חיסרה","מכרה או משכנה ביטל","השתין בפניה לא בטלה","גררה וזרק בה צואה","רבי אומר ביטל וחכמים לא"],"אר ז שפחסה בפניה רקק בפניה והשתין בפניה ":["פחיסה רקיקה והשתנה לא ביטול","חזקיה ופנה למעלה","קללה במלכו ובאלהיו","והנה צרה וחשכה","אל ארץ יביט","אף שקלל מלכו ובאלהיו"],"עבודת כוכבים שהניחוה עובדיה בשעת שלום מו":["ע\"ז שהניחוה עובדיה בשלום","בשעת מלחמה אסורה","בימוסיאות של מלכים מותרות","מעמידין בשעה שהמלכים עוברים","בעיות ע\"ז בשעת מלחמה","ע\"ז מותרת בשלום"],"ריב א מרב בית נמרוד הרי היא כעבודת כוכבי":["בית נמרוד כע\"ז בשלום","הפיצם ה' כשעת מלחמה","אי רצו לחזור היו חוזרים","מדלא חזרו ש'מ בטלוה","ריב\"א מרב על בית נמרוד","בית נמרוד מותר"],"שאלו את הזקנים ברומי אם אין רצונו בעבודת":["למה אינו מבטלה לזקני רומי","יאבד עולמו מפני השוטים","יאבד דבר שאין צורך לעולם","ויניח דבר שצורך העולם בו","מחזיקין ידי עובדיהן","תדעו שהן אלוהות שהרי לא בטלו"],"ת ר שאלו פלוסופין את הזקנים ברומי אם אלה":["עולם כמנהגו נוהג","שוטים שקלקלו עתידין ליתן דין","גזל סאה של חטים וזרעה","בא על אשת חבירו ולא תתעבר","לא דיין לרשעים שעושין סלע שלי","פלוספוס שאל את ר\"ג"],"לוקחין גת בעוטה מן העכו ם אף על פי שהוא ":["גת בעוטה מן העכו\"ם","יין נסך לא הוי עד שירד לבור","דורכין עם העכו\"ם בגת","ישראל בטומאה לא דורכין עמו","מוליכין עמו חביות לגת","נחתום שעושה בטומאה"],"אמר רב הונא יין כיון שהתחיל להמשך עושה י":["יין שהתחיל להמשך עושה יין נסך","גת פקוקה ומלאה לרב הונא","משנה ראשונה ומשנה אחרונה בגת","אין דורכין עם העכו\"ם בגת","בוצרין עם העכו\"ם בגת","לגרום טומאה לחולין שבא\"י"],"גופא אמר רב תינוק בן יומו עושה יין נסך":["תינוק בן יומו עושה יין נסך","עבדים שמלו וטבלו","גדולים עושין יין נסך וקטנים לא","עד שתשקע עבודה זרה מפיהם","לוקח עבדים מעכו\"ם","כמה זמן עד שתשקע"],"עכו ם שנמצא עומד בצד הבור של יין אם יש ל":["עכו\"ם העומד בצד הבור","אם יש לו מלוה עליו אסור","נפל לבור ועלה מדדו בקנה","ימכר ור\"ש מתיר","נטל את החבית וזרקה לבור","מעשה והכשירו"],"שמואל והוא שיש לו מלוה על אותו יין":["מלוה על אותו יין בעינן","המטהר יינו של עכו\"ם","התקבלתי ממך מעות מותר","אין מניחו עד שיתן מעותיו","מעשה בבית שאן ואסרו","טעמא דאין מניחו"],"המטהר יינו של עכו ם ונותנו ברשותו בבית ה":["בית פתוח לרשות הרבים","בעיר שכולה עובדי כוכבים אסור","עד שישב ומשמר","שומר היוצא ונכנס מותר","ר\"ש בן אלעזר רשות אחת","המטהר יינו ונותנו ברשותו"],"אבל אם ירצה ישראל להוציא ואינו מניחו עד ":["ישראל שרוצה להוציא יין","מעשה בבית שאן לאיסור","אינו מניחו עד שיתן מעותיו","יין בידי גוי עד תשלום","מניחו שרי בלא מעות","הוציא את היין לאיסור"],"שכרו לשבור ביין נסך מהו":["שכרו לשבור ביין נסך","כל למעט תיפלה שפיר","ישבור ותבא עליו ברכה","עודרין עם ע\"ז בכלאים","המנכש והמחפה בכלאים לוקה","ר\"ע: המקיים לוקה"],"יין נסך שנפל ע ג ענבים ידיחן והן מותרות ":["יין נסך שנפל על ענבים","ידיחן והן מותרות","נפל על תאנים או תמרים","ביתוס בן זונן וגרוגרות בספינה","כל שבהנאתו בנותן טעם אסור","חומץ שנפל על גריסין"],"חסורי מיחסרא וה ק אם נותן טעם לפגם הוא מ":["אם נותן טעם לפגם מותר","מעשה בביתוס בן זונן","חסורי מיחסרא בגרוגרות","אין בהנאה טעם מותר","נתן טעם לפגם","חבית יין נסך שנשברה על גרוגרות"],"גוי שהיה מעביר עם ישראל כדי יין ממקום למ":["גוי מעביר יין עם ישראל","חביות פתוחות אסורות סתומות מותרות","כדי שישתום ויסתום ויגוב","רשב\"ג: כדי שיפתח את החבית","המניח יינו בקרון או בספינה","המניח גוי בחנות מותר"],"בולשת שנכנסה לעיר":["בולשת שנכנסה לעיר בשעת שלום","בשעת מלחמה אלו ואלו מותרות","עיר שכבשוה כרקום","האומנין ששלח להם נכרי חבית","מותר לומר תן לנו את דמיה","מלטני מן העוצר ולא הכנס"],"דעיר שכבשוה כרקום כל כהנות שבתוכה פסולות":["משיכה בע\"ז קונה","פסק עד שלא מדד דמיו מותרין","הפרסים שולחים מתנות ביניהם","ליקח הכסף קודם המשיכה","הלוו אותו ואח\"כ קחוהו","יין נסך לא הוי עד שנוגע בזה"],"מותר לאדם לומר לעכו ם צא והפס עלי מנת המ":["מערה יינו לכלי מדידה של עכו\"ם","משיכה בע\"ז אינה קונה","כליו של לוקח ברשות מוכר","יין נסך כשיגיע לקרקע","עכבת יין בפי הכלי","גוי אוחז יין ומונח על הקרקע"],"משיכה בע ז קונה":["הלכה כרשב\"ג חבית בחבית","לא יין ביין","הלוקח גרוטאות מן העכו\"ם","כלי הלוקח ברשות המוכר","שפיכת יין נסך לבור","מערה יין נסך מכלי לכלי"],"יין נסך אסור ואוסר בכל שהוא":["יין נסך אוסר בכל שהוא","יין במים ומים ביין בנותן טעם","מין במינו במשהו","שלא במינו בנותן טעם","יין ביין ומים במים בכל שהוא","כלל לאיסור מין במינו"],"ר ד מרי ו המערה יין נסך מחבית לבור אפילו":["המערה יין נסך מחבית לבור","ראשון ראשון בטל","צרצור קטן ודוקא כד קטן","רבין: היתר כאילו אינו","מים שנפלו ליין נסך","ר\"ד מרי\"ו ומבטל"],"אלו אסורין ואוסרין בכל שהו":["אלו אסורין ואוסרין בכל שהו","עורות לבובין ושור הנסקל","עגלה ערופה וציפורי מצורע","שעיר המשתלח וחולין בעזרה","דבר שבמנין ואיסורי הנאה","אגוזי פרך ורימוני בדן"],"האי תנא תרתי אית ליה א דבר שבמנין ב ואיס":["תרתי אית ליה במשנה","ר\"ע מוסיף על האוסרין","ככרות של בעה\"ב לחמץ בפסח","דבר שבמנין ואיסורי הנאה","ערלה וכלאי הכרם בכללם","תנא שתי מיני איסור"],"הלכה כרשב ג חבית בחביות אבל לא יין ביין ":["הלכה למעשה יין נסך ביין","הלכה כשמואל יין ביין","גת של אבן שזפתה עכו\"ם","גת של עץ ינגב או יקלוף","גת של חרס אף שקלף אסורה","ביטול גת מזופתת לאיסור"],"דוקא זפתה אבל דרך בה לא וקמ ל דלא אמרי א":["רבי מתיר בניגוב גת מזופתת","הגת והמחץ והמשפך של נכרי","מודה רבי בקנקנים של עכו\"ם","דוקא זפתה אבל דרך בה לא","סדק מתחתיו מלא יין","לילך עם אותו שבא לטהר גיתו"],"הלוקח כלי תשמיש מן העובדי כוכבים את שדרכ":["כלי תשמיש מן העכו\"ם","את שדרכו להטביל יטביל","השפוד והאסכלא מלבנן באור","הסכין שפה והיא טהורה","להגעיל או ללבן באור","כלי עכו\"ם וטבילה"],"תנא וכולן צריכין טבילה בארבעים סאה":["טבילה בארבעים סאה לכלי עכו\"ם","כל דבר אשר יבא באש תעבירו","במי נדה ארבעים סאה","כלים חדשים וישנים בטבילה","זוזא דסרבלא לא טעון","כלי מתכות אמורין בפרשה"]}