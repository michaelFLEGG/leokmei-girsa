{"מפני מה האמינה תורה עד אחד בסוטה שרגלים ":["עד אחד בסוטה ומקורו","קינוי קודם לסתירה: מתי רוח הקנאה","רוח טהרה או רוח טומאה","מקנא לאשתו: רשות או חובה","מדוע נאמנה עדות אחד בסוטה","ועבר: כבר נאמר והתקיים"],"וקנא את אשתו לרי ש רשות ולר ע חובה":["רשות או חובה: מחלוקת שלוש פסוקים","רשב\"י ור' עקיבא בלשון ויקנא","חלוקת רשות וחובה בכל התורה","כפל הפרשה ודרשת ויקנא","ויקנא את אשתו: רשות לרשב\"י","מחלוקת רשב\"י ור' עקיבא בקרא"],"ל ה יטמא רי ש רשות ר ע חובה":["לה יטמא: לה ולא לאיבריה","למה נכתב יטמא אם יש לה","לה יטמא: טומאה לחובה","פרשה שנשנית לדבר שנתחדש","מיעוט לה ולא לאיבריה","יטמא מיותר אחרי לה"],"זנות בבית כתולעת המכרסמת בשומשום":["זנות וכעס בבית כתולעת","שכינה שורה בזכות המעשה","מעשה טוב מלפנים ורע מלפתו","קשורה בו ככלב: ר' אליעזר","הליכה לפניו: מצוה ועבירה","עוה\"ז ועוה\"ב: שכר ועונש"],"ק ו מה עדות הראשונה שאין אוסרתה איסור עו":["שני עדים בסוטה מק\"ו","ועד אין בה: כל שיש בה","בה ולא בקינוי ובסתירה","מק\"ו משתי עדויות","על פי שנים: הקישור לדבר","עדות טומאה דורשת שניים"],"עדות הראשונה זו עדות סתירה עדות אחרונה ז":["עדות ראשונה סתירה ואחרונה טומאה","שתי העדויות: סתירה וטומאה","סדר העדויות בסוטה","עדות סתירה לפני עדות טומאה","הבחנה בין שתי העדויות","אחרונה טומאה ראשונה סתירה"],"מזיגת הכוס וחזרת דקל שיעור אחד הוא":["שיעור כדי שתיית כוס ומזיגה","כדי גמיעה וצלייה: מחלוקת","שיעורי זמן לבדיקת סוטה","כדי לצלות ביצה: שיעור אחד","כדי שיקשור גרדי נימא","שיעור כדי לגמוע שלוש ביצים"],"ואלו אסורות מלאכול בתרומה":["אסורות לאכול בתרומה","הנשים האסורות בתרומה","אשה שאמרה טמאה אני","סוטה נאסרת מאכילת התרומה","מי אסור לאכול בתרומה מן הסוטות","האומרת איני שותה: איסור תרומה"],"והוכיח ממתני דסוטה שיש לה עדים במה י אין":["עדים לסוטה: אין המים בודקין","זכות תולה במים המרים","סוטה שיש לה עדים במדינה","בדיקת המים ועדי שקר","מתנוונת והולכת: מיתה כמותה","לר\"ש ולרבי: זכות תולה"],"ר ש אין זכות תולה במים המרים שאם תולה את":["רשב\"י: אין זכות תולה במים","הוצאת שם רע על הטהורות","למה לא תולים זכות בסוטה","סוטה עם עדים: הוצאת שם רע","רשב\"י על תליית זכות","דחיית המים לפני הנשים"],"ואלו שמנחותיהן נשרפות האומרת טמאה אני וש":["מנחת סוטה: נשרפת או נאכלת","עדים שבאו אחר הקידוש","סוטה בבת מקדש ומקרב","מתי נשרפת מנחת הסוטה","גזירה שמא יוציאו מכלי שרת","זינתה בעזרה: מנחה שנשרפה"],"נטמאת מנחתה עד שלא קדשה בכלי הרי היא ככל":["שלבי מנחה: קידוש, קומץ, שירים","מנחת הסוטה לפי שלב הקידוש","מנחה שטמאה: נשרפת לעומת נאכלת","נמצאו זוממין: מנחה חולין","הספק שכפרה: מנחה כרגיל","קידוש הקומץ והשירים"],"כיצד עושה לה מוליכה לבית דין שבאותו מקום":["שני תלמידי חכמים מלווים הסוטה","מסירת הסוטה לשני תלמידי חכמים","רבי יהודה: בעלה נאמן עליה","שמא יבא עליה בדרך","הליווי לבית הדין בדרך","בית דין מלווה את הסוטה"],"היו מעלין אותה לבית דין הגדול שבירושלים":["הרכב בית הדין הגדול והאזהרה","אזהרת הסוטה בבית הדין","הדברים שאומרים לסוטה לפני השבועה","אם אמרה טמאה אני שוברת כתובתה","לשער המזרח: מקום השקייה","גילוי לבה וסתירת שערה לר' יהודה"],"מעלין לבין דין הגדול שבירושלים":["ועשה לה את כל התורה: שבעים ואחד","בית דין הגדול מכריע בסוטה","על פי התורה: מה להלן כאן","סוטה נידונת בבית דין של 71","שבעים ואחד: גזירה שווה","כל התורה הזאת בבית דין הגדול"],"במדה שאדם מודד בה מודדין לו":["במדה שאדם מודד בה","קישוט לעבירה ונוולה המקום","מידה כנגד מידה בסוטה","גילוי עצמה לעבירה וגילוי מידתה","בירך תחילה: הירך נלקה תחילה","עונש הסוטה: מידה כנגד מידה"],"סוטה נתנה עיניה במי שאינו ראוי לה":["הנותן עיניו במה שאינו שלו","סוטה והנחש: עין על שאינו שלו","מה שביקש לא ניתן לו","מדה כנגד מדה לנחש","כל הנותן עיניו באסור","הקללה לנחש הקדמוני"],"שמשון הלך אחר עיניו לפיכך נקרו פלשתים את":["שמשון ואבשלום: מידה כנגד מידה","עונש לפי מעשה: נקרו עיניו","תלוי בשערו: אבשלום","זכות מרים: המתנה שבע ימים","יוסף זכה לקבור את אביו","כבוד משה בעצמות יוסף"],"שמשון בעיניו מרד ד אותה קח לי כי היא ישר":["שמשון ומרידה בעיניו","תחילת קלקולו של שמשון בעזה","דלילה: שם שמעיד על כוחו","הגיד לה את כל לבו","שכינה נסתלקה ממנו","שמשון ודלילה: גזירת הקלקול"],"ותרא דלילה כי הגיד לה את כל לבו מנא ידעה":["דלילה ידעה שהוא אומר אמת","ויבקע אלהים את המכתש","נבואת יעקב: דן נחש עלי דרך","צרעה ואשתאול: שני הרים","שבועת אבימלך והושעת שמשון","דבר טמא ונתלו חייו בו"],"ותשב בפתח עינים":["פתח עינים: אברהם ומקום הראייה","אברהם וההכרזה על שם ה'","תמר ואברהם: בית חמיה","כל כלה צנועה בבית חמיה","אשל: נטיעה ופונדק","מלכים ונביאים מן הכלה הצנועה"],"כשתבעה א ל שמא נכרית את א ל גיורת אני":["שאלות לאשה: נכרית, פנויה, טהורה","ויטע אשל: פרדס או פונדק","אברהם מקריא שם השם לעוברים","ויחשבה לזונה: כסתה פניה","אשה צנועה בבית חמיה","סימני תמר: מה שאלה ומה ענתה"],"נא בבקשה ממך הכר פני בוראך ואל תעלים עינ":["יהודה: צדקה ממני","יוסף קידש שם בסתר ויהודה בפרהסיא","בת קול: תמר ושני בניה מן האור","הודאת יהודה בתמר","נא: הכר פני בוראך","שם ה' וחסד יהודה ויוסף"],"צדקה ממני מנא ידע יצתה בת קול ואמרה ממני":["מנא ידע: ממני יצאו כבושים","בת קול ונאמנות יהודה","ולא יסף עוד לדעתה","קול גדול ולא יסף","הוכחת יהודה מבת קול","צדקה ממני מתוך בת קול"],"אשר לא ידע את יוסף דהוה דמי כמאן דלא ידע":["אשר לא ידע את יוסף: כמי שלא ידע","פרעה שלא ידע את יוסף","כמאן דלא ידע ליה כלל","מלך שלא ידע את יוסף","ידיעה שאינה ידיעה","אשר לא ידע: פרשנות לשון"],"ויאמר אל עמו הנה עם בני ישראל":["הבה נתחכמה: עצת פרעה","במה נדונם: באש, בחרב, במים","מדוע לקה פרעה תחילה","שלושה באותה עצה: בלעם איוב יתרו","מכת מצרים במים שבדבר זדו","שכינה מורידה: הבה נתחכמה לו"],"ונלחם בנו ועלה מן הארץ ועלינו מיבעי ליה":["ונלחם בנו: כמקלל את עצמו","שרי מסים: לבנים על צוארו","איסטניס: כלום יותר מפרעה","לבנים בצוארו של פרעה","מלכות מצרים ושרי מסים","כאדם שמקלל את עצמו"],"למען ענותו בסבלותם למען ענותו לפרעה בסבל":["ערי מסכנות: העוסק בבנין מתמסכן","פיתום ורעמסס: ראשון מתרוסס","וכאשר יענו: רוח הקודש מבשרתן","למען ענותו בסבלותם","שמות הערים: פיתום ורעמסס","כן ירבה וכן יפרוץ: ביאור הפסוק"],"ויקוצו מפני בני ישראל מלמד שהיו דומין בע":["ויקוצו: דומים בעיניהם כקוצים","קוץ בעיני מצרים","בני ישראל כקוצים במצרים","שנאת מצרים לישראל","קוצים בעיני המצרים","הדמיון לקוצים והשנאה"],"ויעבידו מצרים את בני ישראל בפרך ר א בפה ":["בפרך: בפה רך או בפריכה","החלפת מלאכת אנשים ונשים","זכות הנשים בשאיבת דגים","נשים צדקניות ובשכר הגאולה","עבודת פרך: מחומר ובלבנים","שכר הנשים: ביזת מצרים"],"ותיראן המילדות את האלהים ולא עשו כאשר דב":["מילדות שלא עשו כאשר דבר","תבען לדבר עבירה ולא נתבעו","המילדות: מנע ממקום עבירה","ותיראן המילדות את האלהים","חטא שלא נתבעו עליו","המילדות נתבעו לעבירה"],"ותחיין את הילדים":["ותחיין: מים ומזון לילדים","לא דיין שלא המיתו אותן","המילדות שהספיקו מים ומזון","הצלת התינוקות מלבד הריגה","חיות לילדי ישראל","הגדרת חיים: מזון ומים"],"ותאמרן המילדות אל פרעה כי לא כנשים וגו ח":["לא כנשים: ישראל כחיות","יהודה גור אריה ודן נחש","בני יעקב במשלי חיות","השוואה לבהמות ביעקב","מה אמך לביא: שאלה למילדות","תשובת המילדות לפרעה"],"וכלב בן חצרון וגו בן יפנה הוא בן שפנה מע":["ויעש להם בתים: כהונה או מלוכה","בתי כהונה ולויה: אהרן ומשה","בית דוד ממרים אפרתי","כלב בן יפנה או בן חצרון","עזובה: מרים שכולם עזבוה","הוליד: נשואה לשם שמים"],"ולאשחור אבי תקוע אשחור זה כלב אלא שהושחר":["אשחור זה כלב: פניו שחורות","תקוע: תקע לבו לאביו","חלאה ונערה: מרים כשתי נשים","אשחור אבי תקוע: פירוש שמות","שחור פנים מתעניות","חלאה בתחילה ונערה לבסוף"],"ובני חלאה צרת וצהר ואתנן":["שלוש גזירות פרעה","צרת צהר ואתנן: שמות מרים","עמרם גירש את אשתו","גזרת פרעה על הנקבות","בתו של עמרם משכנעת לחזור","וילך איש מבית לוי: עצת הבת"],"ותרא אותו כי טוב הוא ר מ טוב שמו":["ותרא אותו כי טוב הוא: מחלוקות","בלידת משה נתמלא הבית אור","טוב שמו או טוביה שמו","נולד מהול: מה טוב בו","כי טוב: אור בראשית ומשה","הגון לנבואה: דעת רבי נתן"],"ותצפנהו שלשה ירחים דלא מנו מצרים אלא משע":["שלושה ירחים: ספירה מן ההיריון","מצרים לא מנו מחודש הלידה","היתה מעוברת שלושה חודשים","הצפנה משלוש חודשים","ותצפנהו שלושה ירחים: לפני הלידה","הריון ודין ספירת מצרים"],"ולא יכלה עוד הצפינו אמאי תצפניה ותלך אלא":["מדוע לא יכלה עוד להצפינו","מצרים הביאו תינוקות לשמוע","תיבת גומא: ממונם חביב עליהם","צדיקים שממונם חביב מגופם","שועלים קטנים: סיבת המסתור","תבת גומא ולא כלי אחר"],"ותחמרה בחמר ובזפת":["חמר מבפנים וזפת מבחוץ","שלא יריח צדיק ריח רע","ריח התיבה: סיבת הזפת","חמר וזפת: הסתרת ריח","זפת חיצון וחמר פנים","חמר וזפת: הגנה על התיבה"],"ותשם בה את הילד ותשם בסוף":["תיבה בסוף: ים סוף או אגם","בת פרעה ירדה לרחוץ מגלולי אביה","הליכה לשון מיתה: נערותיה","קנה וסוף קמלו","רחיצה מגלולים ורחיצת בנות ציון","ותרד בת פרעה לרחוץ"],"ותרא את התיבה בתוך הסוף כיון שראו שרוצה ":["מנהגו של עולם: מלך ביתו","גבריאל חבט את המשרתות בקרקע","אמתה: ידה או שפחתה","אישתרבב: מאמה של בת פרעה","נער בכה: האם עשתה לו חופה","בית העברים והחופה בתיבה"],"ויספדו שם מספד גדול וכבד מאד":["עשו מעכב בקבורת יעקב","ארבע זוגות בקבר המכפלה","בקברי אשר כריתי לי: מכירה","חושים בן דן ואוזניו כבדות","נפתלי שקל כאילה","ויספדו מספד גדול: סוסים וחמורים"],"וישראל גם התעסקו בו ד ואת עצמות יוסף אשר":["עצמות יוסף: קבורה בשכם","העושה דבר ולא גמרו כאילו עשאו","מפני מה נקרא יוסף עצמות","מדוע מת יוסף לפני אחיו","הנהיג עצמו ברבנות","הוריד: איצטגניני פרעה"],"ויאמר אליהם בן מאה ועשרים שנה אנכי היום ":["בן מאה ועשרים: השלמת השנים","את מספר ימיך אמלא","היום מלאו ימי ושנותי","השלמת ימי צדיקים מיום ליום","שנותיו של יעקב נשלמו ליום","צדיקים מחדש לחדש"],"לא אוכל עוד לצאת ולבא בדברי תורה שנסתתמו":["לא אוכל לצאת ולבא: שערי חכמה","שתים עשרה מעלות משה בפסיעה","נסתתמו שערי חכמה ממשה","משה בן מאה ועשרים לא נס ליחה","ערבות מואב ומעלות הר נבו","לצאת ולבוא בדברי תורה"],"וילך משה ויהושע ויתיצבו באהל מועד":["משה ויהושע באהל מועד","היכן משה מת ונקבר","משה מוטל בכנפי השכינה","ספרא רבה דישראל: וימת משה","רשות זוגי לזה ולזה","מי הוליך את משה לקבורה"],"כדי ליגעה שתחזור בה אם ככה חסה תורה על ע":["מחיקת המגילה: לא תימחק משקה","חסה תורה על עוברי רצונו","מגילה נמחקה: הקרבה אחר המשקה","כדי ליגעה שתחזור בה","ק\"ו מעוברי רצון לעושי רצון","משקה ואחר כך מנחה"],"ונותנה לתוך כלי שרת לקדשה בכלי שרת":["לקדשה בכלי שרת: שמן ולבונה","ויצק עליה שמן ונתן לבונה","הבאה אל הכהן אל המזבח","מוליכה לכהן ואל המזבח","נותן שמן ולבונה על המנחה","שמן ולבונה מן הכלי"],"מגישה בקרן דרומית מערבית כנגד חודה של קר":["הגשה בקרן דרומית מערבית","לפני ה' ואל פני המזבח","שני מקראות: מקיים ומבטל","הגשה לדרומה של קרן","המזבח בצפון עומד","הקרבה בקרן: מחלוקת ר' אליעזר"],"היה מביא פילי של חרס ונותן לתוכה חצי לוג":["פילי חרס ומים מן הכיור","חצי לוג או רביעית מים","עפר מן המשכן על המים","טבלא של שיש וטבעת במקדש","כשם שממעט בכתב ממעט במים","עפר המשכן נתון במים"],"פילי של חרס חדשה דגמר כלי כלי ממצורע דחר":["כלי חרס חדשה: גזירה שווה מצורע","מים חיים ומים מכיור","כלי שלא נעשתה בו מלאכה","פילי של חרס שלא נתאכמו פניו","כלי שלא נשתנה כמים שלא נשתנו","מי כיור: מי מעיין או משאר מים"],"בא לו לכתוב את המגילה מאיזה מקום הוא כות":["מה כותב הכהן בסדר הקללה","אמן אמן: האם כותבת בפסוקים","רבי יוסי: לא היה מפסיק","כתיבת האלה ובאו המים המאררים","כל עצמו אינו כותב אלא","בסדר כתיבת מגילת הסוטה"],"וכתב את האלות האלה הכהן בספר":["האלות: ריבוי ומיעוט לקללות","אלה ואלות ומה שנדרש מהם","ה\"י מרבה וה\"י ממעטת","הנקי כתיב: איש ואשה","שכינה בין איש לאשה","עפר לסוטה: מזכה בבן כאברהם"],"אינו כותב לא על הלוח ולא על הנייר ולא על":["הכתיבה על המגילה ולא על הנייר","בדיו ולא בקנקנתום","ומחה: כתב שיכול למחות","אין כותבים בלוח ובדיפתרא","בדיו: כתב שניתן למחות","לא בקומוס ולא בקנקנתום"],"מגילת סוטה שכתבה בלילה פסולה דאתיא תורה ":["מגילת סוטה שנכתבה בלילה","כתיבה למפרע או לפני השבועה","שני דפים: ספר אחד בלבד","אות אחת שנמחקה: פסולה","כתבה איגרת פסולה","תורה תורה: משפט ביום"],"כתב ב מגילות לב סוטות ומחקן לתוך כוס אחד":["שתי מגילות לשתי סוטות","מחיקה בשני כוסות וערבוב","כלי אחד או שני כלים","ברירה בחלוקת המים","יש ברירה: תיקו","מחיקה לשמה בשני כוסות"],"על מה היא אומרת אמן אמן":["על מה האשה אומרת אמן","אמן שלא נטמאתי ואם נטמאתי","ר\"מ: אמן שלא אטמא","אמן על האלה ועל השבועה","אמן מאיש זה ומאיש אחר","אמן שלא שטיתי"],"שומרת יבם שזינתה אסורה ליבמה מדתני שומרת":["שומרת יבם שזינתה","כלל: מי שתיבעל ולא נאסרה","אין הלכה כרב המנונא","מתנה על נישואין ראשונים","שומרת יבם וכנוסה: מתנה","ארוסה ונשואה: מתנה מותרת"],"מנחת סוטה שטעונה תנופה ד והניף":["מנחת סוטה טעונה תנופה","והניף: תנופה בבעלים","יד יד משלמים: תנופה","תנופה בבעלים ולא בכהן","מנחה שטעונה תנופה ביד הבעלים","תנופה לא בכהן"],"עד שלא נמחקה המגילה אמרה איני שותה":["מגילה נמחקה ואמרה איני שותה","מגילה נגנזת ומנחה מתפזרת","עד שפניה מוריקות ועיניה בולטות","בן עזאי: לימוד התורה לבת","ר' אליעזר: לימוד בת תפלות","רוצה אשה בקב ותפלות"],"כשלמדתי אצל ר ע הייתי מטיל קנקנתום לדיו ":["קנקנתום לדיו: נסיון רבו","שמא תחסיר או תתיר אות","זבוב שמחק דלי\"ת ויצר רי\"ש","מחילה בכתיבה: גזירה ואיסור","לבלר שמלאכתו מלאכת שמים","ר' עקיבא אסרה עליו"],"ירא את ה בני ומלך ועם שונים אל תתערב אלו":["ירא את ה' בני: שונים הלכות","אל תתערב עם שונים","חכמים שאינם שונים בחטא","הותרה לו התנאים בשעת עבירה","לא שונין בחטא","שמורין הלכה מתוך משנתן"],"ר ש אין זכות תולה במים המרים שאם תולה מד":["רשב\"י: אין זכות תולה במים","רבי: זכות תולה במים המאררים","כהנת שנשאת לישראל: מנחה נאכלת","בת ישראל לכהן: מנחה נשרפת","כהן וכהנת: הבדלי מנחה וטומאה","מי שנשואה לכהן מנחתה נשרפת"],"ר מ ר יוסי ורי ה ר א ור אליעזר ס ל דאין ":["אין שני עושה שלישי בחולין","שני מטמא לקודש ושלישי מטמא","מטמא שנים ופוסל אחד בקודש","חלה מן הטהורה על הטמאה","שלישי בתרומה ורביעי בתרומה","אוכל ראשון שני ושלישי בקודש"],"כי מצא בה ערות דבר ולא בקינוי ולא בסתירה":["עד אחד בטומאה בלא סתירה","ערות דבר: שני עדים","דבר דבר: מה להלן כאן","בלא קינוי ובלא סתירה","עדות טומאה דורשת שני עדים","כי מצא בה ערות דבר בשניים"],"פרשת סוטה בכל לשון":["פרשת סוטה בכל לשון","ואמר הכהן לאשה: בכל לשון","הכהן אומר בכל לשון שהוא","לשון הקודש ולשון אחרת","שמיעה בכל לשון","קריאה בכל לשון"],"משמיעין אותה בכל לשון ששומעת":["משמיעין בכל לשון ששומעת","על עסקי קינוי וסתירה היא שותה","במקידה של חרש","על מה היא נטמאת: שחוק וילדות","שלא להוציא לעז על המים","בשוגג או במזיד"],"כיצד עברו ישראל את הירדן":["כיצד עברו ישראל את הירדן","הארון נשאו הכהנים בירדן","בכל יום לויים נשאו את הארון","כפות רגלי הכהנים נושאי ארון","הארון נשא יום אחד כהנים","לויים נשאו את הארון"],"בשלשה מקומות נשאו כהנים את הארון":["שלושה מקומות שנשאו הכהנים את הארון","כשניטבלו רגלי כהנים חזרו המים","המים היורדים מלמעלה קמו נד אחד","שלוש פעמים נשאו הכהנים","בכניסת יריחו","החזרת הארון למקומו"],"וכמה גובהן של מים ר י י ב מיל על י ב מיל":["גובה המים בירדן שלוש מאות מיל","י\"ב מיל על י\"ב מיל כנגד מחנה ישראל","מים קלים או מים נגדשים","רחב הזונה ושמיעת מי ים סוף","וימס לבבם: מלכי האמורי והכנעני","כיפין על גבי כיפין"],"עודם בירדן אמר להם יהושע דעו על מה אתם ע":["יהושע: על מה אתם עוברים את הירדן","להורישם: אם לאו באין מים","עודם בירדן: תנאי ההורשה","והורשתם את כל יושבי הארץ","שטיפת המים אותי ואתכם","אם לאו באין מים ושוטפין"],"עודם בירדן אמר להן יהושע הרימו לכם איש א":["הרימו לכם איש אבן אחת","אבן לכל שבט לאות לבנים","למען תהיה זאת אות בקרבכם","שתים עשרה אבנים מירדן","אבן על שכם לכל שבט","סימן לבנים שעברו אבות"],"עודם בירדן אמר להן יהושע שאו לכם מזה מתו":["אשכול: שמונה נשאו ואחד נשא","אבנים מתוך הירדן ללון בהן","שיעור האבן ארבעים סאה","אשר תלינו בו הלילה: מלון אחד","יהושע וכלב לא נשאו כלום","משאוי על שנים: חישוב המשא"],"ויחפרו לנו את הארץ רחב א מרגלים לא נתכוו":["ויחפרו לנו את הארץ: בושת הארץ","מרגלים נתכוונו לבושת ארץ ישראל","וחפרה הלבנה ובושה החמה","מרגלים לבושת הארץ","חפירה כחמה ולבנה","ויחפרו: לשון בושה"],"ואלה שמותם למטה ראובן שמוע בן זכור רי צ ":["שמות המרגלים מסורת מאבות","סתור: מי שסתר את מעשי ה'","נחבי ופסי: החביא ופיסע","מיכאל שעשה עצמו מך","מרגלים נקראו על שם מעשיהם","אחד בלבד מן המרגלים נשאר"],"ויעלו בנגב ויבא עד חברון ולא ויבואו":["כלב פירש מעצת המרגלים","כלב השתטח על קברי האבות","ויבא עד חברון: לא ויבואו","יה יושיעך מעצת מרגלים","רוח אחרת עמו: עקב כלב","כלב נשתטח על קברי האבות"],"ושם אחימן מיומן שבאחיו":["אחימן ששי ותלמי: שמות ענק","ששי משמש את הארץ כשחתות","תלמי שמשים את הארץ תלמים","אחימן בנה ענת","שמות בני ענק לפי מעשיהם","בניית ענת ואלש ותלבוש"],"וחברון שבע שנים נבנתה מבונה בפירות על אח":["חברון נבנתה שבע שנים לפני צוען","טרשים בחברון: קבורת הנפטרים","אילים ממואב וכבשים מחברון","אבשלום הלך להביא כבשים","חברון קרקע קלושה ורועה","מדוע מבונה חברון לפי צוען"],"ויספרו לו ויאמרו באנו וגו וכתיב אפס כי ע":["כל לה\"ר שאין בו אמת לא יתקיים","ויהס כלב את העם: מסית בדברים","שרואים את הסולמות ורקיע","בגנותו של משה מדברים","חשבתיה לטובה: מיתה כדי שלא ישאלו","חזק הוא ממנו: אין מוציא כליו"],"ועל דבר זה נענש עוזא דוישלח עוזא את ידו ":["עוזא נענש על נגיעה בארון","שעשה צרכיו בפני הארון","אם על עסקי שלו שגגה","ויחר לדוד על פרץ בעוזא","ארון קיים לעולם ועוזא לעוה\"ב","נשתנו פניו כחררה"],"מפני מה נענש דוד מפני שקרא לדברי תורה זמ":["מפני מה נענש דוד","זמירות היו לי חוקיך","התעיף עיניך בו ואיננו","לבני קהת: הכשלה בעגלה","הריני מכשילך בדבר ידוע","מה שביקש דוד לקרוא זמירות"],"צרעה לא עברה עמהם והך ד ושלחתי את הצרעה ":["צרעה לא עברה עם משה","צרעה של יהושע עברה","שתי צרעות: משה ויהושע","על שפת ירדן זרקה מרה","סימתה עיניהן וסירסתן","שני צרעות לפני משה ויהושע"],"ותתפשהו בבגדו לאמר וגו באותה שעה באתה די":["דיוקנו של יעקב בחלון","יוסף אבני אפוד ורועה זונות","ותשב באיתן קשתו","אביך מציל מלפני זנות","ותתפשהו בבגדו לאמר","מי שמחק שמו מאבני אפוד"],"ויפוזו זרועי ידיו נעץ ידיו בקרקע ויצאה ש":["ויפוזו זרועי ידיו: נעץ ידיו בקרקע","יצאה שכבת זרע מציפורני ידיו","זרע יוסף נשפך בציפורניו","שיצא שפיכת זרע מאצבעות","נעץ ידיו בקרקע לאות","זרועות ידיו נפוזו"],"מידי אביר יעקב מי גרם לו שיחקק על אבני א":["מידי אביר יעקב","אביר יעקב שחקק על אבני אפוד","מי גרם לו שיחקק","אביר יעקב עשה לו זכות","שם יעקב מסייע ליוסף","מי חקק על האבנים"],"משם רועה אבן ישראל משם זכה ונעשה רועה":["משם רועה אבן ישראל: יוסף","שפיכת זרע מציפורני יוסף: בנימין","בני בנימין ושמותיהם","בלע, בכר, אשבל: סימני בנימין","איצטגניני פרעה: גנוני מלכות","שבטי בנימין נקראו על שמו"],"ברכת כהנים כיצד":["ברכת כהנים במדינה ובמקדש","השם ככתבו במקדש","כ\"ג מגביה ידיו מעל הציץ","כהנים נושאים ידיהם על ראשיהם","כהנים במקדש ע\"ג ראשיהם","ברכה אחת במקדש"],"כהנים שנים ולא אחד ד אמור להם לשנים":["כהנים שנים ולא אחד","כהן כהנים ולא ישראל","אמור להם: לשנים","הכהנים ישראל","אמירה משלהם תהא","כהנים שנים בברכה"],"בית הכנסת שכולה כהנים כולן עולין לדוכן":["בית כנסת שכולה כהנים","למי מברכים: לאחיהם שבשדות","שאחורי כהנים אינן בכלל ברכה","כהנים עולים לדוכן ומקצתן עונים אמן","כשיש יותר מעשרה","ברכה לאחיהם שבשדות"],"כיון שנפתח ספר תורה אסור לספר אפילו בדבר":["בפתיחת ספר תורה אסור לדבר","כי עמדו לא ענו עוד","כהן שלא נטל ידיו לא ישא כפיו","ואזני כל העם אל ספר התורה","שאו ידיכם קדש","כהן לא נטל ידיו"],"ברכות כהן גדול כיצד חזן הכנסת נוטל ספר ת":["ברכות כהן גדול במועד","כ\"ג קורא ומברך שמונה ברכות","ספר תורה מעביר חזן עד כ\"ג","גלילת התורה בחיקו","על המקדש ועל ירושלים","שמונה ברכות לפני הקריאה"],"וגולל את התורה ומניחה בחיקו כו שלא להוצי":["גלילה והנחה בחיק לא להוציא לעז","שלא להוציא לעז על ספר תורה","גוללה ומניחה בחיקו","גוללה ומניחה בחיק: טעם הדבר","לעז על ס\"ת ותיקון הגלילה","גלילה ככבוד"],"פרשת המלך כיצד מוצאי יום טוב הראשון של ח":["פרשת המלך במוצאי שביעית","אגריפס עמד וקרא עומד","מלך יושב על בימה של עץ","אחינו אתה: אגריפס הבוכה","תחילת פרשה: אלה הדברים","נותן של רגלים תחת מחילת העון"],"בשנה שמינית וצריכי מקץ בסוף שמיטה ולא כל":["שנה שמינית: מקץ ושמיטה","מועד בתחילתה ולא בראשה","בבא כל ישראל: תחילת המועד","בחג הסוכות ולא בראשה ממש","דרשת מקץ שבע שנים","ומועד שיהא בתחילתה"],"ודבר ולהלן משה ידבר והאלהים יעננו בקול ב":["ודבר בלשון הקודש","הכהן הממונה ודברו השוטרים","כהן גדול וסגן: ממונה על גביו","נגש הכהן ודבר: הממונה","ממונה ודווקא","שוטר ממונה על גביו"],"ויגש הפלשתי השכם והערב רי ו כדי לבטלן מק":["ויגש הפלשתי: כדי לבטל קריאת שמע","השכם והערב: ביטול קריאת שמע","ביטול שחרית וערבית","כדי לבטלן מקריאת שמע","השכם והערב: אומר יום יום","ביטול תפלה לשם מלחמה"],"ויתיצב ארבעים יום רי ו כנגד ארבעים יום ש":["ויתיצב ארבעים יום: כנגד מתן תורה","גלית ארבעים יום כנגד התורה","ארבעים יום שנתנה בהם תורה","ארבעים יום בתורה","ארבעים יום להתייצב","איש הענק ומתן תורה"],"ויצא איש הבינים רב שמבונה מכל מום ושמואל":["איש הבינים: מבונה מכל מום","בינוני שבאחיו","עשוי כבנין","ממאה אנשים ומאב אחד","איש הבינים בדרשה","איש הבינים: שם הענק"],"וגלית שמו מגת תני רב יוסף שהכל דשין את א":["גלית שמו מגת: דשין את אמו","שהכל דשין את אמו כגת","גת: דישה באם הגבור","דרשה בשם גלית","גת כשם מקום הדישה","מדוע נקרא גלית מגת"],"מערות וקרינן מערכות תני רב יוסף שהכל הער":["ערפה והרפה: שמות האם","מערות וקרינן מערכות","שהכל עורפין אותה מאחריה","ארבעת הרפאים בגת","ואת ארבעת אלה יולדו להרפה","הרפה שמה ונקראה ערפה"],"ויפלו ביד דוד וביד עבדיו ד ותשק ערפה לחמ":["ארבע דמעות של ערפה","יבואו בני הנשוקה ויפלו","שבח רשע: אסור לספר","חץ חניתו: הודעת שבחו של דוד","ותשאנה קולן ותבכינה","מדוע לא פותחים בשבח רשע"],"מי האיש אשר בנה בית חדש ולא חנכו ילך ויש":["מי שבנה בית חדש ולא חנכו","אחד הבונה בית התבן","מי שנטע כרם ולא חללו","מי שארש אשה ולא לקחה","חוזרים מן המלחמה ומתקנים דרכים","הבונה בית שער אכסדרה ומרפסת"],"ויספו השוטרים דברים של עצמן":["כהן מדבר ושוטר משמיע","ויספו השוטרים: דברים של עצמן","דברי משוח מלחמה","הכהן מדבר והשוטר משמיע","בשלושה חלקי הדברים","שוטר מדבר ושוטר משמיע"],"ואלו שאינן חוזרין הבונה בית שער כו":["הוסיף דימוס אחד: חוזר","בית לבנים בשרון אינו חוזר","מחדשים אותו פעמים בשבוע","בונה בית שער אינו חוזר","בונה בית לבנים בשרון","דימוס ומחדשים"],"ויספו השוטרים לדבר אל העם וגו":["הירא ורך הלבב: כמשמעו","מתיירא מן העבירות שבידו","זה אלמנה לכהן גדול","שילוח הזקיפים בעקיבי העם","מי שמבקש לחזור: קפיח שוקיו","מלחמת רשות ומלחמת מצוה"],"בין ר י לריה ג עבירה דרבנן":["שח בין תפילה לתפילה","שמע קול קרנות והרתיע","צחצוח חרבות: חוזר","ולא ימס את לבב אחיו","מחלוקת בתפילה: עבירה דרבנן","עבירה דרבנן: שיחה בין תפלות"],"ד וענו ואמרו ולהלן וענו הלוים ואמרו וגו ":["וענו ואמרו בלשון הקודש","סדר עגלה ערופה: כי ימצא חלל","וענו הלוים ואמרו","זקניך ושופטיך במדידה","בכל לשון בתורה: לה\"ק","בלה\"ק כמו ביתר הפרשה"],"שני חללים זה על גבי זה מהיכן הוא מודד":["שני חללים זה על גבי זה","מין במינו טמון וצף","מודדין מעליון או מתחתון","עומר שהחזיק והניחו על חבירו","חלל בשדה ולא צף על המים","מחלוקת על מין במינו"],"נמצא סמוך לספר או לעיר שרובה ע ז ד כי ימ":["נמצא סמוך לספר או לעיר ע\"ז","כי ימצא פרט למצוי","עיר שאין בה בית דין","מודדים רק לעיר שיש בה ב\"ד","זקני העיר ההיא","ודרשו כי ימצא"],"נמצא מכוון בין שתי עיירות ר א שתיהן מביא":["נמצא מכוון בין שתי עיירות","ראשו במקום אחד וגופו במקום אחר","מודדין מטיבורו או מחוטמו","ירושלים אינה מביאה עגלה","מוליכין הראש אצל הגוף","מודדים מחוטמו"],"נפטרו זקני ירושלים והלכו להן":["זקני העיר רוחצים ידיהם","ידינו לא שפכו את הדם הזה","נחל איתן: עריפת העגלה","ומקומה אסור לזרוע ולעבוד","אם לא ליוו ולא הוציאו","כפר לעמך ישראל"],"ועורפין אותה בקופיץ מאחוריה עריפה עריפה ":["עריפה כחטאת העוף","ועורפין אותה בקופיץ מאחוריה","הדמיון בין עריפת עגלה לחטאת העוף","קופיץ מאחור","מעשה עריפת העגלה"],"במה הראה להם חזקיה בפיו עקם להם רי ו באצ":["במה הראה להם: בפיו או באצבע","בשביל שכנעני זה הראה","לויה לדרך: הלומד בדרך","ד' פסיעות שלוה פרעה לאברהם","ליווי ד' אמות בעיר","ליווי תלמיד לרב ורבו מובהק"],"ויפן אחריו ויראם ויקללם בשם ה":["ויפן אחריו ויקללם בשם ה'","קללת בלעם: ראה ממש","כל מקום שחכמים נתנו עיניהם","ארבעים ושנים ילדים שהובקעו","עשה לשמה: בלק ורות","ארבעים ושנים קרבנות בלק"],"הנה נא מושב העיר טוב כאשר אדוני רואה וגו":["ג' חינות: מקום אשה ומקח","חן מקום על יושביו","הנה נא מושב העיר טוב","חן אשה על בעלה","שלשה חלאין חלה אלישע","שמאל דוחה וימין מקרבת"],"נמצא ההורג עד שלא נערפה העגלה תצא ותרעה ":["נמצא ההורג אחר ערפת העגלה","עד אחד ראה והשני לא ראה","אשה אומרת ראיתי ואשה לא ראתה","משרבו הרוצחנין בטלה עגלה","תחינה בן פרישה: בן הרצחן","עד שלא נערפה: תצא ותרעה בעדר"],"מנין שאם נערפה העגלה ואח כ נמצא ההורג שא":["ולארץ לא יכופר לדם","אם נערפה העגלה ואחר נמצא ההורג","ההורג שאין העגלה פוטרת","דם שפך בה כי אם בדם שפכו","לא יכופר לדם בלא הורג","ההורג אינו נפטר בעגלה"],"משמת יוסי בן יועזר כו אשכולות ריא ש היינ":["אשכולות: איש שהכל בו","משמת יוסי בן יועזר איש צרידה","בטלו האשכולות","איש שהכל בו: ריא\"ש","האשכולות בטלו מן העולם","אשכול לאכול בכורה"],"עד ימיו היה פטיש מכה בירושלים בחולו של מ":["פטיש מכה בירושלים כל ימיו","כל ימיו לא שאל אדם על הדמאי","בחולו של מועד","ימיו של יוסי פטיש ודמאי","בחולו של מועד הפטיש","דמאי לא נשאל"],"משבטלה סנהדרין בטל השיר מבית המשתאות בשי":["משבטלה סנהדרין בטל השיר","בטלו אורים ותומים במות הנביאים","שמיר ונופת צופים בחורבן","ניטל טעם הפירות","הטהרה נטלה את הריח","הזנות והכשפים כילו הכל"],"משבטלה סנהדרי רהבדר י זקנים משער שבתו בח":["זמר בבית סופו חרב","חורבן מתחיל בסף הדלת","זמר ספינות ורועי שוורים","ארבעה מיני זמר מביאים חמש פורענויות","זמר גברי ועניית נשים","אווזים בזוז: ביטול זמר"],"בפולמוס של אספסיינוס גזרו על עטרות חתנים":["גזירות אספסיינוס על חתנים","בפולמוס של טיטוס: עטרות כלות","משמת ר\"מ בטלו מושלי משלים","משמת בן עזאי בטלו השקדנים","משמת רבן יוחנן בן זכאי בטל זיו החכמה","משמת רבי בטל ענוה ויראת חטא"],"דווקא עטרות של מלח וגפרית אבל של הדס ושל":["עטרות של מלח וגפרית","עטרות הדס וורד מותר או אסור","עטרות של קנים וחילת","עטרות החתן: הדס וורד","הדס וורד בעטרות","עטרות של הדס ושל וורד"],"בפולמוס האחרון גזרו שלא תצא כלה באפריון ":["כלה באפריון משום צניעות","בפולמוס האחרון: לא תצא כלה באפריון","גזירת האפריון בעיר","צניעות הכלה ביציאה","אפריון בתוך העיר: גזירה","בטלה יציאת כלה באפריון"]}