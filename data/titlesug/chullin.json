{"שחיטת כותי מותרת בד א כשישראל עומד על גב":["כותי ששחט - הדין כשישראל עומד על גביו","שחיטת כותי בעומד על גביו","בא ומצאו ששחט - חותך כזית","יוצא ונכנס בשחיטת כותי","כותי שחט ואכלו מותר","מצא צפרים קשורות - קוטע ראשו"],"א ין עו ד מ ל ב ד ו ואפי כשפים":["ר' חנינא ואשה המכשפת","כישוף - מכחיש את פמליא של מעלה","אין אדם נוקף אצבעו בלי רשות","דם ניקוף מרצה כדם עולה","זכותו של ר' חנינא","מדוע נקרא כישוף מה"],"בהמה בחייה בחזקת איסור עומדת עד שיודע לך":["נשחטה - הותרה, נטרפה - ספק","נקב שנעשה אחרי הזאב","ספק נקב - חוששין או לא","סכנה לעומת איסור בספק","ספק טומאה ברשות הרבים","ספק סכנה לחומרא, ספק איסור"],"מנא הא מילתא דאמור רבנן זיל בתר רובא ד א":["הלך אחר הרוב - ודקויים","נקב קרום מוח - ביטול הרוב","שבירת עצם בפסח והרוב","חוט השדרה והרוב בנתיחה","רוב מול חזקה ונתיחת העולה","מתי לא הולכים בתר רובא"],"שחיטת עכו ם נבלה ומטמאה במשא":["שחיטת עכו\"ם - האם חשש למין","מין ושחיטתו לעבודה זרה","סתם מחשבת עכו\"ם לעבודה זרה","שחיטת מין נאסרת כעבודה זרה","נכרי בחוצה לארץ אינו עובד","עכו\"ם מקבל קרבן - מכם ולא כולכם"],"ארחב א מרי ו דלא כר א דאמר דסתם מחשבת עכ":["שחיטת עכו\"ם נבלה ולא מין","מין ושחיטתו לעבודה זרה","סתם מחשבת עכו\"ם לעבודה זרה","שחיטת מין כעבודה זרה","נכרי בחוצה לארץ אינו עובד","הנדרים והנדבות של עכו\"ם"],"השוחט בלילה וכן הסומא ששחט שחיטתו כשרה":["שחיטה בלילה ובסומא","דיעבד כשר, לכתחילה אסור","שוחטין בלילה כשיש שאבוקה","השוחט בלילה - דיעבד כשר","הכל שוחטין ביום ובלילה","שחיטה בראש הגג ובספינה"],"השוחט דיעבד אין לכתחלה לא":["השוחט בלילה - לכתחילה לא","שחיטה בשאבוקה כנגדו","שחיטת סומא דומיא דיום","הכל שוחטין בלילה","שחיטה בראש הספינה","דיקא דומיא דסומא"],"השוחט בשבת וביום הכיפורים אע פ שמתחייב ב":["שחיטה בשבת ויום הכיפורים","מה שלא הוכן מאתמול אסור","ר' יהודה - הכנה לכלבים","נבלה לכלבים מערב שבת","ברירה בשחיטה ביום טוב","בהמה לאכילה או לגידול"],"אר ה דרש חייא ב ר אסורה באכילה ליומא ונס":["בהמה בחייה - לאכילה או לגידול","אסורה ליום לפי ר' יהודה","מוכן לאדם מול מוכן לכלבים","אין ברירה לר' יהודה","שחיטה ביום טוב והובררה","מנא לן שאין ברירה לר' יהודה"],"השוחט במגל יד בצור ובקנה שחיטתו כשרה":["שוחטין בכל חוץ מחונקין","מגל קציר, שיניים וציפורן פסולין","שחיטה בצור ובקנה - כשרה","החונקין אינם שחיטה","מגל יד ומגל קציר","הכל שוחטין - הכל בשחיטה"],"השוחט דיעבד אין לכתחלה לא בשלמא במגל יד ":["שחיטה במחובר לקרקע","רבי פוסל, ר\"ח מכשיר בדיעבד","תלוש וחיברו - יישוב הסתירה","סכין למעלה וצואר למטה","השוחט מחובר - נחלקו רבי ור\"ח","בכל שוחטין, אף בתלוש ובמחובר"],"הכל שוחטין ולעולם שוחטין":["לעולם שוחטין - ר' ישמעאל ור\"ע","בשר תאווה לאחר הגלות","מקום המשכן ובשר נחירה","לעולם שוחטין ואוכלין","רחוקים מהמשכן - שחיטה ללא קרבן","כי ירחיב ה' את גבולך - פירוש"],"השוחט במגל קציר בדרך הליכתה ב ש פוסלין ו":["מגל קציר בדרך הליכתה","ב\"ש פוסלין, ב\"ה מכשירין","החלקת שיניה - כסכין","מגל קציר - מחלוקת בית שמאי והלל","שיני מגל קציר שהחליקו","שחיטה במגל קציר"],"ארחב א מרי ו אף כשהכשירו ב ה לא הכשירו א":["מכשירין לטהרה ולא לאכילה","פוסלין ומכשירין - דבר אחד","ב\"ה מכשירין מנבלה בלבד","דקדוק הלשון במחלוקת בית הלל","כשרות שחיטה ואיסור אכילה","מגל קציר - טהרה בלבד"],"השוחט מתוך הטבעת ושייר בה מלא החוט על פנ":["שחיטה מתוך הטבעת - חוט על הקנה","מלא חוט על פני כולה","שחיטה בטבעת ושייר בה חוט","טבעת - רוב החוט על הקנה","ר' יוסי בר' יהודה בטבעת","שחיטה בתוך טבעת הסכין"],"רב ושמואל דאמרי תרוייהו הלכה כר יוסי בר ":["הלכה כר' יוסי בר' יהודה","טבעת גדולה ולא שאר טבעות","מוגרמת כשרה לר' חנינא","יוסף בר חייא ורב יוסף בספיקי","רב ושמואל ומוגרמת דרב יהודה","ריב\"י תרתי קאמר - בטבעת ובמוגרמת"],"השוחט מן הצדדין שחיטתו כשרה המולק מן הצד":["שחיטה מן הצדדין ומן העורף","כשר בשחיטה פסול במליקה","שחיטה מן הצואר - כשרה","מליקה מן העורף כשירה","עורף ושחיטה - מקומות החיתוך","כל העורף כשר למליקה"],"עורף ממול עורף כדקתני סיפא כל העורף כשר ":["מצות מליקה - מחזיר סימנים","ממול עורף - מול הרואה","אף מחזיר לאחורי העורף","יקבלו הרובין את תשובתן","למעוטי שן וצפורן ומוליך","מחזיר סימנים בזמן מליקה"],"כשר בתורין פסול בבני יונה כשר בבני יונה ":["תורין ובני יונה - גדולים וקטנים","כשר בתורין פסול בבני יונה","תחילת הציהוב פוסלת בתור ובן יונה","כשרות יונים לפי גודלן","הציהוב כפסילה לתור ולבן יונה","נמצא כשר בתורין פסול ביונה"],"ת ר תורין גדולים כשרים קטנים פסולים בני ":["ריבוי התורים ולא מיעוטם","ק\"ו מבני יונה לתורים","תורים כשרים משיזהיבו","בני יונה פסולים עד שיצהיבו","יעקב קרחה - מתי כשרים בני יונה","מדרש התורים לפי הזהוב"],"כשר בפרה פסול בעגלה כשר בעגלה פסול בפרה":["פרה בשחיטה ועגלה בעריפה","ושחט וחוקה - לא קל וחומר","ערפו העגלה בעריפה ולא בשחיטה","כשר בפרה פסול בעגלה","עגלה ערופה - השם אינו עושה חטאת","מדרשי פרה ועגלה בשחיטה"],"ת ר פרה בשחיטה כשרה בעריפה פסולה עגלה בע":["פרה אדומה ועגלה ערופה","שחיטת פרה מול עריפת עגלה","לא לגזור קל וחומר מעגלה","ועשאו חטאת - השם אינו עושה","ערפו בעריפה ולא בשחיטה","נמצא כשר בעגלה פסול בפרה"],"כשר בכהנים פסול בלוים כשר בלוים פסול בכה":["כהנים במומין, לוים בשנים","כשר בכהנים פסול בלוים","שנים פוסלין בלוים בלבד","זאת אשר ללוים - מדרש","לוי מבן חמישים שנה","מומין פוסלים בכהנים בלבד"],"ת ר כהנים במומין פסולים בשנים כשרים לוים":["מומין פוסלין בכהנים, שנים בלוים","כהנים לעבודה - ולא מן המשא","ת\"ל אשר ללוים, לא לכהנים","שילה ובית עולמים - מה הדין","לא אמרתי אלא בזמן שהעבודה בכתף","מדרש הלוים שנפסלים בשנים"],"טהור בכלי חרש טמא בכל הכלים טהור בכל הכל":["כלי חרש טמא, כל הכלים טהורים","טהור בכלי חרש טמא בכל הכלים","תוכו טמא אפילו שלא נגע","טומאת תוך כלי חרש","כלי חרס - דין טומאה באוויר","כלי חרש ומדרש תוכו"],"ת ר אויר כלי חרש טמא וגבו טהור אויר כל ה":["אויר כלי חרש טמא וגבו טהור","כלי חרס מיטמא מאוירו","צמיד פתיל ומטמא מאוירו","ק\"ו לכלי חרס מגבו","תוכו האמור לטמא אפילו שלא נגע","ר' יונתן - אפילו מלא חרדל"],"טהור בכלי עץ טמא בכלי מתכות טהור בכלי מת":["כלי עץ טמא, כלי מתכות טהור","טהור בכלי עץ טמא במתכות","גולמי כלי עץ וגולמי כלי מתכות","חסר חטיטה - טהור","כלי עץ עשוי לשוף ולשבץ","כלי מתכות מחוסר כיסוי"],"ת ר גולמי כלי עץ טמאין פשוטיהן טהורין גו":["גולמי כלי עץ טמאים","מחוסר כן או אוזן - מיטמא","כלי עצם ככלי עץ או מתכות","ר\"י ורב נחמן בכלי עצם","מדרש וכל מעשה עזים","הואיל ולכבוד עשויין"],"החייב בשקדים המרים פטור במתוקים החייב במ":["שקדים מרים ומתוקים - חיוב ופטור","החייב במרים פטור במתוקים","גדולים מחייבים במתוקים בלבד","שקדים קטנים וגדולים בתרומה","זה וזה לפטור או לחיוב","שקדים - ההלכה לפי ר' חנינא"],"ת ר שקדים המרים קטנים חייבין גדולים פטור":["זה וזה לפטור - ריב\"י מאביו","גדולים ראויים לתיקון באור","הורה ר' חנינא בציפורי","שקדים מרים - חיוב או פטור","מחלוקת על שקדים מרים ומתוקים","שקד מר שחזו למתיקות"],"התמד עד שלא החמיץ אינו ניקח בכסף מעשר ופ":["תמד לפני החמצה - אינו נקנה במעשר","משהחמיץ נקנה במעשר כסף","תמד ומקוה - אינו פוסל לפני החמצה","שותפים בקלבון ובמעשר בהמה","האחין השותפין - פטור מקלבון","תמד עד שלא החמיץ"],"מתני לא ר י ולא רבנן דתניא המתמד ונתן מי":["המתמד ונתן מים במדה","מחלוקת ר' יהודה ורבנן בתמד","תמד ששייר בכוס","הכל הולך אחר המראה","מים ויין וחלב במקוה","תמד שלקחו בכסף מעשר נקנה"],"כל מקום שיש מכר אין קנס וכל מקום שיש קנס":["מכר וקנס - אחד מהם בלבד","קטנה לפני שתביא שתי שערות","ר\"מ וחכמים בקנס ובמכר","חכמים - יש קנס במקום מכר","קטנה מבת שלוש שנים ויום","אין מכר במקום קנס"],"אריא ר זו דברי ר מ אבל חכמים אמרו יש קנס":["קנס במקום מכר לפי חכמים","ר\"מ - עד שתביא שתי שערות","מבת שלוש שנים ויום אחד","קטנה שיש לה קנס ומכר","מחלוקת על מכר וקנס בקטנה","עד שתיבגר בקנס"],"כל מקום שיש מיאון אין חליצה וכל מקום שיש":["מיאון וחליצה - לא יחד","חכמים - יש מיאון במקום חליצה","עד מתי הבת ממאנת","ר' יהודה - שירבה השחור על הלבן","מיאון לפי שתי שערות","מחלוקת ר\"מ וחכמים במיאון"],"אריא ר זו דברי ר מ אבל חכ א יש מיאון במק":["הבת ממאנת עד שתביא שתי שערות","שחור על הלבן - שיעור מיאון","מיאון לפי ר' יהודה","נערה ממאנת - חכמים","מחלוקת במיאון בין הדעות","שתי שערות וההבדל בדעה"],"כל מקום שיש תקיעה אין הבדלה וכל מקום שיש":["תקיעה או הבדלה בערב יום טוב","יום טוב שחל בערב שבת","מבדילין ולא תוקעין במוצאי שבת","הבדלה בין קודש לקודש","ר' דוסא - בין קודש חמור לקל","תקיעה בשבת ומעשה ההבדלה"],"היכי תוקע אמר רב יהודה תוקע ומריע מתוך ת":["תוקע ומריע מתוך תקיעה","תוקע ומריע בנשימה אחת","רב אסי - שופר בנשימה אחת","תוקעין ולא מריעין בערב שבת","רב יהודה ורב אסי בתקיעה","כשמעתיה של רב אסי בהוצל"],"השוחט דיעבד אין לכתחלה לא שנים בבהמה לכת":["שנים בבהמה - פסול לכתחילה","עד כמה לשחוט ולזיל","שחיטה מן הצוואר במקרא","שחיטה בפי העוף ובבהמה","כמה לעוף כמו לאחד","ושחט - מהו הרמז לשחיטה"],"השוחט ב ראשין כאחד שחיטתו כשרה":["שחיטת שני ראשים כאחד","שנים אוחזין בסכין אחד","התיז את הראש בבת אחת","מלא צואר אחד בסכין","הוליך והביא - שחיטה כשרה","אפילו באיזמל אם הוליך והביא"],"מה מ משמואל ד חץ שחוט לשונם מרמה דבר":["ושחט - ומשך במה שחיטה","חץ שחוט לשונם - משל","שחט העוף תוך כדי שפרח","עפר למטה ועפר למעלה","רבא בדק גירא בפגימה","נוצה כרותה סביב הצוואר"],"נפלה סכין ושחטה אע פ ששחטה כדרכה פסולה ש":["נפלה סכין ושחטה - פסולה","וזבחת ואכלת - מה שזובח אוכל","שחיטה בנפילת סכין","הפילה הוא כשרה","שחיטה שלא בכוונה","מה שאתה זובח אתה אוכל"],"טעמא דנפלה הא הפילה הוא כשרה ואע ג דלא מ":["זרק סכין לנועצה - ר' נתן","שחיטה שלא בכוונה - הלכה כר\"נ","חולין אינם צריכים כוונה","נדה שנאנסה וטבלה","טהורה לביתה ואסורה בתרומה","כוונה בחולין לא בעינן"],"נפלה סכין והגביהה נפלו כליו והגביהן":["נפלה סכין ושחט חבירו","שהה כדי שחיטה - פסולה","רבי שמעון - כדי ביקור","השחיז את הסכין ושחט חבירו","נפלו כליו והגביהן","שהייה בין שחיטה לשחיטה"],"כדי שחיטה רב כדי שחיטת בהמה אחרת":["כדי שחיטה - בהמה לבהמה","שמואל - בהמה לעוף מותר","כדי שיגביהנה וירביצנה","כדי שיביא בהמה אחרת","שהיית שחיטה בסכין רעה","שהיות מצטרפות? תיקו"],"ר ש אומר אם שהה כדי ביקור":["ר\"ש - כדי ביקור טבח חכם","לא ביקור חכם סתם","שיעור שהייה בין שחיטות","נתת דבריך לשיעורין","שהייה מעין כדי ביקור","טבח חכם - שיעור השהייה"],"שחט את הוושט ופסק את הגרגרת או פסק את הג":["שחט הוושט ופסק הגרגרת","כל שנפסלה בשחיטתה - נבלה","דבר אחר גרם - טרפה","ר' ישבב משום ר' יהושע","ר' עקיבא - טרפה, ר' ישבב - נבלה","הודה לו רבי עקיבא"],"השוחט בהמה חיה ועוף ולא יצא מהן דם כשרים":["בהמה ועוף שלא יצא מהם דם","נאכלין בידים מסואבות","הוכשרו בדם או בשחיטה","ר' שמעון - הוכשרו בשחיטה","כשר אך אסור לטומאה","אין שחיטה בלא דם לכשרות"],"טעמא דלא יצא מהן דם הא יצא מהן דם אין נא":["ידים שניות בחולין - אין","קדשים לדם הוא צריך","דם קדשים אינו מכשיר","שחוטה בכסף מעשר","רשב\"א - אין ידים תחלות לחולין","חיבת הקדש מכשרתן"],"ת ר השוחט והתיז דם על הדלעת רבי אומר הוכ":["השוחט והתיז דם על הדלעת","רבי מכשיר, ר' חייא תולין","נתקנח הדם בין סימן לסימן","דם מכה או דם שחיטה","לא אוכלין ולא שורפין - תולין","באו ונסמוך על דברי ר\"ש"],"השוחט את המסוכנת רשב ג אומר עד שתפרכס בי":["המסוכנת - עד שתפרכס","דיה אם זינקה","שחיטת מסוכנת בלילה","בהמה דקה ששפשטה ידה","בחזקת בריאה - כשרה","כשכשה בזנבה - מסוכנת"],"מסוכנת ס ד דאסירא ד וזאת החיה אשר תאכלו ":["מסוכנת - אסורה או מותרת","נבלה לאחר מיתה ובעשה","טרפה לא תאכל מכלל מסוכנת","חלב נבלה וחלב טרפה","איסור נבלה חל על חלב","מסוכנת אינה נבלה"],"השוחט לעכו ם שחיטתו כשרה":["שחיטה לעכו\"ם - כשרה","ר\"א פוסל, מחצר כבד","מחשבת עכו\"ם סתם לעבודה זרה","ק\"ו של ר' יוסי מקדשים","השוחט לעכו\"ם ואכל מחצר","מחשבה פוסלת במוקדשין בלבד"],"הני תנאי אית להו דר א ברבי יוסי דתניא אר":["הבעלים מפגלין - מחלוקת","זה מחשב וזה עובד","חשיבה בפנים וחוץ בלא","ת\"ק ור\"א - סתם מחשבה","ר' יוסי - אפילו בפנים","נשמעה מחשבה לעבודה זרה"],"אתמר השוחט את הבהמה לזרוק דמה לעבודת כוכ":["זורק דמה לעבודה זרה ומקטיר","מחשבין מעבודה לעבודה","רי\"ו - פסולה, ר\"ל - מותרת","לשמה לזרוק דמה שלא לשמה","מחשבת פיגול וחוץ מפנים","מחשבה ממקום לעבודה אחרת"],"השוחט לשם הרים לשם גבעות לשם ימים לשם נה":["שוחט לשם הרים ונהרות - פסול","שנים אוחזין לשמות שונים","זבחי מתים - לשם הרים","שחיטה לשם ימים ומדברות","לשם הר - אין נעשה עבודה זרה","שחיטה לשם הר פסולה"],"פסולה אין זבחי מתים לא":["זבחי מתים אף לשם מלאך","לשם הר או למלאך הממונה","לשם מיכאל השר הגדול","בהמת חבירו לפני עבודה זרה","סימן אחד - אסרה","שחט חטאת בחוץ לעבודה זרה"],"אין שוחטין לא לתוך ימים ולא לתוך נהרות ו":["שחיטה לתוך מים או כלים - אסורה","שוחט לתוך עוגה של מים","גומא בתוך הבית לדם","שוחט בשוק - מחקה הצדוקים","שחיטה בספינה על גבי כלים","אין שוחטין לגומא כל עיקר"],"השוחט לשם עולה לשם זבחים לשם אשם תלוי לש":["שחיטה לשם עולה או זבחים - פסול","ר\"ש מכשיר בשם עולה","שחיטה לשם חטאת או בכור","כל שנידר ונידב - לשמו אסורה","שנים אוחזין לשמות שונים","זה הכלל לשם קדושה"],"השוחט לשם עולה":["אשם תלוי מתנדב בכל יום","פסח - ר' אליעזר ושאינו נידב","בעלי מומין - ספק הפרשה","א\"ר ינאי - רק תמימים","השוחט לשם אשם תלוי","חייב חטאת - לשם חטאתו"],"השוחט לשם חטאת":["שחיטה לשם חטאת שאינו מחויב","מחויב חטאת - לשם חטאתו","שאמר לשם חטאתי","ר' יוחנן - רק שאינו מחויב","הבעלים שחייבו חטאת","לשם חטאתו הוא עושה"],"זה הכלל לאתויי עולת נזיר דאימר נדר בצינע":["זה הכלל לעולת נזיר","נדר בצינעה לעולת נזיר","עולת נזיר - הנדר בצנעא","כלל השוחט לשם נדר","אתויי עולת נזיר","שחיטה לנזיר בצינעה"],"ארשב ל טרפה מן התורה ובשר בשדה טרפה לא ת":["טרפה מן התורה - רמז בשדה","כל שאין כמוה חיה - טרפה","י\"ח טרפות שנאמרו למשה","זאת החיה אשר תאכלו - מדרשים","רשב\"ל - טרפה אינה חיה","בהמה שנחתכו רגליה מן הארכובה"],"עולא ח מיני טרפות נאמרו למשה בסיני":["שמונה טרפות שנאמרו למשה","נקובה ופסוקה, נטולה וחסורה","חייא בר רבא - טרפות בנקובה","מרה וקורקבן בנקובה","הלכה כריב\"י בטרפות","ניסא של איוב אין מזכירין"],"ניקב הלב לבית חללו":["ניקב הלב לבית חללו","לבית חלל גדול או קטן","עד שתינקב לבית הסמפונות","קנה הלב - במשהו או ברובו","שלושה קנים בלב","חלב על דופני ריאה"],"ר ש אומר עד שתינקב":["ר\"ש - עד שתינקב לסמפון גדול","הלכה כר' שמעון בנקב הלב","מלוך ערבאה קאמרת","ר' מאיר בשם ריב\"ל","מסמפון גדול - ר' שמעון","ישב ר' אבא קמיה דר\"ה"],"המסס ובית הכוסות":["מחט בעובי בית הכוסות","מחט מצד אחד מול משני צדדים","קורט דם בידוע לפני שחיטה","מכה שהגליד - ראיה בבעל","נקב רגיל ונקב מחט","מחט שנמצאת - מעשה לפני רבי"],"נשתברו רוב צלעותיה":["רוב צלעות - שש מכאן ושש מכאן","נעקרו או נשתברו ברוב צד","נעקרה צלע וחוליא עמה","צלעות גדולות שיש בהן מוח","רב: צלע וחוליא - טרפה","מחציין כלפי שדרה"],"ואלו כשרות בבהמה ניקבה הגרגרת או שנסדקה":["מומין הכשרים בבהמה","ניקבה הגרגרת או נסדקה","עד כמה תחסר - כאיסר","ניטל הטחול - כשר","הגלודה - ר' מאיר מכשיר","נפחתה הגולגולת ולא ניקב"],"אתמר רי ו אמר אלו טרפות דוקא ורשב ל אמר ":["אלו טרפות - דוקא או לא","בוקא דאטמא דשף - טרפה","תנא טרפות ותנא זה הכלל","כשרות דוקא לפי רשב\"ל","לאו לנקובי דמיא ולא לפסוקי","בוקא דאטמא - אלו טרפות"],"אר נ כסלע כיתר מכסלע כאיסר כיתר מכאיסר א":["עד ולא עד בכלל - שיעור","כסלע כיתר מכסלע","חבל היוצא מן המטה","שיעור טפחים מלמעלה","לוג וסאה - כלמעלה","הדקין שבכלי חרס"],"ואלו טרפות בעוף נקובת הוושט ופסוקת הגרגר":["טרפות בעוף - נקובת הוושט","הכתה חולדה על ראשה","בני מעיים ירוקים ואדומים","דרסה וטרפה בכותל","מפרכסת ושהתה מעת לעת","נפלה לאור - טרפה"],"רב ושמואל ולוי דאמרי מכניס ידו לפנים ובו":["בדיקת חולדה - ביד או במסמר","מכניס ידו לפנים ובודק","אין בדיקה לחולדה - שיניה דקות","כי סליק לנהרדעא - חזרה בטעות","בודקין לחולדה ביד בלבד","עד דמנקיב קרמא תתאה"],"ואלו כשרות בעוף ניקבה הגרגרת או שנסדקה":["ניקבה הגרגרת ונסדקה - כשר","הכתה חולדה במקום שאינו טרפה","ניקב הזפק ורבי אומר","נשתברו גפיה או רגליה - כשר","נטלה הנוצה - פסולה","רבי יהודה - נמרטו כנפיה"],"ת ר מעשה ברבי סימאי ורבי צדוק שהלכו לעבר":["מעשה ר' סימאי ור' צדוק בלוד","הורו בטרפחת כרבי בזפק","גגו של זפק נידון כוושט","טרפחת - לאיסור או להתיר","זפק וגגו כוושט","שני חכמים בעבר שנה"],"אחוזת הדם והמעושנת והמצוננת ושאכלה הרדופ":["אחוזת הדם והמעושנת - כשרה","שאכלה הרדופני - כשרה","אכלה סם המות - מותרת","הכישה נחש - מותרת משום טרפה","צואת תרנגולים ומים רעים","סכנת נפשות באכילה"],"שמואל הלעיטה חלתית טרפה שנוקב למעייה":["הלעיטה חלתית - טרפה","שנוקב למעייה","תיעה חלתית ופלפלין","כאן בעלין שאינן מנקבין","סם המות דבהמה - הרדופני","עיקרא דמרירתא - תיעה"],"סימני בהמה וחיה נאמרו מן התורה וסימני הע":["סימני עוף - דורס וזפק","כל שיש לו אצבע יתירה","חגבים - ארבע רגלים וקרצולים","דגים - סנפיר וקשקשת","ר' יהודה - שני קשקשין וסנפיר","עוף החולק את רגליו טמא"],"ת ר אלו הן סימני בהמה כל בהמה מפרסת פרסה":["סימני בהמה - מפרסת ומעלה גרה","בלי שיניים למעלה - טהורה","שפן וארנבת יש להן שיניים","בודק בפיה כשפרסותיה חתוכות","הכרת בן גמל במדבר","הדומה לבן גמל"],"אריא ר ואבר עצמו אסור":["אבר שיצא מן הבהמה - אסור","בהמה המקשה לילד והוציא עובר","כילוד - יצא ראשו","בכור לנחלה ואינו לכהנים","יצא ראשו חי או מת","בשר חוץ למחיצתו נאסר"],"המבכרת המקשה לילד מחתך אבר אבר ומשליך לכ":["המבכרת המקשה לילד","מחתך אבר אבר לכלבים","יצא רובו - יקבר","בכורה ונפטרת מן הבכורה","המבכרת שנפטרה מבכורה","יקבר ולא לכלבים"],"אתמר יצא שליש ומכרו לעכו ם וחזר ויצא שלי":["יצא שליש ומכרו לעכו\"ם","קדוש למפרע או מכאן ולהבא","יצא שליש דרך דופן","רבה ור' הונא בשליש","בחומרא לא מודה לרבה","רובא דרך רחם נפיק"],"בהמה שמת עוברה בתוך מעיה והושיט הרועה את":["עוברה מת בתוך מעיה","הושיט הרועה את ידו","בבהמה טמאה או טהורה","ר' יוסי הגלילי - טמא בטמאה","טהור בטהורה לעובר","נגע בעובר מת בבהמה"],"טעמא דת ק אר ח ק ו אם הועילה אמו להתירו ":["מטמא אם שאכלה - ק\"ו","טמאה לטהורה - עוברו טהור","כי ימות מן הבהמה - טמאה","הולך על כפיו - מהלכי ארבע","קלוט במעי פרה","ק\"ו דרב חסדא"],"האשה שמת ולדה בתוך מעיה ופשטה חיה את ידה":["אשה שמת ולדה במעיה","חיה טמאה טומאת שבעה","האשה טהורה עד שיצא הולד","פשטה חיה את ידה","חיה נוגעת בולד מת","טומאה של ולד בבטן"],"רבה כשם שטומאה בלועה אינה מטמאה כך טהרה ":["טומאה בלועה אינה מטמאה","טהרה בלועה אינה מיטמאה","והאוכל מנבלתה יכבס בגדיו","רבה ובר פדא - טומאה חמורה","כלי חרס המוקף צמיד פתיל","טהרה בלועה מק\"ו"],"ורי ש ור ע דתניא לרי ש וכל אשר יגע על פנ":["עובר במעי אשה - טמא מדאורייתא","גולל ודופק - הלכה למשה","נפש של אדם - רביעית דם","הנוגע במת בנפש - לרי\"ש","רביעית דם מטמאה באהל","ועל כל נפשות מת לא יבא"],"בהמה המקשה לילד והוציא עובר את ידו וחתכה":["הבשר מגע נבלה או מגע טרפה","שחיטת טרפה מטהרתה","ר' מאיר - טרפה אסורה כבהמה טמאה","שחיטה מטהרת את האבר","בהמה טמאה לא מטהרת שחיטה","מגע טרפה שחוטה"],"אמאי טומאת בית הסתרים היא ולא מטמיא":["שלושה על שלושה שנחלק","טהור מן המדרס, טמא מגע מדרס","שלש הבאות מבגד גדול","בגד לאו לחתיכה קאי","כל העומד לחתוך כחתוך","ר\"מ וכלי ידות ארוכות"],"וחכמים אומרים מגע טרפה שחוטה":["טרפה שחוטה מטמאה כאביה","טרפה ששחטה - במוקדשין","שמואל - טרפה ששחטה מטמאה","מגע טרפה שחוטה לטומאה","טמאה כאביה במוקדשין","ביטול דין טרפה לשחיטה"],"השוחט את הבהמה ומצא בה בן שמנה חי או מת ":["בן תשעה חי - טעון שחיטה","שחיטת אמו מטהרתו","בן שמונה חי או מת","קורעה ומצא בן תשעה חי","ר\"ש שזורי - בן חמש שנים","לפי שלא נשחטה אמו"],"ר א מר א לא הילכו בו אלא על עסקי שחיטה ב":["גיד הנשה וחלב השליל","ר\"מ - גיד נוהג בשליל","מחטט אחריו וחותך שמנו","לא הילכו בו אלא על עסקי שחיטה","רובעו וחורש בו - למעט","חלב דשליל ודגיד - פלוגתא"],"בהמה שנחתכו רגליה מן הארכובה ולמטה כשרה":["רגליה שנחתכו מן הארכובה","מן הארכובה ולמעלה - פסולה","נשבר העצם ורוב הבשר קיים","צומת הגידין - כשר או פסול","שחיטה מטהרת כשרוב הבשר","נשבר העצם - טעון בדיקה"],"אריא ר מר ח למטה למטה מן הארכובה למעלה ל":["למטה מן הארכובה - מה פירוש","ארכובה הנמכרת עם הראש","כנגדו בגמל ניכר","רכובה בלא צומת הגידים","עולא - ארכובה וצומת הגידין","נחתכו קתני - לא למטה"],"השוחט את הבהמה ומצא בה שליא נפש היפה תאכ":["שליא בבהמה - נפש היפה תאכלנה","חישב עליה - מטמאה לאוכלין","שליא שיצאה מקצתה - אסורה","סימן ולד באשה ובבהמה","שליא בפרשת דרכים אסורה","אין תולין שליא באילן - דרכי האמורי"],"כל בהמה תאכלו לרבות את השליא אותה ולא של":["כל בהמה תאכלו לרבות שליא","שליא בלא ולד - אסמכתא","אותה ולא שליתה","קרא אסמכתא בשליא","שליא ללא ולד בדין","שליא - לאכול או לא לאכול"],"ת ר מנין לאותו ואת בנו שנוהג במוקדשין ת ":["אותו ואת בנו במוקדשין","שור או כשב או עז כי יולד","שור ושה אותו ואת בנו","הכלאים בדין אותו ואת בנו","איש אשר יקלל את אביו","לחלק בנו ואותו בקדשים"],"השוחט ונמצא טרפה השוחט לעבודה זרה והשוחט":["השוחט ונמצאת טרפה - פטור","השוחט לעבודה זרה - ר\"ש פוטר","שור הנסקל ועגלה ערופה","נוחר והמעקר - פטור","נתנבלה בידו - לא חייב","ר\"ש פוטר בכמה מקרים"],"ארשב ל לא שנו אלא ששחט ראשון לעבודה זרה ":["שחט ראשון לעבודה זרה ושני לשלחנו","ראשון לשלחנו ושני לע\"ז - פטור","ריש לקיש - כשלא אתרו ביה","חייבי מיתות שוגגין","תינוקות של בית רבן יודעין","נתבטל הדין בשחיטה כפולה"],"שנים שלקחו פרה ובנה איזה שלקח ראשון ישחו":["שנים שלקחו פרה ובנה","זריז ראשון ישחוט","מי שקדם זכה בשחיטה","פרה ובנה לפי הקודם בלקיחה","שחיטה לפי זכות הקניה","קדם השני זכה לקדימה"],"אמר רב יוסף לענין דינא תנן":["לענין דינא תנן - זריז ונשכר","זריז שלא עבד איסורא","נשכר - שאכל בשרא","רב יוסף - הלכה כמשנה זו","זריז ונשכר במשנה","שאלה: מי קדם בשחיטה"],"שחט פרה ואח כ שני בניה סופג שמונים":["שחט פרה ואח\"כ שני בניה","סופג שמונים או ארבעים","פרה ובת בת - מלקות","שחטה ואת בתה ואח\"כ","סומכוס משום ר' מאיר","סופג את הארבעים בלבד"],"וילפי מ לא תשחטו הרי שנים אחד השוחט את ה":["לא תשחטו - שנים חייבין","האחרונים חייבין בלא תשחטו","אחד השוחט את הפרה","אחד אין ושנים לא","לימוד מלא תשחטו","שחיטת אם ובת - שנים"],"בארבעה פרקים בשנה המוכר בהמה לחבירו צריך":["ארבעה פרקים בשנה להודיע","בערב יום טוב האחרון של חג","ערב עצרת ערב ראש השנה","מוכר בהמה צריך להודיעו","בזמן שאין לו ריוח","ערב יום הכפורים בגליל"],"תנא אם לא הודיעו הולך ושוחט ואינו נמנע":["לא הודיעו - שוחט ואינו נמנע","תנא: שחיטה בלא הודעה","הולך ושוחט בלא הודאה","בארבעה פרקים שוחטים בעל כרחו","מוכר בהמה בלא הודעה","הודעה למוכר: אם לא הודיעו"],"יום אחד האמור באותו ואת בנו היום הולך אח":["יום אחד - היום הולך אחר הלילה","שמעון בן זומא ומעשה בראשית","יום אחד במעשה בראשית ובאותו","לילה הולך אחר היום בקדשים","את זו דרש ר' שמעון בן זומא","היום הולך אחר הלילה - דרשה"],"ת ר את זו דרש לפי שכל הענין כולו אינו מד":["לילה הולך אחר היום בקדשים","רשב\"ז - יום אחד כמעשה בראשית","יום אחד המיוחד טעון כרוז","מכאן כרוז בארבעה פרקים","יום המיוחד - הודעה לקונה","יום אחד ולילה - דיני קדשים"],"מוקדשין לא":["שחיטה צריכה עפר למטה ולמעלה","והכא לא אפשר - כסוי בשפך","חיה שנשחטה לפני בהמה","כל הראוי לבילה אין בילה מעכבת","דם הניתז ושעל הסכין חייב לכסות","ואינו ראוי לבילה - מעכב"],"השוחט ונמצאת טריפה והשוחט לעבודת כוכבים ":["השוחט ונמצאת טרפה - כיסוי","שוחט לעבודה זרה פטור מכיסוי","שוחט חולין בפנים וקדשים בחוץ","חיה ועוף הנסקלים - ר\"מ מחייב","הנוחר והמעקר - פטור מכיסוי","חכמים פוטרים מכיסוי נסקלים"],"רחב א מרי ו ראה רבי דבריו של ר מ באותו ו":["ר\"מ - שחיטה ראויה ושאינה","גמר שחיטה משחוטי חוץ","ר\"ש - גמר מטבוח טבח והכן","ושב הכהן ובא הכהן - שיבה וביאה","נפק\"מ בדינא ד'ושב הכהן'","דנין שחיטה משחיטה"],"חרש שוטה וקטן ששחטו ואחרים רואין אותם חי":["חרש שוטה וקטן ששחטו","ששחטו ואחרים רואין אותם","בינן לבין עצמן פטור מכיסוי","רבי מאיר מתיר לשחוט אחריהם","שאם שחט אינו סופג ארבעים","שחיטת קטן לפני אחרים"],"רבנן אכולה מילתא פליגי ונטרי ליה לר מאיר":["ר\"מ וחכמים - לחומרא או לקולא","מחייב רבי מאיר משום נבלה","ר\"א - רובם מקולקלים במעשיהם","סמוך מיעוטא לחזקה","תינוק בצד העיסה - ר\"מ מטהר","רוב תינוקות מטפחין"],"שחט מאה חיות במקום אחד כסוי אחד לכולן":["שחט מאה חיות במקום אחד","כיסוי אחד לכל החיות","מאה עופות וחיה - כיסוי אחד","ר' יהודה - חיה יכסנה ואחר","חיה ועוף - ישחוט אחר הכיסוי","שחט חיה ואחר כך עוף"],"ת ר חיה כל משמע חיה בין מרובה ובין מועטת":["חיה או עוף - לחלק בכיסוי","מדמו נפקא - ר' יהודה","כי נפש כל בשר דמו בנפשו","ר' יהודה - מודה במאה חיות","חיה ועוף בנפש הדם","רבנן - דמו טובא משמע"],"שחט ולא כסה וראהו אחר חייב לכסות":["שחט ולא כיסה וראהו אחר","כיסהו ונתגלה - פטור","כיסהו הרוח - חייב לכסות","כיסוי הדם בעת חיוב","אחר רואה חייב לכסות","נתגלה לאחר כיסוי"],"ת ר ושפך וכסה מי ששפך יכסה שחט ולא כסה ו":["ושפך וכסה - מי ששפך יכסה","אזהרה לכל בני ישראל לכסות","שלא יכסנו ברגל","מעשה ברבן גמליאל ודמי כיסוי","שכר מצוה או שכר ברכה","ברכת המזון - ארבעים"],"כסהו ונתגלה":["השב אבדה לעומת כיסוי הדם","כסהו ונתגלה - חייב","הכא כתיב מיעוטא וכסהו","השבה אפילו מאה פעמים","מיעוט בכיסוי ואין במציאה","תורת שיעור בכיסוי"],"כסהו הרוח":["כסהו הרוח - לא חזר ונתגלה","אין דיחוי אצל מצות","שחזר ונתגלה - חייב לכסות","דם שנבלע בקרקע רשומו ניכר","רבב\"ח - לכסות אם חזר","שאני מהשוחט ונבלע דם"],"מתני":["דם שנתערב במים - מראית דם","נתערב ביין כמים","דם בהמה או דם חיה כמים","רבי יהודה - אין דם מבטל דם","דם הניתז ושעל הסכין","אימתי - בזמן שאין שם דם אחר"],"תנן התם דם שנתערב במים אם יש בו מראית דם":["דם שנפל למים - ראשון בטל","אין דחוי אצל מצות לכיסוי","כל מראה אדמומית מכשירין","דם מכשיר או מים מכשירין","מכפרין ומכשירין וחייבין בכיסוי","מה חידשה משנה במראה דם"],"במה מכסין ובמה אין מכסין":["במה מכסין - זבל הדק וחול הדק","אין מכסין בזבל הגס","רשב\"ג - מגדל צמחים","לא יכפה עליו את הכלי","סיד וחרסית ומגופה שכתשן","דבר שמגדל צמחים מכסין בו"],"חול הדק רי ו כל שאין היוצר צריך לכתשו":["חול הדק - כל שאין היוצר צריך לכתשו","חול הגס - כל שהיוצר צריך לכתשו","איכא בינייהו - צריך ולא צריך","וכסהו בעפר ולא באבנים","קמח וסובין ומורסן - מין עפר","שחיקת כלי מתכות אינה עפר"],"ואף שלימה מותר שישראל קונים מגוי כשלא הכ":["שלימה מותרת וחתוכה אסורה","שחיטת גוי ניכר - מותר לקנות","גזירה שמא יתננה לו בפני ישראל","גניבת דעת - חתוכה אסורה","אסור לגנוב דעת הבריות","תרנגולת טריפה בחזקת שחוטה"],"גמ":["בר פיולי וניקר ירך לפני שמואל","גמם מלמעלה כר\"י","מה שנטל - דאורייתא","רבנן לר\"י - מה ששייר","אל תרעד - כר\"י הורה לך","בר פיולי ושמואל - גיד הירך"],"לא שנו אלא שנתבשל בה אבל נצלה בה קולף וא":["נצלה בחלבו - קולף ואוכל","גדי שצלאו בחלבו אסור","שאני חלב שמפעפע","כחוש היה או כוליא בחלבה","קדרה של בשר לחלב - נותן טעם","בשר בחלב - טועמו מי"],"וסבר ר י איסור חל על איסור והרי ר י אמר ":["איסור חל על איסור - נבלת טמא","בל תאכל נבלה ובל תאכל טמאה","נוהג בשליל - מחלוקת","גיד ואיסור טומאה באים כאחד","טמאה נוהגת בשליל","טהורה לא נוהג בשליל"],"ואסור להעלות וכו":["שמע מינה - בשר עוף בחלב דאורייתא","גזירה לגזירה לא גזרינן","חלת חוצה לארץ בשולחן","אכילה גזירה - ואנן נגזר העלאה","אי אפשר לגזור בשר לחלב","העלאה בשולחן עם העוף והגבינה"],"לב ש העוף עולה עם הגבינה על השולחן ואינו":["העוף עולה עם הגבינה על השולחן","ב\"ש - עולה ונאכל, ב\"ה - לא","זו מקולי ב\"ש ומחומרי ב\"ה","שולחן שאוכל עליו ושסודר עליו","נותן זה בצד זה ואינו חושש","עוף וגבינה בשולחן"],"רבי יוסי היינו ת ק":["ת\"ק הוא רבי יוסי","קינוח או הדחה בנטילת ידים","עוף וגבינה באפיקורן","קולי ב\"ש וחומרי ב\"ה בנטילה","אכילה בלא נטילה ובלא קינוח","דבר בשם אומרו"],"ת ר נטילת ידים לחולין עד הפרק לתרומה עד ":["נטילה עד הפרק לחולין ולתרומה","נטילת שחרית וכוונה לכל היום","נטילה לחומרא או לקולא","מחלוקת רב ושמואל בנטילת ידים","שעת הדחק ונטילה בלא מים","חציצה בנטילת ידים לחולין"],"איבעיא להו מהו לאכול במפה מי חיישינן דלמ":["אכילה במפה וחשש נגיעה","ראיה מאכילת רבי צדוק","אוכל פחות מכביצה במפה","חובת סוכה לאוכל כביצה","מפה וסוכה וברכה","ספק נגיעה בידים במפה"],"כשעלה ר ז מצאם לר א ור א שאוכלי בבלאי חמ":["מפה לאוכלי תרומה ולא לטהרות","דעתי קצרה - ר' אמי ור' אסי","שני גדולים שטעו בדרב ושמואל","הכהנים ר' אמי ור' אסי","תרומה לעומת טהרות בנטילה","לקיחת דברי ר' אבא משמואל"],"איבעיא להו אוכל מחמת מאכיל צריך נטילת יד":["אוכל מחמת מאכיל - נטילה","נטילת השמש הנותן פרוסה","זריז קדים ומשי ידיה","ברכה על כל פרוסה לשיטת ר' יוחנן","שמש טרוד ואדם חשוב","איסור פרוסה לשמש בלא נטילה"],"ת ר לא יתן אדם פרוסה לשמש בין שהכוס בידו":["אסור ליתן פרוסה לשמש שלא נטל","מאכיל אינו צריך נטילה","שמאי הזקן והאכלה בידו אחת","בכי שמואל על האכלת בנו","הלכתא: נטילה לאוכל ולא למאכיל","שמא יארע דבר קלקלה בסעודה"],"צורר אדם בשר וגבינה במטפחת אחת ובלבד שלא":["בשר וגבינה במטפחת אחת","שני אכסנאין על שולחן אחד","שלא יהיו נוגעין זה בזה","רשב\"ג ואין חוששין","הפרדה בין בשר לגבינה על השולחן","הקפדה על נגיעה בין מאכלים"],"אביי ואפי דצונן בצונן הוא וקליפה לא בעי ":["צונן בצונן - הדחה בלבד","קליפה אינה נדרשת לצונן","הדחה נדרשת אף בצונן","אביי: הדחה ולא קליפה","דין הדחה בכלי צונן","אביי על צונן בצונן"],"רשבג א שני אכסנאין אוכלין על שולחן וכו":["אכסנאין שאינם מכירים זה את זה","אכסנאין המכירים זה את זה","שני אחים המקפידים זה על זה","סריקין ובייתוס - הבחנה","איזורו שמכבס עמו מוכיח","עין תפיסה אחת בשני אכסנאין"],"טיפת חלב שנפלה על החתיכה אם יש בה בנותן ":["טיפת חלב שנפלה על החתיכה","ניעור הקדרה וטעם בקדרה","טעם באותה חתיכה או קדרה","טיפת חלב ונותן טעם","ניער את הקדרה - אסור","איסור טעם בבשר ובחלב"],"אביי טעמו ולא ממשו בעלמא דאורייתא דאי דר":["טעמו ולא ממשו מדאורייתא","דרך בשול אסרה תורה","חתיכה נעשית נבלה ואוסרת מינה","מין במינו ורוטב עבה","אפשר לסוחטו - אסור או מותר","רב ור' יוחנן במין במינו"],"אמר מר ודברי חכמים כשניער וכסה":["ניער וכיסה בסוף ולא בתחילה","נראין דברי ר' יוסי בהא","אפשר לסוחטו - מותר לחכמים","קושיית רב אחא על המחלוקת","מין במינו - לשיטת ר' יוסי","ניעור וכיסוי - לשון חכמים"],"הכחל קורעו ומוציא את חלבו לא קרעו אינו ע":["קריעת הכחל והוצאת חלבו","קריעת הלב והוצאת דמו","כחל ולב בקריעה","לא קרעו - אינו עובר עליו","הוצאת חלב ודם מן הבשר","הבחנה בין כחל ללב"],"ר ז מרב אינו עובר עליו ומותר":["אינו עובר עליו - מותר","אינו עובר משמע שיש איסור","איידי דסיפא תנא נמי רישא","קריעה ללב ולא לכחל","לב סגי בקריעה וכחל לא","רב: אינו עובר עליו ומותר"],"המעלה את העוף עם הגבינה על השלחן אינו עו":["המעלה עוף עם גבינה על השולחן","העלאה לשולחן אין בה לאו","אינו בא לידי לא תעשה","עוף וגבינה על השולחן","איסור העלאה בשולחן","תעשה ולא תעשה בשולחן"],"ה ק המעלה את העוף עם הגבינה על השולחן אי":["שאינו אסור מדאורייתא","העלאה לשולחן - איסור דרבנן","לא בא לידי לא תעשה","ביאור ההעלאה על השולחן","עוף וגבינה בלא לאו","הבאה ללאו בשולחן"],"בשר בהמה טהורה בחלב בהמה טהורה אסור לבשל":["בשר בחלב - איסור מן התורה","ר' עקיבא: חיה ועוף לא מן התורה","שלוש פעמים לא תבשל גדי","ר' יוסי הגלילי וגזירת נבלה","עוף שאין לו חלב אם","בשר בהמה טמאה בחלב טהורה"],"מה מ אר א וישלח יהודה את גדי העזים וכתיב":["שני כתובים הבאים כאחד","גדי לרבות ולהוציא","שש דרשות משלוש פעמים גדי","איסור חל על איסור לשמואל","חלב מתה ודם מן הגדי","בחלב אמו ולא חלב זכר"],"קבת עכו ם ושל נבלה הרי זו אסורה":["קיבת עכו\"ם ושל נבלה","המעמיד גבינה בקיבה","כשרה שינקה מן הטרפה","טרפה שינקה מן הכשרה","כנוס במעיה - מותרת","קיבה ודין היניקה"],"קבת עכו ם לאו נבלה היא":["קיבת עכו\"ם אינה נבלה","חשש יניקה מן הטמאה","גדי שנקנה מן העכו\"ם","ביצים מן העכו\"ם ואין חוששין","טרפה אינה שכיחה וטמאה שכיחה","קודם חזרה ולאחר חזרה"],"חומר בחלב מבדם וחומר בדם מבחלב":["חומר בחלב מבדם","חומר בדם מבחלב","מעילה ופיגול בחלב","דם נוהג בטמאים ובטהורים","השוואת חלב ודם לחומרה","חלב נוהג בבהמה טהורה בלבד"],"מה מ אמר ר ינאי ד כאשר יורם משור זבח השל":["כאשר יורם משור זבח השלמים","אימורי קדשים קלים למעילה","חלב יותרת ושתי כליות","אליה אינה נקראת חלב","כל חלב שור כשב ועז","כרב זביד - האליה בחלב"],"בכור שנתערב במאה בזמן שמאה שוחטין את כול":["בכור שנתערב במאה","שוחט לכהן ולעכו\"ם - פטור","המשתתף צריך לרשום","חוץ מן המתנות - פטור מהן","מכירת בני מעיה של פרה","ניכוי המתנות מן הדמים"],"גר שנתגייר והיתה לו פרה נשחטה עד שלא נתג":["גר שנתגייר והיתה לו פרה","נשחטה לפני גיורו - פטור","ספק פטור - המוציא עליו הראיה","שחיטה לפני ואחרי הגיור","הנטל על המוציא מחבירו","פרה שנשחטה משנתגייר - חייב"],"איזהו הזרוע מן הפרק של ארכובה עד כף של י":["היכן מתחיל הזרוע ומה סופו","זרוע של נזיר","הזרוע מן הארכובה עד כף היד","שוק לפי ר' יהודה עד הסובך","הלחי מן הפרק עד הפיקה","גבול הלחי והגרגרת"],"ה ז ר ע זרוע ימין ולא שמאל ד ה ז ר ע":["הזרוע - ימין ולא שמאל","הזרוע והיד המיומנת","הלחיים - צמר הראש ושער הזקן","הקבה - חלב שעל הקיבה","תרומה ללמד על זרוע מוקדשין","תתנו - לזרוע חולין"],"במוקדשין לא ד צאנך ולא צאן הקדש":["גיזת קדשי בדק הבית","צאנך ולא צאן הקדש","גיזה בקדשים - מדרבנן","קדשי מזבח ובדק הבית","הקדיש רגל - כולה עולה","הקדיש גיזה עצמה"],"רבי אבין ור מ חד אמר כל היכא דתנן בארץ ו":["ראשית הגז בארץ ובחוץ לארץ","ראשית הגז לדעת ר' אלעאי","בפני הבית ושלא בפני הבית","אותו ואת בנו","גיד הנשה לחולין ולקודשים","איידי דתנא לצורך"],"היתה מעופפת בזמן שכנפיה נוגעות בקן חייב ":["קן מעופפת וכנפיה נוגעות","אפרוח אחד או ביצה אחת","אפרוחים מפריחים וביצים מוזרות","רובצת על האפרוחים או הביצים","בני קיימא - חובת שילוח","פטור משילוח הקן"],"ת ר רובצת ולא מעופפת ומדלא כתיב יושבת לא":["רובצת - ולא מעופפת","יושבת בין שני רובדי אילן","למה נאמר רובצת ולא יושבת","מעופפת פטורה אף בנוגעת","נוגע מן הצד - כוונת המשנה","שני רובדי אילן ושילוח"],"שלחה וחזרה אפי ארבעה וחמשה פעמים חייב שנ":["שילח וחזרה ארבע וחמש פעמים","נוטל את האם ומשלח את הבנים","שלח תשלח את האם","נטל את הבנים והחזירן","חזרת האם על הבנים - פטור","שילוח הקן בחזרות"],"א ל ההוא מרבנן לרבא ואימא שלח חדא זימנא ":["שלח אפילו מאה פעמים","תשלח - לפחות שתי פעמים","שלוח הקן לדבר מצוה","עשה אינו דוחה לא תעשה ועשה","נטילה על מנת לשלח","מצורע ומגע באשתו"],"הנוטל אם על הבנים ר יהודה אומר לוקה ואינ":["הנוטל אם על הבנים","ר' יהודה: לוקה ואינו משלח","חכמים: משלח ואינו לוקה","לא תעשה שיש בה קום עשה","אין לוקין על מצוות לא תעשה","כלל: לאו שניתק לעשה"],"בעי רבי אבא בר ממל טעמא דרבי יהודה משום ":["לאו שניתק לעשה - לוקין","גנב וגזלן בכלל מלקות","לא תשוב ושב ולא תכלה וכלה","שלח מעיקרא משמע","לא תותירו ממנו עד בקר","מחלוקת ר' יהודה וחכמים בלוקין"],"לא יטול אדם אם על בנים אפי לטהר את המצור":["לא יטול אדם אם על בנים","למען ייטב לך והארכת ימים","שילוח הקן לטהרת מצורע","מצוה קלה כאיסר - קל וחומר","שכר מצוה קלה ומצוות חמורות","אם על בנים לטהר מצורע"],"תניא דר יע אין לך כל מצוה ומצוה שבתורה ש":["שכר מצוות בצדן","שילוח הקן וכיבוד אב ואם","למען יאריכון ימיך - בעולם ארוך","ולמען ייטב לך - לעולם טוב","נפילה מן הבירה ושכר המצוה","שלוחי מצוה וסכנתם"]}