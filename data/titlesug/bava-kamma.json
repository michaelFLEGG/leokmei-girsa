{"כשהן שמין בשלו הן שמין או בשל עולם הן שמ":["מיטב שדהו - לנזקין או לכל עולם","גבייה מן העידית לנזקין בלבד","שמין בשל עולם או בשלו","נזקין בעידית וחוב בבינונית","דרגות נכסים בגביית הנזק","מיטב שדהו בתשלומי נזק"],"כגון זו כר ה דיכולה אשה לומר לבעלה איני ":["אשה שמוותרת על מזונותיה","זכות האשה לומר איני עושה","ויתור אשה על מזון ומלאכה","אשה שאינה ניזונית ואינה עושה","עבודת אשה ומזונותיה","הכרעה על מזונות אשה בבעל"],"כל שחבתי בשמירתו הכשרתי את נזקו":["שמירה מחייבת בתשלומי נזק","הכשר נזק במקצת מחייב בכולו","נכסים שאין בהן מעילה","מיטב הארץ לתשלומי נזק","חיוב המזיק בנכסים מיוחדים","מקום שאין הנזק חל ברשות"],"אין שמין לגנב ולגזלן רק לנזקין ואני אומר":["שמין לנזקין בלבד ולא לגנב","שמין לשואל כדעת אבא","אומדין נזק בשואל וגזלן","הערכה לתשלום נזק בלבד","שמאות לשואל ולגזלן","גבייה ושמאות לגנב"],"הלכתא גובין מן העבדים ולא מיתמי אלא ממנו":["גביית חוב מעבד משועבד","פרוזבול חל על קרקע ולא עבדים","גבייה מנכסי יתומים בעבדים","מטלטלין נקנים עם הקרקע","עולא ורבי אלעזר בגביית עבדים","שעבוד עבד מכור ואין קול"],"ומעלה מעל בה":["מעילה בקדשים קלים ושלמים","קדשים קלים שהם ממונו","בן עזאי: שלמים בכלל מעילה","מעילה בבכור לדעת בן עזאי","ריבוי מעילה לקדשים","קדשים כממון הדיוט למעילה"],"שום כסף שוה כסף בפני ב ד ועל פי עדים בני":["תשלומי נזק בשוה כסף","נשים בכלל תשלומי נזק","ניזק ומזיק בתשלומין","תשלומי נזק בבית דין","עדים בני חורין ובני ברית","דין שוה כסף בנזקין"],"ואי אמר קבעו לי זמן לארץ ישראל קובעים לו":["זמן לעלייה לארץ ישראל","קביעת זמן למי שמבקש לעלות","בקשת זמן לנדוד לארץ","אם מבקש זמן לארץ ישראל","זמן ליציאה לארץ ישראל","קביעת זמן להליכה לארץ"],"ואי לא הלך מנדים ובין כך מנדים אותו עד ש":["נידוי המזיק עד הסרת הנזק","לא תשים דמים בביתך","איסור גידול כלב רע","נידוי כעונש לבעל הנזק","סולם רעוע והפקרת נזק","חובת סילוק הנזק מן הבית"],"חמשה תמין וחמשה מועדין":["חמשה תמין וחמשה מועדין","בהמה אינה מועדת לנגיחה","שן ורגל מועדות לנזק","חיות רעות מועדות לנזק","רבי אליעזר: חיה בת תרבות","נחש מועד לעולם"],"מה בין תם למועד":["הבדל בין תם למועד בתשלום","תם משלם מגופו מועד מעלייה","מעלייה ומגופו בתשלום נזק","עלייה במעולה שבנכסיו","המעלה כמעולים שבמשפחה","תשלומי תם ומועד בשיעור"],"עלייה במעולה שבנכסיו וכן ויקברוהו במעלה ":["עלייה - מיטב הנכסים","מעלה קברי בני דוד","מעולים שבמשפחה במעלה","פירוש מילת עלייה במקרא","דוד ושלמה כמעולי המשפחה","פירוש עלייה בתשלומין"],"וישכיבוהו במשכב אשר מלא בשמים וזנים":["בשמים וזנים - זנות או זנים","בשמים במשכב המת","ריח הבשמים והבא לידי זימה","ביאור זנים במשכב המת","דרשת זני זני לכבוד מת","רבי נתן: בשמים מביאים לזימה"],"וכבוד עשו לו במותו מלמד שהושיבו ישיבה על":["כבוד המת והושבת ישיבה על קברו","מספר ימי האבל על המלך","הנחת ספר תורה על מטת המת","אמירת קיים ולא לימד","כבוד חזקיהו לעומת אחאב","הלימוד מביא לידי מעשה"],"רישא דתני רגל ותני בהמה דתנא אבות ותני ת":["למה הקדים רגל לבהמה","שן ובהמה בכלל בהמה","איידי דסליק מרגל פתח ברגל","אבות ותולדות בתיאור הנזיקין","שן חביב ורגל אינה משנה","סדר המשנה בשן ורגל"],"בהמה מועדת להלך כדרכה ולשבר כיצד בהמה שנ":["נזק בהילוך ובשער ההולכת","בהמה נכנסת לחצר ומזיקה","אוכף ושליף ופרומביא בנזקין","חמור במשאו משלם נזק שלם","צרורות מחזיר וחזיר המתיז","בהמה מועדת להלך כדרכה"],"תרנגולין שמפריחין ממקום למקום ושברו כלים":["תרנגולים שמפריחים כלים","רוח הכנפיים וחצי נזק","סומכוס ורבנן בנזקי תרנגולין","כוחו כגופו בנזקי צרורות","עיסה ופירות בנזקי תרנגול","צרורות בזב טהור וטמא"],"חצי נזק צרורות משלם מגופו או מעלייה":["צרורות משלם מגופו או מעלייה","כלב שנטל חררה והצית גדיש","נזק שלם על החררה חצי על הגדיש","צרורות כדעת סומכוס ורבנן","גחלת שהדליקה גדיש","האם הידוס מועד לצרורות"],"יש העדאה לצרורות או לא אי דמי לקרן או תו":["האם יש העדאה לצרורות","צרורות כקרן או כרגל","גללים לעיסה במחלוקת ר' יהודה","פעם שלישית בנזקי צרורות","תרנגול בכלי זכוכית","הידוס והתיז מועד או לא"],"מהלכת במקום שא א אא כ מנתזת ובעטה והתיזה":["מהלכת במקום שאין לה ברירה","נתזה מחמת בעיטה או הילוך","בהמה שאין אורחה בלא נתזה","ספק בנזק צרורות תיקו","בעיטה והתזה האם מועד","הילוך ובעיטה בנזקי בהמה"],"כיצד השן מועדת לאכול את הראוי לה":["שן מועדת לאכול את הראוי לה","אכילת כסות וכלים בנזקין","נהנית משלמת מה שנהנית","חצי נזק בכסות ובכלים","פטור ברשות הרבים באכילה","מה שנהנית מתוך הרחבה"],"השן מועדת לאכול את הראוי לה כיצד בהמה שנ":["אכילה על ידי הדחק שמה אכילה","חתול שאכל תמרים נזק שלם","חמור שאכל לחם והזיק לסל","כלב ששתה שמן וחזיר שאכל בשר","מה נחשב אכילה לנזקי שן","עז שעלה על החבית לאכול לפת"],"בהמה שפשטה צוארה ברה ר ואכלה מע ג חברתה ":["צוואר פשוטה לאכול ברשות הרבים","בהמה ברשות הרבים שאכלה מעל חברתה","קופתו מופשלת לאחוריו ואוכל","אכילה בקופצת חייבת","הפטור באכילה ברשות הרבים","מי שפשטה צוארה ואכלה"],"מתגלגל מהו שהעמיר קיים ברה י ומתגלגל מרה":["מתגלגל מרשות היחיד לרבים","אכילה בפנים חייבת ובחוץ פטורה","עמיר המתגלגל בין רשויות","משוי מקצתו בפנים ומקצתו בחוץ","פתילה דאספסתא בנזקין","מתגלגל כמשא שנפל"],"אינו צריך להעלות לו שכר ר א מרי ו צריך ל":["שכירות לדר בחצר חברו שלא מדעתו","אבן או קורה של הקדש ומעילה","רבי אליעזר: צריך להעלות שכר","שתיקה כהודאה בדיור שלא מדעת","קדש שלא מדעת כהדיוט מדעת","מעילה בנטילה ובנתינה לחבירו"],"הכלב והגדי שקפצו מראש הגג ושברו את הכלים":["כלב וגדי שקפצו מגג","נזק שלם מפני שמועדין","כלב שנטל חררה לגדיש","גדי וכלב מועדים בנזקין","פירוט נזק בחררה ובגדיש","קפיצה מראש הגג כנזק"],"לרב יוסף א ל לאביי אמור לבעליהם להצניעם":["עיזי דשוקא שמפסידות","התראה לבעלים שלוש פעמים","כפייה לשחוט עיזים מזיקות","שן שחתרה וכותל שנפל בלילה","הכרזה לבעלי בהמה מזיקה","אביי ורב יוסף בנזקי עיזים"],"איזהו תם ואיזו מועד":["הגדרת מועד ותם לר' יהודה","התראה שלוש פעמים לר' מאיר","שלושה ימים להתראה במועד","תם כשחזר בו שלושה ימים","תינוקות ממשמשין בשור תם","מועד ותם בהתראה"],"שור המזיק ברשות הניזק כיצד":["שור המזיק ברשות הניזק","חצי נזק ברשות הרבים","ר' טרפון ורבי עקיבא בנזק קרן","קרן ברשות הניזק נזק שלם","דיו לבא מן הדין להיות כנדון","השוואה בין קרן לשן ורגל"],"שן ורגל חייבת ברה ר ר ו מקרן שברשות הניז":["שן ורגל ברשות הניזק חצי נזק","קל וחומר מקרן לשן ורגל","אדם חייב בכופר משור","ובער בשדה אחר ולא ברשות הרבים","ד' דברים בשור מקל וחומר מאדם","דרשת יחצון וכופר ככל אשר יושת"],"רגל שדרסה ע ג תינוק בחצר הניזק מהו שתשלם":["רגל שדרסה תינוק וכופר","שור שנכנס לחצר שלא ברשות","כופר ברגל מכופר ברגל","קרן שג' פעמים ורגל","כופר בשור תם ומועד","מה לניזקין דרגל שכן"],"אדם מועד לעולם בין שוגג בין מזיד בין ער ":["אדם מועד לעולם בשוגג ובמזיד","אדם ישן מועד בנזקין","סימא עין חבירו ושבר כלים","מועד לעולם ער או ישן","נזק שלם לאדם שסימא עין","אדם מועד בלי תלות בכוונה"],"הרי אמרו לרכובה שלש ולבעיטה חמש לסנוקרת ":["רכיבה שלוש ובעיטה חמש","קנס על הכאה בכלי העבודה","אדם עושה דין לעצמו במקום הפסד","שני השותפים בבור המים","בן בג בג: שבור את שיניו","לא יעשה אדם דין לעצמו"],"נשברה כדו ברה ר והוחלק אחד במים או שלקה ":["כד שנשבר ברשות הרבים","מתכוין לנזק בשבירת כד","רבי יהודה: מתכוין חייב","מי שהוחלק במים ברשות הרבים","שבירת כלי חרס ברשות הרבים","אינו מתכוין פטור ברשות הרבים"],"השופך מים ברה ר והוזק בהן אחר חייב בנזקו":["שפיכת מים ברשות הרבים","מצניע קוץ וזכוכית חייב","גדר שנפל לרשות הרבים","מזיק ברשות הרבים בנזקיהם","קוצים בגדר ונזקי רבים","המצניע חייב בנזקן"],"המוציא תבנו וקשו לרה ר לזבלים והוזק בהן ":["הוצאת זבל לרשות הרבים","הקודם בזבל זכה","רשב'ג: כל המקלקלין ברבים","הופך גלל ברשות הרבים","מותרים לקלקל ברשות הרבים","תבן וקש בשעת הוצאת זבלים"],"דבשעת הוצאת זבלים אדם מוציא זבלו לרה ר ו":["שעת הוצאת זבלים לר' יהודה","נר חנוכה ופטור מנזק ברבים","מותרי קלקול ברשות הרבים","מתני' שלא בשעת זבלים","כשהוזק משלם אף במותר","יהושע הנחיל את הארץ לנישוף"],"למ ד קנסו גופן משום שבחן לאלתר או לכשיגי":["קנסו גופן משום שבחן","קנס לאלתר או בשעת השבח","רב מודה כשאין בו שבח","גללים וקנס על שבח הבהמה","עונש לאלתר מול שבח עתידי","מחלוקת רב ורב נחמן בשבח"],"מתני אף לרבנן שהנתקל אנוס ופטור כאן חייב":["הנתקל אנוס ופטור","לא היה לו לעמוד חייב","מתני' לרבנן בנתקל","אנס בהכשלה ברשות הרבים","חובת העמידה למניעת נזק","נתקל לעומת מי שהיה לו לעמוד"],"זה בא בחביתו וזה בא בקורתו נשברה כדו של ":["קורה וחבית ברשות הרבים","מי שעמד מחויב בנזק","בעל הקורה ראשון ובעל החבית אחרון","זה בא בחביתו וזה בקורתו","אמר לחברו עמוד פטור","נר ופשתן ברשות הרבים"],"שנים שהיו מהלכין ברה ר אחד רץ ואחד מהלך ":["שניים שרצו והזיקו זה את זה","רצים ברשות הרבים פטורים","הולך ורץ והזיקו זה לזה","הזיקו זה את זה בהליכה","שני המזיקים ברשות הרבים","פטור לשניהם בהזקה הדדית"],"המבקע ברה ר והזיק ברה י ברה י והזיק ברה ":["מבקע ברשות הרבים והזיק ברשות היחיד","ברשות היחיד והזיק ברשות הרבים","חייב בהזקת רשות לרשות אחרת","בקיעה בין רשויות בנזקין","ברשות היחיד והזיק אחר","מי שבקע חייב בכל שילוב"],"שני שוורין תמין שחבלו זה את זה משלמין במ":["שני שוורים תמים שחבלו זה בזה","חצי נזק במותר בשור תם","רבי עקיבא: תם שחבל באדם","כמשפט הזה כתחתון ולא כעליון","תם ומועד במותר נזק","משפט שור באדם מגופו"],"כמשפט הזה יעשה לו כמשפט שור בשור כך משפט":["כמשפט הזה יעשה לו כשור בשור","מגופו ולא מן העלייה","זה לפוטרו מארבעה דברים","איש בעמיתו ולא שור בעמיתו","ריפוי ושבת בנזקי אדם","כמשפט הזה דרשת ר' עקיבא"],"שור שוה מנה שנגח שור שוה מאתים ואין הנבי":["שור שוה מנה שנגח שור מאתים","נוטל את השור כשאין הנבילה יפה","נבילה ששוה לא כלום","חצי חי וחצי מת לשור נגוח","השור החי נוטל כשנבילתו אינה יפה","נגיחה ושור כשנבילה בטלה"],"מכרו אין מכור הקדישו מוקדש":["מכירת שור מזיק והקדשתו","מזיק מכור ומוקדש לדעת רבי","גזירה שיאמרו הקדש יוצא בלא פדיון","שור מזיק משועבד לניזק","מכרו אין מכור הקדישו מוקדש","מזיק במכר והקדש"],"שור תם שהזיק":["שור תם לפני ואחרי העמדה בדין","מכירה והקדשה לפני הדין","אחרי הדין שור מזיק אינו נמכר","בעלי חובות וגבייה משור תם","משתלם רק מגופו","שחיטה ומתנה של שור מזיק"],"זאת אומרת המזיק שעבודו של חבירו פטור":["המזיק שעבודו של חבירו פטור","שורף שטרותיו של חבירו פטור","מזיק שעבוד ובעל חוב","בעל חוב מאוחר שקדם וגבה","כחפר בור שיחין ומערות","ניזק קודם לבעל חוב"],"שור שוה מאתים שנגח שור שוה מאתים וחבל בו":["שבח מזיק בנזקי שור","שור שבח לאחר הנזק","כחש כשעת העמדה בדין","שבח ממילא ושבח בפיטום","שבח הניזק לפי שעת הנזק","פיטום השור ושבח ההפסד"],"שור שוה מאתים שנגח שור שוה מאתים ואין הנ":["ומכרו את השור החי וחצו את כספו","וגם המת יחצון לא קיים","שור שנגח שור והנבילה יפה","חצי החי וחצי המת לשני הצדדים","רבי מאיר ורבי חנינא בנבילה","מכירת שור חי וחלוקת כספו"],"יש חייב על מעשה שורו ופטור על מעשה עצמו":["חייב על מעשה שורו ופטור על מעשה עצמו","שורו שבייש ופטור","מעשה שור ומעשה אדם בנזיקין","שורו שחבל באביו חייב","שורו שהדליק גדיש בשבת חייב","מתחייב בנפשו בשבת"],"שור שהיה רודף אחר שור אחר והוזק":["שור רודף אחר שור והזיק","המוציא מחבירו עליו הראיה","שור גדול וקטן במחלוקת נזק","שני שורים רודפים אחד","ניזק אומר מועד ומזיק אומר תם","ניזק ומזיק בראיה על תם ומועד"],"שור שמועד למינו ולא לשאינו מינו מועד לאד":["מועד למינו ולא לשאינו מינו","מועד לשבתות ולא לחול","מועד לקטנים ולא לגדולים","מועד לאדם ולא לבהמה","סומכוס: מועד לאדם מועד לבהמה","אימתי הוא תם לאחר שבתות"],"ואינו מועד תנן הא סתמא הוי מועד":["ואינו מועד בסתם לא מועד","דרשה מסיפא מועד לקטנים","קרא לאדם ולבהמה חזרה","סומכוס: מק'ו מאדם לבהמה","שפרץ באותו המין","חזרה מבהמה חזרה היא"],"שור של פקח שנגח שור של חש ו חייב":["שור של פקח ושור חרש שוטה","שור האצטדין אינו חייב מיתה","אפוטרופוס לחרש שוטה וקטן","כי יגח ולא שיגיחוהו","נתפקח החרש חזר לתמותו","נתפקח החרש ונשתפה השוטה"],"שור חש ו שנגח לרבי יעקב משלם ח נ":["שור חרש שוטה שנגח לרבי יעקב","מועד ששמר שמירה פחותה","אפוטרופוס לתם לגבות מגופו","שמירה פחותה לתם ולמועד","מחלוקת ר' יעקב ורבי יהודה במועד","רשות משנה בנתפקח החרש"],"בראב י שאדם גדול הוא א ל ר נ לכשיבא לידך":["ר' אבהו: אדם גדול הוא","לכשיבא לידך הביאהו לידי","גדול שנתפקח ונתבגר בנזיקין","ר' נחמן ור' אבהו בבגרות","קטן שהגדיל במחלוקת","מי מכריע בגדלות המזיק"],"שאלו בחזקת תם ונמצא מועד בעלים משלמין ח ":["שאלו בחזקת תם ונמצא מועד","השואל חצי נזק בשור מועד","הועד בבית השואל והחזירו","החזרה לבעלים ושואל פטור","אם משתלם מגופו בלי נכסים","מי משלם כשנמצא מועד בשאלה"],"הועד בבית שואל והחזירו לבעלים משלמין ח נ":["רשות משנה ורשות אינה משנה","מי ששנה זו לא שנה זו","שואל פטור כשהוחזר לבעלים","בעלים בני חזקה בשור מועד","כל מקום שהולך שם בעליו","סתירה בין רישא לסיפא בשאלה"],"נוגח משלם את הכופר רובע אינו משלם את הכו":["נוגח משלם כופר רובע לא","רבעה ולא הרגה לאו כמאן דהרגה","רגל שדרסה תינוק לאביי ולרבא","שור האצטדין כשר למזבח","שור מעושה כשר למזבח","כופר בנגיחה ובריבוע"],"שור שנגח את האדם ומת":["שור שנגח אדם ומת כופר","תם פטור מכופר מועד משלם","שלשים סלעים בנגיחת עבד","חיוב מיתה לשור תם ומועד","נגיחת בן ובת כנגיחת אדם","עבד ואמה בנגיחה שלושים שקל"],"בעל השור נקי ר ע נקי מדמי עבד":["בעל השור נקי מדמי עבד","רבי עקיבא: נקי מדמי עבד","כשקדם בעליו ושחטו","מדוע כתב הכתוב בעל השור נקי","דמי עבד מעלייה לר' עקיבא","דמי עבד בתם ומועד"],"והמית איש או אשה ר ע להקיש אשה לאיש דנזק":["נזקי אשה כנזקי איש בכופר","דמי ולדות לבעל","הכה את האשה ויצאו ילדיה","ירושה בנזקי אשה ובעלה","שפחה שנשתחררה לדמי ולדות","כאשר ישית עליו בעל האשה"],"לא מוקמי כרבה וכשגבו מעות ולר נ כגון שגב":["שור שהמית עבד שלא בכוונה","כל זמן שהשור בסקילה משלמים","שלשים שקלים בעבד ששור הרג","כופר בבן חורין שלא בכוונה","הבעלים משלמים כופר כשהשור נסקל","המית שורי את פלוני משלם על פי עצמו"],"שור האשה היתומים האפוטרופוס המדבר ההקדש ":["שור של אשה ויתומים חייב מיתה","ר' יהודה: אין להם בעלים פטורים","שור המדבר והקדש פטורים ממיתה","שור גר שמת בלא יורשים","שור היוצא ליסקל והקדשו","מסירה לשומר חינם ולשואל בשור מזיק"],"שור שור שבעה להביא שור האשה היתומים האפו":["שור ליסקל ומתנה בשור מזיק","ר' יהודה פוטר אפילו נגח והקדיש","הפקר אחר נגיחה בשור מזיק","מה שור הגר פטור ממיתה","שור שהמית עד שלא נגמר דינו","מועד נשלם נזק שלם ותם חצי"],"שור שהמית עד שלא נגמר דינו מכרו מכור הקד":["שור שהמית לאחר גמר הדין","גמר דין שור בפניו או שלא בפניו","החזרת שומר לבית בעליו","מחלוקת ר' יעקב ותנא קמא","הרי שלך לפניך באיסורי הנאה","שור אינו בר טענה"],"קשרו בעליו במוסרה ונעל בפניו כראוי ויצא ":["קשרו בעליו במוסרה ונעל","שמירה לתם ולמועד ר' יהודה","ר' מאיר: תם וגם מועד חייבים","שמירה מעולה לשור מועד","שמירה פחותה בתם ובמועד","אין לו שמירה אלא סכין"],"דסתם שוורים אינן בחזקת שימור":["מועד בשמירה פחותה סגי","נגיחה לתם ונגיחה למועד","ריבוי אחר ריבוי בשמירה","צד העדאה ולא צד תמות","מועד לקרן ימין ולא שמאל","ולא ישמרנו לזה ולא לאחר"],"המשנה זו דברי סומכוס שממון המוטל בספק חו":["ממון המוטל בספק חולקין","סומכוס וחכמים בממון מוטל בספק","המוציא מחבירו עליו הראיה","כלל גדול בדין מוציא","חלוקה בספק נזק לסומכוס","הכרעת חכמים בספק ממון"],"אין שמין לפרה בפנ ע ולולד בפנ ע אלא שמין":["שמין לולד על גבי פרה","פרה מעוברת הזקתיך","מזיק שדה חבירו ושמין הולד","חולקין בפרה וולד","אין שמין לפרה בפני עצמה","הלכה: חולקין בפרה ובולד"],"הקדר שהכניס קדרותיו לחצר בעה ב שלא ברשות":["קדר שהכניס קדרותיו לחצר","הכניס פירותיו שלא ברשות","שור שנכנס לחצר שלא ברשות","נפל לבורו והבאיש מימיו","אביו או בנו לתוך הבור כופר","ר' אומר עד שיקבל עליו לשמור"],"שור שהתכוין לחבירו והכה את האשה ויצאו יל":["שור שהתכוין לחבירו ודמי ולדות","אדם המתכוין משלם דמי ולדות","שמין הולדות ונותן לבעל","כיצד משלם דמי ולדות","שפחה שנשתחררה פטורה מדמי ולדות","משהאשה יולדת משבחת"],"החופר בור ברה י ופתחו לרה ר או ברה ר ופת":["בור ברשות היחיד ופתחו לרשות הרבים","בור שבתורה הפקיר רשותו","כי יפתח וכי יכרה כסוי ואטימה","בעל הבור לרבי עקיבא ובעל התקלה","החופר ברשות הרבים ופתחו לרשות היחיד פטור","חורשין ומערות ברשות היחיד"],"החופר בור ברה י ופתחו לרה ר חייב וזהו בו":["בור של רשות היחיד בזמן אטימה","פתיחה חייב כל שכן כרייה","כרייה בעי שיאטום ופתיחה בכסוי","זהו בור האמור בתורה","חורשין ונעיצין ברשות הרבים","אין עושין חלל תחת רשות הרבים"],"החופר בור ברה ר ונפל לתוכו שור או חמור ח":["בור ברשות הרבים ונפל שור או חמור","חריצין ונעיצין חייבים כבור","למה נאמר בור כדי להמית","פחות מעשרה טפחים פטור במיתה","פחות מעשרה שהוזק חייב","בור שיש בו כדי להמית"],"בור של שני שותפין עבר עליו הראשון ולא כס":["בור של שני שותפין שלא כיסה","השני שעבר ולא כיסה חייב","שותפין בבור וחובת כיסוי","הראשון שעבר ולא כיסה","כיסוי בור בשותפות","בור משותף ואחריות בכיסוי"],"משכוכית כאן תרגמו קרקשתא ר יעקב עז ההולכ":["משכוכית ופירוש קרקשתא","עז ההולכת בראש העדר","כשהקדוש ברוך הוא כועס על בניו","מעוור עיני ראשי העם","שכוכית במשל ראשי העם","תרגום משכוכית ועז המובילה"],"כסהו הראשון ובא השני ומצאו מגולה ולא כסה":["כסוי כראוי ופטור מנזק בור","נפל לפניו מקול הכרייה חייב","שור וכליו נשברו חייב על הבהמה","חרש שוטה וקטן שנפלו לבור","בן או בת עבד או אמה פטור","כסוי לא כראוי ונפל שור חייב"],"אחד שור ואחד כל בהמה לנפילת הבור ולהפרשת":["שור וכל בהמה לנפילת הבור","דבר הכתוב בהווה שור או חמור","כלל ופרט בבהמה לשבת","השבת אבידה ופריקה וחסימה","לכלאים שור ואת חמור","למה נאמר שור או חמור"],"לנפילת הבור כסף ישיב לבעליו כל דיש לו בע":["כל בהמתך בשבת כלל ופרט","שבת בדברות הראשונות והאחרונות","דוקא מה שיש בפרט","כעין הפרט דבעלי חיים","שור לגבי מזבח וחמור לבכורה","אם שור או חמור ולא כל בהמה"],"כראוי דלת שיכולה לעמוד ברוח מצויה":["דלת כראוי לעמוד ברוח מצויה","דלת שאינה עומדת ברוח מצויה","דין דלת בנזקי כלים","חיוב על דלת שאינה כראויה","דלת כראוי כשיעור רוח","תנאי הדלת לחיוב המזיק"],"ארבעה דברים העושה אותן פטור מדיני אדם וח":["ארבעה דברים פטור מדיני אדם","פורץ גדר לפני בהמת חבירו","כופף קמת חבירו בפני הדליקה","השוכר עדי שקר פטור מדיני אדם","היודע עדות ואינו מעיד","חייב בדיני שמים אך פטור בדיני אדם"],"הני תנאי ור ש בן יהודה אמרו דבר אחד שמחש":["שמין נזק עתידי בחיה","נכי מזונות של מעוברת","דמי מיילדת מתוך דמי הולדות","דקל ואדמה בשומה","נהגו כרב נחמן בששים","ר' שמעון בן יהודה ודמי נזק עתידי"],"והלכה כר פ ורהבדר י בדקל ארמי פחות דמים":["הלכה כרב פפא בדקל ארמי","דקל פרסי כריש גלותא","דקל ארמי ודקל פרסי בשומה","הלכה בדקל משובח ופחות דמים","שמין דקל לפי מקומו","מחלוקת ארמי ופרסי בדקל"],"לבש נעליים רצועות שחורות ועמד בשוק נהרדע":["נעליים רצועות שחורות לאבל ירושלים","יוהרא באבל על ירושלים","הקוצץ תמר בוסר כמה משלם","בששים ולא בשישים","שמואל חי ובית דין קיים","אדם גדול בנהרדעא ושאלוני"],"המגדיש בתוך שדה חבירו שלא ברשות":["המגדיש בשדה חבירו שלא ברשות","עד שיקבל עליו בעל הבית לשמור","שומר הגרנות עלה וגדוש","גדיש ברשות בעל השדה חייב","בהמה שאכלה מגדיש חבירו","מגדיש וזרע בשדה חבירו"],"דאמר עד שיקבל עליו בעה ב לשמור":["כאומר עלה ואשמור לך","שומר גרנות וגדישה","מדובר בשומר הגרנות","אם מקבל על עצמו שמירה","גדיש ואחריות שומר","מדובר ברשות בעל השדה"],"השולח את הבערה ביד חש ו פטור בדיני אדם ו":["השולח בערה ביד חרש שוטה","המביא את העצים והמביא את האור","המלבה והרוח שליבתה","מסר גחלת וליבה ומסר שלהבת","מעשי המשלח גרמו לנזק","שולח אש ביד פקח ביד חרש"],"רק במסר גחלת וליבה אבל מסר שלהבת חייב דמ":["מסר שלהבת חייב מעשיו גרמו","מסר שלהבת פטור מעשה החרש","מסר ענפים עצים ונר","מעשי המשלח בוודאי","גחלת שמסרה לאחר וליבה","הפטור בהבערה על ידי חרש"],"השולח את הבערה ואכלה עצים או אבנים או עפ":["השולח את הבערה ואכלה עצים","כי תצא אש ומצאה קוצים","אין פורענות אלא בזמן שרשעים","גדיש ואבנים ועפר בשליחת אש","שמתחיל מן הצדיקים תחלה","כל בעלי קומה בהבערה"],"גדיש אפי דלא מצוי אש גבייהו":["מה קמה בגלוי אף כל בגלוי","או הקמה ולחלק או השדה","לאתויי חכה נירו וסכסכה","ואתם לא תצאו מפתח ביתכם","כי מפני הרעה נאסף הצדיק","לעולם יכנס אדם בכי טוב"],"עברה גדר שהוא גבוה ד אמות או דרך הרבים א":["עברה גדר גבוהה ארבע אמות","שדה קוצים ומשפת הקוצים","בקולחת ובנכפפת לעניין הגדר","נהר או שלולית ברוחב שמונה אמות","תנא דידן מלמעלה למטה","בהמה שעברה גדר ונזקה"],"עברה גדר שהוא גבוה ד אמות חייב":["גדר גבוהה ארבע אמות ודין פטור","שלולית רחבה שמונה אמות פטור","נכפפת מאה אמה או מאה מיל","מתני' בנכפפת ובקולחת","עצים מצויין לה מאה מיל","הבדל בין קולחת לנכפפת"],"המדליק בתוך שלו עד כמה תעבור הדליקה":["המדליק בתוך שלו עד כמה תעבור","שש עשרה אמה כדרך רשות הרבים","חמישים אמה בהדלקה","הכל לפי הדליקה לר' שמעון","ר' עקיבא: כאילו באמצע בית כור","שיעור התפשטות הדליקה"],"המדליק את הגדיש והיו בו כלים ודלקו":["המדליק את הגדיש והיו בו כלים","רבי יהודה: משלם מה שבתוכו","חכמים: רק גדיש של חטין ושעורין","מדליק את הבירה משלם הכל","גדי כפות ועבד סמוך לו","כלים שדרכן להטמין בגדיש"],"מחלוקת במדליק בתוך שלו והלכה ואכלה בתוך ":["מדליק בשלו והלכה לשל חבירו","כלים שאין דרכן להטמין בגדיש","רואין מקום כלים כאילו מלא תבואה","מדליק בשל חבירו משלם הכל","כלי בקר ומוריגין בגדיש","מחלוקת ר' יהודה וחכמים בטמון באש"],"גץ שיצא מתחת הפטיש והזיק חייב":["גץ שיצא מתחת הפטיש","גמל טעון פשתן ברשות הרבים","נר חנוכה פטור לר' יהודה","הניח חנוני נרו מבחוץ","נר חנוכה בתוך עשרה טפחים","גמל ורוכבו ונר חנוכה בשוק"],"ש מ מדר י נר חנוכה מצוה להניחה בתוך עשרה":["נר חנוכה בתוך עשרה","למעלה מעשרים אמה פסולה","עוסק במצוה לא הטריחוהו","כסוכה וכמבוי פסולה למעלה","נר חנוכה למעלה מעשרה","הדלקה גבוהה ופטור"],"דאף בטוען טענת גנב וטבח ומכר משלם דו ה ו":["טוען טענת גנב וטבח ומכר","תנא ושייר במרובה","אין בין תני מרובה","תשלומי כפל לטוען טענת גנב","הסיועא שאין בין","טענת גנב ודין תשלומי כפל"],"כל ריבוי בכל כלל":["כל ריבוי בכל כלל","בכל כלל ופרט במעשר","כל כלל הוא כל דכאן ריבוי","על כל דבר פשע כלל לכל פשיעה","כי יתן איש סתם וכסף כלים פרט","כלל ופרט וחזר וכלל"],"דכל ריבוי כל הני פרטי למעט א קרקע ב עבדי":["למעט קרקע ועבדים ושטרות","על כל אבידה טוען טענת גנב","היכן פקדוני אבד משביעך אני","הודה על פי עצמו משלם קרן וחומש","נגנב ורק בשבועה משלם כפל","ונקרב בעל הבית לשבועה"],"יאמר שור וגניבה והיינו דתנא אחיים סמיך ו":["אם המצא תמצא שור וגניבה","שני כללות סמוכים ופרט ביניהם","גניבה לרבות כל דבר","חיים ואם המצא ודרשת כלל ופרט","דבר שאין בו בעלי חיים","לרבות כל בהמה וחיה ועוף"],"גניבה וחיים כרב דאחייה שלם לקרן כעין שגנ":["גניבה וחיים כרב אחייה שלם","המרשיע את עצמו פטור","אם המצא בעדים תמצא בדיינים","מודה בקנס ואחר כך באו עדים","אשר ירשיעון אלהים","שגנב עצמו חייב רק בשבועה"],"א קרן כעין שגנב תשלומי כפל ודו ה כשעת הע":["קרן כעין שגנב ותשלומי כפל כשעת הדין","כחושה שהשמינה או שמינה והכחישה","אפטם ואתה תיקח","שווי ארבע לבסוף זוז","בחבית בשבר בידים ובנשבר","מה לי קטלה כולה מה לי קטלה פלגא"],"בעה ב שטען טענת גנב בפקדון ונשבע והודה ו":["שטען טענת גנב בפקדון ונשבע והודה","הודה לפני שבאו עדים","הודה אחר שבאו עדים כפל ואשם","חומשו עולה בכפילו","אין חומש ואשם במקום כפל","בתחילה ד' ולבסוף ד' חמישיות"],"בראשו וחמישיתו רק ממון המשתלם בראש מוסיף":["ואת אשמו פסקו קרא","את מפסיק בין ממון גבוה להדיוט","ו' החיבור בפסוק ערבו קרא","בראשו וחמישיתו ואת אשמו","אשם מביא אף דבר שאין כפל","פסוק ואת אשמו ואין כפל"],"גנב טלה ונעשה איל עגל ונעשה שור נעשה שינ":["גנב טלה ונעשה איל","שינוי בידו וקנאו","שינוי קונה בגניבה","עגל ונעשה שור בגזלה","הגזילה נשתנתה ונקנית","גנב והפך לבהמה אחרת"],"שינוי קונה כתיבא ותנינא":["שינוי קונה כתיבא ותנינא","השיב את הגזלה כעין שגזל","גוזל עצים ועשאן כלים","צמר ועשאן בגדים משלם כשעת הגזילה","לא הספיק ליתנו עד שצבעו פטור","שינוי קונה בגזל"],"מניין לשנוי שהוא קונה ד והשיב את הגזלה":["מניין לשינוי שהוא קונה","אשר גזל למעט גזל אביו","אין מוסיפין חומש על גזל אביו","והשיב את הגזלה לדרשה","למה לא נכתוב אשר גזילו","גזל אביו ופטור מחומש"],"אי לאו דארי ו צנועין ורבי דוסא אמרו דבר ":["צנועין ורבי דוסא בדבר אחד","מעשר ממון גבוה ופדייה","כרם רבעי ולחילול","לקט ממונו והפקרה","מה בגנב עשו תקנה לעניים","תנא דצנועין הוא רבי מאיר"],"לא כתבינן אורכתא הרשאה לתביעה אמטלטלי":["לא כותבין אורכתא לתביעת מטלטלין","גזל ולא נתייאשו הבעלים","שניהם אינם יכולין להקדיש","כופר ונראה כשקר","אורכתא בקרקע וטענה כפירה","הרשאה לתביעה במטלטלין"],"גנב ע פ שנים וטבח ומכר על פיהם או על פי ":["גנב וטבח על פי שני עדים","גנב ומכר בשבת או לעבודה זרה","תשלומי ארבעה וחמשה לדעת חכמים","ר' שמעון פוטר לאו שמיה שחיטה","דבר ולא חצי דבר בעדות","שחיטה בעזרה וטריפה"],"מתני דלא כר ע ד דבר ולא חצי דבר":["עדים לגניבה ולא לטביחה","דבר קרינא ביה ולא חצי דבר","שנים אומרים באחד בגבה ואחד בכריסה","אחד אומר בלא חצי עדות","עדי ביאה וקידושין","אבא חלפתא ורבנן בשנה ראשונה"],"גנב וטבח ומכר ע פ שנים ונמצאו זוממים משל":["נמצאו זוממין משלמין הכל","ראשונים משלמין כפל ואחרונים ג'","אחד מהראשונים זוממין בטלה כל העדות","אחד מהאחרונים זוממין בטלה עדות שניה","אם אין גניבה אין טביחה ואין מכירה","זוממין בעדות גניבה וטביחה"],"עדים שהוכחשו ולבסוף הוזמו נהרגין דהכחשה ":["עדים שהוכחשו ולבסוף הוזמו","הכחשה תחילת הזמה","מעידין שסימא את עין עבדו","שהרי הרב אומר כן בעדות","שן ועין בעדי זומם","עדים מציעאי משלמין דמי עין"],"גנב ע פ שנים וטבח ומכר ע פ עד אחד או ע פ":["גנב וטבח על פי עד אחד משלם כפל","גנב וטבח בשבת לעבודה זרה","קדשים שחייב באחריותם לר' שמעון","גנב והקדיש ואחר כך טבח ומכר","על פי עצמו משלם רק כפל","ר' שמעון: קדשים באחריותו"],"גנב והקדיש ואח כ טבח ומכר משלם כפל אבל ל":["גנב והקדיש ואחר כך טבח ומכר","אין טביחה לדבר הקדש","כשטבח הקדש לא מחייב","כפל אבל לא תשלומי דו'ה","הקדש שנשחט ונמכר ברשותו","גנב והקדיש ואחר כך טבח"],"הרי עלי עולה והפריש שור ובא אחר וגנב שלר":["הרי עלי עולה והפריש שור","מי פטר גנב עצמו בכבש","ר' שמעון חייב דו'ה בגניבת קרבן","הרי עלי עולה ובן יונה","כבש לרבנן ותור לדעה שניה","קיבל שם עולה או מצוה מן המובחר"],"מכרו חוץ מאחד ממאה שבו או שהיתה לו בו שו":["מכר חוץ מאחד ממאה שבו","שותפות בבהמה שנגנבה ונשחטה","השוחט ונתנבלה בידו משלם כפל","הנוחר והמעקר בגניבה","כפל ולא ארבעה וחמשה בשותפות","טביחה שנתנבלה ותשלום כפל"],"הגונב הקיטעת חיגרת וסומא וכן הגונב בהמת ":["הגונב הקיטעת חיגרת וסומא","שותפין שגנבו פטורין","שותף שגנב מחבירו פטור","שותף שגנב מעלמא חייב","טביחה לדעת חבירו ושלא לדעת","גניבת בהמת השותפין"],"גנב ונתן לאחר וטבח גנב ונתן לאחר ומכר גנ":["גנב ונתן לאחר וטבח","שליח לדבר עבירה בטביחה","גנב ופרע חובו משלם דו'ה","גנב ושלח סבלונות לחמיו","גנב והקדיש ומכר להדיוט או לשמים","גנב והחליף ונתן במתנה"],"גנב ברשות הבעלים וטבח ומכר חוץ מרשותם":["גנב ברשות הבעלים וטבח חוצה לה","היה מושכו ומת ברשות הבעלים פטור","הגביהו או הוציאו מרשות הבעלים חייב","נתנו לבכורות בנו או לבעל חוב","שומר חנם ושואל ושוכר בגניבה","גנב וטבח ברשותם פטור"],"אין מגדלין בהמה דקה בארץ ישראל":["אין מגדלין בהמה דקה בארץ ישראל","תרנגולין בירושלים מפני הקדשים","לא יגדל אדם כלב אלא בשלשלת","נישובים ליונים רחוק ל' ריס","גזירה על הצבור ורוב יכולין לעמוד","משהה בהמה קודם לרגל ל' יום"],"אבל מגדלין בהמה דקה בחורשין שבארץ ישראל":["מגדלין בהמה דקה במדברות","גזירה על הציבור והבהמה הדקה","משהה קודם לרגל ומשתה בנו","לוקח ושוהה ולא את העגונה","אי יצא הרגל לא נתירו להשהותה","טבח לוקח ושוחט ושוהה"],"א מתריעין על החיכוך בשבת ב ודלת הננעלת ל":["מתריעין על החיכוך בשבת","דלת הננעלת לא במהרה תפתח","הלוקח בית בארץ ישראל כותבין עליו אונו","חגב זבוב צירעה ויתוש צועקים","שחין מצרים לח מבחוץ ויבש מבפנים","לוקח עיר בארץ ישראל כופין דרך"],"עין תחת עין נפש תחת נפש ולא נפש ועין תחת":["עין תחת עין ממון ולא ממש","פצע תחת פצע צער במקום נזק","ורפא ירפא רפואה במקום נזק","תחת תחת משור מה להלן ממון","דנין נזקין מנזקין ולא ממיתה","אדם מאדם ולא אדם מבהמה"],"עין תחת עין ממש ולא שחלק על כולם":["עין תחת עין ממש לא בכל","חמור שקטע יד תינוק","שישומוהו כעבד ולא בן חורין","שור שלעס יד תינוק שישומוהו כעבד","גובין בבבל נזקי שור בשור","שומה כעבד לתשלום בבבל"],"המבייש את הערום את הסומא את הישן חייב וי":["המבייש ערום סומא או ישן","נפל מן הגג והזיק ובייש","ביישו בבית המרחץ לעומת השוק","הרוח הסירה חלק מבגדיו","פטור על הבושת עד שיתכוין","ביישו ערום לעומת ביישו לבוש"],"ביישו ערום חייב ואינו דומה ביישו ערום לב":["ביישו בערום ובבית המרחץ","שיעור הבושת לפי מקומו ומצבו","ביישו ערום שונה מביישו לבוש","ביישו על גב הנהר לדעת ר\"פ","חיוב בושת בפומבי ובהיחבא","בושת הנבוש לפי כבודו במקום"],"מחייבי גליות ד בלא ראות":["סומא בגדר מחייבי גליות","מיעוט בלא ראות ובלי דעת","מיעוט אחר מיעוט בבלי דעת","בבלי דעת פרט למתכוין","דרשת ואשר יבוא את רעהו לסומא","סומא שאינו בכלל רוצח"],"חייבי מיתות ב ד אתיא רוצח רוצח מחייבי גל":["גזירה שוה רוצח לחייבי גליות","רוצח מחייבי מיתות לגלות","היקש רוצח לרוצח מגליות","גלות לרוצח מדין בית דין","אתיא רוצח רוצח","למד חייבי מיתות מחייבי גליות"],"חייבי מלקיות אתיא רשע רשע מחייבי מיתות ב":["גזירה שוה רשע לחייבי מלקות","סומא ואין לו בושת לענין מלקות","בושת הסומא ופטורו מן המצוות","מלקות לרשע ודין סומא","ר\"י בדין סומא ופטורו מן המצוות","סומא בכל מצוה ומצות האמורות"],"זה חומר באדם מבשור":["חומר באדם מבשור בתשלומי נזיקין","ארבעה תשלומים באדם ושור רק נזק","שישה תשלומים לאדם מול שור","חובל בעבד עברי ובעבד כנעני","עבד ואשה בפגיעה רעה","חבלה בשבת ופטור מכולן"],"לא יומתו אבות על בנים לא יומתו על פי אבו":["לא יומתו אבות על בנים לעדות","חייס למעלה ולמטה בעדות","פסול העבד והגר לעדות","לא יומתו בעדות בנים","קל וחומר מגר לעבד בפסול עדות","עבד שאין לו חייס פסול לעדות"],"טובת הנאה לאשה":["טובת הנאה של האשה ולא של הבעל","הבעל אינו אוכל פירות אשתו","תקנת חכמים לבעל בפירות בלבד","טובת הנאה לבעל ולאשה בעדים","פירות נכסי אשה ותקנת הבעל","רווח הבית ואשת הבעל"],"התוקע לחבירו נותן לו סלע ר י משום ר יוסי":["שיעור בושת לפי כבוד הנבזה","התוקע לחבירו סלע או מנה","סטירה ולפי כבודו של הנפגע","תשלום בושת הכל לפי הכבוד","פרע ראש האשה בשוק ודמי בושתה","כבוד העני ותשלום הבושת"],"יש אומד לנזקין או לא":["אומד בנזיקין שלא כאומד למיתה","בור פחות מעשרה טפחים ונזק","עבד שהוכה בעינו ויצא לחירות","מבעית את חבירו פטור מדיני אדם","המבעית את עצמו בהיזק עין ואוזן","השוואת אומד הנזק למיתה"],"אמדוהו והבריא נותנין לו כל מה שאמדוהו":["אמדוהו והבריא לחצי יום","אומד הנזק כשהבריא מוקדם","הבריא לחצי יום ועבד","חישוב הנזק לפי האומד במחלה","אומדים שהבריא מחלקו מן היום","השלמת היום למי שאמדוהו"],"דקל שטען קב אסור לקוצצו":["דקל שטען קב אסור לקוצצו","קציצת עץ מאכל והיתר במעולה בדמים","איסור קצוץ עץ מאכל על פי שיעור","כמה קב בדקל לאסור קציצה","תמרים בין הגפנים וטעמם","עקירת דקלים בין הגפנים"],"אף על פי שהוא נותן לו אין נמחל לו עד שיב":["מחילה בנזק צער ודמי בושת","האומר סמא את עיני ע\"מ לפטור","תנאי לפטור בנזקי גוף וממון","צער שאינו נמחל בלי בקשה","דרך ארץ לאכסנאי ואשת האיש","בקשת מחילה ותשלום הצער"],"כל אלו שאמרו דמי בושתו אבל צערו אפי הביא":["שתי עצירות באיש ובאשה","ג' עצירות באיש ובאשה","עצירת הרחם ופי טבעת","אבימלך ולימוד דרך ארץ לבן נח","תרנגולת של בית אבימלך","סוגי עצירה לאיש ולאשה"],"עצים ועשאן כלים אבל לא שיפן צמר ועשאן בג":["שינוי שחוזר לברייתו בגזילה","עצים לכלים ושינוי דאורייתא","גזילה שנשתנתה ומשלם כשעת הגזילה","שינוי חוזר ושינוי שאינו חוזר","צמר ועשאו בגדים בגזל","שינוי במקומו עומד או חוזר"],"כל אלו ס ל דשינוי במקומו עומד רשב י וב ש":["שינוי במקומו עומד בחטין וזיתים","חטין לסולת ואתננה אסור או מותר","גזלן שהשביח נוטל שבחו","בוצע ברך נאץ בגזל חטין","הפרשת חלה מחטין גזולות","גזלן שהשביחה ורשות הבעלים"],"דבר תורה גזילה הנשתנית חוזרת בעיניה והשי":["הלכה כסתם משנה בשינוי גזילה","צבועה שלא הוחזרה לבעליה","עצים משופין לכלים בגזל","גזילה שלא הוחזרה וצבעה","שינוי החוזר לברייתו ופטור","גזילה נשתנית ותקנת השבים"],"הגזלנין ומלוי ברבית שהחזירו אין מקבלין מ":["אין מקבלים מגזלנים ומלוי ברבית","תשובה של גזלן וחזרה בלי קבלה","יורשים שהניחו מעות רבית","אשה שמונעת מבעלה לעשות תשובה","מלוי ברבית שמת ומחזירין","הגבאים והמוכסין ותשובתם קשה"],"גזילה חוזרת בעיניה ר ש רואין כאילו היא ש":["שבח על גבי גזילה לר\"י ולר\"ש","גזלן שהשביח ולוקח למחצה","פרה שנתעברה וילדה אצל הגזלן","גזילה חוזרת בעיניה ושומא בכסף","רחל שנטענה וגזזה אצל הגזלן","ולד הגזילה ושיעור השבח"],"גזל והשביח ומכר או הוריש מה שהשביח מכר א":["גזל דקל וקצצו אינו קונה","שינוי שם הגזילה וקניינה","גזל לולב ועשאו עלים","השבחת גוי בגזילה ישראל","קורות שנעשו קטנות וקרשים","גזלן שמכר ושינה שם החפץ"],"גזל בהמה והזקינה עבדים והזקינו משלם כשעת":["הזקנה והרקבה בגזילה משלם כשעת","מטבע שנפסל ותרומה שנטמאת","חמץ שעבר עליו הפסח בגזל","בהמה שנתעבדה בה עבירה","עבדים שהזקינו והשבת הגזל","גזילה שנפסלה ויצאה ליסקל"],"מטבע של ירושלים צד אחד דוד ושלמה צד שני ":["מטבע ירושלים וצד דוד ושלמה","מטבע אברהם אבינו וזקן וזקינה","הדמויות החקוקות על המטבעות","צדי המטבע של אברהם ויצחק","מטבע ירושלים עיה\"ק","צורות המטבעות של האבות"],"נתן לאומנין לתקן וקלקלו חייבין לשלם":["אומן שקלקל בתיקון חייב לשלם","נותן עצים לאומן לעשות כלי","אומן קונה בשבח כלי","סתירת כותל ונפילה מצד אחר","צמר לצבע והקדיחו יורה","שידה תיבה ומגדל לנעץ מסמר"],"דווקא שנתן לחרש שידה תיבה ומגדל לנעץ בהן":["אומן קונה בשבח כלי או לא","שמואל ורב אסי באומן ושבח","צמר לצבע ויציאת השבח","הקדיחו בשעת נפילה או אחריה","הנותן דמי צמרו ולא דמי שבחו","צבע בשכר ידו לוקח"],"טבח אומן שקלקל חייב לשלם מזיק הוא פושע ה":["טבח אומן שקלקל חייב לשלם","הדיוט ואומן בהנותן בהמה לטבח","תם ומועד לר\"מ בנזקי אומן","נשברה כדו או נפלה גמלו","נתקל פושע ונזקי טבח","השמירה על עצמו בשחיטה"],"טבח אומן שקלקל חייב ואפילו הוא אומן כטבח":["טבח שקלקל ושכרו חייב","טבח כטבחי ציפורי ומומחיותו","שחייב טבח שנתן בו שכר","טחינה ששינתה חטים לסובין","נחתום שעשה פת ניפולין","בהמה שנעשתה ניבלה בידי טבח"],"פטר טבח מלשלם בהגרמה כשהיטה חוץ לטבעת הג":["טבח שהיטה חוץ לטבעת הגדולה","הגרמה לטבח ופטור מתשלום","הולך רכיל מגלה סוד בהטרפה","הטריף כרבנן ושחייבו לשלם","טבח שמתיר ספק איסור לאכילה","פגע בך בשנים ודין הטבח"],"לזו שהראתהו דינר שהוא טוב ולמחר באה ואמר":["מומחה למטבע ודינר שנמצא גרוע","לפנים משורת הדין בדינר","דרשת והודעת להם לפנים משורת הדין","דין מומחים למטבע בהטעיה","הרואה דינר טוב ונמצא גרוע","רבי מאיר דן דין דגרמי"],"הנותן צמר לצבע והקדיחו יורה נותן לו דמי ":["צמר לצבע והקדיחו יורה","צבע לאדום ונצבע שחור","שבח הצבע לעומת היציאה","צבע כאור ושיעור השבח","עצים לחרש לכסא או לספסל","שכר הצבע על פי היציאה והשבח"],"כאור כלבוס כפרא דודי שיירי הצבע שביורה":["עצים לחרש שעשה כסא לספסל","מודה ר\"מ בכסא נאה שנעשה כעור","שבח מתנה נאה וכעור ליציאה","שיירי הצבע שביורה","כלבוס וכפרא דודי בצבע","תשלום יציאה לפי שבח הכסא"],"הנותן מעות לשלוחו ליקח לו חטין ולקח מהם ":["שליח שקנה שעורין במקום חטין","שינוי בשליחות קונה לר\"מ","הרווח בשליחות מעות לחטין","המקדיש נכסיו וכסות אשתו","גזבר ושליחות בכסות ובנעליים","הותירו לשליח או לאמצע"],"הלוקח שדה בשם חבירו אין כופין אותו למכור":["לוקח שדה בשם חבירו ואין כופין","לוקח בשם ריש גלותא ואין כופין","על מנת לכופין למכור שדה","כפייה למכור שדה לריש גלותא","קנין על מנת שכופין את המוכר","כפיית המוכר למכור פעם נוספת"],"ואם אמר לו על מנת כופין את המוכר למכור":["אמנה בפשתן ולא בדמים","פשתן שהתייקר ומכר בעליו","אמנה בפירות ולא בדמים","עדים לשטר מכירה נוסף בפניו","ריבית בהקנאת פשתן שנתייקר","כשקנית אמרו פשתנו של ר\"כ"],"הגוזל את חבירו שוה פרוטה ונשבע לו יוליכנ":["גזלן ששוה פרוטה שנשבע","הוליכו אחריו למדי בשבועה","נתן הקרן ונשבע על החומש","מחילה על הקרן ולא על החומש","שוה פרוטה במחילת הקרן","שבועה על פקדון וקרן וחומש ואשם"],"הכופר בפקדון נעשה עליו גזלן וחייב באונסי":["כופר בפקדון נעשה גזלן","כחש בה ונשבע על שקר לעונש","שבועה קונה ולא כפירה","עדים שבאו אחרי השבועה","חשוד על שבועת עדות בפקדון","לאזהרה ולעונש בלא תכחשו"],"מנה לי בידך והלה אומר אין לך בידי כלום ו":["ולקח בעליו ולא ישלם בשבועה","פטור מלוה כשנשבע והעדים באו","שבועה במלוה ובפקדון לרב","היכן פקדוני אבד ואמן","נגנב ונשבע חוץ לבית דין","קפץ ונשבע פטור מכפל"],"היכן פקדוני אמר לו אבד משביעך אני ואמר א":["גזל את אביו ונשבע לו ומת","קונם אי אתה נהנה משלי","כפל בפקדון שנגנב ונשבע","קרן וחומש ואשם לבנים ולאחים","בעלי חוב שנפרעים מגזלן מת","נדר שלא ליהנות מנכסי האב"],"לה לכהן קנאו השם ונתנו לכהן שבאותו משמר ":["גזילה שחזרה למשמרת של כהן","גזל כהן וקרבן משמרת","כהן גזלן ומתנת הכהונה","גזל הגר נכנס לרשות הכהנים","שדה היוצאה לכהנים ביובל","אשם לכהן מלבד איל הכפורים"],"גזל את הגר ונשבע לו ומת משלם קרן וחומש ל":["גזל הגר ומתנתו למשמרת","אשם ירעה עד שיסתאב","אשם ליהויריב וכסף לידעיה","נתן הקרן ולא החומש בגזל הגר","הביא אשמו לפני גזילו","מתנה לכהן של משמרת אחרת"],"אשם זה קרן המושב זה חומש שהרי אומר מלבד ":["אשם זה קרן והמושב זה חומש","השבת גזל הגר בלילה או לחצאין","השבה שוה פרוטה לכל כהן","הביא לידעיה במשמרת יהויריב","מדרש אשם המושב בגזל הגר","חומש מעכב או אינו מעכב"],"אשר גזל יחזיר כעין שגזל":["גדולים חייבים קטנים פטורים בגזילה","הגוזל ומאכיל את בניו","יתומים שירשו ותובע על בית האב","עדים שלא בפני בעל הדין לסומכוס","תינוק שתקף בעבדיו ושדה חבירו","כעין שגזל ודין הקטנים"],"אין פורטין לא מתיבת המוכסין ולא מכיס של ":["אין פורטין מכיס המוכסים והגבאים","נטילת צדקה מן המוכסין","פריטת דינר ממעות הגבאים","נתינת דינר לנגזל כמציל מידו","מציל מידם של מוכסין וגבאין","דינר לגבאי ונותן את השאר"],"אין פורטין אבל נותן לו דינר ונותן לו את ":["נותן לו דינר ונותן לו את השאר","כמציל מידו בפריטת מעות","פריטה מכיס גבאין כמציל","אין פורטין אלא נותן דינר שלם","דין המציל מיד הגבאין","חיוב פריטה כמציל מידו"],"נטלו מוכסין חמורו ונתנו לו חמור אחר נטלו":["נטלו מוכסים חמור ונתנו אחר","נחיל דבורים שנתייאשו הבעלים","יאוש הבעלים ודין המציל מן הנהר","נאמנת אשה לומר נחיל יצא","מהלך בשדה חבירו להציל נחילו","קוצץ סוכו ונותן את הדמים"],"המכיר כליו וספריו ביד אחר ויצא לו שם גני":["כליו וספריו ביד אחר ושבועת הלוקח","יצא שם גניבה בעיר ובעל הבית","מחתרת ובא לגנוב פטור מכלים","קינון כלים במחתרת ובעל הבית","בעל הבית העשוי למכור כליו","מחתרת שמסר נפשו להריגה"],"ולא חוששים שלא נגנב ושהוא עצמו הוציא קול":["בעל הבית שאינו עשוי למכור","אנבורקראות של כלים בכתף","הוציא קול גניבה בביתו בעצמו","לא חוששים שמא נצרך למעות","שם גניבה בעיר כסימן לגזל","מי שהוציא קול שנגנב לו"],"גנב ומכר ואח כ הוכר הגנב":["גנב ומכר ואחר הוכר הגנב","לפני יאוש ולאחר יאוש בגזילה","מתנות כהונה במכירת מעיה של פרה","מתנות כהונה נגזלות או לא","הטבח ששקל לו ונותנו לכהן","חלוקה ביאוש והדין עם השני"],"גנב ופרע בחובו גנב ופרע בהיקיפו לא עשו ב":["גנב שפרע בחובו ותקנת השוק","היקף חוב במשכון גנוב","תקנת השוק בשוה בשוה","משכון שוה מאתים במאה","אמימר ותקנת השוק לפי הלכה","שלא על דעת זו נתתם המשכון"],"מכר שוה בשוה עשו בו תקנת השוק":["גנב גלימא והלוואה שניה","ספר שנגנב ונמכר מיד ליד","בכל עשו תקנת השוק חוץ מגנב","גנב שמכר לפפונאה ולבר מחוזאה","מכר שוה מאה במאתן לר\"ש","לוקח מלוקח ותקנת השוק"],"זה בא בחביתו של יין וזה בא בכדו של דבש נ":["הצלת כלי חבירו בשכר בלבד","הציל את של חבירו והזכה בשכר","נסדקה חבית דבש ושפך יינו","שטף נחל חמורו וחמור חבירו","אציל את שלך ואתה נותן לי","הצלה בתשלום או בשכר בלבד"],"ולא יכול לומר שזכה מההפקר כדתניא הרי שהי":["לא זכה מן ההפקר במשברי יין ושמן","תרומה ומעשר על פירות שבביתו","הכרזה על יין ושמן שנשברו","עקל בית הבד כרוך עליה","הפקר כשהכלים משתברים בדרך","אמר הרי זה תרומה ולא אמר כלום"],"שיירא שהיתה מהלכת במדבר ועמד עליה גייס ל":["שיירא שנטרפה במדבר ונזק הממון","חמרין שהתנו להעמיד חמור אחר","שמירת שנים משמירת אחד","מחשבין לפי ממון ולא לפי נפשות","בפשיעה אין מעמידין חמור","תייר ששכר לצורך נפשות"],"הגוזל שדה מחבירו ונטלוה מסיקין":["שדה שנטלוה מסיקים של מדינה","הגזלן שהעמיד שדה אחר","מציקין או מסיקין בגזילת שדה","מכת מדינה ופטור הגזלן","במצור ובמצוק בשדה הגזולה","יירש הצלצל ותרגום יחסניניה"],"מאן דתני מציקין לא משתבש ד במצור ובמצוק":["מציקין במצור ובמצוק","מסיקין בתרגום יחסניניה סקאה","שדה שנטלוה מסיקין ואין שבש","מאן דתני מציקין ומאן דתני מסיקין","יירש הצלצל בגירסה","לשון הגרסה בגזילת שדה"],"הגוזל את חבירו או שהלוה הימנו או שהפקיד ":["החזרת גזילה במדבר ובישוב","מלוה ניתנה ליתבע בכל מקום","אבידה ופקדון רק במקומן","על מנת לצאת למדבר","מקום ההחזרה לפי סוג התביעה","הלוה מחבירו והפקיד בישוב"],"מלוה ניתנה ליתבע בכל מקום אבידה ופקדון ר":["מלוה ליתבע בכל מקום","אבידה ופקדון רק במקומם","מקום התביעה לפי סוג החוב","הבדל בין מלוה לפקדון במקום","אבידה שנתבעת במקומה בלבד","סוג התביעה ומקום הדין"],"האומר לחבירו גזלתיך הלויתני הפקדת אצלי":["איני יודע מה מן התביעות חייב","החזרה שלא נודעה לתובע","אמר לו איני יודע ופטור מלשלם","ספק בטענות גזילה ולוה ופקדון","תביעה שאינה ידועה ואינו משלם","ספק החזרה בתביעה כללית"],"הגונב טלה מן העדר והחזירו ומת או נגנב חי":["גנב טלה והחזירו מנה ומת","דעת הבעלים בחזרת הטלה","מנו את הצאן ושלמה פטור","הגונב טלה ולימוד הגנב לצאת","סלע מן הכיס לר\"ש ולר\"ע","הבעלים מודעים לגניבה ולחזרה"],"לדעת בעלים צריך דעת בחזרה שלא לדעת מנין ":["סלע מן הכיס ורי\"ש לחזור למקום","אדם עשוי למשמש בכיסו","כולם סברו כר\"צ בכיס","גנב מכיס יחזיר למקום שגנב","שלא לדעת ולדעת בגניבת כיס","החזיר למקום שגנב או לדעת"],"אין לוקחין מן הרועים צמר וחלב וגדיים":["לוקחים מן הרועים כלי צמר ופשתן","רועה שמוכר וכשבעל הבית מרגיש","לוקחים ארבע וחמש צאן מן הרועה","שתי צאן ושתי גיזין אסורים","בייתות לוקחים ומדבריות אסורים","ביצים ותרנגולין מכל מקום"],"אין לוקחין מן הרועים עזים גדיים וגיזין ו":["עזים וגדיים מן הרועה אסורים","תפורין לוקחים כי שלהם הם","חלב וגבינה במדבר ולא בישוב","ד' מתוך חמשה מעדר קטן וגדול","שלוש צאן מסיפא ומרישא בכחושות","לקיחה מרועה שלא הרגיש בעל הבית"],"מוכין שהכובס מוציא הרי אלו שלו והסורק מו":["מוכין שהכובס מוציא לעצמו","כובס שנוטל שני חוטים העליונים","סורק וחייט ושאריות הבד","חרש שמוציא במעצד הנסרים","מטלית שלוש על שלוש לבעל הבית","נסרים שעשה אצל בעל הבית"],"לוקחין מוכין מן הכובס מפני שהן שלו":["כובס שנוטל ג' חוטין בקטנים","לא יטיל יותר משלושה חובין","סריקה לשתי וערב בבגד","סרבלא לשתיו ומשוהו לארכו","השוואת הבגד עד טפח","מוכין לקניית הכובס"]}