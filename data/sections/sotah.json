},
{
"daf": "ח:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 568,
"text": "היתה מכוסה לבנים וכו'.",
"next": ""
},
{
"daf": "ח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 571,
"text": "היו עליה כלי זהב מעבירין ממנה וכו'.",
