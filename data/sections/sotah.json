"how": "ref",
"i": 2425,
"text": "שבועת הפקדון. בכל לשון",
"next": ""
},
{
"daf": "לג.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2427,
"text": "ואלו נאמרין בלה\"ק: ",
"next": ""
},
{
"daf": "לג.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2428,
"text": "מקרא ביכורים וכו' כיצד? וענית ואמרת לפני ה' אלהיך, ",
"next": ""
},
{
"daf": "לג.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2431,
"text": "חליצה כיצד וענתה ואמרה וכו' מה להלן אף כאן בלה\"ק.",
"next": ""
},
{
"daf": "לג:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2442,
"text": "ברכות וקללות כיצד? כיון שעברו ישראל את הירדן כו'.",
"next": ""
},
{
"daf": "לה:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2606,
"text": "נמצאת אתה אומר: שלשה מיני אבנים היו;",
"next": ""
},
{
"daf": "לו.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2651,
"text": "ששה שבטים עלו לראש הר גריזים כו'.",
"next": ""
},
{
"daf": "לז.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2730,
"text": "הפכו פניהם כלפי הר גריזים ופתחו בברכה כו'.",
"next": ""
},
{
"daf": "מ:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2962,
"text": "ובמקדש ברכה אחת כו'.",
"next": ""
},
{
"daf": "מ:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2976,
"text": "וכ\"ג עומד ומקבל וקורא וכו'.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 2986,
"text": "וקורא אחרי מות ואך בעשור.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2998,
"text": "ובעשור שבחומש הפקודים קורא על פה.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3004,
"text": "ומברך עליה שמנה ברכות כו'.",
"next": ""
},
{
"daf": "מא.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3008,
"text": "והשאר תפלה.",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ו",
"how": "ref",
"i": 3021,
"text": "וחזן הכנסת נוטל ס\"ת ונותנו לראש הכנסת.",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3024,
"text": "והמלך עומד ומקבל וקורא יושב;",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3029,
"text": "ושבחוהו חכמים.",
"next": ""
},
{
"daf": "מא:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3035,
"text": "וכשהגיע ללא תוכל לתת.",
"next": ""
},
{
"daf": "מב.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3092,
"text": "ואמר אליהם שמע ישראל.",
"next": ""
},
{
"daf": "מב.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3095,
"text": "אל ירך לבבכם אל תיראו כו'.",
"next": ""
},
{
"daf": "מב:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3105,
"text": "פלשתים באו בנצחונו של גלית כו'.",
"next": ""
},
{
"daf": "מב:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3147,
"text": "בני עמון באו בנצחונו של שובך כו'.",
"next": ""
},
{
"daf": "מג.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3202,
"text": "מי האיש אשר בנה בית חדש כו'.",
"next": ""
},
{
"daf": "מג:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3212,
"text": "ומי האיש אשר נטע כרם כו'.",
"next": ""
},
{
"daf": "מד.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3265,
"text": "מי האיש אשר ארש אשה כו'.",
"next": ""
},
{
"daf": "מד.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3295,
"text": "ואלו שאין זזין ממקומן: בנה בית חדש וחנכו וכו'.",
"next": ""
},
{
"daf": "מד.",
"k": "m",
"letter": "ה",
"how": "m",
"i": 3305,
"text": "ויספו השוטרים לדבר אל העם וגו' ",
"next": "ר\"ע: הירא ורך הלבב כמשמעו, שאינו יכול לעמוד בקשרי המלחמה ולראות חרב שלופה."
},
{
"daf": "מד:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3327,
"text": "בד\"א - במלחמות הרשות כו'.",
"next": ""
},
{
"daf": "מד:",
"k": "m",
"letter": "א",
"how": "m",
"i": 3341,
"text": "עגלה ערופה בלה\"ק דכי ימצא חלל באדמה ויצאו זקניך ושופטיך, ",
"next": "שלשה מבית דין הגדול שבירושלים היו יוצאין;"
},
{
"daf": "מד:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3353,
"text": "רבי יהודה אומר: חמשה וכו'.",
"next": ""
},
{
"daf": "מה.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3388,
"text": "נמצא טמון בגל או תלוי באילן.",
"next": ""
},
{
"daf": "מה:",
"k": "m",
"letter": "ג",
"how": "m",
"i": 3462,
"text": "נמצא מכוון בין שתי עיירות ר''א: שתיהן מביאות שתי עגלות",
"next": "ואין ירושלים מביאה עגלה ערופה."
},
{
"daf": "מה:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3472,
"text": "ואין ירושלים מביאה עגלה ערופה.",
"next": ""
},
{
"daf": "מה:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3475,
"text": "נמצא ראשו במקום כו'.",
"next": ""
},
{
"daf": "מה:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3486,
"text": "מאין היו מודדין.",
"next": ""
},
{
"daf": "מה:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3495,
"text": "ראב''י ממקום שנעשה חלל, מצוארו.",
"next": ""
},
{
"daf": "מה:",
"k": "m",
"letter": "ה",
"how": "m",
"i": 3499,
"text": "נפטרו זקני ירושלים והלכו להן.",
"next": "זקני אותה העיר מביאין עגלת בקר אשר לא משכה בעול, ואין המום פוסל בה, ומורידין אותה לנחל איתן, איתן כמשמעו קשה, אף שאינו איתן כשר, ועורפין אותה בקופיץ מאחוריה;"
},
{
"daf": "מו:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3559,
"text": "ומורידין אותה אל נחל איתן, איתן כמשמעו - קשה.",
"next": ""
},
{
"daf": "מו:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3568,
"text": "ומקומה אסור מלזרוע ומליעבד.",
"next": ""
},
{
"daf": "מו:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3574,
"text": "ומותר לסרוק שם פשתן ולנקר שם אבנים.",
"next": ""
},
{
"daf": "מו:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3581,
"text": "זקני העיר רוחצין ידיהן כו'.",
"next": ""
},
{
"daf": "מז.",
"k": "m",
"letter": "ב",
"how": "r",
"i": 3684,
"text": "נמצא ההורג, עד שלא נערפה העגלה - תצא ותרעה בעדר, משנערפה העגלה - תקבר במקומה, שעל ספק באתה מתחילתה, כיפרה ספיקה והלכה לה.",
"next": "נערפה העגלה ואחר כך נמצא ההורג - הרי זה יהרג."
},
{
"daf": "מז:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3704,
"text": "עד אחד אומר ראיתי את ההורג כו'.",
"next": ""
},
{
"daf": "מז:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3727,
"text": "משרבו הרוצחין כו'.",
"next": ""
},
{
"daf": "מז:",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3732,
"text": "משרבו הנואפין כו'.",
"next": ""
},
{
"daf": "מח.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3778,
"text": "יוחנן כהן גדול העביר הודיית המעשר כו'.",
"next": ""
},
{
"daf": "מח.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3799,
"text": "ואף הוא ביטל את המעוררים.",
"next": ""
},
{
"daf": "מח.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3807,
"text": "ואת הנוקפים.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3860,
"text": "משמתו נביאים הראשונים.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3888,
"text": "משחרב בהמ\"ק - בטל השמיר כו'.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 3909,
"text": "ונופת צופים.",
"next": ""
},
{
"daf": "מח:",
"k": "dh",
"letter": "ד",
"how": "ref",
"i": 3929,
"text": "ופסקו אנשי אמנה.",
"next": ""
},
{
"daf": "מט.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3955,
"text": "רשב\"ג אומר משום ר' יהושע: מיום שחרב בהמ\"ק אין וכו'.",
"next": ""
},
{
"daf": "מט.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3961,
"text": "ולא ירד טל לברכה, וניטל טעם פירות וכו'.",
"next": ""
}
]
}