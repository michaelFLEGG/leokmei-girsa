"daf": "מז:",
"k": "m",
"letter": "ג",
"how": "m",
"i": 3401,
"text": "מתני'.",
"next": "אי זהו בכור לנחלה ולכהן: המפלת שפיר מלא מים, מלא דם, מלא גנינין."
},
{
"daf": "מח.",
"k": "m",
"letter": "א",
"how": "m",
"i": 3415,
"text": "מתני'.",
"next": "מי שלא בכרה אשתו, וילדה שני זכרים - נותן ה' סלעים לכהן, "
},
{
"daf": "מח:",
"k": "m",
"letter": "ב",
"how": "m",
"i": 3458,
"text": "מתני'.",
"next": "שתי נשים שלא בכרו, וילדו שני זכרים נותן י' סלעים לכהן; "
},
