{"מנין שמונין למלכים רק מניסן":["מנין השנים מניסן ולא מתשרי","שנת הארבעים במדבר","ענני הכבוד נסתלקו במיתת אהרן","ערד וסיחון הם כנען","מכלל דר\"ה לאו תשרי הוא","סבר שניתנה רשות להלחם"],"ור ה לאו אייר ויהי בחדש הראשון בשנה השני":["ראש השנה לא באייר","מדניסן קרי שנית","הקמת המשכן בניסן","ענן נעלה בשנה השנית","מנין שנים מהקמת המשכן","שנית באייר ובניסן"],"ור ה לאו סיון ד בחודש השלישי לצאת בנ י ל":["ר\"ה אינו בסיון מחודש השלישי","שנה שנייה ולא שלישי","ויחל לבנות בשני מניסן","בשני לחדש הנמנה למלכות","מקיש שני לחדש ולא לשבת","מנין המלכים אינו מסיון"],"ולרגלים דהיינו רגל שבו ר ה לרגלים":["בל תאחר ברגל שראשון לרגלים","פסח תחילה לרגלים","נודר לעבור בבל תאחר","ר\"ה הרגל לרגלים","נפקא מינה לנודר","רגל שבו ר\"ה לרגלים"],"היינו חילופי עולה ושלמים שעברו עליו שני ":["חילופי קדשים ועבר רגל","הומם בתוך הרגל","ברגל ראשון עובר","בך חטא ולא בקרבנך","קדשים בני הרצאה","מכח ראשון כמי שעבר"],"מוצא שפתיך זו מצות עשה":["מוצא שפתיך חמש מצוות","תשמר ועשית כאשר נדרת","נדר נדבה ודברת","קדשי בדק הבית","בפיך זו צדקה","הקרבה שכופין אותו"],"בפיך זו צדקה ומתחייב מיד כשקיימים עניים":["בפיך זו צדקה מיד","צדקה מתחייבת מיד","חיוב צדקה בלי רגלים","צדקה כשקיימים עניים","מתי מתחייבת הצדקה","צדקה לעניים המצויים"],"בפסח נולד יצחק למועד אשוב אליך עמד בחג ו":["יצחק נולד בפסח","למועד אשוב אליך","לידה בשבעה חודשים","שנה מעוברת מתקופות","יולדת למקוטעין","מיעוט תקופות וימים"],"בר ה יצא יוסף מבית האסורין":["יוסף יצא בר\"ה מבית האסורים","תקעו בחודש שופר","שופר ויציאת האסיר","יוסף ובית האסורים","עדות ביהוסף בצאתו","שופר לעדות בישראל"],"בר ה בטלה עבודה מאבותינו במצרים":["ביטול עבודת מצרים בר\"ה","בניסן נגאלו ובתשרי עתידין","שופר לעתיד לגאולה","ליל שמרים לגאולה","שמירה מן המזיקין","ר\"א ליל משומר"],"ליקט ירק ערב ר ה עד שלא תבא השמש":["ירק ערב ר\"ה לתרומות","מעשר שני בשנה השלישית","אין תורמין מחדש על ישן","שנה שנייה לשלישית","מעשר עני בשנה השלישית","בא הלוי כל זמן"],"האורז והדוחן והפרגין והשומשמין קטניות שה":["אורז ודוחן לשביעית","השרשה לפני ר\"ה","לקיטה מעט מעט","קטניות שהשרישו","מעשר לשנה הבאה","השרשה ולא לקיטה"],"אילן אחר חנטה תבואה וזיתים אחר שליש ירק ":["אילן שחנט אחר שליש","בילה לערב הגורן","לקיטת ירק לעשירה","כפול המצרי ותורם","הלכה כר' שמעון שזורי","גמר פרי קובע מעשר"],"בארבעה פרקים העולם נידון":["ארבעה פרקים לדין העולם","ר\"ה נידון כבני מרון","בפסח נידון התבואה","בחג נידון המים","דין העולם בראש השנה","עוברים לפניו כבני מרון"],"תוקעין ומריעין כשהן יושבין וכשהן עומדין ":["תקיעה לערבב השטן","שנה ללא תקיעה","מרשית השנה ועד אחריתה","אין דנין אלא לפי מעשיו","שלוש טענות לעוון","ארבעה דברים מקרעין גזר דין"],"שלשה ספרים נפתחין בר ה":["שלושה ספרים בר\"ה","ספר רשעים וצדיקים","בינוניים נתלים עד כיפור","ימחו מספר ואם אין מחני","זכו נכתבים לחיים","תלויים ועומדים מר\"ה"],"שלש כתות ליום הדין":["שלוש כיתות לדין","בינונים יורדים לגיהנם","זכויות ועוונות במחצה","פושעי ישראל בגופן","קרקפתא שלא מניח תפילין","רשעים בגיהנם י\"ב חודש"],"ויעבר ה על פניו ויקרא שנתעטף הקב ה כש ץ ":["הקב\"ה כשליח ציבור","סדר תפילה למשה","ישראל חוטאין ואני מוחל","ויעבר ה' על פניו","תפילה ברשות משה","מוחל לישראל בזמן חטא"],"ה ה אני הוא קודם שיחטא האדם ואחר שיחטא ו":["ה' ה' אני הוא","י\"ג מדות לפני החטא","ברית י\"ג מידות","הנה אנכי כורת ברית","מדת הרחמים קודם לחטא","י\"ג מידות שאינן חוזרות"],"על ששה חדשים השלוחין יוצאין":["שלוחין על ששה חודשים","תקנת שלוחין לחודשים","צום לשלום ולשמחה","תשעה באב חובה בשני בתים","שלוחין על אייר לפסח קטן","תמוז וטבת ללא שלוחין"],"ולא יוצאים על תמוז וטבת אפי שצום הרביעי ":["תענית בשעת שלום או שמד","שחרב הבית בראשונה ושניה","ביתר ונחרשה העיר","צום לשמחה בזמן שלום","תשעה באב חובה","רצו מתענין רצו אין מתענין"],"ד דברים דרש ר ע ואיני דורש כמותו ואחד מה":["ארבעה צומות לחודשים","צום הרביעי ט' בתמוז","צום החמישי ט' באב","צום השביעי גדליה","צום העשירי עשרה בטבת","ר\"ע ואיני דורש כמותו"],"יכול אני לתקן לכל הגולה סדר חדשים בלי עד":["מתקן סדר חדשים בלי עדים","מולד קודם או אחר חצות","מערב עד ערב","חצות לילה לתאריך","אביי ורבא בחודש","מחשבין את מולד הלבנה"],"כל ספק מוסיפים יום ליו ט לט ו ט ז ולא י ":["ספק מוסיפים יום ליו\"ט","תמוז ואב חסרים","יום טוב של ט\"ו וט\"ז","לא י\"ד בספק","ספק חודש מוסיפים יום","קול בחודשים חסרים"],"כשתקופת טבת עד ט ז ניסן תעבר השנה":["תקופת טבת עד ניסן","שמור את חודש האביב","יורדי הים בודקין חמץ","הירח משלים הלילה בי\"ד","אביב בחודש ניסן","בערו חמץ ליורדי הים"],"על שני חדשים מחללין את השבת על ניסן ותשר":["חילול שבת על שני חודשים","ניסן ותשרי שלוחין לסוריא","חילול שבת בבית המקדש","שלוחין על ששה חודשים מבערב","ניסן ותשרי רק מב\"ד","תקנת הקרבן בשבת"],"על ששה חודשים השלוחין יוצאין מבערב דל א ":["ששה חודשים שלוחין מבערב","דל\"א או ל' בעליל","ניסן ותשרי מפי ב\"ד","שלוחין מבערב בחודשים","ביטול חילול שבת בחודשים","נידון החודש בשלוחין"],"אלה מועדי ה אשר תקראו אותם במועדם על קרי":["אלה מועדי ה' במועדם","חילול שבת על קריאתם","עדים ולא שלוחים","מחללין על קריאתם ולא קיומם","מועדים לשבת מחללין","מפני קריאת העדים"],"בין שנראה בעליל בין שלא נראה בעליל מחללי":["חילול שבת על ראיה בעליל","רבי יוסי נגד חילול","ארבעים זוג ורבי עקיבא","ר\"ג שולח לרבי עקיבא","מכשיל הרבים לעתיד","מעכב את הרבים"],"עליל לשון גלוי כסף צרוף בעליל לארץ":["כסף צרוף בעליל לארץ","חמשים שערי בינה למשה","בקש קהלת למצוא","משה חסר אחד מחמישים","נביא כמשה ביקש לדון","בת קול על עדים"],"אב ובנו שראו את החדש ילכו לא שמצטרפין זה":["אב ובנו עדים לחדש","לא מצטרפין זה עם זה","ר\"ש אב ובנו כשרים","טוביה הרופא ראה החדש","פסול עבד וכשר בן","החדש הזה לכם עדות מסורה"],"החדש הזה לכם ר ש עדות זו תהא כשרה בכם":["עדות זו תהא מסורה לכם","אין הלכה כרבי שמעון","החדש הזה לכם כשר","הפך ר\"ש בר' יוסי","עדות כשרה או מסורה","מחלוקת ר\"ש וחכמים בעדות"],"אלו הן הפסולין":["פסולי עדות המשחק בקוביא","מלוי ברבית פסול לעדות","סוחרי שביעית ועבדים","כל עדות שאין אשה כשרה","גזלן כשר לעדות אשה","הכלל בפסולי עדות"],"הא במקום שאשה כשרה לה אף הן כשרין לה":["גזלן כשר לעדות אשה","במקום שאשה כשרה","עדות הפסולים לאשה","עדות מכשירה במקום אשה","כלל הפסולים בעדות חדש","פסול עדות ונשים"],"מי שראה את החדש ואינו יכול להלך":["ראה החדש ואינו הולך","מוליכין על החמור","מקלות ומזונות לעדים","מהלך לילה ויום מחללין","עדים מחללין שבת","מי שראה ולא הלך"],"אחר זוג אחר דחד לא נאמן":["אחר זוג אחר","נאמנות עד אחד בחדש","מעשה רבי נהוראי והעד","קידשו החודש בארץ","הכל נאמנים לעתיד","עד מספק מחללין שבת"],"משיאין לשון יקוד וישאם דוד ואנשיו ומתרגמ":["שיר יקוד ותרגומו","וישאם דוד ואוקדינן","תרגום יקוד בשם דוד","משיאין לשון יקוד","וישאם בתרגום","לשון יקוד בתורה"],"חצר גדולה היתה בירושלים בית יעזק":["בית יעזק חצר בירושלים","רבן גמליאל הרחיב אלפיים אמה","בית יעזק לשון מובחרת","סעודות לעדים","העדים ללא עיכוב","חכמה ליילד ולהציל"],"בית יעזק לשון מובחרת ד ויעזקהו ויסקלהו":["בית יעזק לשון צער","סעודות גדולות לעדים","והוא אסור באזקים","סעודה יחד עם צער","שם בית יעזק","בית יעזק כמו בית יזק"],"כיצד בודקין את העדים":["בודקין את העדים בנפרד","לפני החמה או אחריה","הגדול מכניסים ראשון","שאלות לעדי הלבנה","פגימת הלבנה לפני החמה","שאלות ראשי דברים לעדים"],"פגימתה אם אמר לפני החמה לא אמר כלום":["המשל ופחד עמו","פגימת הלבנה לא נראית","פגימת קשת לא תשאל","פגימה לפני החמה","חלשה דעתה של הלבנה","פגימה של קשת מכופרים"],"ראש ב ד אומר מקודש וכל העם עונין אחריו מ":["ראש ב\"ד אומר מקודש","מקודש מקודש כפול","אם לא נראה בזמנו","קידשו השמים לראב\"צ","מקראי קדש ברי","לעולם לא מקדשין שנה"],"ראש ב ד אומר מקודש רבי וידבר משה את מועד":["מקודש פעמיים מקראי קדש","הלכה כרבי אלעזר בן צדוק","עובר מעובר בקידוש","מועדי הם יאמרו","אשר תקראו אתם קרי","בזמנו ושלא בזמנו מקדשין"],"דמות צורות לבנה היו לרבן גמליאל בטבלא וב":["דמות לבנה לרבן גמליאל","לא תעשון אתי בתמונות","צורת היכל ומנורה","אסור לעשות שמש ולבנה","מדור עליון ותחתון","לא תעשון אתי שלא לעבוד"],"ד לא תעשון אתי שאסור לעשות כשמשין המשמשי":["בולט חותם מותר לחתום","השחתת צורה משום חשד","חותם שוקע מותר","לא רק עשייה אסורה","עבודה של השהיה","טבעת ותמונת חמה"],"מעשה שבאו שנים ואמרו ראינוהו שחרית במזרח":["שני עדים שראו בשחרית ובערבית","רי\"ו בן נורי עדי שקר","רבן גמליאל מקבל העדים","עדים שלא נראה בליל עיבור","ר\"ד בן הרכינס חשד בעדים","יוה\"כ במקלו ובמעותיו"],"טעם שקיבלן ר ג שפעמים בא בארוכה ופעמים ב":["טעם רבי לחשד לירח","שמש ידע מבואו","ראה ללבנה זרק אדמה","עין טוב וקידוש הירח","דוד מלך ישראל חי","חדוש הלבנה כ\"ט יום וחצי"],"ראוהו ב ד וכל ישראל קמ ל דאפי שנתפרסם צר":["ראוהו ב\"ד וכל ישראל","חקירת עדים לא תחילת דין","דין ביום וגמר בלילה","חק לישראל משפט לאלהי יעקב","שנתפרסם צריך לעבר","חקירת עדים בלילה"],"כל השופרות כשרים חוץ משל פרה מפני שהוא ק":["כל השופרות כשרים חוץ מפרה","שופר של פרה פסול","פרה נקרא קרן בלבד","שופר משל פרה","שופר ולא קרן","פסול קרן של פרה"],"כל השופרות נקראו גם שופר וקרן":["פרה נקראת שופר ולא קרן","כה\"ג בבגדי זהב","שופר של פרה בחוץ","קטיגור סניגור בבגדי זהב","ארון כפורת ודם הפר","כל השופרות נקראו קרן"],"שופר של ר ה של יעל פשוט ופיו מצופה זהב":["שופר של ר\"ה של יעל","תעניות בשל זכרים","שופר מאריך וחצוצרות מקצרות","שוה היובל לר\"ה","ר\"י בשופר ובשל יעלים","כופפין לתעניות"],"בר ה כמה דפשיט דעתו עדיף וכן ביו כ גז ש":["בר\"ה כמה דפשיט","ביו\"כ גז\"ש תעניות","שופר בכופפין ותעניות בפשוטין","ר\"ה כר\"י ויו\"כ כת\"ק","פסק מצוה בכפופין","דעתו עדיף בתקיעה"],"שופר שנסדק ודבקו פסול דיבק שברי שופרות פ":["שופר שנסדק ודבקו","דיבק שברי שופרות פסול","ניקב וסתמו מעכב","קול הברה לא יצא","שמע קול שופר מהבור","כיוון לבו ביהכנ\"ס"],"ארוך וקצרו כשר גרדו והעמידו על גלדו כשר":["ארוך וקצרו כשר","גרדו והעמידו על גלדו","שופר שאורכו משתנה","גרוד שופר כשר","תיקון שופר כשר","קצר ארוך כשר"],"ציפהו זהב במקום הנחת פה פסול שלא במקום ה":["ציפהו זהב במקום הפה","זהב שלא במקום הפה","ציפוי זהב במקום פה פסול","זהב מחוץ לפה כשר","ציפוי מקום הנחת פה","כשר בלי מקום הפה"],"ציפהו זהב מבפנים פסול מבחוץ אם לא נשתנה ":["ציפהו זהב מבפנים פסול","זהב מבחוץ אם לא נשתנה","ציפוי פנימי פוסל","קול שופר מזהב","שינוי קול בציפוי זהב","זהב מבחוץ כשר"],"שופר בתוך שופר אם רק קול פנימי שמע יצא":["שופר בתוך שופר","קול פנימי בשופר בתוך שופר","שמע קול פנימי יצא","שופר בתוך שופר ידי חובה","הקול החיצוני לא יצא","שופר תוך שופר"],"שהרחיב הקצר וקיצר הרחב לא יצא והעברת דרך":["הרחיב הקצר וקיצר הרחב","והעברת דרך העברתו","העברת השופר","שינוי צורת השופר","שופר ששונה בהעברה","דרך העברתו בעינן"],"הוסיף כל שהוא בין במינו בין שלא במינו פס":["הוסיף כל שהוא פסול","הוספה במינו ושלא במינו","תוספת לשופר פוסלת","כל הוספה פוסלת שופר","שופר שהוסיפו","הוספת מין אחר"],"ניקב וסתמו בין במינו בין שלא במינו פסול":["ניקב וסתמו במינו","ר\"נ במינו כשר","במינו כשר ברוב","שלא במינו פסול","נפחת רובו במינו","סתימה במינו בכל שופר"],"נסדק לאורכו פסול לרוחבו אם נשתייר בו שיע":["נסדק לאורכו פסול","נסדק לרוחבו שיעור","רשב\"ג יאחזנו בידו","טפח שופר נסדק","שיעור תקיעה בשופר","סדק לרוחב כשר"],"קולו דק או עבה או צרוד כשר שכל הקולות כש":["כל הקולות כשרים בשופר","קולו דק או עבה","קול צרוד בשופר","סוג הקול בשופר","קול השופר בכשר","שופר בקול עבה כשר"],"קדחו בזכרותו ותקע בו יצא ולא אמרי דמין ב":["קדחו בזכרותו ותקע","מין במינו אינו חוצץ","שופר שנקדח בזכרותו","קידוח שופר לא חוצץ","תקיעה דרך קידוח","זכרות השופר נקדחה"],"כפאו פרסיים ואכל מצה יצא דמצות א צ כונה":["כפאו פרסיים ואכל מצה","תקע לשיר יצא","יוצא בלא כוונה","שומע קול שופר וחשב חמור","ישן בשמיני בסוכה","מוסיף ברכה בלי כוונה"],"והיה כאשר ירים משה ידו וגבר ישראל וגו":["משה ידיו מלחמה","ישראל מסתכלין למעלה","נחש נחושת ורפואה","משעבדין לבם לאביהם","חרש שוטה וקטן","הכל חייבים בשופר"],"הכל חייבין בשופר כהנים ולוים וישראלים גר":["טומטום ואנדרוגינוס בשופר","חציו עבד וחציו בן חורין","כהנים חייבים בשופר","מוציא את מינו בשופר","גרים ועבדים משוחררים","הכל חייבים בתקיעה"],"בראשונה היה הלולב ניטל במקדש שבעה ובמדינ":["לולב ניטל במדינה שבעה","זכר למקדש לולב","יום הנף אסור","ריב\"ז לולב במדינה","ציון היא דורש","לולב זכר למקדש"],"זכר למקדש ד ציון היא דורש אין לה מכלל דב":["זכר למקדש בדרשה","ציון היא דורש אין לה","מכלל דבעיא דרישה","לולב במדינה זכר","דרשת ציון בזכר","זכר למקדש ולא בדרשה"],"בראשונה היו מקבלין עדות החדש כל היום":["קבלת עדות החדש עד המנחה","נתקלקלו הלוים בשיר","ריב\"ז קבלת עדות כל היום","עדים שלא באו בזמנם","ביטול עדות אחר המנחה","חורבן ותקנת ריב\"ז"],"רבי יהושע בן קרחה ועוד זאת התקין ריב ז ש":["ר' יהושע בן קרחה ריב\"ז","עדים הולכים למקום הוועד","ראש ב\"ד בכל מקום","תקנת ריב\"ז למקום הוועד","עדים לא הולכים לראש ב\"ד","מקום הוועד לעדים"],"סדר ברכות":["סדר ברכות ר\"ה לר' יוחנן בן נורי","אבות גבורות קדושת השם","עשר מלכיות ואם אינו תוקע","שמונה ברכות של ר\"ה","ר' עקיבא מלכיות בתפילה","תשע פסוקים ולא עשר"],"שאם אינו תוקע במלכיות אומר תשע פסוקים ול":["אם אינו תוקע במלכיות","תשע פסוקים ולא עשר","מלכיות בלי תקיעה","ר\"ה בתשע פסוקים","אם לא תוקע מזכיר","מלכיות ללא תקיעה"],"אבות הבו לה בני אלים":["אבות הבו לה' בני אלים","גבורות הבו לה' כבוד","קדושות השתחוו לה'","פסוקי האבות בר\"ה","מזמורי ברכות ר\"ה","השתחוו לה' בהדרת קדש"],"אין פוחתין מעשרה מלכיות מעשרה זכרונות מע":["אין פוחתין מעשר מלכיות","עשרה זכרונות ושופרות","שלש שלש מכולן יצא","מספר ברכות ר\"ה","ר' יוחנן בן נורי שלוש שלוש","עשרה פסוקים בתפילה"],"אין מזכירין מלכוית זכרונות ושופרות של פו":["אין מזכירין פורענות","מתחיל בתורה ומשלים בנביא","מלכיות של פורענות","פורענות של ישראל אסורה","זכרון לנכרים בר\"ה","מלכיות ללא ישראל"],"מלכיות כגון חי אני וגו ובחמה שפוכה אמלוך":["לשון פקידה בזכרונות","לשון תרועה בשופרות","לשון שאלה במלכות","ר' יוסי ור\"י בלשון","זכרון של יחיד אסור","מלכות ור\"י לשון שאלה"],"העובר לפני התיבה ביו ט של ר ה השני מתקיע":["שני מתקיע בר\"ה","הראשון מקרא את ההלל","זריזין מקדימין במשמרת","ר\"ה אין הלל","שש שעות שארבו בשמד","מלך על כסא דין"],"טעם שהלל הראשון מקרא דזריזין מקדימין עדי":["ר\"ה אין אומרים הלל","ספרי חיים ומתים פתוחים","ישראל אומרים שירה בדין","מלאכי השרת בדין","מלך על כסא דין","שירה ביום הדין"],"שופר של ר ה":["שופר של ר\"ה אין מעבירין תחום","לא עולין באילן ברכיבה","שופר לא חותכין","מעכבין את התנוקות","מתעסק לא יצא","שופר עשה דוחה שבת"],"והטעם דשופר עשה הוא ואינו דוחה יו ט שהוא":["שופר עשה ולא תעשה","שופר אינו דוחה יום טוב","תקיעה ביום טוב","שופר דוחה שבת ולא יו\"ט","שופר עשה ואינו דוחה","תקיעה לא דוחה חג"],"סדר תקיעות שלש של שלש שלש":["שלוש של שלוש שלוש","שיעור תקיעה שלוש תרועות","שיעור תרועה שלוש יבבות","תקע בראשונה ומשך בשניה","שליח ציבור ויחיד חייבים","רבן גמליאל שליח ציבור מוציא"],"דשיעור תקיעה כתרועה בחד בבא ומתני בג בבי":["תקיעה כתרועה בבא אחד","יום תרועה יום יבבא","גנח ארוכים או יליל קצרים","יבבות שברים בתרועה","סיסרא ותיבב","שיעור תרועה בשברים"],"פשוטה לפניה והעברת פשוטה שופר תרועה":["פשוטה לפניה תרועה","והעברת פשוטה שופר תרועה","פשוטה לפני התרועה","תקיעה פשוטה לפני שברים","סדר התקיעות בפשוטה","פשוטה לפניה בשופר"],"שלש של שלש שלש והעברת שופר תרועה ביובל":["שלש של שלש שלש והעברת","גזירה שווה ר\"ה ויובל","תקעו בחודש שופר","ר\"ה ביובל בגזירה שווה","תרועה במדבר ויובל","ג' פסוקים לר\"ה ויובל"],"כיון שאמר ובתורתך כתוב לאמר שוב א צ פסוק":["ובתורתך כתוב לאמר","פסוקי מוספין ביחיד ובציבור","אחד יחיד ואחד ציבור","שוב אין צריך פסוקי מוספין","סדר תפילה לר\"ה","ובתורתך כתוב פסוקי תפילה"],"לעולם יסדיר אדם תפלתו ואחר כך יתפלל":["לעולם יסדיר אדם תפילתו","ברכות ר\"ה ויוה\"כ","סידור תפילה לפרקים","ר' יהודה שסידר לל' יום","שנאנסים ממלאכה בשדות","פטור בשדות משמיעת מש\"ץ"]}