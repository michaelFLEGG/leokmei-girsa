},
{
"daf": "מה:",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 3252,
"text": "השולט בשתי ידיו.",
"next": ""
},
{
"daf": "מה:",
"k": "m",
"letter": "ג",
"how": "m",
"i": 3259,
"text": "מתני'.",
"next": "הכושי, הגיחור, והלבקן, והקפח, והננס, והחרש, והשוטה, והשיכור, ובעלי נגעים טהורים - פסולין באדם וכשרים בבהמה."
},
