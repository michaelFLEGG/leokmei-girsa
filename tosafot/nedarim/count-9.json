   "line": 5,
   "seg": 1,
   "ref": "Tosafot on Nedarim 65b:5:1",
   "text": "מוכר שער ראשך - מפרש בגמרא:",
   "dh": "מוכר שער ראשך",
   "dhRule": "מקף",
   "verified": false,
   "n": 31,
   "hn": "ל\"א",
   "dafKey": "סה:",
   "url": "https://www.sefaria.org/Tosafot_on_Nedarim_65b.5.1",
