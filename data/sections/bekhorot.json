"daf": "מה:",
"k": "dh",
"letter": "ט",
"how": "ref",
"i": 3283,
"text": "והנושא נשים כו'.",
"next": ""
},
{
"daf": "מו.",
"k": "dh",
"letter": "א",
"how": "ref",
"i": 3294,
"text": "והמטמא למתים כו'.",
