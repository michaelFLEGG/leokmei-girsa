},
{
"daf": "לט.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 2651,
"text": "מתני'.",
"next": "חוטמו שניקב ושנפגם ושנסדק."
},
{
"daf": "לט.",
"k": "m",
"letter": "ה",
"how": "m",
"i": 2659,
"text": "מתני'.",
"next": "חוטין החיצונות - שנפגמו ושנגממו הפנימים - שנעקרו."
},
{
"daf": "לט:",
"k": "m",
"letter": "א",
"how": "m",
"i": 2719,
"text": "מתני'.",
"next": "נפגם הזובן, או העריה של נקבה במוקדשין."
},
{
"daf": "לט:",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2727,
"text": "נפגמה הזנב מן העצם וכו'.",
"next": ""
},
{
"daf": "מ.",
"k": "m",
"letter": "א",
"how": "m",
"i": 2743,
"text": "מתני'.",
"next": "אין לו ביצים או אין לו אלא ביצה אחת."
},
{
"daf": "מ.",
"k": "dh",
"letter": "ב",
"how": "ref",
"i": 2756,
"text": "ומעשה שמיעך ולא יצא וכו'.",
"next": ""
},
{
"daf": "מ.",
"k": "m",
"letter": "ג",
"how": "m",
"i": 2763,
"text": "מתני'.",
"next": "בעל חמש רגלים, או שאין לו אלא שלש."
},
{
"daf": "מ.",
"k": "dh",
"letter": "ג",
"how": "ref",
"i": 2773,
"text": "והשחול והכסול וכו': ",
