ְטָרוֹ", "וְאָמַר", "לוֹ", "אִם", "לֹא", "אֶתֵּן", "לְךָ", "מִכָּאן", "וְעַד", "יוֹם", "פְּלוֹנִי", "תֵּן", "לוֹ", "שְׁטָרוֹ"], "הגיע זמן ולא נתן - רבי יוסי: יתן, ר''י: לא יתן.": ["הִגִּיעַ", "זְמַן", "וְלֹא", "נָתַן", "רַבִּי", "יוֹסֵי", "יִתֵּן", "", "", "לֹא", "יִתֵּן"], "מי שנמחק שטר חובו מעמיד עליו עדים, ובא לפני ב''ד ועושין לו קיום:": ["מִי", "שֶׁנִּמְחַק", "שְׁטַר", "חוֹבוֹ", "מַעֲמִיד", "עָלָיו", "עֵדִים", "וּבָא", "לִפְנֵי", "", "", "וְעוֹשִׂין", "לוֹ", "קִיּוּם"], "מי שפרע מקצת חובו:  ר' יהודה: יחליף. רבי יוסי: יכתוב שובר.": ["מִי", "שֶׁפָּרַע", "מִקְצָת", "חוֹבוֹ", "", "יְהוּדָה", "יַחֲלִיף", "רַבִּי", "יוֹסֵי", "יִכְתּוֹב", "שׁוֹבֵר"], "אר''י: נמצא הלוה צריך לשמור שוברו מן העכברים.": ["אַר", "", "נִמְצָא", "הַלֹּוֶה", "צָרִיךְ", "לִשְׁמוֹר", "שׁוֹבְרוֹ", "מִן", "הָעַכְבָּרִים"], "א''ל רבי יוסי: כך יפה לו, ולא ירע כחו של זה.": ["אָ", "לָ", "רַבִּי", "יוֹסֵי", "כָּךְ", "יָפֶה", "לוֹ", "וְלֹא", "יֵרַע", "כֹּחוֹ", "שֶׁל", "זֶה"], "שנים שהיו בעיר אחת, שם אחד יוסף בן שמעון ושם אחר יוסף בן שמעון - אין יכולין להוציא שטר חוב זע''ז, ולא אחר יכול להוציא עליהן שטר חוב.": ["שְׁנַיִם", "שֶׁהָיוּ", "בְּעִיר", "אַחַת", "שֵׁם", "אֶחָד", "יוֹסֵף", "בֶּן", "שִׁמְעוֹן", "וְשֵׁם", "אַחֵר", "יוֹסֵף", "בֶּן", "שִׁמְעוֹן", "אֵין", "יְכוֹלִין", "לְהוֹצִיא", "שְׁטַר", "חוֹב", "", "", "וְלֹא", "אַחֵר", "יָכוֹל", "לְהוֹצִיא", "עֲלֵיהֶן", "שְׁטַר", "חוֹב"], "המלוה את חבירו על ידי ערב - לא יפרע מן הערב,": ["הַמַּלְוֶה", "אֶת", "חֲבֵירוֹ", "עַל", "יְדֵי", "עָרֵב", "לֹא", "יִפָּרַע", "מִן", "הֶעָרֵב"], "רשב\"ג: אם יש נכסים ללוה - בין כך ובין כך לא יפרע מן הערב.": ["רַשְׁבָּ", "", "אִם", "יֵשׁ", "נְכָסִים", "לַלֹּוֶה", "בֵּין", "כָּךְ", "וּבֵין", "כָּךְ", "לֹא", "יִפָּרַע", "מִן", "הֶעָרֵב"], "וכן היה רשב''ג אומר: הערב לאשה בכתובתה, והיה בעלה מגרשה - ידירנה הנאה, שמא יעשו קנוניא על נכסים של זה ויחזיר את אשתו.": ["וְכֵן", "הָיָה", "רַשָּׁב", "גּ", "אוֹמֵר", "הֶעָרֵב", "לְאִשָּׁה", "בִּכְתוּבָּתָהּ", "וְהָיָה", "בַּעְלָהּ", "מְגָרְשָׁהּ", "יַדִּירֶנָּה", "הֲנָאָה", "שֶׁמָּא", "יַעֲשׂוּ", "קְנוּנְיָא", "עַל", "נְכָסִים", "שֶׁל", "זֶה", "וְיַחְזִיר", "אֶת", "אִשְׁתּוֹ"], "מעשה ובא לפני ר' ישמעאל, ואמר: גובה מנכסים בני חורין.": ["מַעֲשֶׂה", "וּבָא", "לִפְנֵי", "", "יִשְׁמָעֵאל", "וְאָמַר", "גּוֹבֶה", "מִנְּכָסִים", "בְּנֵי", "חוֹרִין"], "א''ל בן ננס: אינו גובה לא מנכסים משועבדים ולא מנכסים בני חורין.": ["אָ", "לָ", "בֶּן", "נַנָּס", "אֵינוֹ", "גּוֹבֶה", "לֹא", "מִנְּכָסִים", "מְשׁוּעְבָּדִים", "וְלֹא", "מִנְּכָסִים", "בְּנֵי", "חוֹרִין"]}